<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Athena.UI.ViewModels"
        x:Class="Athena.UI.Views.ApprovalQueueWindow"
        x:DataType="vm:ApprovalQueueViewModel"
        Title="待审批工具"
        Width="520" Height="420" MinWidth="440" MinHeight="260"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Grid Margin="14" RowDefinitions="Auto,*">
        <StackPanel>
            <TextBlock Text="待审批工具" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock Text="会话会停在工具调用处；你可以按任意顺序处理，其他会话不受影响。" Opacity="0.65" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding Pending}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ApprovalQueueItemViewModel">
                        <Border Padding="12" Margin="0,0,0,9" BorderThickness="1" BorderBrush="{DynamicResource SemiGreyLowBrush}" CornerRadius="8">
                            <StackPanel Spacing="7">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RiskText}" Foreground="{DynamicResource SemiOrange5}"/>
                                </Grid>
                                <TextBlock Text="{Binding ConversationId, StringFormat=会话：{0}}" FontSize="10" Opacity="0.55"/>
                                <TextBlock Text="{Binding Request.PrettyArguments}" FontFamily="Menlo, Consolas, monospace" FontSize="11" MaxHeight="100" TextWrapping="Wrap"/>
                                <WrapPanel>
                                    <Button Content="允许一次" Command="{Binding AllowOnceCommand}" Margin="0,0,6,0"/>
                                    <Button Content="本会话允许" Command="{Binding AllowSessionCommand}" Margin="0,0,6,0"/>
                                    <Button Content="始终允许" Command="{Binding AllowAlwaysCommand}" Margin="0,0,6,0"/>
                                    <Button Content="拒绝" Command="{Binding DenyCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
