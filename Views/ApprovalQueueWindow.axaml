<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Athena.UI.ViewModels"
        xmlns:loc="using:Athena.UI.Markup"
        x:Class="Athena.UI.Views.ApprovalQueueWindow"
        x:DataType="vm:ApprovalQueueViewModel"
        Title="{loc:Loc Approval.Window.Title}"
        Width="520" Height="420" MinWidth="440" MinHeight="260"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Grid Margin="14" RowDefinitions="Auto,*">
        <StackPanel>
            <TextBlock Text="{loc:Loc Approval.Heading}" FontSize="{DynamicResource App.FontSize.PageTitle}" FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Loc Approval.Description}" Opacity="0.65" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding Pending}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ApprovalQueueItemViewModel">
                        <Border Padding="12" Margin="0,0,0,9" BorderThickness="1" BorderBrush="{DynamicResource SemiGreyLowBrush}" CornerRadius="8">
                            <StackPanel Spacing="7">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RiskText}" Foreground="{DynamicResource SemiOrange5}"/>
                                </Grid>
                                <TextBlock Text="{Binding ConversationIdLabel}" FontSize="{DynamicResource App.FontSize.Caption}" Opacity="0.55"/>
                                <TextBlock Text="{Binding Request.PrettyArguments}" FontFamily="Menlo, Consolas, monospace" FontSize="{DynamicResource App.FontSize.Body}" MaxHeight="100" TextWrapping="Wrap"/>
                                <WrapPanel>
                                    <Button Content="{loc:Loc Approval.Button.AllowOnce}" Command="{Binding AllowOnceCommand}" Margin="0,0,6,0"/>
                                    <Button Content="{loc:Loc Approval.Button.AllowSession}" Command="{Binding AllowSessionCommand}" Margin="0,0,6,0"/>
                                    <Button Content="{loc:Loc Approval.Button.AllowAlways}" Command="{Binding AllowAlwaysCommand}" Margin="0,0,6,0"/>
                                    <Button Content="{loc:Loc Approval.Button.Deny}" Command="{Binding DenyCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
