<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="https://irihi.tech/ursa"
        xmlns:loc="using:Athena.UI.Markup"
        xmlns:vm="using:Athena.UI.ViewModels"
        xmlns:models="using:Athena.UI.Models"
        x:Class="Athena.UI.Views.ProviderModelsWindow"
        x:DataType="vm:ProviderModelsViewModel"
        Title="{loc:Loc ProviderModels.Title}"
        Width="1280" Height="820"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="5" ColumnDefinitions="280,5,*">
        <!-- 固定宽度的供应商导航，操作按钮始终留在顶部。 -->
        <Border Background="{DynamicResource App.WorkspaceLeftBackground}"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid RowDefinitions="Auto,*">
                <Border Padding="10"
                        BorderBrush="{DynamicResource SemiGreyLowBrush}"
                        BorderThickness="0,0,0,1">
                    <Button Content="{loc:Loc ProviderModels.AddProvider}"
                            Command="{Binding AddProviderCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Theme="{StaticResource AccentButtonTheme}"/>
                </Border>

                <ListBox Grid.Row="1"
                         Margin="8"
                         ItemsSource="{Binding Providers}"
                         SelectedItem="{Binding SelectedProvider}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <!-- 仅在 ListBoxItem 悬停时显示删除按钮；选中态也保留可见。 -->
                        <Style Selector="ListBoxItem Button.provider-item-delete">
                            <Setter Property="IsVisible" Value="False"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover Button.provider-item-delete">
                            <Setter Property="IsVisible" Value="True"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected Button.provider-item-delete">
                            <Setter Property="IsVisible" Value="True"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:OpenAiProviderConfiguration">
                            <Border Padding="11"
                                    Margin="0,0,0,7"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                                    CornerRadius="7">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding BaseUrl}"
                                                   FontSize="{DynamicResource App.FontSize.Body}"
                                                   Opacity="0.65"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding Models.Count}" FontSize="{DynamicResource App.FontSize.Body}" Opacity="0.8"/>
                                            <TextBlock Text="{loc:Loc ProviderModels.ModelCount}" FontSize="{DynamicResource App.FontSize.Body}" Opacity="0.8"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="provider-item-delete"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Margin="8,0,0,0"
                                            Command="{Binding $parent[Window].((vm:ProviderModelsViewModel)DataContext).DeleteProviderCommand}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="4,4"
                                            ToolTip.Tip="{loc:Loc ProviderModels.DeleteProvider}"
                                            AutomationProperties.Name="{loc:Loc ProviderModels.DeleteProvider}">
                                        <PathIcon Data="{StaticResource SemiIconDelete}"
                                                  Width="14"
                                                  Height="14"
                                                  Foreground="{DynamicResource App.IconDangerForeground}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 右侧 Tab 布局：连接页（连接配置 + 业务模型分工）、模型目录与元数据。 -->
        <Border Grid.Column="2"
                Background="{DynamicResource App.WorkspaceRightBackground}"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <TabControl x:Name="ProviderModelsTabs">
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{loc:Loc ProviderModels.Connection}" FontWeight="SemiBold"/>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="14"
                                    Margin="16"
                                    MinWidth="660"
                                    MaxWidth="1020"
                                    HorizontalAlignment="Center">
                            <Border Padding="16"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                                    Background="{DynamicResource App.SectionBg}"
                                    CornerRadius="8">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="{loc:Loc ProviderModels.Connection}"
                                               FontSize="{DynamicResource App.FontSize.Title}"
                                               FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="160,460,*" ColumnSpacing="8">
                                        <TextBlock Text="{loc:Loc ProviderModels.Preset}"
                                                   VerticalAlignment="Center"/>
                                        <TextBox x:Name="ProviderTypeEditor"
                                                 Grid.Column="1"
                                                 Text="{Binding SelectedProvider.ProviderPreset, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{loc:Loc ProviderModels.PresetPlaceholder}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="160,460,*" ColumnSpacing="8">
                                        <TextBlock Text="{loc:Loc ProviderModels.DisplayName}"
                                                   VerticalAlignment="Center"/>
                                        <TextBox x:Name="ProviderDisplayNameEditor"
                                                 Grid.Column="1"
                                                 Text="{Binding SelectedProvider.DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="160,460,*" ColumnSpacing="8">
                                        <TextBlock Text="{loc:Loc ProviderModels.ApiRoot}"
                                                   VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding SelectedProvider.BaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="160,460,*" ColumnSpacing="8">
                                        <TextBlock Text="{loc:Loc ProviderModels.ApiKey}"
                                                   VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding SelectedProvider.ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                                 PasswordChar="●"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="160,460,*" ColumnSpacing="8">
                                        <TextBlock Text="{loc:Loc ProviderModels.Protocol}"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="{loc:Loc ProviderModels.Protocol.Hint}"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding ProtocolOptions}"
                                                  SelectedItem="{Binding SelectedProtocolOption}"
                                                  HorizontalAlignment="Left"
                                                  MinWidth="220"
                                                  ToolTip.Tip="{loc:Loc ProviderModels.Protocol.Hint}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="168,2,0,0">
                                        <u:IconButton Content="{loc:Loc ProviderModels.RefreshInventory}"
                                                      Command="{Binding RefreshModelsCommand}"
                                                      CommandParameter="{Binding SelectedProvider}"
                                                      IsLoading="{Binding IsRefreshing}"/>
                                        <TextBlock Text="{Binding StatusText}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SemiOrange5}"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox PlaceholderText="{loc:Loc ProviderModels.ManualModelId}"
                                                 Text="{Binding ManualModelId}"/>
                                        <Button Grid.Column="1"
                                                Content="{loc:Loc Common.Add}"
                                                Command="{Binding AddManualModelCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Padding="16"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                                    Background="{DynamicResource App.SectionBg}"
                                    CornerRadius="8">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{loc:Loc ProviderModels.Roles}"
                                               FontSize="{DynamicResource App.FontSize.Title}"
                                               FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding Roles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProviderRoleSelectionViewModel">
                                                <Grid ColumnDefinitions="132,190,300"
                                                      ColumnSpacing="8"
                                                      Margin="0,4">
                                                    <TextBlock Text="{Binding Name}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <ComboBox Grid.Column="1"
                                                              Width="190"
                                                              MaxWidth="190"
                                                              ItemsSource="{Binding Providers}"
                                                              SelectedItem="{Binding SelectedProvider}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip.Tip="{Binding DisplayName}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <ComboBox Grid.Column="2"
                                                              Width="300"
                                                              MaxWidth="300"
                                                              ItemsSource="{Binding AvailableModels}"
                                                              SelectedItem="{Binding SelectedModel}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Id}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip.Tip="{Binding Id}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{loc:Loc ProviderModels.Metadata.Title}" FontWeight="SemiBold"/>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14"
                                    Margin="16"
                                    MinWidth="660"
                                    MaxWidth="1020"
                                    HorizontalAlignment="Center">
                            <Border Padding="16"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                                    Background="{DynamicResource App.SectionBg}"
                                    CornerRadius="8">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc ProviderModels.Metadata.Title}"
                                                    FontSize="{DynamicResource App.FontSize.Title}"
                                                    FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding MetadataCatalogText}" Opacity="0.62" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <u:IconButton Content="{loc:Loc ProviderModels.Metadata.Refresh}"
                                                      Command="{Binding RefreshMetadataCatalogCommand}"
                                                      IsLoading="{Binding IsMetadataRefreshing}"
                                                      AutomationProperties.Name="{loc:Loc ProviderModels.Metadata.Refresh}"/>
                                        <u:IconButton Margin="10,0,0,0" 
                                                      Content="{loc:Loc ProviderModels.Metadata.ExportCsv}"
                                                      Command="{Binding ExportMetadataCsvCommand}"
                                                      AutomationProperties.Name="{loc:Loc ProviderModels.Metadata.ExportCsv}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding MetadataStatusText}" IsVisible="{Binding HasMetadataStatusText}" TextWrapping="Wrap"/>
                                    <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="8">
                                        <TextBox PlaceholderText="{loc:Loc ProviderModels.Metadata.Search}"
                                                 Text="{Binding MetadataSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding CapabilityFilters}" SelectedItem="{Binding SelectedCapabilityFilter}">
                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding MatchFilters}" SelectedItem="{Binding SelectedMatchFilter}">
                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
            
                                    <Grid ColumnDefinitions="310,8,*" Height="560">
                                        <ListBox x:Name="MetadataModelList"
                                                 Grid.Column="0"
                                                 ItemsSource="{Binding MetadataModels}"
                                                 SelectedItem="{Binding SelectedMetadataModel}"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ProviderModelMetadataItemViewModel">
                                                    <Grid Margin="4" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding ExternalModelId}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ExternalModelId}"/>
                                                        <TextBlock Grid.Row="1" Text="{Binding OpenRouterModelId}" Opacity="0.65"
                                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OpenRouterModelId}"/>
                                                        <TextBlock Grid.Row="2" Text="{Binding ContextWindowText}" Opacity="0.65"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding MatchStatusText}" Margin="8,0,0,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
            
                                        <Border Grid.Column="2" BorderThickness="1" BorderBrush="{DynamicResource SemiGreyLowBrush}" CornerRadius="7">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel Margin="14" DataContext="{Binding SelectedMetadataModel}" Spacing="12">
                                                    <TextBlock Text="{loc:Loc ProviderModels.Metadata.Empty}"
                                                               IsVisible="{Binding $parent[Window].((vm:ProviderModelsViewModel)DataContext).HasNoSelectedMetadataModel}"
                                                               Opacity="0.6"/>
                                                    <StackPanel Spacing="6" IsVisible="{Binding $parent[Window].((vm:ProviderModelsViewModel)DataContext).HasSelectedMetadataModel}">
                                                        <TextBlock Text="{loc:Loc ProviderModels.Metadata.Identity}" FontWeight="SemiBold"/>
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                            <SelectableTextBlock Text="{Binding ExternalModelId}" TextWrapping="Wrap"/>
                                                            <Button Grid.Column="1" Content="{loc:Loc Common.Copy}"
                                                                    Command="{Binding $parent[Window].((vm:ProviderModelsViewModel)DataContext).CopyMetadataTextCommand}"
                                                                    CommandParameter="{Binding ExternalModelId}"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding AvailabilityText}"/>
                                                        <SelectableTextBlock Text="{Binding OpenRouterModelId}" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding OpenRouterModelName}" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding MatchDetails}" TextWrapping="Wrap"/>
                                                    </StackPanel>
            
                                                    <StackPanel Spacing="5" IsVisible="{Binding $parent[Window].((vm:ProviderModelsViewModel)DataContext).HasSelectedMetadataModel}">
                                                        <TextBlock Text="{loc:Loc ProviderModels.Metadata.ResolvedFacts}" FontWeight="SemiBold"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{loc:Loc ProviderModels.Metadata.ContextWindow}"/><TextBlock Text="{Binding ContextWindowText}" TextWrapping="Wrap"/></StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{loc:Loc ProviderModels.Metadata.MaxOutput}"/><TextBlock Text="{Binding MaxCompletionText}" TextWrapping="Wrap"/></StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{loc:Loc ProviderModels.Metadata.Tools}"/><TextBlock Text="{Binding ToolsText}" TextWrapping="Wrap"/></StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{loc:Loc ProviderModels.Metadata.Reasoning}"/><TextBlock Text="{Binding ReasoningText}" TextWrapping="Wrap"/></StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{loc:Loc ProviderModels.Metadata.StructuredOutputs}"/><TextBlock Text="{Binding StructuredOutputText}" TextWrapping="Wrap"/></StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{loc:Loc ProviderModels.Metadata.Responses}"/><TextBlock Text="{Binding ResponsesText}" TextWrapping="Wrap"/></StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{loc:Loc ProviderModels.Metadata.ReasoningEffort}"/><TextBlock Text="{Binding ReasoningEffortText}" TextWrapping="Wrap"/></StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{loc:Loc ProviderModels.Metadata.Input}"/><TextBlock Text="{Binding InputModalitiesText}" TextWrapping="Wrap"/></StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{loc:Loc ProviderModels.Metadata.Output}"/><TextBlock Text="{Binding OutputModalitiesText}" TextWrapping="Wrap"/></StackPanel>
                                                        <TextBlock Text="{Binding WarningText}" IsVisible="{Binding HasWarnings}" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource SemiOrange5}"/>
                                                    </StackPanel>
            
                                                    <StackPanel Spacing="7" IsVisible="{Binding $parent[Window].((vm:ProviderModelsViewModel)DataContext).HasSelectedMetadataModel}">
                                                        <TextBlock Text="{loc:Loc ProviderModels.Metadata.Binding}" FontWeight="SemiBold"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Button Content="{loc:Loc ProviderModels.Metadata.Automatic}" Command="{Binding UseAutomaticMatchCommand}"/>
                                                            <Button Content="{loc:Loc ProviderModels.Metadata.CustomOnly}" Command="{Binding UseCustomOnlyCommand}"/>
                                                        </StackPanel>
                                                        <ComboBox ItemsSource="{Binding OpenRouterModels}" SelectedItem="{Binding SelectedPinnedModel}"
                                                                  PlaceholderText="{loc:Loc ProviderModels.Metadata.PinPlaceholder}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:OpenRouterModelMetadata">
                                                                    <TextBlock Text="{Binding Id}" ToolTip.Tip="{Binding Name}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <ItemsControl ItemsSource="{Binding MatchCandidates}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:ModelMatchCandidate">
                                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
                                                                        <TextBlock Text="{Binding OpenRouterModelId, StringFormat='• {0}'}" ToolTip.Tip="{Binding Rule}" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Grid.Column="1" Text="{loc:Loc ProviderModels.Metadata.Score}" Opacity="0.6"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding Score}" Opacity="0.6"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
            
                                                    <StackPanel Spacing="7" IsVisible="{Binding $parent[Window].((vm:ProviderModelsViewModel)DataContext).HasSelectedMetadataModel}">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="{loc:Loc ProviderModels.Metadata.Overrides}" FontWeight="SemiBold"/>
                                                            <Button Grid.Column="1" Content="{loc:Loc ProviderModels.Metadata.ResetOverrides}"
                                                                    Command="{Binding ResetOverridesCommand}"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                            <StackPanel><TextBlock Text="{loc:Loc ProviderModels.Metadata.ContextWindow}"/><NumericUpDown Value="{Binding ContextWindowOverride}" Minimum="1024"/></StackPanel>
                                                            <StackPanel Grid.Column="1"><TextBlock Text="{loc:Loc ProviderModels.Metadata.MaxOutput}"/><NumericUpDown Value="{Binding MaxCompletionOverride}" Minimum="1"/></StackPanel>
                                                        </Grid>
                                                        <CheckBox Content="{loc:Loc ProviderModels.Metadata.Tools}" IsThreeState="True" IsChecked="{Binding SupportsToolsOverride}"/>
                                                        <CheckBox Content="{loc:Loc ProviderModels.Metadata.Reasoning}" IsThreeState="True" IsChecked="{Binding SupportsReasoningOverride}"/>
                                                        <CheckBox Content="{loc:Loc ProviderModels.Metadata.StructuredOutputs}" IsThreeState="True" IsChecked="{Binding SupportsStructuredOutputOverride}"/>
                                                        <CheckBox Content="{loc:Loc ProviderModels.Metadata.Responses}" IsThreeState="True" IsChecked="{Binding SupportsResponsesOverride}"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{loc:Loc ProviderModels.Metadata.ReasoningEffort}"/>
                                                            <ComboBox ItemsSource="{Binding ReasoningEffortOptions}"
                                                                      SelectedItem="{Binding SelectedEffortOption}"
                                                                      HorizontalAlignment="Stretch">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:ReasoningEffortOption">
                                                                        <TextBlock Text="{Binding Label}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>
                                                        <TextBox PlaceholderText="{loc:Loc ProviderModels.Metadata.InputPlaceholder}" Text="{Binding InputModalitiesOverride}"/>
                                                        <TextBox PlaceholderText="{loc:Loc ProviderModels.Metadata.OutputPlaceholder}" Text="{Binding OutputModalitiesOverride}"/>
                                                    </StackPanel>
            
                                                    <Expander Header="{loc:Loc ProviderModels.Metadata.RawJson}" IsVisible="{Binding HasRawOpenRouterJson}">
                                                        <StackPanel Spacing="6">
                                                            <Button Content="{loc:Loc Common.Copy}" HorizontalAlignment="Left"
                                                                    Command="{Binding $parent[Window].((vm:ProviderModelsViewModel)DataContext).CopyMetadataTextCommand}"
                                                                    CommandParameter="{Binding RawOpenRouterJson}"/>
                                                            <SelectableTextBlock Text="{Binding RawOpenRouterJson}" FontFamily="Menlo,Consolas,monospace"
                                                                                 TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
