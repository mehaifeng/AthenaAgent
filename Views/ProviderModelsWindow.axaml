<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Athena.UI.ViewModels"
        xmlns:models="using:Athena.UI.Models"
        x:Class="Athena.UI.Views.ProviderModelsWindow"
        x:DataType="vm:ProviderModelsViewModel"
        Title="供应商模型"
        Width="1120" Height="780"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16" ColumnDefinitions="280,16,*">
        <!-- 固定宽度的供应商导航，操作按钮始终留在顶部。 -->
        <Border Background="{DynamicResource App.WorkspaceLeftBackground}"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid RowDefinitions="Auto,*">
                <Border Padding="10"
                        BorderBrush="{DynamicResource SemiGreyLowBrush}"
                        BorderThickness="0,0,0,1">
                    <Button Content="＋ 添加供应商"
                            Command="{Binding AddProviderCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Theme="{StaticResource AccentButtonTheme}"/>
                </Border>

                <ListBox Grid.Row="1"
                         Margin="8"
                         ItemsSource="{Binding Providers}"
                         SelectedItem="{Binding SelectedProvider}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:OpenAiProviderConfiguration">
                            <Border Padding="11"
                                    Margin="0,0,0,7"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                                    CornerRadius="7">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding BaseUrl}"
                                               FontSize="{DynamicResource App.FontSize.Body}"
                                               Opacity="0.65"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Models.Count, StringFormat={}{0} 个模型}"
                                               FontSize="{DynamicResource App.FontSize.Body}"
                                               Opacity="0.8"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 右侧容器铺满整列；仅约束内部表单宽度，滚动条保持在列边缘。 -->
        <Border Grid.Column="2"
                Background="{DynamicResource App.WorkspaceRightBackground}"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid RowDefinitions="*,Auto">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14"
                                Margin="16"
                                MinWidth="600"
                                MaxWidth="760"
                                HorizontalAlignment="Center">
                <Border Padding="16"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SemiGreyLowBrush}"
                        Background="{DynamicResource App.SectionBg}"
                        CornerRadius="8">
                    <StackPanel Spacing="9">
                        <TextBlock Text="连接"
                                   FontSize="{DynamicResource App.FontSize.Title}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="显示名称"/>
                        <TextBox Text="{Binding SelectedProvider.DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="预设"/>
                        <TextBox Text="{Binding SelectedProvider.ProviderPreset, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="OpenAI / OpenRouter / Custom"/>
                        <TextBlock Text="API Root"/>
                        <TextBox Text="{Binding SelectedProvider.BaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="API Key"/>
                        <TextBox Text="{Binding SelectedProvider.ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                 PasswordChar="●"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="刷新模型"
                                    Command="{Binding RefreshModelsCommand}"
                                    CommandParameter="{Binding SelectedProvider}"/>
                            <Button Content="删除供应商"
                                    Command="{Binding DeleteProviderCommand}"
                                    CommandParameter="{Binding SelectedProvider}"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox PlaceholderText="手动模型 ID"
                                     Text="{Binding ManualModelId}"/>
                            <Button Grid.Column="1"
                                    Content="添加"
                                    Command="{Binding AddManualModelCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Padding="16"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SemiGreyLowBrush}"
                        Background="{DynamicResource App.SectionBg}"
                        CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock Text="模型分工"
                                   FontSize="{DynamicResource App.FontSize.Title}"
                                   FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding Roles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProviderRoleSelectionViewModel">
                                    <Grid ColumnDefinitions="132,190,*"
                                          ColumnSpacing="8"
                                          Margin="0,4">
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Providers}"
                                                  SelectedItem="{Binding SelectedProvider}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding AvailableModels}"
                                                  SelectedItem="{Binding SelectedModel}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Id}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="1"
                           Text="{Binding StatusText}"
                           Foreground="{DynamicResource SemiOrange5}"
                           HorizontalAlignment="Center"
                           Margin="12,0,12,10"/>
            </Grid>
        </Border>
    </Grid>
</Window>
