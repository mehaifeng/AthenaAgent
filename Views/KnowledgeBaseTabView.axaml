<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Athena.UI.Markup"
             xmlns:models="using:Athena.UI.Models"
             xmlns:lmd="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             mc:Ignorable="d"
             d:DesignWidth="720" 
             d:DesignHeight="1080"
             x:Class="Athena.UI.Views.KnowledgeBaseTabView"
             x:DataType="vm:KnowledgeBaseTabViewModel"
             Loaded="OnLoaded">

    <Design.DataContext>
        <vm:KnowledgeBaseTabViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="40,*,Auto">

        <!-- HEADER BAR -->
        <Border Grid.Row="0"
                CornerRadius="0,0,5,5"
                Background="{DynamicResource App.SectionBg}"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{loc:Loc Files.Header}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1" 
                        Command="{Binding RefreshFilesCommand}" 
                        Padding="8,4" 
                        Margin="0,0,8,0"
                        ToolTip.Tip="{loc:Loc Files.BtnRefresh}">
                    <PathIcon Data="{StaticResource SemiIconRefresh}" Width="16" Height="16"/>
                </Button>
                <Button Grid.Column="2" 
                        Command="{Binding ImportCommand}" 
                        Padding="8,4" 
                        Margin="0,0,8,0"
                        ToolTip.Tip="{loc:Loc Files.BtnImport}">
                    <PathIcon Data="{StaticResource SemiIconUpload}" Width="16" Height="16"/>
                </Button>
                <Button Grid.Column="3" 
                        Command="{Binding ExportCommand}" 
                        Padding="8,4" 
                        Margin="0,0,8,0"
                        ToolTip.Tip="{loc:Loc Files.BtnExport}">
                    <PathIcon Data="{StaticResource SemiIconDownload}" Width="16" Height="16"/>
                </Button>
                <Button Grid.Column="4" 
                        Command="{Binding DeleteFileCommand}" 
                        Padding="8,4" 
                        ToolTip.Tip="{loc:Loc Files.BtnDelete}">
                    <PathIcon Data="{StaticResource SemiIconDelete}" Width="16" Height="16"/>
                </Button>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="1" ColumnDefinitions="0.4*,0.6*" Margin="0,5,0,5">

            <!-- LEFT PANEL: DIRECTORY -->
            <Border Grid.Column="0"
                    Background="{DynamicResource App.SectionBg}"
                    CornerRadius="8">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Panel Header -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="12,8" >
                        <TextBlock Text="{loc:Loc Files.DirectoryStructure}" FontWeight="Bold" FontSize="13"/>
                    </Border>

                    <!-- Tree View -->
                    <TreeView Grid.Row="1"
                             ItemsSource="{Binding Files}"
                             SelectedItem="{Binding SelectedFile}"
                             Background="Transparent"
                             Padding="8">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Name}"/>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True"/>
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:Loc Files.CtxView}" Command="{Binding ViewFileCommand}"/>
                                <MenuItem Header="{loc:Loc Files.CtxDelete}" Command="{Binding DeleteFileCommand}"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>

                    <!-- File/Folder Creation -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0" Padding="12" >
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding NewFolderName}" PlaceholderText="{loc:Loc Files.MkdirPlaceholder}" />
                                <Button Grid.Column="1" Command="{Binding NewFolderCommand}" Padding="12,4" Margin="8,0,0,0">
                                    <PathIcon Data="{StaticResource SemiIconPlus}" Width="14" Height="14"/>
                                </Button>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding NewFileName}" PlaceholderText="{loc:Loc Files.TouchPlaceholder}" />
                                <Button Grid.Column="1" Command="{Binding NewFileCommand}" Padding="12,4" Margin="8,0,0,0">
                                    <PathIcon Data="{StaticResource SemiIconPlus}" Width="14" Height="14"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: FILE INSPECTOR -->
            <Border Grid.Column="1"
                    Background="{DynamicResource App.SectionBg}"
                    CornerRadius="8"
                    Margin="5,0,0,0">
                <Grid RowDefinitions="Auto,*">

                    <!-- Panel Header -->
                    <Grid ColumnDefinitions="*,Auto" Margin="10,10">
                        <!-- 左列：用 Grid 替换 StackPanel，避免撑开 -->
                        <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0"
                                    Text="{loc:Loc Files.Path}"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Opacity="0.6"
                                    Margin="0,0,8,0"/>
                            <SelectableTextBlock Grid.Column="1"
                                    Text="{Binding SelectedFileDisplayPath}"
                                    FontSize="12"
                                    ToolTip.Tip="{Binding SelectedFileDisplayPath}"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"/>
                        </Grid>

                        <!-- 右列：模式标志 + 切换按钮 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0">
                            <TextBlock Text="{loc:Loc Files.ModeEdit}"
                                    IsVisible="{Binding IsEditingFile}"
                                    FontSize="12" FontWeight="Bold"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource App.EmphasisForeground}"/>
                            <TextBlock Text="{loc:Loc Files.ModeRead}"
                                    IsVisible="{Binding !IsEditingFile}"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Opacity="0.8"/>
                            <Button Command="{Binding ToggleEditModeCommand}"
                                    IsVisible="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Padding="8,2"
                                    FontSize="11"
                                    ToolTip.Tip="{loc:Loc Files.ModeEdit}">
                                <Panel>
                                    <PathIcon Data="{StaticResource SemiIconEyeOpened}" Width="13" Height="13"
                                              IsVisible="{Binding !IsEditingFile}"/>
                                    <PathIcon Data="{StaticResource SemiIconEdit}" Width="13" Height="13"
                                              IsVisible="{Binding IsEditingFile}"/>
                                </Panel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Editor -->
                    <Grid Grid.Row="1" Margin="10">
                        <!-- 预览模式：Markdown 渲染 -->
                        <ScrollViewer IsVisible="{Binding !IsEditingFile}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <lmd:MarkdownRenderer loc:MarkdownHelper.Text="{Binding EditingFileContent}">
                                <lmd:MarkdownRenderer.Styles>
									<Style Selector="lmd|CodeBlock">
                                      <Setter Property="ColorTheme" Value="TomorrowNightBlue"/>
                                    </Style>
                                </lmd:MarkdownRenderer.Styles>
                            </lmd:MarkdownRenderer>
                        </ScrollViewer>

                        <!-- 编辑模式：TextBox -->
                        <TextBox
                                Text="{Binding EditingFileContent}"
                                IsVisible="{Binding IsEditingFile}"
                                VerticalContentAlignment="Top"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="16"
                                PlaceholderText="{loc:Loc Files.NoFileSelected}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER BAR (ACTIONS) -->
        <Border Grid.Row="2" 
                BorderBrush="{DynamicResource App.SectionBg}" 
                BorderThickness="0,1,0,0" 
                Padding="12,8" >
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Loc Files.AwaitingInput}" VerticalAlignment="Center" FontSize="12" Opacity="0.6"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEditingFile}">
                    <Button Command="{Binding CancelEditCommand}" 
                            Padding="16,4"
                            ToolTip.Tip="{loc:Loc Chat.BtnAbort}">
                        <PathIcon Data="{StaticResource SemiIconClose}" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding SaveFileCommand}" 
                            Theme="{StaticResource AccentButtonTheme}" 
                            Padding="16,4"
                            ToolTip.Tip="{loc:Loc Files.BtnCommitWrite}">
                        <PathIcon Data="{StaticResource SemiIconSave}" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
