<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Athena.UI.Markup"
             xmlns:lmd="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             mc:Ignorable="d"
             d:DesignWidth="1080"
             d:DesignHeight="760"
             x:Class="Athena.UI.Views.KnowledgeBaseTabView"
             x:DataType="vm:KnowledgeBaseTabViewModel"
             Loaded="OnLoaded">

    <Design.DataContext>
        <vm:KnowledgeBaseTabViewModel/>
    </Design.DataContext>

    <Grid Margin="14" ColumnDefinitions="3*,12,7*">
        <!-- 左侧目录区保持约三成宽度。 -->
        <Border Grid.Column="0"
                Background="{DynamicResource App.WorkspaceLeftBackground}"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid RowDefinitions="Auto,*,Auto">
                <Border Padding="12,10"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="{loc:Loc Files.DirectoryStructure}"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource App.FontSize.Subheading}"/>
                </Border>

                <TreeView Grid.Row="1"
                          ItemsSource="{Binding Files}"
                          SelectedItem="{Binding SelectedFile}"
                          Background="Transparent"
                          Padding="8"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}"/>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True"/>
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Loc Files.CtxView}"
                                      Command="{Binding ViewFileCommand}"/>
                            <MenuItem Header="{loc:Loc Files.CtxDelete}"
                                      Command="{Binding DeleteFileCommand}"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>

                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="10">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding NewFolderName}"
                                     PlaceholderText="{loc:Loc Files.MkdirPlaceholder}"/>
                            <Button Grid.Column="1"
                                    Command="{Binding NewFolderCommand}"
                                    Padding="11,4">
                                <PathIcon Data="{StaticResource SemiIconPlus}"
                                          Width="14"
                                          Height="14"/>
                            </Button>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding NewFileName}"
                                     PlaceholderText="{loc:Loc Files.TouchPlaceholder}"/>
                            <Button Grid.Column="1"
                                    Command="{Binding NewFileCommand}"
                                    Padding="11,4">
                                <PathIcon Data="{StaticResource SemiIconPlus}"
                                          Width="14"
                                          Height="14"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧编辑区允许随窗口完整拉伸。 -->
        <Border Grid.Column="2"
                Background="{DynamicResource App.WorkspaceRightBackground}"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid RowDefinitions="Auto,Auto,Auto,*">
                <!-- 功能集中到右侧顶部栏。 -->
                <Border Padding="10,8"
                        BorderBrush="{DynamicResource SemiGreyLowBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{loc:Loc Files.AwaitingInput}"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource App.FontSize.Body}"
                                   Opacity="0.6"/>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="7">
                            <Button Command="{Binding RefreshFilesCommand}"
                                    Padding="8,4"
                                    ToolTip.Tip="{loc:Loc Files.BtnRefresh}">
                                <PathIcon Data="{StaticResource SemiIconRefresh}"
                                          Width="15"
                                          Height="15"/>
                            </Button>
                            <Button Command="{Binding ImportCommand}"
                                    Padding="8,4"
                                    ToolTip.Tip="{loc:Loc Files.BtnImport}">
                                <PathIcon Data="{StaticResource SemiIconUpload}"
                                          Width="15"
                                          Height="15"/>
                            </Button>
                            <Button Command="{Binding ExportCommand}"
                                    Padding="8,4"
                                    ToolTip.Tip="{loc:Loc Files.BtnExport}">
                                <PathIcon Data="{StaticResource SemiIconDownload}"
                                          Width="15"
                                          Height="15"/>
                            </Button>
                            <Button Command="{Binding DeleteFileCommand}"
                                    Padding="8,4"
                                    ToolTip.Tip="{loc:Loc Files.BtnDelete}">
                                <PathIcon Data="{StaticResource SemiIconDelete}"
                                          Width="15"
                                          Height="15"/>
                            </Button>
                            <Separator Width="1"
                                       Height="20"
                                       Margin="3,0"
                                       VerticalAlignment="Center"/>
                            <Button Command="{Binding CancelEditCommand}"
                                    IsVisible="{Binding IsEditingFile}"
                                    Padding="8,4"
                                    ToolTip.Tip="{loc:Loc Chat.BtnAbort}">
                                <PathIcon Data="{StaticResource SemiIconClose}"
                                          Width="15"
                                          Height="15"/>
                            </Button>
                            <Button Command="{Binding SaveFileCommand}"
                                    IsVisible="{Binding IsEditingFile}"
                                    Theme="{StaticResource AccentButtonTheme}"
                                    Padding="10,4"
                                    ToolTip.Tip="{loc:Loc Files.BtnCommitWrite}">
                                <PathIcon Data="{StaticResource SemiIconSave}"
                                          Width="15"
                                          Height="15"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Expander Grid.Row="1"
                          Header="{loc:Loc Config.KnowledgeMaintenance}"
                          Margin="10,8,10,0">
                    <Border Padding="12"
                            BorderBrush="{DynamicResource SemiGreyLowBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                                <TextBlock Text="{loc:Loc Config.KbMaintenanceEnabled}"
                                           VerticalAlignment="Center"/>
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding Config.KnowledgeMaintenanceEnabled}"/>
                                <TextBlock Grid.Row="1"
                                           Text="{loc:Loc Config.KbMaintenanceInterval}"
                                           VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Row="1"
                                               Grid.Column="1"
                                               Value="{Binding Config.KnowledgeMaintenanceIntervalDays}"
                                               Minimum="1"
                                               Maximum="365"
                                               Width="120"/>
                            </Grid>
                            <WrapPanel>
                                <Button x:Name="RunKnowledgeMaintenanceButton"
                                        Command="{Binding RunKnowledgeMaintenanceCommand}"
                                        Content="{loc:Loc Config.KbMaintenanceRunNow}"
                                        Margin="0,0,8,0"/>
                                <Button x:Name="RebuildVectorIndexButton"
                                        Command="{Binding RebuildVectorIndexCommand}"
                                        Content="{loc:Loc Config.RebuildVectorIndex}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding MaintenanceStatus}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"/>
                            <TextBlock Text="{Binding VectorIndexStatus}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"/>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- 文件路径和预览/编辑模式独占一行。 -->
                <Grid Grid.Row="2"
                      ColumnDefinitions="*,Auto"
                      Margin="12,9">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="{loc:Loc Files.Path}"
                                   FontSize="{DynamicResource App.FontSize.Body}"
                                   VerticalAlignment="Center"
                                   Opacity="0.6"
                                   Margin="0,0,8,0"/>
                        <SelectableTextBlock Grid.Column="1"
                                             Text="{Binding SelectedFileDisplayPath}"
                                             FontSize="{DynamicResource App.FontSize.Body}"
                                             ToolTip.Tip="{Binding SelectedFileDisplayPath}"
                                             FontWeight="SemiBold"
                                             VerticalAlignment="Center"
                                             TextTrimming="CharacterEllipsis"
                                             TextWrapping="NoWrap"/>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="10,0,0,0">
                        <TextBlock Text="{loc:Loc Files.ModeEdit}"
                                   IsVisible="{Binding IsEditingFile}"
                                   FontSize="{DynamicResource App.FontSize.Body}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.EmphasisForeground}"/>
                        <TextBlock Text="{loc:Loc Files.ModeRead}"
                                   IsVisible="{Binding !IsEditingFile}"
                                   FontSize="{DynamicResource App.FontSize.Body}"
                                   VerticalAlignment="Center"
                                   Opacity="0.8"/>
                        <Button Command="{Binding ToggleEditModeCommand}"
                                IsVisible="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Padding="8,2"
                                ToolTip.Tip="{loc:Loc Files.ModeEdit}">
                            <Panel>
                                <PathIcon Data="{StaticResource SemiIconEyeOpened}"
                                          Width="13"
                                          Height="13"
                                          IsVisible="{Binding !IsEditingFile}"/>
                                <PathIcon Data="{StaticResource SemiIconEdit}"
                                          Width="13"
                                          Height="13"
                                          IsVisible="{Binding IsEditingFile}"/>
                            </Panel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3" Margin="10,0,10,10">
                    <ScrollViewer IsVisible="{Binding !IsEditingFile}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch">
                        <lmd:MarkdownRenderer loc:MarkdownHelper.Text="{Binding EditingFileContent}">
                            <lmd:MarkdownRenderer.Styles>
                                <Style Selector="lmd|CodeBlock">
                                    <Setter Property="ColorTheme" Value="TomorrowNightBlue"/>
                                </Style>
                            </lmd:MarkdownRenderer.Styles>
                        </lmd:MarkdownRenderer>
                    </ScrollViewer>

                    <TextBox Text="{Binding EditingFileContent}"
                             IsVisible="{Binding IsEditingFile}"
                             VerticalContentAlignment="Top"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="16"
                             PlaceholderText="{loc:Loc Files.NoFileSelected}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
