<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:views="using:Athena.UI.Views"
             xmlns:conv="using:Athena.UI.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Athena.UI.Markup"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="760"
             x:Class="Athena.UI.Views.TasksView"
             x:DataType="vm:TasksViewModel">

    <Design.DataContext>
        <vm:TasksViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <conv:ToolIconKeyToGeometryConverter x:Key="IconKeyToGeometry"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.task-item-card">
            <Setter Property="Background" Value="{DynamicResource App.SectionBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGreyLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,13"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.task-item-card">
            <Setter Property="Background" Value="{DynamicResource SemiGrey1}"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.task-item-card">
            <Setter Property="Background" Value="{DynamicResource App.SelectedBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.SelectedBorderBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="5" ColumnDefinitions="3*,5,7*">

        <!-- 左栏：创建/编辑共用同一个编辑器 -->
        <Border Grid.Column="0"
                Background="{DynamicResource App.WorkspaceLeftBackground}"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid RowDefinitions="Auto,*,Auto">
                <Border Padding="14,10"
                        BorderBrush="{DynamicResource SemiGreyLowBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding Editor.SaveButtonText}"/>
                </Border>

                <views:CronTaskEditorView Grid.Row="1" DataContext="{Binding Editor}"/>

                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource SemiGreyLowBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12">
                    <StackPanel Spacing="8">
                        <Button Command="{Binding SaveTaskCommand}"
                                Theme="{StaticResource AccentButtonTheme}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                IsEnabled="{Binding Editor.CanSave}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource AthenaIconTaskCreate}" Width="13" Height="13"
                                          Foreground="{DynamicResource App.IconAccentForeground}"/>
                                <TextBlock Text="{Binding Editor.SaveButtonText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CancelEditCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                IsVisible="{Binding Editor.IsEditing}"
                                Content="{loc:Loc Cron.Editor.CancelEdit}"/>

                        <TextBlock Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource App.FontSize.Body}"
                                   Opacity="0.7"
                                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 右栏：任务卡片列表 -->
        <Border Grid.Column="2"
                Background="{DynamicResource App.WorkspaceRightBackground}"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid RowDefinitions="Auto,Auto,*">
                <Border Padding="12,9"
                        BorderBrush="{DynamicResource SemiGreyLowBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource AthenaIconScheduledRun}" Width="15" Height="15" Opacity="0.75"/>
                        <TextBlock Text="{loc:Loc Cron.Tasks.Header}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Tasks.Count}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        IsVisible="{Binding HasCorruptedRecords}"
                        Background="#18C62828"
                        BorderBrush="#88C62828"
                        BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <TextBlock Text="{Binding CorruptedRecordsMessage}"
                               TextWrapping="Wrap"
                               Foreground="#C62828"
                               FontSize="{DynamicResource App.FontSize.Body}"/>
                </Border>

                <TextBlock Grid.Row="2"
                           IsVisible="{Binding !HasTasks}"
                           Text="{loc:Loc Cron.Tasks.Empty}"
                           TextWrapping="Wrap"
                           Margin="24"
                           Opacity="0.6"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <ListBox Grid.Row="2"
                         Margin="10"
                         IsVisible="{Binding HasTasks}"
                         ItemsSource="{Binding Tasks}"
                         SelectedItem="{Binding SelectedTask}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CronTaskItemViewModel">
                            <Border Classes="task-item-card">
                                <StackPanel Spacing="10">

                                    <!-- 标题行 + 操作 -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="5">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="{Binding Name}"
                                                           TextWrapping="Wrap"
                                                           FontSize="{DynamicResource App.FontSize.Heading}"
                                                           FontWeight="Medium"/>
                                                <Border IsVisible="{Binding ShowRunOnceBadge}"
                                                        Background="{DynamicResource SemiGrey2}"
                                                        CornerRadius="4"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RunOnceText}"
                                                               FontSize="{DynamicResource App.FontSize.Body}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Instruction}"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="{DynamicResource App.FontSize.Body}"
                                                       Opacity="0.7"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="2"
                                                    VerticalAlignment="Top">
                                            <Button Command="{Binding RunNowCommand}"
                                                    Theme="{StaticResource BorderlessButtonTheme}"
                                                    Padding="5"
                                                    ToolTip.Tip="{loc:Loc Cron.Action.RunNow}">
                                                <PathIcon Data="{StaticResource AthenaIconTaskRunNow}" Width="14" Height="14" Opacity="0.7"/>
                                            </Button>
                                            <Button Command="{Binding ToggleEnabledCommand}"
                                                    Theme="{StaticResource BorderlessButtonTheme}"
                                                    Padding="5"
                                                    ToolTip.Tip="{Binding ToggleEnabledText}">
                                                <PathIcon Data="{Binding ToggleEnabledIconKey, Converter={StaticResource IconKeyToGeometry}}"
                                                          Width="14" Height="14" Opacity="0.7"/>
                                            </Button>
                                            <Button Command="{Binding EditCommand}"
                                                    Theme="{StaticResource BorderlessButtonTheme}"
                                                    Padding="5"
                                                    ToolTip.Tip="{loc:Loc Cron.Action.Edit}">
                                                <PathIcon Data="{StaticResource AthenaIconEdit}" Width="14" Height="14" Opacity="0.7"/>
                                            </Button>
                                            <Button Command="{Binding DeleteCommand}"
                                                    Classes="danger"
                                                    Theme="{StaticResource BorderlessButtonTheme}"
                                                    Padding="5"
                                                    ToolTip.Tip="{loc:Loc Cron.Action.Delete}">
                                                <PathIcon Data="{StaticResource AthenaIconDelete}" Width="14" Height="14" Opacity="0.65"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 调度元信息 -->
                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto" ColumnSpacing="7">
                                        <TextBlock Text="{loc:Loc Cron.Card.Schedule}"
                                                   FontSize="{DynamicResource App.FontSize.Body}" Opacity="0.6"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ScheduleDescription}"
                                                   TextWrapping="Wrap"
                                                   FontSize="{DynamicResource App.FontSize.Body}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{loc:Loc Cron.Card.NextRun}"
                                                   FontSize="{DynamicResource App.FontSize.Body}" Opacity="0.6"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding NextRunText}"
                                                   FontSize="{DynamicResource App.FontSize.Body}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding TimeZoneId}"
                                                   FontSize="{DynamicResource App.FontSize.Body}" Opacity="0.55"/>
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding StatusText}"
                                                   Margin="8,0,0,0"
                                                   FontSize="{DynamicResource App.FontSize.Body}"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.8"/>
                                    </Grid>

                                    <TextBlock Text="{Binding CronExpression}"
                                               FontFamily="{DynamicResource MonospaceFontFamily}"
                                               FontSize="{DynamicResource App.FontSize.Body}"
                                               Opacity="0.55"/>

                                    <!-- 近期运行：点进去就是那次触发开出的会话 -->
                                    <Expander IsVisible="{Binding HasRuns}"
                                              Header="{loc:Loc Cron.Card.RecentRuns}"
                                              HorizontalAlignment="Stretch">
                                        <ItemsControl ItemsSource="{Binding Runs}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CronTaskRunItemViewModel">
                                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                                                          ColumnSpacing="8"
                                                          Margin="0,0,0,4">
                                                        <PathIcon Data="{Binding StateIconKey, Converter={StaticResource IconKeyToGeometry}}"
                                                                  Width="12" Height="12"
                                                                  VerticalAlignment="Center"
                                                                  Opacity="0.7"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding StateText}"
                                                                   FontSize="{DynamicResource App.FontSize.Body}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding TimestampText}"
                                                                   FontSize="{DynamicResource App.FontSize.Body}"
                                                                   Opacity="0.7"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding TriggerText}"
                                                                   FontSize="{DynamicResource App.FontSize.Body}"
                                                                   Opacity="0.55"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding DetailText}"
                                                                   IsVisible="{Binding HasDetail}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   FontSize="{DynamicResource App.FontSize.Body}"
                                                                   Opacity="0.55"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Grid.Column="5"
                                                                Command="{Binding OpenConversationCommand}"
                                                                IsVisible="{Binding CanOpenConversation}"
                                                                Theme="{StaticResource BorderlessButtonTheme}"
                                                                Padding="4"
                                                                ToolTip.Tip="{loc:Loc Cron.Action.OpenSession}">
                                                            <PathIcon Data="{StaticResource AthenaIconChevronRight}"
                                                                      Width="11" Height="11" Opacity="0.6"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
