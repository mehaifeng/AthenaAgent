<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Athena.UI.ViewModels"
        xmlns:views="using:Athena.UI.Views"
        xmlns:loc="using:Athena.UI.Markup"
        xmlns:appconv="using:Athena.UI.Converters"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="Athena.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:Loc App.Title}"
        Width="1440" Height="900"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        Icon="/Assets/Athena.ico"
        FontFamily="{DynamicResource MainFontFamily}">
    <Design.DataContext><vm:MainWindowViewModel/></Design.DataContext>

    <Window.Resources>
        <appconv:BoolToExpandIconConverter x:Key="BoolToExpandIcon"/>

        <DataTemplate x:Key="ConversationSessionItemTemplate" x:DataType="vm:ConversationSessionItemViewModel">
            <Grid Classes="conversation-row" Classes.selected="{Binding IsSelected}" IsVisible="{Binding IsSearchMatch}">
                <!-- 选中指示条：从中心纵向长出来。用 Classes.on 直接绑 IsSelected，
                     而不是 `Grid.conversation-row.selected Border.row-accent` 这种跨元素后代
                     选择器——后者每次状态翻转都要重算整条后代样式链（CLAUDE.md 里量过的那条）。
                     scaleY 是合成器变换，不触发布局，所以这条动画不会让会话树重排。 -->
                <Border Classes="row-accent" Classes.on="{Binding IsSelected}"
                        Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Margin="0,3" CornerRadius="2"
                        Background="{DynamicResource App.IconAccentForeground}"
                        IsHitTestVisible="False"/>
                <Grid IsVisible="{Binding !IsRenaming}" ColumnDefinitions="*,Auto">
                    <Button Classes="session-row"
                            Command="{Binding $parent[Window].DataContext.SelectConversationCommand}"
                            CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="12,Auto,*">
                            <PathIcon Grid.Column="0" Data="{StaticResource AthenaIconConversation}"
                                      Width="11" Height="11"
                                      Foreground="{DynamicResource App.IconMutedForeground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsVisible="{Binding !HasStatusIndicator}"/>
                            <Grid Grid.Column="0" Width="12" ToolTip.Tip="{Binding StatusText}"
                                  IsVisible="{Binding HasStatusIndicator}">
                                <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource SemiGreen6}" Classes="running-indicator" Classes.running="{Binding ShowRunningIndicator}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowRunningIndicator}"/>
                                <TextBlock Text="…" FontWeight="Bold" FontSize="{DynamicResource App.FontSize.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding ShowQueuedIndicator}"/>
                                <TextBlock Text="◆" FontSize="{DynamicResource App.FontSize.Micro}" Foreground="{DynamicResource SemiOrange5}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowWaitingIndicator}"/>
                                <TextBlock Text="↻" FontWeight="Bold" FontSize="{DynamicResource App.FontSize.Caption}" Foreground="{DynamicResource SemiOrange5}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowArchivePendingIndicator}"/>
                                <TextBlock Text="!" FontWeight="Bold" FontSize="{DynamicResource App.FontSize.Caption}" Foreground="{DynamicResource SemiRed6}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowArchiveFailedIndicator}"/>
                                <TextBlock Text="!" FontWeight="Bold" FontSize="{DynamicResource App.FontSize.Caption}" Foreground="{DynamicResource SemiRed6}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowScheduledFailureIndicator}"/>
                                <TextBlock Text="!" FontWeight="Bold" FontSize="{DynamicResource App.FontSize.Caption}" Foreground="{DynamicResource SemiRed6}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowInterruptedIndicator}"/>
                                <TextBlock Text="✓" FontSize="{DynamicResource App.FontSize.Caption}" Foreground="{DynamicResource SemiGreen6}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowCompletionIndicator}"/>
                            </Grid>
                            <!-- 来源标识：分支会话显示分支图标（深度≥2 追加 (n)）；cron 触发的会话显示时钟。
                                 两者互斥（定时会话总是全新的，不可能同时是分支），共用同一列。 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3"
                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource AthenaIconBranch}" Width="12" Height="12"
                                          Foreground="{DynamicResource App.IconForeground}"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding ShowForkIcon}"/>
                                <TextBlock Text="{Binding ForkBadgeText}" IsVisible="{Binding HasForkBadge}"
                                           FontSize="{DynamicResource App.FontSize.Micro}"
                                           Foreground="{DynamicResource App.IconMutedForeground}"
                                           VerticalAlignment="Center"/>
                                <PathIcon Data="{StaticResource AthenaIconScheduledRun}" Width="12" Height="12"
                                          Foreground="{DynamicResource App.IconForeground}"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="{loc:Loc Cron.Session.Tooltip}"
                                          IsVisible="{Binding IsScheduledRun}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="{DynamicResource App.FontSize.Body}"
                                       Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Classes="icon-plain conversation-menu" ToolTip.Tip="{loc:Loc MainWindow.Menu.Conversation}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Click="OnOverflowMenuClick">
                        <PathIcon Data="{StaticResource AthenaIconOverflowMenu}" Width="14" Height="14" Foreground="{DynamicResource App.IconMutedForeground}"/>
                        <Button.ContextFlyout>
                            <MenuFlyout>
                                <MenuItem Header="{loc:Loc MainWindow.Menu.Rename}" Command="{Binding StartRenameCommand}">
                                    <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconEdit}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{Binding PinActionText}" Command="{Binding TogglePinnedCommand}">
                                    <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconPin}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc MainWindow.Menu.Fork}" Command="{Binding RequestForkCommand}">
                                    <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconBranch}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc MainWindow.Menu.Export}" Command="{Binding RequestExportCommand}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource AthenaIconExport}" Width="16" Height="16" Foreground="{DynamicResource App.IconForeground}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc MainWindow.Menu.Delete}" Command="{Binding RequestDeleteCommand}">
                                    <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconDelete}" Foreground="{DynamicResource App.IconDangerForeground}"/></MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.ContextFlyout>
                    </Button>
                </Grid>
                <Grid IsVisible="{Binding IsRenaming}" ColumnDefinitions="*,Auto" Margin="4,2">
                    <TextBox Text="{Binding RenameText}" FontSize="{DynamicResource App.FontSize.Body}" MinHeight="28"/>
                    <Button Grid.Column="1" Classes="icon-plain" ToolTip.Tip="{loc:Loc MainWindow.Tip.ConfirmRename}" Command="{Binding CommitRenameCommand}">
                        <PathIcon Data="{StaticResource AthenaIconConfirm}" Width="13" Height="13" Foreground="{DynamicResource App.IconAccentForeground}"/>
                    </Button>
                </Grid>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.shell-panel">
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground0}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.PanelBorderBrush}"/>
            <Setter Property="BoxShadow" Value="{DynamicResource App.PanelShadow}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <!-- 面板透明度：只让面板 Background 画笔变透明以透出背景图像，内容（文字/图标/文件等）保持完全不透明。
                 画笔由 MainWindow.ApplyShellPanelMaterial 按 ShellPanelOpacity 动态构造并赋值，
                 不能对整个 Border 设 Opacity —— 那会让整个子树合成后一起变淡。
                 描边与投影同样走窗口级动态资源（App.PanelBorderBrush / App.PanelShadow），
                 由同一个 ApplyShellPanelMaterial 重建：新增面板只要消费这三个键就自动跟随材质，
                 不需要再挂类或加绑定。 -->
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.26" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- ══ 微交互动效层 ════════════════════════════════════════════════════
             时长三档：120ms 按下反馈 / 180ms 悬停与选中 / 260ms 材质切换，缓动统一
             CubicEaseOut。这三档和曲线是取值，没有测量撑着，随便调。
             下面三条边界不一样——它们来自 CLAUDE.md 里已经量过的数字，不要越过：
               1. 选择器只覆盖 MainWindow 作用域的 shell 类，MainConversationView
                  一个都不用——消息列表不虚拟化，一条 hover 过渡在那里量到 16.9ms/行
                  （无过渡 1.1ms）。任何往消息列表里加动效的改动都必须先用
                  ATHENA_SCROLL_PERF=1 重测。
               1b. BrushTransition 的起点不能是 Transparent：直通 alpha 插值会经过
                  半透明白，深色主题下闪白光（AvaloniaUI/Avalonia#15419）。这就是
                  hover 态（起点由 Semi 主题决定，控制不了）没有画笔过渡、
                  只有选中态有的原因——后者两端都由我们自己给。
               2. 全部是自身属性选择器，没有 `A:pointerover B` 跨元素后代选择器——
                  那种选择器每次悬停翻转都要重算整条后代样式链。
               3. 没有 IterationCount="Infinite"。过渡跟随属性变化，属性不动就没有帧，
                  不存在隐藏元素上仍在驱动合成器逐帧重绘的问题（Avalonia#17139）。
             ═══════════════════════════════════════════════════════════════════ -->
        <Style Selector="Button.launcher">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Body}"/>
            <Setter Property="Height" Value="40"/>
            <!-- RenderTransformOrigin 必须显式给中心：默认是左上角，scale 会把按钮往右下推而不是原地缩。 -->
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- launcher 的 Background 交给 Semi 主题：它是一块真实的按钮表面，
             覆盖成自建画笔会把它压平。这里只做位移——底色照旧瞬时切换，
             颜色snap配合尺度动画是原生 UI 的常见做法，不会显得断。 -->
        <Style Selector="Button.launcher:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.025)"/>
        </Style>
        <Style Selector="Button.launcher:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>
        <!-- 标题栏按钮：悬停轻微放大。这里敢加 transform 是因为它们是固定的 5 个按钮，
             不在任何列表里，悬停翻转次数由鼠标路过决定而不是由滚动决定。 -->
        <Style Selector="Button.titlebar-action">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.titlebar-action:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.12)"/>
        </Style>
        <Style Selector="Button.titlebar-action:pressed">
            <Setter Property="RenderTransform" Value="scale(0.9)"/>
        </Style>
        <Style Selector="Button.session-row">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="28"/>
            <!-- 左内边距要留出选中指示条的宽度（3px）再加一段呼吸间距，
                 否则条和会话图标是贴着的。这是行内容的缩进，不是条的位置——
                 条绝对定位在行左缘，给它加 Margin 只会让条自己变窄。 -->
            <Setter Property="Padding" Value="12,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!-- 同上：同色零透明度起点，只过渡画笔不过渡 transform（这是个可滚动列表）。 -->
            <Setter Property="Background" Value="{DynamicResource App.HoverOverlayFaded}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.session-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource App.HoverOverlay}"/>
        </Style>
        <!-- 选中态淡入。起点刻意不用 Transparent：BrushTransition 走直通 alpha 插值，
             从 Transparent（#00FFFFFF）过渡到深色选中色会在中途经过"半透明白"，
             深色主题下肉眼就是闪一下白光（AvaloniaUI/Avalonia#15419）。
             App.SelectedBackgroundFaded 是同色零透明度版本，由 ApplyShellPanelMaterial
             用 RebuildBrushWithOpacity 生成，插值全程同色，只有 alpha 在动。 -->
        <Style Selector="Grid.conversation-row">
            <Setter Property="Background" Value="{DynamicResource App.SelectedBackgroundFaded}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- 工作区窗格进场。刻意用一次性 Style.Animations 而不是"基础 Opacity=0 + .shown 置 1"：
             后者一旦 class 绑定失灵，右上角就是一块永远看不见的空白——正是 CLAUDE.md 规则 1
             说的那种静默失败。这里的局部值始终是"完全可见"，动画只是在 class 挂上的那一刻
             播一遍；没有 FillMode，播完属性就回落到局部值。class 没挂上 = 没有动画，而不是消失。
             它够不到 workbench 的视觉用例：那些用例自建 Window 承载 view，吃不到 MainWindow 的样式。 -->
        <Style Selector="views|WorkspaceWorkbenchView.shown">
            <Style.Animations>
                <Animation Duration="0:0:0.26" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="TranslateTransform.Y" Value="8"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.row-accent">
            <Setter Property="RenderTransformOrigin" Value="0%,50%"/>
            <Setter Property="RenderTransform" Value="scaleY(0)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <!-- 0.38s：这是一条"长出来/收回去"的动作，不是状态反馈，
                         快了就只剩一次闪烁，看不出它在生长。 -->
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.38" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.row-accent.on">
            <Setter Property="RenderTransform" Value="scaleY(1)"/>
        </Style>
        <!-- 当前打开（选中）的会话行高亮。IsSelected 由 MainWindowViewModel 随 SelectedConversation 维护。 -->
        <Style Selector="Grid.conversation-row.selected">
            <Setter Property="Background" Value="{DynamicResource App.SelectedBackground}"/>
        </Style>
        <!-- 运行中绿色指示点：仅 ShowRunningIndicator 挂载 .running 类时才运行动画，
             避免隐藏状态下关键帧动画仍驱动合成器逐帧重绘（AvaloniaUI/Avalonia#17139）。 -->
        <Style Selector="Border.running-indicator.running">
            <Style.Animations>
                <Animation Duration="0:0:0.8" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- 图标按钮的悬停/按下反馈。起点用 App.HoverOverlayFaded（同色零透明度）而不是
             Transparent：BrushTransition 走直通 alpha 插值，从 Transparent（#00FFFFFF）
             过渡到深色覆盖层会中途经过半透明白，深色主题下就是闪一下白光
             （AvaloniaUI/Avalonia#15419）。三支覆盖画笔由 ApplyShellPanelMaterial 同色生成。
             这里不加 transform：icon-plain 会出现在会话树的行里，而列表滚动时指针底下的行
             会逐个翻转 :pointerover，能少一个动画属性就少一个。 -->
        <Style Selector="Button.icon-plain">
            <Setter Property="Background" Value="{DynamicResource App.HoverOverlayFaded}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.icon-plain:pointerover">
            <Setter Property="Background" Value="{DynamicResource App.HoverOverlay}"/>
        </Style>
        <Style Selector="Button.icon-plain:pressed">
            <Setter Property="Background" Value="{DynamicResource App.PressOverlay}"/>
        </Style>
        <Style Selector="Button.nav-expand">
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="MinHeight" Value="24"/>
        </Style>
        <Style Selector="Grid.nav-group-header">
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style Selector="StackPanel.nav-group">
            <Setter Property="Spacing" Value="0"/>
        </Style>
        <Style Selector="GridSplitter.layout-splitter">
            <Setter Property="Background" Value="{DynamicResource SemiColorBorder}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="GridSplitter.layout-splitter:pointerover">
            <Setter Property="Background" Value="{DynamicResource App.IconAccentForeground}"/>
        </Style>
        <Style Selector="GridSplitter.layout-splitter:pressed">
            <Setter Property="Background" Value="{DynamicResource App.IconAccentForeground}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="30,*">
        <!-- 两层底图的 Opacity 过渡就是材质切换的视觉斜坡。260ms 是取值，不是测量结论。
             终值由 ApplyShellPanelMaterial 同步赋，这里只负责斜坡。
             注意底图的 Opacity 只有材质代码会写——主题过渡动的是 RenderTransform 与 Effect，
             不会和这条过渡打架。 -->
        <Image Grid.RowSpan="2" x:Name="BaseBackgroundImage" Source="{DynamicResource App.BackgroundImage}" Stretch="UniformToFill" Opacity="0.24" IsHitTestVisible="False">
            <Image.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.26" Easing="CubicEaseOut"/>
                </Transitions>
            </Image.Transitions>
        </Image>
        <!-- 毛玻璃底图层：同一张背景图解码到 96px 再由 UniformToFill 升采样铺满窗口。
             HighQuality 插值（mipmap + 三次卷积）把 15 倍放大变成一层高斯模糊，
             运行期成本为零——刻意不用 Effect="blur(n)"，那是每帧一次全窗口离屏渲染，
             而这张图是静态的。Source / Opacity 由 ApplyShellPanelMaterial 驱动；
             关闭时只把 Opacity 归零、刻意保留 Source（位图是进程级缓存的，置空省不下内存，
             只会把"淡出还没结束就把图抹掉"变成一个要防的竞态）。
             位置在清晰底图之上、主题过渡层之下：主题切换时过渡层照旧盖住两者。 -->
        <Image Grid.RowSpan="2" x:Name="GlassBackdropImage" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False"
               RenderOptions.BitmapInterpolationMode="HighQuality">
            <Image.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.26" Easing="CubicEaseOut"/>
                </Transitions>
            </Image.Transitions>
        </Image>
        <Image Grid.RowSpan="2" x:Name="ThemeTransitionImage" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False"/>

        <Border Grid.Row="0"
                Background="{DynamicResource App.SectionBg}"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <Grid x:Name="TitleBarDragArea"
                      Background="Transparent"
                      PointerPressed="OnTitleBarPointerPressed"
                      chrome:WindowDecorationProperties.ElementRole="TitleBar">
                    <TextBlock Text="{loc:Loc App.Title}"
                               Margin="12,0"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource App.FontSize.Body}"
                               FontWeight="SemiBold"
                               IsHitTestVisible="False"/>
                </Grid>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <Button x:Name="TitleBarThemeButton"
                            Classes="icon-plain titlebar-action"
                            Margin="0,0,10,0"
                            Command="{Binding MainConversationViewModel.ToggleThemeCommand}"
                            Tag="{Binding MainConversationViewModel.ThemeIcon}"
                            ToolTip.Tip="{loc:Loc Chat.BtnTheme}">
                        <Panel>
                            <PathIcon Width="16" Height="16"
                                      Data="{StaticResource AthenaIconThemeDark}"
                                      IsVisible="{Binding MainConversationViewModel.ThemeIcon, Converter={StaticResource ThemeTagToVisibilityConverter}, ConverterParameter=Moon}"/>
                            <PathIcon Width="16" Height="16"
                                      Data="{StaticResource AthenaIconThemeLight}"
                                      IsVisible="{Binding MainConversationViewModel.ThemeIcon, Converter={StaticResource ThemeTagToVisibilityConverter}, ConverterParameter=Sun}"/>
                        </Panel>
                    </Button>
                    <Button x:Name="TitleBarAppSettingsButton"
                            Classes="icon-plain titlebar-action"
                            Margin="0,0,10,0"
                            Command="{Binding OpenAppSettingsCommand}"
                            ToolTip.Tip="{loc:Loc Settings.Window.Title}">
                        <PathIcon Data="{StaticResource AthenaIconSettings}"
                                  Width="16" Height="16"
                                  Foreground="{DynamicResource App.IconAccentForeground}"/>
                    </Button>
                    <Button x:Name="TitleBarMinimizeButton"
                            Classes="icon-plain titlebar-action"
                            Margin="0,0,10,0"
                            Click="OnTitleBarMinimizeClick"
                            ToolTip.Tip="{loc:Loc MainWindow.Minimize}">
                        <PathIcon Width="16" Height="16"
                                  Data="{StaticResource AthenaIconWindowMinimize}"
                                  Foreground="{DynamicResource App.IconForeground}"/>
                    </Button>
                    <Button x:Name="TitleBarMaximizeButton"
                            Classes="icon-plain titlebar-action"
                            Margin="0,0,10,0"
                            Click="OnTitleBarMaximizeRestoreClick"
                            ToolTip.Tip="{loc:Loc MainWindow.MaximizeRestore}">
                        <Panel Width="14" Height="14">
                            <PathIcon x:Name="TitleBarMaximizeIcon"
                                      Width="14" Height="14"
                                      Data="{StaticResource AthenaIconWindowMaximize}"
                                      Foreground="{DynamicResource App.IconForeground}"/>
                            <PathIcon x:Name="TitleBarRestoreIcon"
                                      Width="14" Height="14"
                                      IsVisible="False"
                                      Data="{StaticResource AthenaIconWindowRestore}"
                                      Foreground="{DynamicResource App.IconForeground}"/>
                        </Panel>
                    </Button>
                    <!-- Width 19 is not a typo: CoreUI insets the X to 67% of its canvas while the
                         window glyphs fill 81-94%, so equal Width values draw a visibly smaller
                         close button. All three land on ~13px of actual ink. -->
                    <Button x:Name="TitleBarCloseButton"
                            Classes="icon-plain titlebar-action"
                            Margin="0,0,10,0"
                            Click="OnTitleBarCloseClick"
                            ToolTip.Tip="{loc:Loc MainWindow.Close}">
                        <PathIcon Width="19" Height="19"
                                  Data="{StaticResource AthenaIconClose}"
                                  Foreground="{DynamicResource App.IconForeground}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Image Grid.RowSpan="2" x:Name="ThemeSplashImage" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="True" ZIndex="100"/>

        <Grid Grid.Row="1" x:Name="MainShellGrid" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292" MinWidth="260"/>
                <ColumnDefinition Width="5" MinWidth="5"/>
                <ColumnDefinition Width="*" MinWidth="540"/>
                <ColumnDefinition Width="5" MinWidth="5"/>
                <ColumnDefinition Width="470" MinWidth="360"/>
            </Grid.ColumnDefinitions>
            <!-- 左侧：入口 + 工作区会话树。语义区域可与右侧整体对调。 -->
            <Border x:Name="LeftPanel"
                    Grid.Column="{Binding IsSidePanelsSwapped, Converter={StaticResource SidePanelColumnConverter}, ConverterParameter=LeftPanel}"
                    Classes="shell-panel" MinWidth="260">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                    <Grid Margin="10" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="7" RowSpacing="7">
                        <Button Classes="launcher" Command="{Binding OpenProviderModelsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource AthenaIconModelProvider}" Width="16" Height="16" Foreground="{DynamicResource App.IconAccentForeground}"/>
                                <TextBlock Text="{loc:Loc MainWindow.Launcher.Providers}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="launcher" Command="{Binding OpenKnowledgeBaseCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource AthenaIconKnowledgeBase}" Width="16" Height="16" Foreground="{DynamicResource App.IconAccentForeground}"/>
                                <TextBlock Text="{loc:Loc MainWindow.Launcher.KnowledgeBase}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="1" Classes="launcher" Command="{Binding OpenTasksCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource AthenaIconScheduledMessages}" Width="16" Height="16" Foreground="{DynamicResource App.IconAccentForeground}"/>
                                <TextBlock Text="{loc:Loc MainWindow.Launcher.Tasks}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1" Classes="launcher" Command="{Binding OpenSkillsConnectorsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource AthenaIconSkillsConnectors}" Width="16" Height="16" Foreground="{DynamicResource App.IconAccentForeground}"/>
                                <TextBlock Text="{loc:Loc MainWindow.Launcher.Skills}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="10,0,10,7" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox x:Name="WorkspaceSearchBox"
                                 PlaceholderText="{loc:Loc MainWindow.Search.Placeholder}"
                                 Text="{Binding ConversationSearchText}"/>
                        <Button x:Name="AddWorkspaceButton" Grid.Column="1" Classes="icon-plain" ToolTip.Tip="{loc:Loc MainWindow.Tip.AddWorkspace}" Command="{Binding AddWorkspaceCommand}">
                            <PathIcon Data="{StaticResource AthenaIconWorkspaceAdd}" Width="16" Height="16"
                                      Foreground="{DynamicResource App.IconAccentForeground}"/>
                        </Button>
                    </Grid>

                    <StackPanel x:Name="PinnedConversationsSection" Grid.Row="2" Margin="8,0,8,4"
                                IsVisible="{Binding HasPinnedConversations}" Spacing="0">
                        <TextBlock Text="{loc:Loc MainWindow.Section.Pinned}" FontSize="{DynamicResource App.FontSize.Caption}" FontWeight="SemiBold" Opacity="0.55" Margin="6,0,0,2"/>
                        <ItemsControl x:Name="PinnedConversationsList"
                                      ItemsSource="{Binding PinnedConversations}"
                                      ItemTemplate="{StaticResource ConversationSessionItemTemplate}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="3" Margin="6,0">
                        <ItemsControl ItemsSource="{Binding ConversationGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorkspaceConversationGroupViewModel">
                                    <StackPanel Classes="nav-group" IsVisible="{Binding IsSearchMatch}" Margin="0,0,0,1">
                                        <Grid Classes="nav-group-header" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                            <Button Grid.Column="0" Classes="icon-plain nav-expand"
                                                    ToolTip.Tip="{loc:Loc MainWindow.Tip.ExpandCollapse}"
                                                    Command="{Binding ToggleExpandedCommand}">
                                                <PathIcon Data="{Binding IsExpanded, Converter={StaticResource BoolToExpandIcon}}"
                                                          Width="10" Height="10"
                                                          Foreground="{DynamicResource App.IconMutedForeground}"/>
                                            </Button>
                                            <PathIcon Grid.Column="1" Width="13" Height="13" Margin="1,0,0,0"
                                                      Data="{Binding IconKey, Converter={StaticResource ToolIconKeyToGeometryConverter}}"
                                                      Foreground="{DynamicResource App.IconAccentForeground}"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource App.FontSize.Body}"
                                                       Margin="6,0,4,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       IsVisible="{Binding !IsRenaming}"/>
                                            <TextBox Grid.Column="2" Text="{Binding RenameText}" FontSize="{DynamicResource App.FontSize.Body}" VerticalAlignment="Center"
                                                     Margin="6,1,0,1" IsVisible="{Binding IsRenaming}"/>
                                            <Button Grid.Column="3" Classes="icon-plain workspace-add-conversation"
                                                    ToolTip.Tip="{loc:Loc MainWindow.Tip.NewConversation}"
                                                    Command="{Binding $parent[Window].DataContext.CreateConversationCommand}"
                                                    CommandParameter="{Binding}">
                                                <PathIcon Data="{StaticResource AthenaIconConversationAdd}" Width="14" Height="14"
                                                          Foreground="{DynamicResource App.IconAccentForeground}"/>
                                            </Button>
                                            <Button Grid.Column="4" Classes="icon-plain global-menu" ToolTip.Tip="{loc:Loc MainWindow.Tip.GlobalMenu}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Click="OnOverflowMenuClick"
                                                    IsVisible="{Binding !IsWorkspace}">
                                            <PathIcon Data="{StaticResource AthenaIconOverflowMenu}" Width="13" Height="13" Foreground="{DynamicResource App.IconMutedForeground}"/>
                                            <Button.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="{loc:Loc MainWindow.Tip.RevealInFolder}" Command="{Binding RequestRevealCommand}">
                                                        <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconFolderReveal}" Width="16" Height="16" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{loc:Loc MainWindow.Tip.CopyPath}" Command="{Binding RequestCopyPathCommand}">
                                                        <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconCopy}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
                                                    </MenuItem>
                                                </MenuFlyout>
                                            </Button.ContextFlyout>
                                            </Button>
                                            <Button Grid.Column="4" Classes="icon-plain workspace-menu" ToolTip.Tip="{loc:Loc MainWindow.Tip.WorkspaceMenu}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Click="OnOverflowMenuClick"
                                                    IsVisible="{Binding IsWorkspace}">
                                                <PathIcon Data="{StaticResource AthenaIconOverflowMenu}" Width="13" Height="13" Foreground="{DynamicResource App.IconMutedForeground}"/>
                                                <Button.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuItem Header="{loc:Loc MainWindow.Menu.Rename}" Command="{Binding StartRenameCommand}">
                                                            <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconEdit}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{loc:Loc WorkspaceContext.Menu}" Command="{Binding RequestContextSettingsCommand}">
                                                            <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconSettings}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{loc:Loc MainWindow.Tip.RevealInFolder}" Command="{Binding RequestRevealCommand}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource AthenaIconFolderReveal}" Width="16" Height="16" Foreground="{DynamicResource App.IconForeground}"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{loc:Loc MainWindow.Tip.CopyPath}" Command="{Binding RequestCopyPathCommand}">
                                                            <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconCopy}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{loc:Loc MainWindow.Menu.Delete}" Command="{Binding RequestDeleteCommand}">
                                                            <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconDelete}" Foreground="{DynamicResource App.IconDangerForeground}"/></MenuItem.Icon>
                                                        </MenuItem>
                                                    </MenuFlyout>
                                                </Button.ContextFlyout>
                                            </Button>
                                            <Button Grid.Column="4" Classes="icon-plain" ToolTip.Tip="{loc:Loc MainWindow.Tip.ConfirmRename}"
                                                    IsVisible="{Binding IsRenaming}" Command="{Binding CommitRenameCommand}">
                                                <PathIcon Data="{StaticResource AthenaIconConfirm}" Width="13" Height="13" Foreground="{DynamicResource App.IconAccentForeground}"/>
                                            </Button>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Conversations}"
                                                      ItemTemplate="{StaticResource ConversationSessionItemTemplate}"
                                                      IsVisible="{Binding IsExpanded}"
                                                      Margin="14,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid Grid.Row="4" Margin="10,7" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <Button x:Name="GlobalConversationButton" HorizontalAlignment="Stretch"
                                Command="{Binding CreateConversationCommand}" CommandParameter="{Binding GlobalConversationGroup}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Data="{StaticResource AthenaIconConversationAdd}" Width="16" Height="16"
                                          Foreground="{DynamicResource App.IconAccentForeground}"/>
                                <TextBlock Text="{loc:Loc MainWindow.Launcher.GlobalChat}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="icon-plain" ToolTip.Tip="{loc:Loc MainWindow.Tip.SwapLayout}" Command="{Binding ToggleSidePanelsCommand}">
                            <PathIcon Data="{StaticResource AthenaIconLayoutSwap}" Width="16" Height="16" Foreground="{DynamicResource App.IconAccentForeground}"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter x:Name="LeftSideSplitter"
                          Classes="layout-splitter"
                          Grid.Column="{Binding IsSidePanelsSwapped, Converter={StaticResource SidePanelColumnConverter}, ConverterParameter=LeftSplitter}"
                          Width="5"
                          MinWidth="5"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          DragCompleted="OnSideSplitterDragCompleted"/>

            <!-- 中间始终是当前主对话，会话切换不销毁其他 Chat VM。间隙由相邻 ColumnDefinition 控制，
                 不要在这里再加 Margin，否则会和 5px 列间隙叠加成 10px。 -->
            <Border Grid.Column="2" MinWidth="540" Classes="shell-panel">
                <!-- 绑 DisplayedConversation 而不是 MainConversationViewModel：这是整棵气泡树的
                     DataContext，也是会话切换里唯一贵的那个绑定，它要比选中态晚一拍落地，
                     好让幕布先画出来一帧。理由见 MainWindowViewModel.BeginConversationSurfaceSwap。
                     幕布本身在 MainConversationView 里（消息列表那一格），这样骨架屏能直接
                     套用真实气泡的几何，不必在这里复刻一份行高与边距。 -->
                <views:MainConversationView x:Name="MainConversationView"
                                            Workbench="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Workbench}"
                                            IsSwitching="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsConversationSwitching}"
                                            DataContext="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DisplayedConversation}"/>
            </Border>

            <GridSplitter x:Name="RightSideSplitter"
                          Classes="layout-splitter"
                          Grid.Column="{Binding IsSidePanelsSwapped, Converter={StaticResource SidePanelColumnConverter}, ConverterParameter=RightSplitter}"
                          Width="5"
                          MinWidth="5"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          DragCompleted="OnSideSplitterDragCompleted"/>

            <!-- 右侧整体：上部编辑器/文件浏览器，下部日志。不再包外层 shell-panel 边框，
                 工作区与日志区各自成独立圆角面板悬浮（各自自带背景，透明度跟随 App.PanelBackgroundBrush）。
                 面板直接占满右列，距窗口边缘仅剩外壳 5px，与左/中面板一致。 -->
            <Grid x:Name="RightPanelGrid"
                  Grid.Column="{Binding IsSidePanelsSwapped, Converter={StaticResource SidePanelColumnConverter}, ConverterParameter=RightPanel}"
                  MinWidth="360">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="280"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="190" MinHeight="120"/>
                    </Grid.RowDefinitions>
                    <!-- IsVisible 照旧独占布局；Classes.shown 只驱动那一次进场动画。
                         打开一个文件时右上窗格从"凭空出现"变成"淡着抬起来"。 -->
                    <views:WorkspaceWorkbenchView x:Name="WorkspaceWorkbench"
                                                  DataContext="{Binding Workbench}"
                                                  IsVisible="{Binding ShowWorkbenchPane}"
                                                  Classes.shown="{Binding ShowWorkbenchPane}"/>
                    <GridSplitter Grid.Row="1"
                                  Classes="layout-splitter"
                                  Height="5"
                                  IsVisible="{Binding Workbench.ShowRowSplitter}"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"
                                  ShowsPreview="False"
                                  DragCompleted="OnRightRowSplitterDragCompleted"/>
                    <Border Grid.Row="{Binding Workbench.LogGridRow}"
                            Grid.RowSpan="{Binding Workbench.LogGridRowSpan}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource App.PanelBorderBrush}"
                            BoxShadow="{DynamicResource App.PanelShadow}"
                            CornerRadius="8"
                            Background="{DynamicResource App.PanelBackgroundBrush}">
                        <TabControl x:Name="UtilityTabControl"
                                    SelectedIndex="{Binding SelectedUtilityTabIndex}">
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <PathIcon Data="{StaticResource AthenaIconLogs}"
                                                  Width="15"
                                                  Height="15"
                                                  Foreground="{DynamicResource App.IconMutedForeground}"/>
                                        <TextBlock Text="{loc:Loc Logs.Header}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding GlobalErrorCount}"
                                                   Foreground="{DynamicResource SemiRed5}"/>
                                    </StackPanel>
                                </TabItem.Header>
                                <Grid RowDefinitions="Auto,*" Classes="utility-tab-page">
                                    <Button HorizontalAlignment="Right"
                                            Margin="5,3,5,0"
                                            Padding="7,3"
                                            Command="{Binding OpenDetailedLogsCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <PathIcon Data="{StaticResource AthenaIconDetails}"
                                                      Width="14"
                                                      Height="14"
                                                      Foreground="{DynamicResource App.IconAccentForeground}"/>
                                            <TextBlock Text="{loc:Loc MainWindow.Launcher.Detailed}"/>
                                        </StackPanel>
                                    </Button>
                                    <ListBox x:Name="CompactLogsList"
                                             Grid.Row="1"
                                             ItemsSource="{Binding CompactLogEntries}"
                                             Margin="5"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LogEntryViewModel">
                                                <Grid ColumnDefinitions="64,48,*" Margin="2">
                                                    <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" FontSize="{DynamicResource App.FontSize.Caption}" Opacity="0.55"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="{DynamicResource App.FontSize.Caption}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="{DynamicResource App.FontSize.Caption}" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </TabItem>
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <PathIcon Data="{StaticResource AthenaIconTerminal}"
                                                  Width="15"
                                                  Height="15"
                                                  Foreground="{DynamicResource App.IconMutedForeground}"/>
                                        <TextBlock Text="{loc:Loc Terminal.Header}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </TabItem.Header>
                                <!-- 终端刻意不挂 utility-tab-page：它是一张活的等宽字符网格，
                                     任何动画都会让字形重新栅格化，读起来就是"抽一下"。
                                     而且终端的价值在于立刻看到内容，淡入对它是纯负收益。 -->
                                <views:TerminalPanelView DataContext="{Binding TerminalPanelViewModel}"/>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>

        <!-- 窗口级宠物覆盖层：根据漫游区域锚定到不同面板的底部。 -->
        <views:VirtualPetView x:Name="VirtualPet"
                              Grid.ColumnSpan="5"
                              ZIndex="60"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              DataContext="{Binding MainConversationViewModel.Pet}"/>

        </Grid>
    </Grid>
</Window>
