<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Athena.UI.ViewModels"
        xmlns:views="using:Athena.UI.Views"
        xmlns:loc="using:Athena.UI.Markup"
        x:Class="Athena.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:Loc App.Title}"
        Width="1440" Height="900"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Athena.ico"
        FontFamily="{DynamicResource MainFontFamily}">
    <Design.DataContext><vm:MainWindowViewModel/></Design.DataContext>

    <Window.Resources>
        <DataTemplate x:Key="ConversationSessionItemTemplate" x:DataType="vm:ConversationSessionItemViewModel">
            <Border Classes="conversation-card"
                    IsVisible="{Binding IsSearchMatch}"
                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,2">
                <Grid>
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsRenaming}">
                        <Button Classes="session-row"
                                Command="{Binding $parent[Window].DataContext.SelectConversationCommand}"
                                CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="16,16,*,48" ColumnSpacing="5">
                                <Grid Width="16" ToolTip.Tip="{Binding StatusText}">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SemiGreen6}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowRunningIndicator}"/>
                                    <TextBlock Text="…" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding ShowQueuedIndicator}"/>
                                    <TextBlock Text="◆" FontSize="9" Foreground="{DynamicResource SemiOrange5}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowWaitingIndicator}"/>
                                    <TextBlock Text="!" FontWeight="Bold" Foreground="{DynamicResource SemiRed6}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowInterruptedIndicator}"/>
                                    <TextBlock Text="✓" Foreground="{DynamicResource SemiGreen6}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowCompletionIndicator}"/>
                                </Grid>
                                <PathIcon Grid.Column="1" Data="{StaticResource AthenaIconBranch}" Width="12" Height="12"
                                          Foreground="{DynamicResource App.IconMutedForeground}" Opacity="0.7"
                                          IsVisible="{Binding IsForked}" ToolTip.Tip="分支会话"/>
                                <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="9" Opacity="0.58"
                                           TextAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>
                        <Button Grid.Column="1" Classes="icon-plain conversation-menu" ToolTip.Tip="会话菜单"
                                Click="OnOverflowMenuClick">
                            <Path Data="{StaticResource AthenaIconOverflowMenu}" Width="14" Height="14" Stretch="Uniform"
                                  Stroke="{DynamicResource App.IconMutedForeground}" StrokeThickness="1.8"
                                  StrokeLineCap="Round" StrokeJoin="Round"/>
                            <Button.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem Header="重命名" Command="{Binding StartRenameCommand}">
                                        <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconEdit}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{Binding PinActionText}" Command="{Binding TogglePinnedCommand}">
                                        <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconPin}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="分支" Command="{Binding RequestForkCommand}">
                                        <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconBranch}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="导出" Command="{Binding RequestExportCommand}">
                                        <MenuItem.Icon>
                                            <Path Data="{StaticResource AthenaIconExport}" Width="16" Height="16" Stretch="Uniform"
                                                  Stroke="{DynamicResource App.IconForeground}" StrokeThickness="1.8"
                                                  StrokeLineCap="Round" StrokeJoin="Round"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="删除" Command="{Binding RequestDeleteCommand}">
                                        <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconDelete}" Foreground="{DynamicResource App.IconDangerForeground}"/></MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.ContextFlyout>
                        </Button>
                    </Grid>
                    <Grid IsVisible="{Binding IsRenaming}" ColumnDefinitions="*,Auto" Margin="4,2">
                        <TextBox Text="{Binding RenameText}" FontSize="11" MinHeight="28"/>
                        <Button Grid.Column="1" Classes="icon-plain" ToolTip.Tip="确认重命名" Command="{Binding CommitRenameCommand}">
                            <PathIcon Data="{StaticResource AthenaIconConfirm}" Width="13" Height="13" Foreground="{DynamicResource App.IconAccentForeground}"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.shell-panel">
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground0}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGreyLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Button.launcher">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="40"/>
        </Style>
        <Style Selector="Button.session-row">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.icon-plain">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Image x:Name="BaseBackgroundImage" Source="{DynamicResource App.BackgroundImage}" Stretch="UniformToFill" Opacity="0.24" IsHitTestVisible="False"/>
        <Image x:Name="ThemeTransitionImage" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False"/>
        <Border Background="{DynamicResource App.BackgroundOverlay}" Opacity="0.72" IsHitTestVisible="False"/>
        <Image x:Name="ThemeSplashImage" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="True" ZIndex="100"/>

        <Grid x:Name="MainShellGrid" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292" MinWidth="260"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="540"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="470" MinWidth="360"/>
            </Grid.ColumnDefinitions>
            <!-- 左侧：入口 + 工作区会话树。语义区域可与右侧整体对调。 -->
            <Border Grid.Column="{Binding IsSidePanelsSwapped, Converter={StaticResource SidePanelColumnConverter}, ConverterParameter=LeftPanel}"
                    Classes="shell-panel" MinWidth="260">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                    <Grid Margin="10" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="7" RowSpacing="7">
                        <Button Classes="launcher" Command="{Binding OpenProviderModelsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource AthenaIconModelProvider}" Width="16" Height="16" Foreground="{DynamicResource App.IconAccentForeground}"/>
                                <TextBlock Text="供应商模型"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="launcher" Command="{Binding OpenKnowledgeBaseCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource AthenaIconKnowledgeBase}" Width="16" Height="16" Foreground="{DynamicResource App.IconAccentForeground}"/>
                                <TextBlock Text="知识库"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="1" Classes="launcher" Command="{Binding OpenScheduledMessagesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource AthenaIconScheduledMessages}" Width="16" Height="16" Foreground="{DynamicResource App.IconAccentForeground}"/>
                                <TextBlock Text="定时消息"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1" Classes="launcher" Command="{Binding OpenSkillsConnectorsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource AthenaIconSkillsConnectors}" Width="16" Height="16" Foreground="{DynamicResource App.IconAccentForeground}"/>
                                <TextBlock Text="技能与连接器"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="10,0,10,7" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox x:Name="WorkspaceSearchBox"
                                 PlaceholderText="搜索工作区、标题或摘要"
                                 Text="{Binding ConversationSearchText}"/>
                        <Button x:Name="AddWorkspaceButton" Grid.Column="1" Classes="icon-plain" ToolTip.Tip="添加工作区" Command="{Binding AddWorkspaceCommand}">
                            <Path Data="{StaticResource AthenaIconWorkspaceAdd}" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{DynamicResource App.IconAccentForeground}" StrokeThickness="2"
                                  StrokeLineCap="Round" StrokeJoin="Round"/>
                        </Button>
                    </Grid>

                    <Border Grid.Row="2" Margin="7,0,7,5" Padding="5"
                            BorderBrush="{DynamicResource SemiGreyLowBrush}" BorderThickness="1" CornerRadius="7"
                            IsVisible="{Binding HasPinnedConversations}" MaxHeight="180">
                        <Grid RowDefinitions="Auto,*">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="5,2,5,3">
                                <PathIcon Data="{StaticResource AthenaIconPin}" Width="13" Height="13" Foreground="{DynamicResource App.IconMutedForeground}"/>
                                <TextBlock Text="置顶对话" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl x:Name="PinnedConversationsList"
                                              ItemsSource="{Binding PinnedConversations}"
                                              ItemTemplate="{StaticResource ConversationSessionItemTemplate}"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="3" Margin="5,0">
                        <ItemsControl ItemsSource="{Binding ConversationGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorkspaceConversationGroupViewModel">
                                    <Border Classes="workspace-card" IsVisible="{Binding IsSearchMatch}" Margin="1,3"
                                            BorderBrush="{DynamicResource SemiGreyLowBrush}" BorderThickness="1" CornerRadius="7">
                                        <Expander IsExpanded="{Binding IsExpanded}">
                                            <Expander.Header>
                                                <Grid ColumnDefinitions="*,Auto,Auto" Height="34">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               IsVisible="{Binding !IsRenaming}"/>
                                                    <TextBox Text="{Binding RenameText}" FontSize="11" VerticalAlignment="Center"
                                                             IsVisible="{Binding IsRenaming}"/>
                                                    <Button Grid.Column="1" Classes="icon-plain workspace-add-conversation"
                                                            ToolTip.Tip="在此工作区新建对话"
                                                            Command="{Binding $parent[Window].DataContext.CreateConversationCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Path Data="{StaticResource AthenaIconConversationAdd}" Width="16" Height="16" Stretch="Uniform"
                                                              Stroke="{DynamicResource App.IconAccentForeground}" StrokeThickness="1.8"
                                                              StrokeLineCap="Round" StrokeJoin="Round"/>
                                                    </Button>
                                                    <Button Grid.Column="2" Classes="icon-plain workspace-menu" ToolTip.Tip="工作区菜单"
                                                            Click="OnOverflowMenuClick"
                                                            IsVisible="{Binding IsWorkspace}">
                                                        <Path Data="{StaticResource AthenaIconOverflowMenu}" Width="14" Height="14" Stretch="Uniform"
                                                              Stroke="{DynamicResource App.IconMutedForeground}" StrokeThickness="1.8"
                                                              StrokeLineCap="Round" StrokeJoin="Round"/>
                                                        <Button.ContextFlyout>
                                                            <MenuFlyout>
                                                                <MenuItem Header="重命名" Command="{Binding StartRenameCommand}">
                                                                    <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconEdit}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="在文件夹中显示" Command="{Binding RequestRevealCommand}">
                                                                    <MenuItem.Icon>
                                                                        <Path Data="{StaticResource AthenaIconFolderReveal}" Width="16" Height="16" Stretch="Uniform"
                                                                              Stroke="{DynamicResource App.IconForeground}" StrokeThickness="1.8"
                                                                              StrokeLineCap="Round" StrokeJoin="Round"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="复制路径" Command="{Binding RequestCopyPathCommand}">
                                                                    <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconCopy}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="删除" Command="{Binding RequestDeleteCommand}">
                                                                    <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconDelete}" Foreground="{DynamicResource App.IconDangerForeground}"/></MenuItem.Icon>
                                                                </MenuItem>
                                                            </MenuFlyout>
                                                        </Button.ContextFlyout>
                                                    </Button>
                                                    <Button Grid.Column="2" Classes="icon-plain" ToolTip.Tip="确认重命名"
                                                            IsVisible="{Binding IsRenaming}" Command="{Binding CommitRenameCommand}">
                                                        <PathIcon Data="{StaticResource AthenaIconConfirm}" Width="13" Height="13" Foreground="{DynamicResource App.IconAccentForeground}"/>
                                                    </Button>
                                                </Grid>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Conversations}"
                                                          ItemTemplate="{StaticResource ConversationSessionItemTemplate}"
                                                          Margin="7,0,5,5"/>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid Grid.Row="4" Margin="10,7" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                        <Button x:Name="AppSettingsButton" Classes="icon-plain" ToolTip.Tip="应用设置" Command="{Binding OpenAppSettingsCommand}">
                            <PathIcon Data="{StaticResource AthenaIconSettings}" Width="17" Height="17" Foreground="{DynamicResource App.IconAccentForeground}"/>
                        </Button>
                        <Button x:Name="GlobalConversationButton" Grid.Column="1" HorizontalAlignment="Stretch"
                                Command="{Binding CreateConversationCommand}" CommandParameter="{Binding GlobalConversationGroup}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Data="{StaticResource AthenaIconConversationAdd}" Width="16" Height="16" Stretch="Uniform"
                                      Stroke="{DynamicResource App.IconAccentForeground}" StrokeThickness="1.8"
                                      StrokeLineCap="Round" StrokeJoin="Round"/>
                                <TextBlock Text="全局对话"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="icon-plain" ToolTip.Tip="左右布局对调" Command="{Binding ToggleSidePanelsCommand}">
                            <PathIcon Data="{StaticResource AthenaIconPanelSwap}" Width="16" Height="16" Foreground="{DynamicResource App.IconAccentForeground}"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="{Binding IsSidePanelsSwapped, Converter={StaticResource SidePanelColumnConverter}, ConverterParameter=LeftSplitter}"
                          Width="5" MinWidth="5" Background="Transparent" DragCompleted="OnSideSplitterDragCompleted"/>

            <!-- 中间始终是当前主对话，会话切换不销毁其他 Chat VM。 -->
            <Border Grid.Column="2" MinWidth="540" Margin="5,0" Classes="shell-panel">
                <views:ChatTabView x:Name="ChatTabView" DataContext="{Binding ChatTabViewModel}"/>
            </Border>

            <GridSplitter Grid.Column="{Binding IsSidePanelsSwapped, Converter={StaticResource SidePanelColumnConverter}, ConverterParameter=RightSplitter}"
                          Width="5" MinWidth="5" Background="Transparent" DragCompleted="OnSideSplitterDragCompleted"/>

            <!-- 右侧整体：上部编辑器/文件浏览器，下部日志。 -->
            <Border Grid.Column="{Binding IsSidePanelsSwapped, Converter={StaticResource SidePanelColumnConverter}, ConverterParameter=RightPanel}"
                    Classes="shell-panel" MinWidth="360">
                <Grid x:Name="RightPanelGrid" Margin="7">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="280"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="190" MinHeight="120"/>
                    </Grid.RowDefinitions>
                    <views:WorkspaceWorkbenchView DataContext="{Binding Workbench}"/>
                    <GridSplitter Grid.Row="1" Height="5" Background="{DynamicResource SemiColorBorder}"
                                  DragCompleted="OnRightRowSplitterDragCompleted"/>
                    <Border Grid.Row="2" BorderThickness="1" BorderBrush="{DynamicResource SemiGreyLowBrush}" CornerRadius="8">
                        <Grid RowDefinitions="Auto,*">
                            <Grid Margin="8,5" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <PathIcon Data="{StaticResource AthenaIconActivity}" Width="15" Height="15" Foreground="{DynamicResource App.IconMutedForeground}"/>
                                    <TextBlock Text="日志" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding GlobalErrorCount}" Foreground="{DynamicResource SemiRed5}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" SelectedItem="{Binding SelectedLogScope}" HorizontalAlignment="Left" Width="132">
                                    <x:String>全部</x:String>
                                    <x:String>当前工作区</x:String>
                                    <x:String>当前对话</x:String>
                                </ComboBox>
                                <Button Grid.Column="2" Command="{Binding OpenDetailedLogsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <PathIcon Data="{StaticResource AthenaIconDetails}" Width="14" Height="14" Foreground="{DynamicResource App.IconAccentForeground}"/>
                                        <TextBlock Text="详细"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding CompactLogEntries}" Margin="5">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LogEntryViewModel">
                                        <Grid ColumnDefinitions="64,48,*" Margin="2">
                                            <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" FontSize="10" Opacity="0.55"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="10"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
