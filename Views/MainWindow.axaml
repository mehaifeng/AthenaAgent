<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Athena.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:Athena.UI.Models"
        xmlns:views="using:Athena.UI.Views"
        xmlns:loc="using:Athena.UI.Markup"
        mc:Ignorable="d" 
        d:DesignWidth="700" 
        d:DesignHeight="900"
        x:Class="Athena.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:Loc App.Title}"
        Width="700" 
        Height="900"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Athena.ico"
        FontFamily="{DynamicResource MainFontFamily}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>


    <Grid RowDefinitions="*,Auto">
        <!-- 背景图片 -->
        <Image x:Name="BaseBackgroundImage"
               Source="{DynamicResource App.BackgroundImage}"
               Grid.Row="0"
               Grid.RowSpan="2"
               Stretch="UniformToFill"
               IsHitTestVisible="False" />
        <!-- 主题切换过渡层：持有旧主题背景做"失焦淡出"，平时隐藏；
             位于底图之上、蒙版之下，效果只发生在真正的底层背景上 -->
        <Image x:Name="ThemeTransitionImage"
               Grid.Row="0"
               Grid.RowSpan="2"
               Stretch="UniformToFill"
               Opacity="0"
               IsHitTestVisible="False" />
        <!-- 背景蒙版 -->
        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Background="{DynamicResource App.BackgroundOverlay}"
                IsHitTestVisible="False" />

        <!-- 主题过渡动画图片覆盖层 -->
        <Image x:Name="ThemeSplashImage"
               Grid.Row="0"
               Stretch="UniformToFill"
               Opacity="0"
               IsHitTestVisible="True"
               ZIndex="100"/>

        <!-- 主页面始终留在视觉树中，仅切换 IsVisible。这样 Chat 消息控件不会在每次切页时重建。 -->
        <Grid Grid.Row="0" Margin="5" RowDefinitions="Auto,*">
            <TabStrip Grid.Row="0"
                      Name="MainTabControl"
                      SelectedIndex="{Binding SelectedTabIndex, UpdateSourceTrigger=PropertyChanged}"
                      FontSize="15"
                      FontWeight="Medium">
                <TabStripItem Content="{loc:Loc Tab.ChatLink}"/>
                <TabStripItem Content="{loc:Loc Tab.SysConfig}"/>
                <TabStripItem Content="{loc:Loc Tab.Extensions}"/>
                <TabStripItem Content="{loc:Loc Tab.McpServer}"/>
                <TabStripItem Content="{loc:Loc Tab.Scheduler}"/>
                <TabStripItem Content="{loc:Loc Tab.Archives}"/>
                <TabStripItem Content="{loc:Loc Tab.Files}"/>
                <TabStripItem Content="{loc:Loc Tab.SysLogs}"/>
                <TabStripItem Content="{loc:Loc Tab.Diagnostic}"/>
            </TabStrip>

            <Grid Grid.Row="1">
                <Border IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}">
                    <views:ChatTabView x:Name="ChatTabView" DataContext="{Binding ChatTabViewModel}"/>
                </Border>
                <Border IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}">
                    <views:ConfigTabView DataContext="{Binding ConfigTabViewModel}"/>
                </Border>
                <Border IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}">
                    <views:ExtensionsTabView DataContext="{Binding ExtensionsTabViewModel}"/>
                </Border>
                <Border IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}">
                    <views:McpTabView DataContext="{Binding McpTabViewModel}"/>
                </Border>
                <Border IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=4}">
                    <views:TasksTabView DataContext="{Binding TasksTabViewModel}"/>
                </Border>
                <Border IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=5}">
                    <views:HistoryTabView DataContext="{Binding HistoryTabViewModel}"/>
                </Border>
                <Border IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=6}">
                    <views:KnowledgeBaseTabView DataContext="{Binding KnowledgeBaseTabViewModel}"/>
                </Border>
                <Border IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=7}">
                    <views:LogsTabView DataContext="{Binding LogsTabViewModel}"/>
                </Border>
                <Border IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=8}">
                    <views:AboutTabView DataContext="{Binding AboutTabViewModel}"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
