<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Athena.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:Athena.UI.Models"
        xmlns:views="using:Athena.UI.Views"
        xmlns:loc="using:Athena.UI.Markup"
        mc:Ignorable="d" 
        d:DesignWidth="700" 
        d:DesignHeight="900"
        x:Class="Athena.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:Loc App.Title}"
        Width="700" 
        Height="900"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/avalonia-logo.ico"
        FontFamily="{DynamicResource MonospaceFontFamily}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="*,Auto">
        <!-- TabControl (功能模块) -->
        <TabControl Grid.Row="0"
                    SelectedIndex="{Binding SelectedTabIndex, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0"
                    Name="MainTabControl">

            <!-- 聊天 -->
            <TabItem Header="{loc:Loc Tab.ChatLink}">
                <views:ChatTabView DataContext="{Binding ChatTabViewModel}"/>
            </TabItem>

            <!-- 配置 -->
            <TabItem Header="{loc:Loc Tab.SysConfig}">
                <views:ConfigTabView DataContext="{Binding ConfigTabViewModel}"/>
            </TabItem>

            <!-- 任务 -->
            <TabItem Header="{loc:Loc Tab.Scheduler}">
                <views:TasksTabView DataContext="{Binding TasksTabViewModel}"/>
            </TabItem>

            <!-- 历史 -->
            <TabItem Header="{loc:Loc Tab.Archives}">
                <views:HistoryTabView DataContext="{Binding HistoryTabViewModel}"/>
            </TabItem>

            <!-- 知识库 -->
            <TabItem Header="{loc:Loc Tab.Files}">
                <views:KnowledgeBaseTabView DataContext="{Binding KnowledgeBaseTabViewModel}"/>
            </TabItem>

            <!-- 日志 -->
            <TabItem Header="{loc:Loc Tab.SysLogs}">
                <views:LogsTabView DataContext="{Binding LogsTabViewModel}"/>
            </TabItem>

            <!-- 关于 -->
            <TabItem Header="{loc:Loc Tab.Diagnostic}">
                <views:AboutTabView DataContext="{Binding AboutTabViewModel}"/>
            </TabItem>
        </TabControl>

        <!-- 配置保存/重置底部栏 (仅在配置激活时显示) -->
        <Border Grid.Row="1"
                Padding="12,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                IsVisible="{Binding IsShowConfigSaveReset}">

            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="12">
                <Button Command="{Binding SaveConfigCommand}"
                        Classes="accent"
                        Padding="16,4"
                        ToolTip.Tip="{loc:Loc Btn.CommitChanges}">
                    <PathIcon Data="{StaticResource SemiIconSave}" Width="16" Height="16"/>
                </Button>
                <Button Command="{Binding ResetConfigCommand}"
                        Padding="16,4"
                        ToolTip.Tip="{loc:Loc Btn.Rollback}">
                    <PathIcon Data="{StaticResource SemiIconUndo}" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
