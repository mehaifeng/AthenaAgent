<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Athena.UI.ViewModels"
        xmlns:loc="using:Athena.UI.Markup"
        xmlns:conv="using:Athena.UI.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="560"
        x:Class="Athena.UI.Views.OnboardingWindow"
        x:DataType="vm:OnboardingViewModel"
        Title="{loc:Loc Onboarding.Title}"
        Width="720" Height="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SemiColorBackground0}"
        CanResize="False">

    <Window.Styles>
        <!-- 黑白灰蚀刻风按钮。对比度规则（明暗主题通用）：
             背景取 SemiColorText*（随主题反转的"前景族"）时，文字必取 SemiColorBackground0（"背景族"），反之亦然——
             两族天然反色，任意主题下都不会撞色。
             关键实现点：Semi 主题会在 hover/pressed 改写模板内 ContentPresenter 的背景，且模板文字
             走继承色，因此每个交互态都必须"背景(/template/ ContentPresenter) + 文字(后代 TextBlock)"
             成对显式覆盖，缺一态就会在该态出现黑底黑字/白底白字。 -->

        <!-- oracle：主行动按钮，静态=前景色反转实底 -->
        <Style Selector="Button.oracle">
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="18,6"/>
        </Style>
        <Style Selector="Button.oracle /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorText0}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.oracle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorText2}"/>
        </Style>
        <Style Selector="Button.oracle:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorText1}"/>
        </Style>
        <Style Selector="Button.oracle TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorBackground0}"/>
        </Style>
        <Style Selector="Button.oracle:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorBackground0}"/>
        </Style>
        <Style Selector="Button.oracle:pressed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorBackground0}"/>
        </Style>

        <!-- plain：次级按钮，透明底细边框，文字全程用正常前景色 -->
        <Style Selector="Button.plain">
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="18,6"/>
        </Style>
        <Style Selector="Button.plain /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.plain:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiGrey0}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorText2}"/>
        </Style>
        <Style Selector="Button.plain:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiGrey1}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorText2}"/>
        </Style>
        <Style Selector="Button.plain TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}"/>
        </Style>
        <Style Selector="Button.plain:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}"/>
        </Style>
        <Style Selector="Button.plain:pressed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}"/>
        </Style>

        <!-- lang：语言分段切换。未选中=透明底+正常文字；选中=前景色反转实底 -->
        <Style Selector="ToggleButton.lang">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Body}"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style Selector="ToggleButton.lang /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ToggleButton.lang:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiGrey0}"/>
        </Style>
        <Style Selector="ToggleButton.lang:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiGrey1}"/>
        </Style>
        <Style Selector="ToggleButton.lang TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText1}"/>
        </Style>
        <Style Selector="ToggleButton.lang:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}"/>
        </Style>
        <Style Selector="ToggleButton.lang:pressed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}"/>
        </Style>
        <Style Selector="ToggleButton.lang:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorText0}"/>
        </Style>
        <Style Selector="ToggleButton.lang:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorText2}"/>
        </Style>
        <Style Selector="ToggleButton.lang:checked:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorText1}"/>
        </Style>
        <Style Selector="ToggleButton.lang:checked TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorBackground0}"/>
        </Style>
        <Style Selector="ToggleButton.lang:checked:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorBackground0}"/>
        </Style>
        <Style Selector="ToggleButton.lang:checked:pressed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorBackground0}"/>
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Consolas, Menlo, monospace"/>
            <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Body}"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
    </Window.Styles>

    <Panel>
    <Grid RowDefinitions="Auto,*,Auto" Margin="30,24">

        <!-- 头部：猫头鹰 logo + 标题 + 语言切换 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                <Border Width="50" Height="50" CornerRadius="26"
                        BorderBrush="{DynamicResource SemiColorText0}" BorderThickness="1"
                        ClipToBounds="True">
                    <Image Source="avares://Athena.UI/Assets/AthenaAgent.png" Width="54" Height="54" Stretch="Fill"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="ΑΘΗΝΑ · Athena" FontSize="{DynamicResource App.FontSize.Brand}" FontWeight="SemiBold" LetterSpacing="1"/>
                    <TextBlock Classes="mono" Text="{loc:Loc Onboarding.Motto}"/>
                </StackPanel>
            </StackPanel>

            <!-- 呈现层设置：主题切换 + 语言切换 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Spacing="10">
                <!-- 主题切换：Moon=当前 Dark，Sun=当前 Light。参考 ChatTabView 的两 PathIcon 互斥可见方案。 -->
                <Button Command="{Binding ToggleThemeCommand}"
                        Tag="{Binding ThemeIcon}"
                        ToolTip.Tip="{loc:Loc Chat.BtnTheme}"
                        Padding="8,4">
                    <Panel>
                        <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconMoon}"
                                  IsVisible="{Binding ThemeIcon, Converter={StaticResource ThemeTagToVisibilityConverter}, ConverterParameter=Moon}"/>
                        <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconSun}"
                                  IsVisible="{Binding ThemeIcon, Converter={StaticResource ThemeTagToVisibilityConverter}, ConverterParameter=Sun}"/>
                    </Panel>
                </Button>

                <StackPanel Orientation="Horizontal" Spacing="0">
                    <Border BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1,1,0,1" CornerRadius="2,0,0,2">
                        <ToggleButton Width="60" Classes="lang" IsChecked="{Binding IsChineseSelected}"><TextBlock Text="中文"/></ToggleButton>
                    </Border>
                    <Border BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1" CornerRadius="0,2,2,0">
                        <ToggleButton Width="60" Classes="lang" IsChecked="{Binding !IsChineseSelected}"><TextBlock Text="EN"/></ToggleButton>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
        
        <!-- Step 1：主凭据 -->
        <StackPanel Grid.Row="1" Spacing="12" IsVisible="{Binding IsStep1}" Margin="0,20,0,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Onboarding.Provider}" VerticalAlignment="Center" Opacity="0.8"/>
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Providers}"
                          SelectedItem="{Binding PrimaryProvider.ProviderPreset}" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                          SelectionChanged="OnProviderSelectionChanged"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Base URL" VerticalAlignment="Center" Opacity="0.8"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PrimaryProvider.BaseUrl}"
                         FontFamily="Consolas, Menlo, monospace" FontSize="{DynamicResource App.FontSize.Body}" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="API Key" VerticalAlignment="Center" Opacity="0.8"/>
                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                    <TextBox Text="{Binding PrimaryProvider.ApiKey}" PasswordChar="*"
                             FontFamily="Consolas, Menlo, monospace" FontSize="{DynamicResource App.FontSize.Body}"/>
                    <Button Grid.Column="1" Command="{Binding LoadModelOptionsCommand}" Content="{loc:Loc Config.RefreshModelList}"/>
                </Grid>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Onboarding.Model}" VerticalAlignment="Center" Opacity="0.8"/>
                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding Config.AiModels.MainConversation.Model}" IsEditable="True" MinWidth="260" Margin="0,0,0,8"/>

            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="plain" Command="{Binding TestConnectionCommand}">
                    <TextBlock Text="{loc:Loc Onboarding.TestConnection}"/></Button>
                <TextBlock Classes="mono" Text="{Binding ConnectionStatus}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/>
            </StackPanel>

            <!-- 最小化配置：只要求首个供应商和主对话模型。 -->
            <Border Classes="card" Margin="0,4,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="其他模型分工默认复用主模型，可在下一步展开调整；Embedding 与图像识别均为可选。" FontSize="{DynamicResource App.FontSize.Body}" Opacity="0.65"/>
                    <WrapPanel>
                        <Border Classes="chip" Margin="0,0,6,6"><TextBlock FontSize="{DynamicResource App.FontSize.Body}" Opacity="0.75" Text="{loc:Loc Onboarding.Role.Primary}"/></Border>
                        <Border Classes="chip" Margin="0,0,6,6"><TextBlock FontSize="{DynamicResource App.FontSize.Body}" Opacity="0.75" Text="{loc:Loc Onboarding.Role.Background}"/></Border>
                        <Border Classes="chip" Margin="0,0,6,6"><TextBlock FontSize="{DynamicResource App.FontSize.Body}" Opacity="0.75" Text="Embedding"/></Border>
                        <Border Classes="chip" Margin="0,0,6,6"><TextBlock FontSize="{DynamicResource App.FontSize.Body}" Opacity="0.75" Text="{loc:Loc Config.ModelRole.Approval}"/></Border>
                        <Border Classes="chip" Margin="0,0,6,6"><TextBlock FontSize="{DynamicResource App.FontSize.Body}" Opacity="0.75" Text="{loc:Loc Onboarding.Role.SubAgents}"/></Border>
                        <Border Classes="chip" Margin="0,0,6,6"><TextBlock FontSize="{DynamicResource App.FontSize.Body}" Opacity="0.75" Text="{loc:Loc Onboarding.Role.Browser}"/></Border>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Step 2：可选模型分工，默认留空即在完成时复用主模型。 -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding IsStep2}" Margin="0,20,0,0">
            <StackPanel Spacing="12">
                <TextBlock Text="模型分工（可选）" FontSize="{DynamicResource App.FontSize.Title}" FontWeight="SemiBold"/>
                <TextBlock Text="留空的通用分工会自动复用主对话模型。Embedding 与图像识别留空即禁用。" Opacity="0.65"/>
                <Expander Header="展开高级分工">
                    <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8" Margin="0,10,0,0">
                        <TextBlock Text="标题生成"/><ComboBox Grid.Column="1" ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding Config.AiModels.TitleGeneration.Model}" IsEditable="True"/>
                        <TextBlock Grid.Row="1" Text="上下文压缩"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding Config.AiModels.ContextCompression.Model}" IsEditable="True"/>
                        <TextBlock Grid.Row="2" Text="自动审批"/><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding Config.AiModels.Approval.Model}" IsEditable="True"/>
                        <TextBlock Grid.Row="3" Text="子代理"/><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding Config.AiModels.SubAgent.Model}" IsEditable="True"/>
                        <TextBlock Grid.Row="4" Text="知识整理"/><ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding Config.AiModels.KnowledgeMaintenance.Model}" IsEditable="True"/>
                    </Grid>
                </Expander>
                <Border Classes="card">
                    <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <TextBlock Text="Embedding（可选）"/><ComboBox Grid.Column="1" ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding Config.AiModels.Embedding.Model}" IsEditable="True"/>
                        <TextBlock Grid.Row="1" Text="图像识别（可选）"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding Config.AiModels.ImageRecognition.Model}" IsEditable="True"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Step 3：神谕开场 -->
        <StackPanel Grid.Row="1" Spacing="14" IsVisible="{Binding IsStep3}" VerticalAlignment="Center">
            <TextBlock Classes="mono" Text="{loc:Loc Onboarding.Step3Oracle}" HorizontalAlignment="Center"/>
            <TextBlock Text="{loc:Loc Onboarding.Step3Welcome}" FontSize="{DynamicResource App.FontSize.Title}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="520"/>
            <StackPanel Spacing="8" Margin="0,10,0,0" HorizontalAlignment="Center" MinWidth="420">
                <Button Classes="plain" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding PickStarterCommand}" CommandParameter="Onboarding.Starter1">
                    <TextBlock Text="{loc:Loc Onboarding.Starter1}" TextWrapping="Wrap" TextAlignment="Center"/></Button>
                <Button Classes="plain" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding PickStarterCommand}" CommandParameter="Onboarding.Starter2">
                    <TextBlock Text="{loc:Loc Onboarding.Starter2}" TextWrapping="Wrap" TextAlignment="Center"/></Button>
                <Button Classes="plain" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding PickStarterCommand}" CommandParameter="Onboarding.Starter3">
                    <TextBlock Text="{loc:Loc Onboarding.Starter3}" TextWrapping="Wrap" TextAlignment="Center"/></Button>
            </StackPanel>
        </StackPanel>

        <!-- 底部：步骤指示（方块）+ 导航 -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,18,0,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border Width="8" Height="8" BorderBrush="{DynamicResource SemiColorText1}" BorderThickness="1"
                        Background="{DynamicResource SemiColorText1}"/>
                <Border Width="8" Height="8" BorderBrush="{DynamicResource SemiColorText1}" BorderThickness="1">
                    <Border.Background>
                        <SolidColorBrush Color="Transparent"/>
                    </Border.Background>
                    <Border Background="{DynamicResource SemiColorText1}" IsVisible="{Binding !IsStep1}"/>
                </Border>
                <Border Width="8" Height="8" BorderBrush="{DynamicResource SemiColorText1}" BorderThickness="1">
                    <Border Background="{DynamicResource SemiColorText1}" IsVisible="{Binding IsStep3}"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Classes="plain" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}"><TextBlock Text="{loc:Loc Onboarding.Back}"/></Button>
                <Button Classes="oracle" Command="{Binding NextCommand}" IsVisible="{Binding IsNotLastStep}"><TextBlock Text="{loc:Loc Onboarding.Next}" Foreground="{DynamicResource SemiColorBackground0}"/></Button>
                <Button Classes="oracle" Command="{Binding FinishCommand}" IsVisible="{Binding IsStep3}"><TextBlock Text="{loc:Loc Onboarding.Finish}" Foreground="{DynamicResource SemiColorBackground0}"/></Button>
            </StackPanel>
        </Grid>
    </Grid>

    <!-- 引导→主窗口交接遮罩：与 MainWindow.ThemeSplashImage 同一张雅典娜版画，
         完成引导时先在本窗渐入满幕，随后主窗口以同图覆盖状态接棒，实现跨窗延续。 -->
    <Image x:Name="HandoffVeilImage"
           Stretch="UniformToFill"
           Opacity="0"
           IsHitTestVisible="False"
           ZIndex="100"/>
    </Panel>
</Window>
