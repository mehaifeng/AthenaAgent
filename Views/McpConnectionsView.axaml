<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Athena.UI.Markup"
             xmlns:appconv="using:Athena.UI.Converters"
             mc:Ignorable="d"
             x:Name="McpRoot"
             d:DesignWidth="720"
             d:DesignHeight="1200"
             x:Class="Athena.UI.Views.McpConnectionsView"
             x:DataType="vm:McpConnectionsViewModel">

    <Design.DataContext>
        <vm:McpConnectionsViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <appconv:McpStatusToBrushConverter x:Key="McpStatusToBrushConverter"/>
        <appconv:McpTransportIsHttpConverter x:Key="McpTransportIsHttp"/>
        <appconv:McpStatusIsFailedConverter x:Key="McpStatusIsFailed"/>
        <appconv:BoolToExpandGlyphConverter x:Key="BoolToExpandGlyph"/>
    </UserControl.Resources>

    <Grid RowDefinitions="40,*">

        <!-- HEADER -->
        <Border Grid.Row="0"
                CornerRadius="0,0,5,5"
                Background="{DynamicResource App.WorkspaceRightBackground}">
            <Grid MinWidth="600" MaxWidth="800" HorizontalAlignment="Center" Margin="0,18,0,0">
                <TextBlock Text="{loc:Loc Config.Mcp}" FontSize="{DynamicResource App.FontSize.PageTitle}" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- SCROLLABLE CONTENT -->
        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" Padding="0,5,0,5">
            <Grid RowDefinitions="Auto" Width="{Binding #MainScrollViewer.Viewport.Width}" HorizontalAlignment="Stretch">
                <Border
                    Grid.Row="0"
                    Background="{DynamicResource App.SectionBg}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="16,0,16,60"
                    Padding="16"
                    MinWidth="600"
                    MaxWidth="800"
                    HorizontalAlignment="Center">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                            <TextBlock Grid.Column="0" Text="{loc:Loc Config.Mcp.Enable}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Config.EnableMcp}" HorizontalAlignment="Left"/>
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc Config.Mcp.DiscoveryHint}" Opacity="0.7" FontSize="{DynamicResource App.FontSize.Body}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Loc Config.Mcp.ExampleHint}"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource App.FontSize.Body}"
                                           Opacity="0.6"
                                           VerticalAlignment="Center"/>
                                <HyperlinkButton Margin="5,0,0,0"
                                                 Content="{loc:Loc Config.Mcp.ExampleLink}"
                                                 NavigateUri="https://mcpservers.org"
                                                 FontSize="{DynamicResource App.FontSize.Body}"
                                                 Padding="0"
                                                 MinHeight="0"
                                                 VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Content="{loc:Loc Config.Mcp.AddServer}"
                                Command="{Binding AddMcpServerCommand}"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding Config.EnableMcp}"/>

                        <ItemsControl ItemsSource="{Binding Config.McpServers}" IsEnabled="{Binding Config.EnableMcp}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1" BorderBrush="{DynamicResource SemiColorBorder}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                        <StackPanel Spacing="6">
                                            <!-- 折叠标题栏（始终可见）：展开箭头 · 名称 · 状态 · 重连(仅失败) · 开关 · 删除 -->
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                                <Button Grid.Column="0"
                                                        Command="{Binding #McpRoot.DataContext.ToggleMcpExpandedCommand}"
                                                        CommandParameter="{Binding}"
                                                        Padding="4,0"
                                                        MinWidth="0"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Content="{Binding IsExpanded, Converter={StaticResource BoolToExpandGlyph}}"/>
                                                <!-- 名称：点击也可展开/折叠 -->
                                                <Button Grid.Column="1"
                                                        Command="{Binding #McpRoot.DataContext.ToggleMcpExpandedCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                </Button>
                                                <!-- 连接状态灯 + 提示 -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                             Fill="{Binding Status, Converter={StaticResource McpStatusToBrushConverter}}"/>
                                                    <TextBlock Text="{Binding StatusDetail}" VerticalAlignment="Center" Opacity="0.7" FontSize="{DynamicResource App.FontSize.Body}"
                                                               MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <!-- 重连：仅在连接失败时出现（改动配置会自动重连，此处用于配置未变时的失败重试） -->
                                                <Button Grid.Column="3"
                                                        Content="{loc:Loc Config.Mcp.Reconnect}"
                                                        IsVisible="{Binding Status, Converter={StaticResource McpStatusIsFailed}}"
                                                        Command="{Binding #McpRoot.DataContext.ReconnectMcpCommand}"/>
                                                <ToggleSwitch Grid.Column="4" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="5"
                                                        Command="{Binding #McpRoot.DataContext.RemoveMcpServerCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Data="{DynamicResource SemiIconDelete}" Height="15" Width="15"/>
                                                </Button>
                                            </Grid>

                                            <!-- 可编辑详情（默认折叠） -->
                                            <StackPanel Spacing="6" IsVisible="{Binding IsExpanded}">
                                            <!-- 名称 + 传输类型 -->
                                            <Grid ColumnDefinitions="90,*,Auto" ColumnSpacing="10">
                                                <TextBlock Grid.Column="0" Text="{loc:Loc Config.Mcp.Name}" VerticalAlignment="Center" Opacity="0.8"/>
                                                <TextBox Grid.Column="1" Text="{Binding Name}"/>
                                                <ToggleSwitch Grid.Column="2"
                                                              IsChecked="{Binding Transport, Converter={StaticResource McpTransportIsHttp}}"
                                                              OnContent="{loc:Loc Config.Mcp.TransportHttp}"
                                                              OffContent="{loc:Loc Config.Mcp.TransportStdio}"/>
                                            </Grid>

                                            <!-- Stdio 段 -->
                                            <StackPanel Spacing="6" IsVisible="{Binding Transport, Converter={StaticResource McpTransportIsHttp}, ConverterParameter=Stdio}">
                                                <Grid ColumnDefinitions="90,*" ColumnSpacing="10" RowDefinitions="Auto,Auto">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.Mcp.Command}" VerticalAlignment="Center" Opacity="0.8"/>
                                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Command}" PlaceholderText="{loc:Loc Mcp.Placeholder.Command}"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Config.Mcp.WorkingDir}" VerticalAlignment="Center" Opacity="0.8"/>
                                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WorkingDirectory}" PlaceholderText="{loc:Loc Mcp.Placeholder.WorkingDir}"/>
                                                </Grid>

                                                <!-- 启动参数列表 -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{loc:Loc Config.Mcp.Args}" VerticalAlignment="Center" Opacity="0.8"/>
                                                    <Button Grid.Column="1" Content="+"
                                                            Command="{Binding #McpRoot.DataContext.AddMcpArgCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Arguments}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,0,0,2">
                                                                <TextBox Grid.Column="0" Text="{Binding Value}"/>
                                                                <Button Grid.Column="1" Content="✕"
                                                                        Command="{Binding #McpRoot.DataContext.RemoveMcpArgCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- 环境变量列表 -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{loc:Loc Config.Mcp.Env}" VerticalAlignment="Center" Opacity="0.8"/>
                                                    <Button Grid.Column="1" Content="+"
                                                            Command="{Binding #McpRoot.DataContext.AddMcpEnvCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Environment}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6" Margin="0,0,0,2">
                                                                <TextBox Grid.Column="0" Text="{Binding Key}" PlaceholderText="{loc:Loc Mcp.Placeholder.EnvKey}"/>
                                                                <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="{loc:Loc Mcp.Placeholder.EnvValue}"/>
                                                                <Button Grid.Column="2" Content="✕"
                                                                        Command="{Binding #McpRoot.DataContext.RemoveMcpEnvCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Http 段 -->
                                            <StackPanel Spacing="6" IsVisible="{Binding Transport, Converter={StaticResource McpTransportIsHttp}}">
                                                <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                    <TextBlock Grid.Column="0" Text="{loc:Loc Config.Mcp.Url}" VerticalAlignment="Center" Opacity="0.8"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Url}" PlaceholderText="{loc:Loc Mcp.Placeholder.Url}"/>
                                                </Grid>

                                                <!-- 请求头列表 -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{loc:Loc Config.Mcp.Headers}" VerticalAlignment="Center" Opacity="0.8"/>
                                                    <Button Grid.Column="1" Content="+"
                                                            Command="{Binding #McpRoot.DataContext.AddMcpHeaderCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Headers}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6" Margin="0,0,0,2">
                                                                <TextBox Grid.Column="0" Text="{Binding Key}" PlaceholderText="{loc:Loc Mcp.Placeholder.HeaderKey}"/>
                                                                <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="{loc:Loc Mcp.Placeholder.HeaderValue}"/>
                                                                <Button Grid.Column="2" Content="✕"
                                                                        Command="{Binding #McpRoot.DataContext.RemoveMcpHeaderCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Claude Desktop JSON 导入 -->
                        <TextBlock Text="{loc:Loc Config.Mcp.ImportTitle}" FontWeight="SemiBold" Opacity="0.8"/>
                        <TextBox Text="{Binding McpImportJson}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="80"
                                 IsEnabled="{Binding Config.EnableMcp}"
                                 PlaceholderText="{loc:Loc Config.Mcp.ImportPlaceholder}"/>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Content="{loc:Loc Config.Mcp.Import}"
                                    Command="{Binding ImportMcpJsonCommand}"
                                    IsEnabled="{Binding Config.EnableMcp}"/>
                            <TextBlock Grid.Column="1" Text="{Binding McpImportStatus}" VerticalAlignment="Center" Opacity="0.7" FontSize="{DynamicResource App.FontSize.Body}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
