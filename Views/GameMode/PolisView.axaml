<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gm="using:Athena.UI.ViewModels.GameMode"
             xmlns:loc="using:Athena.UI.Markup"
             x:Class="Athena.UI.Views.GameMode.PolisView"
             x:DataType="gm:GameModeViewModel"
             x:Name="PolisRoot">
    <!-- 游戏视图：替换消息列表所在的那一行（设计稿 12.1）。WebView 惰性创建在 PolisPageHost 里（代码后台按 PageUrl 建/拆）。
         原生 WebView 永远在最上层，Avalonia 画不到它上面——所以失败时 ViewModel 先拆掉 WebView，下面的失败面板才看得见。 -->
    <Grid Background="#C8C5BF">
        <TextBlock x:Name="PolisLoadingText"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#4A433D"
                   FontSize="{DynamicResource App.FontSize.Body}"
                   Text="{loc:Loc GameMode.Loading}"
                   IsVisible="{Binding IsLoading}"/>

        <Border x:Name="PolisPageHost"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>

        <Border x:Name="PolisFailurePanel"
                IsVisible="{Binding HasFailure}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="560"
                Margin="24"
                Padding="24,20"
                CornerRadius="10"
                Background="#F6F3EE"
                BorderBrush="#33000000"
                BorderThickness="1">
            <StackPanel Spacing="10">
                <TextBlock x:Name="PolisFailureTitle"
                           Text="{Binding FailureTitle}"
                           FontWeight="SemiBold"
                           Foreground="#2A2622"
                           FontSize="{DynamicResource App.FontSize.Heading}"/>
                <TextBlock x:Name="PolisFailureReason"
                           Text="{Binding FailureReason}"
                           TextWrapping="Wrap"
                           Foreground="#2A2622"/>
                <TextBlock Text="{loc:Loc GameMode.Failure.DetailHint}"
                           TextWrapping="Wrap"
                           Foreground="#6B625A"
                           FontSize="{DynamicResource App.FontSize.Caption}"/>
                <!-- 技术细节，方便反馈：可选中、可复制，不可编辑 -->
                <TextBox x:Name="PolisFailureDetail"
                         Text="{Binding FailureDetail}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         MaxHeight="140"
                         FontFamily="Menlo, Consolas, monospace"
                         FontSize="{DynamicResource App.FontSize.Caption}"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="PolisRetryButton"
                            Content="{loc:Loc GameMode.Failure.Retry}"
                            Command="{Binding RetryCommand}"/>
                    <Button x:Name="PolisReturnButton"
                            Theme="{StaticResource AccentButtonTheme}"
                            Content="{loc:Loc GameMode.Failure.Return}"
                            Command="{Binding ReturnToConversationCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
