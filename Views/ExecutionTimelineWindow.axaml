<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Athena.UI.Controls"
        xmlns:vm="using:Athena.UI.ViewModels"
        xmlns:loc="using:Athena.UI.Markup"
        x:Class="Athena.UI.Views.ExecutionTimelineWindow"
        x:DataType="vm:ExecutionTimelineViewModel"
        Title="{loc:Loc Timeline.Title}" Width="1080" Height="700" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="20" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc Timeline.Title}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.78"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                <Button Name="TimelineZoomOut" Content="{loc:Loc Timeline.ZoomOut}" Click="OnZoomOut"/>
                <Button Name="TimelineFit" Content="{loc:Loc Timeline.Fit}" Click="OnFit"/>
                <Button Name="TimelineZoomIn" Content="{loc:Loc Timeline.ZoomIn}" Click="OnZoomIn"/>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding Notice}" TextWrapping="Wrap" Opacity="0.78"/>
        <Border Grid.Row="2" BorderThickness="1" BorderBrush="{DynamicResource SemiGreyLowBrush}" CornerRadius="8" ClipToBounds="True">
            <ScrollViewer Name="TimelineScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ScrollChanged="OnScrollChanged">
                <controls:ExecutionTimelineChart Name="TimelineChart" Snapshot="{Binding Snapshot}" LanguageVersion="{Binding LanguageVersion}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    AutomationProperties.Name="{loc:Loc Timeline.Title}"/>
            </ScrollViewer>
        </Border>
        <TextBlock Grid.Row="3" Text="{Binding Detail}" TextWrapping="Wrap" MinHeight="42"/>
        <TextBlock Grid.Row="4" Text="{loc:Loc Timeline.MeasurementHint}" TextWrapping="Wrap" Opacity="0.62" FontSize="11"/>
    </Grid>
</Window>
