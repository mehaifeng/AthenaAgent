<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Athena.UI.Markup"
             mc:Ignorable="d" 
             d:DesignWidth="720"
             d:DesignHeight="1080"
             x:Class="Athena.UI.Views.AboutTabView"
             x:DataType="vm:AboutTabViewModel">

    <Design.DataContext>
        <vm:AboutTabViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="40,*">

        <!-- HEADER BAR -->
        <Border Grid.Row="0"
                Background="{DynamicResource App.SectionBg}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <TextBlock Text="{loc:Loc About.Header}"
                       FontWeight="SemiBold"
                       FontSize="14"/>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="20">
            <StackPanel Spacing="24" HorizontalAlignment="Center" MaxWidth="600">

                <!-- 系统信息块 -->
                <Border Background="{DynamicResource App.SectionBg}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="32">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Agent Athena"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SemiBlue6}"/>

                        <Separator Height="1" Opacity="0.3" Margin="0,8"/>

                        <TextBlock Text="{loc:Loc About.Subtitle}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center"
                                   Opacity="0.8"/>
                    </StackPanel>
                </Border>

                <!-- 规格信息块 -->
                <Border Background="{DynamicResource App.SectionBg}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        HorizontalAlignment="Stretch">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{loc:Loc About.Specs}"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Opacity="0.9"/>

                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="12,0,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc About.KernelVer}" Opacity="0.6" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="v0.0.1-ALPHA" FontWeight="Bold" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc About.Framework}" Opacity="0.6" Margin="0,12,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text=".NET 10 / AVALONIA UI /Semi.Avalonia" Margin="0,12,0,0" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc About.License}" Opacity="0.6" Margin="0,12,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="MIT" Margin="0,12,0,0" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc About.Author}" Opacity="0.6" Margin="0,12,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="@mehaifeng
                            " Margin="0,12,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 名言块 -->
                <Border Background="{DynamicResource App.AssistantBubbleBg}"
                        CornerRadius="8"
                        Padding="16">
                    <TextBlock Text="{loc:Loc About.Quote}"
                               FontStyle="Italic"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Opacity="0.8"/>
                </Border>

                <!-- 按钮组 -->
                <StackPanel Orientation="Horizontal"
                            Spacing="16"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0">
                    <Button Command="{Binding CheckForUpdatesCommand}"
                            Theme="{StaticResource AccentButtonTheme}"
                            Padding="20,8"
                            ToolTip.Tip="{loc:Loc About.BtnChkUpdates}">
                        <PathIcon Data="{StaticResource SemiIconSync}" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding OpenDocumentationCommand}"
                            Padding="20,8"
                            ToolTip.Tip="{loc:Loc About.BtnViewDocs}">
                        <PathIcon Data="{StaticResource SemiIconArticle}" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding OpenGitHubCommand}"
                            Padding="20,8"
                            ToolTip.Tip="{loc:Loc About.BtnSourceRepo}">
                        <PathIcon Data="{StaticResource SemiIconGithubLogo}" Width="16" Height="16"/>
                    </Button>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>