<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Athena.UI.ViewModels"
        xmlns:loc="using:Athena.UI.Markup"
        x:Class="Athena.UI.Views.SkillsConnectorsWindow"
        x:DataType="vm:SkillsConnectorsWindowViewModel"
        Title="{loc:Loc Connectors.Window.Title}"
        Width="1160"
        Height="800"
        MinWidth="1000"
        MinHeight="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="5" ColumnDefinitions="3*,5,7*">
        <!-- 导航项样式与 AppSettingsWindow 左侧一致；上下边距拉开（Padding 纵向 16） -->
        <Border Padding="8,16"
                Background="{DynamicResource App.WorkspaceLeftBackground}"
                BorderThickness="1"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                CornerRadius="8">
            <ListBox x:Name="ConnectorNavigation"
                     ItemsSource="{Binding Sections}"
                     SelectedItem="{Binding SelectedSection}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SkillsConnectorSection">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="2,4">
                            <PathIcon Grid.Column="0"
                                      Width="16"
                                      Height="16"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource App.IconAccentForeground}"
                                      IsVisible="{Binding IconKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                      Data="{Binding IconKey, Converter={StaticResource ToolIconKeyToGeometryConverter}}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Title}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Column="2"
                Background="{DynamicResource App.WorkspaceRightBackground}"
                BorderThickness="1"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                CornerRadius="8">
            <ContentControl x:Name="ConnectorContentHost"
                            Content="{Binding SelectedSection.Content}"/>
        </Border>
    </Grid>
</Window>
