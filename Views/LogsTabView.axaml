<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Athena.UI.Markup"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="900"
             x:Class="Athena.UI.Views.LogsTabView"
             x:DataType="vm:LogsTabViewModel">

    <Design.DataContext>
        <vm:LogsTabViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="40,Auto,*,Auto">

        <!-- HEADER BAR -->
        <Border Grid.Row="0"
                Background="{DynamicResource App.SectionBg}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <TextBlock Text="{loc:Loc Logs.Header}"
                       FontWeight="SemiBold"
                       FontSize="14"/>
        </Border>

        <!-- FILTER & QUERY PARAMETERS -->
        <Border Grid.Row="1"
                Background="{DynamicResource App.SectionBg}"
                CornerRadius="8"
                Margin="0,10,0,0"
                Padding="16">
            <StackPanel Spacing="16">
                <TextBlock Text="{loc:Loc Logs.QueryParams}"
                           FontWeight="Bold"
                           FontSize="13"/>

                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
                    <!-- Row 1: Date & Level -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                        <TextBlock Text="{loc:Loc Logs.TStart}" VerticalAlignment="Center" Width="80" FontSize="12" Opacity="0.8"/>
                        <CalendarDatePicker SelectedDate="{Binding LogStartTime}" Width="150" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                        <TextBlock Text="{loc:Loc Logs.TEnd}" VerticalAlignment="Center" Width="80" FontSize="12" Opacity="0.8"/>
                        <CalendarDatePicker SelectedDate="{Binding LogEndTime}" Width="150" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{loc:Loc Logs.Lvl}" VerticalAlignment="Center" Width="80" FontSize="12" Opacity="0.8"/>
                        <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding SelectedLogLevel}" Width="150" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{loc:Loc Logs.Keyword}" VerticalAlignment="Center" Width="80" FontSize="12" Opacity="0.8"/>
                        <TextBox Text="{Binding SearchLogText}" Width="150" Watermark="{loc:Loc Logs.OptionalFilter}" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <Button Command="{Binding SearchLogsCommand}" 
                            Padding="16,4" 
                            Theme="{StaticResource AccentButtonTheme}"
                            ToolTip.Tip="{loc:Loc Logs.BtnQuery}">
                        <PathIcon Data="{StaticResource SemiIconSearch}" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding RefreshLogsCommand}" 
                            Padding="12,4"
                            ToolTip.Tip="{loc:Loc Logs.BtnRefresh}">
                        <PathIcon Data="{StaticResource SemiIconRefresh}" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding ExportLogsCommand}" 
                            Padding="12,4"
                            ToolTip.Tip="{loc:Loc Logs.BtnExport}">
                        <PathIcon Data="{StaticResource SemiIconDownload}" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- LOG LIST -->
        <Border Grid.Row="2" Margin="0,10,0,0" 
                Background="{DynamicResource App.SectionBg}"
                CornerRadius="8">
            <ScrollViewer Padding="8">
                <ListBox ItemsSource="{Binding LogEntries}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="5,0"
                                    Opacity="0.9">
                                <Grid ColumnDefinitions="140,100,*">
                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Timestamp, StringFormat='{}{0:MM-dd HH:mm:ss}'}"
                                               FontSize="11"
                                               Opacity="0.6"
                                               VerticalAlignment="Center"/>
                                    <!-- Level Indicator -->
                                    <Border Grid.Column="1"
                                            Width="70"
                                            Background="{Binding LevelColor}"
                                            Padding="4,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            CornerRadius="4">
                                        <TextBlock Text="{Binding Level}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                  FontSize="10"
                                                  FontWeight="Bold"
                                                  Foreground="White"/>
                                    </Border>

                                    <!-- Message -->
                                    <TextBlock Grid.Column="2"
                                              Text="{Binding Message}"
                                              TextWrapping="Wrap"
                                              FontSize="12"
                                              VerticalAlignment="Center"
                                              LineHeight="18"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Border>

        <!-- PAGINATION / FOOTER -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource App.SectionBg}"
                BorderThickness="0,1,0,0"
                Padding="12,8"
                >
            <Grid ColumnDefinitions="*,Auto,Auto">

                <!-- Total Count -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Logs.TotalEvents}" FontSize="12" Opacity="0.6"/>
                    <TextBlock Text="{Binding TotalLogCount}" FontWeight="Bold" FontSize="12"/>
                </StackPanel>

                <!-- Page Size -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="{loc:Loc Logs.Limit}" FontSize="12" VerticalAlignment="Center" Opacity="0.6"/>
                    <ComboBox ItemsSource="{Binding LogPageSizes}" SelectedItem="{Binding SelectedLogPageSize}" MinWidth="80" Padding="4,2"/>
                </StackPanel>

                <!-- Pagination Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Content="&lt;" Command="{Binding PrevPageCommand}" IsEnabled="{Binding HasPrevPage}" Padding="12,4"/>
                    <TextBlock Text="{Binding CurrentPageInfo}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" TextAlignment="Center" MinWidth="80"/>
                    <Button Content="&gt;" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" Padding="12,4"/>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</UserControl>