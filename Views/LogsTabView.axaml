<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Athena.UI.Markup"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="900"
             x:Class="Athena.UI.Views.LogsTabView"
             x:DataType="vm:LogsTabViewModel">

    <Design.DataContext>
        <vm:LogsTabViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <!-- 自定义时间范围：起止倒置时的警示态 -->
        <Style Selector="CalendarDatePicker.invalid">
            <Setter Property="BorderBrush" Value="{DynamicResource SemiRed6}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="40,Auto,*,Auto">

        <!-- HEADER BAR -->
        <Border Grid.Row="0"
                CornerRadius="0,0,5,5"
                Background="{DynamicResource App.SectionBg}"
                Padding="12,8">
            <TextBlock Text="{loc:Loc Logs.Header}"
                       FontWeight="SemiBold"
                       FontSize="{DynamicResource App.FontSize.Heading}"/>
        </Border>

        <!-- SEARCH & FILTER BAR：与历史页同款布局；选"自定义范围"时展开日期行 -->
        <Border Grid.Row="1"
                Background="{DynamicResource App.SectionBg}"
                CornerRadius="8"
                Margin="0,5,0,0"
                Padding="10">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,8,Auto,8,Auto,8,Auto">
                    <TextBox Grid.Column="0"
                             Classes="clearButton"
                             Text="{Binding SearchLogText}"
                             PlaceholderText="{loc:Loc Logs.OptionalFilter}">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="{StaticResource SemiIconSearch}"
                                      Width="14" Height="14"
                                      Margin="8,0,4,0"
                                      Opacity="0.5"/>
                        </TextBox.InnerLeftContent>
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SearchLogsCommand}"/>
                        </TextBox.KeyBindings>
                    </TextBox>

                    <ComboBox Grid.Column="2"
                              MinWidth="92"
                              ItemsSource="{Binding LogLevels}"
                              SelectedItem="{Binding SelectedLogLevel}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="{loc:Loc Logs.Lvl}"/>

                    <ComboBox Grid.Column="4"
                              MinWidth="118"
                              SelectedIndex="{Binding TimeFilterIndex}"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="{loc:Loc History.TimeAll}"/>
                        <ComboBoxItem Content="{loc:Loc History.TimeToday}"/>
                        <ComboBoxItem Content="{loc:Loc History.Time7Days}"/>
                        <ComboBoxItem Content="{loc:Loc History.Time30Days}"/>
                        <ComboBoxItem Content="{loc:Loc History.TimeCustom}"/>
                    </ComboBox>

                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Command="{Binding SearchLogsCommand}"
                                Padding="8,4"
                                Theme="{StaticResource AccentButtonTheme}"
                                ToolTip.Tip="{loc:Loc Logs.BtnQuery}">
                            <PathIcon Data="{StaticResource SemiIconSearch}" Width="14" Height="14"/>
                        </Button>
                        <Button Command="{Binding RefreshLogsCommand}"
                                Padding="8,4"
                                ToolTip.Tip="{loc:Loc Logs.BtnRefresh}">
                            <PathIcon Data="{StaticResource SemiIconRefresh}" Width="14" Height="14"/>
                        </Button>
                        <Button Command="{Binding ExportLogsCommand}"
                                Padding="8,4"
                                ToolTip.Tip="{loc:Loc Logs.BtnExport}">
                            <PathIcon Data="{StaticResource SemiIconDownload}" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,Auto,*,8,Auto" IsVisible="{Binding IsCustomRange}">
                    <CalendarDatePicker Grid.Column="0"
                                        SelectedDate="{Binding CustomStartDate}"
                                        Classes.invalid="{Binding IsCustomRangeInvalid}"
                                        PlaceholderText="{loc:Loc History.TimeStartDate}"
                                        HorizontalAlignment="Stretch"/>
                    <TextBlock Grid.Column="1"
                               Text="—"
                               Margin="8,0"
                               Opacity="0.5"
                               VerticalAlignment="Center"/>
                    <CalendarDatePicker Grid.Column="2"
                                        SelectedDate="{Binding CustomEndDate}"
                                        Classes.invalid="{Binding IsCustomRangeInvalid}"
                                        PlaceholderText="{loc:Loc History.TimeEndDate}"
                                        HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="4"
                            Command="{Binding ClearCustomRangeCommand}"
                            Padding="6,4"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{loc:Loc History.TimeClear}">
                        <PathIcon Data="{StaticResource SemiIconClose}" Width="12" Height="12"/>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- LOG LIST -->
        <Border Grid.Row="2" Margin="0,5,0,0" 
                Background="{DynamicResource App.SectionBg}"
                CornerRadius="8">
            <ScrollViewer>
                <ListBox ItemsSource="{Binding LogEntries}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="5,0"
                                    MaxHeight="96"
                                    Opacity="0.9">
                                <Grid ColumnDefinitions="100,100,*">
                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Timestamp, StringFormat='{}{0:MM-dd HH:mm:ss}'}"
                                               FontSize="{DynamicResource App.FontSize.Body}"
                                               Opacity="0.6"
                                               VerticalAlignment="Center"/>
                                    <!-- Level Indicator -->
                                    <Border Grid.Column="1"
                                            Width="65"
                                            Background="{Binding LevelBackground}"
                                            Padding="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            CornerRadius="4">
                                        <TextBlock Text="{Binding Level}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                  FontSize="{DynamicResource App.FontSize.Caption}"
                                                  FontWeight="Bold"
                                                  Foreground="{Binding LevelForeground}"/>
                                    </Border>

                                    <!-- Message -->
                                    <TextBlock Grid.Column="2"
                                              Text="{Binding Message}"
                                              TextWrapping="Wrap"
                                              MaxHeight="72"
                                              TextTrimming="CharacterEllipsis"
                                              FontSize="{DynamicResource App.FontSize.Body}"
                                              VerticalAlignment="Center"
                                              LineHeight="18"/>
                                </Grid>
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:Loc Chat.BtnCopy}"
                                                  Command="{Binding $parent[ListBox].((vm:LogsTabViewModel)DataContext).CopyLogDetailsCommand}"
                                                  CommandParameter="{Binding .}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Border>

        <!-- PAGINATION / FOOTER -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource App.SectionBg}"
                BorderThickness="0,1,0,0"
                Padding="12,8"
                >
            <Grid ColumnDefinitions="*,Auto,Auto">

                <!-- Total Count -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Logs.TotalEvents}" FontSize="{DynamicResource App.FontSize.Body}" Opacity="0.6"/>
                    <TextBlock Text="{Binding TotalLogCount}" FontWeight="Bold" FontSize="{DynamicResource App.FontSize.Body}"/>
                </StackPanel>

                <!-- Page Size -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="{loc:Loc Logs.Limit}" FontSize="{DynamicResource App.FontSize.Body}" VerticalAlignment="Center" Opacity="0.6"/>
                    <ComboBox ItemsSource="{Binding LogPageSizes}" SelectedItem="{Binding SelectedLogPageSize}" MinWidth="80" Padding="4,2"/>
                </StackPanel>

                <!-- Pagination Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Content="&lt;" Command="{Binding PrevPageCommand}" IsEnabled="{Binding HasPrevPage}" Padding="12,4"/>
                    <TextBlock Text="{Binding CurrentPageInfo}" FontWeight="Bold" FontSize="{DynamicResource App.FontSize.Body}" VerticalAlignment="Center" TextAlignment="Center" MinWidth="80"/>
                    <Button Content="&gt;" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" Padding="12,4"/>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</UserControl>
