<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:services="using:Athena.UI.Services"
             xmlns:loc="using:Athena.UI.Markup"
             xmlns:lmd="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             x:Class="Athena.UI.Views.WorkspaceWorkbenchView"
             x:DataType="vm:WorkspaceWorkbenchViewModel">
    <UserControl.Styles>
        <Style Selector="Button.editor-command">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Caption}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.editor-command:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiGrey0}"/>
        </Style>
        <Style Selector="Button.editor-command:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiGrey1}"/>
        </Style>
        <Style Selector="ListBox.editor-tabs">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.editor-tabs ListBoxItem">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>
    <Grid x:Name="WorkbenchGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="240"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="100"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                IsVisible="{Binding IsEditorVisible}"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{DynamicResource SemiColorBackground0}">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="6,5">
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
                        <Button Classes="editor-command" Command="{Binding SetEditorModeCommand}" CommandParameter="Edit">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <PathIcon Data="{StaticResource AthenaIconEdit}" Width="10" Height="10" Foreground="{DynamicResource App.IconAccentForeground}"/>
                                <TextBlock Text="编辑"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="editor-command" Command="{Binding SetEditorModeCommand}" CommandParameter="Preview"
                                IsEnabled="{Binding SelectedEditorTab.CanPreview}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <PathIcon Data="{StaticResource AthenaIconPreview}" Width="10" Height="10" Foreground="{DynamicResource App.IconAccentForeground}"/>
                                <TextBlock Text="预览"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="editor-command" Command="{Binding SetEditorModeCommand}" CommandParameter="Diff"
                                IsEnabled="{Binding SelectedEditorTab.CanDiff}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <PathIcon Data="{StaticResource AthenaIconBranch}" Width="10" Height="10" Foreground="{DynamicResource App.IconAccentForeground}"/>
                                <TextBlock Text="Diff"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SaveEditorButton" Classes="editor-command"
                                Command="{Binding SaveFileCommand}" CommandParameter="{Binding SelectedEditorTab}"
                                IsVisible="{Binding SelectedEditorTab.IsEditMode}"
                                IsEnabled="{Binding SelectedEditorTab.IsDirty}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <PathIcon Data="{StaticResource AthenaIconSave}" Width="10" Height="10" Foreground="{DynamicResource App.IconAccentForeground}"/>
                                <TextBlock Text="保存"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelEditorButton" Classes="editor-command"
                                Command="{Binding CancelFileEditsCommand}" CommandParameter="{Binding SelectedEditorTab}"
                                IsVisible="{Binding SelectedEditorTab.IsEditMode}"
                                IsEnabled="{Binding SelectedEditorTab.IsDirty}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <PathIcon Data="{StaticResource AthenaIconCancel}" Width="10" Height="10" Foreground="{DynamicResource App.IconAccentForeground}"/>
                                <TextBlock Text="取消"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="editor-command" ToolTip.Tip="关闭编辑区" Command="{Binding CloseEditorPaneCommand}">
                        <PathIcon Data="{StaticResource AthenaIconClose}" Width="10" Height="10" Foreground="{DynamicResource App.IconAccentForeground}"/>
                    </Button>
                </Grid>
                <Grid Grid.Row="1" RowDefinitions="Auto,*">
                    <ListBox x:Name="EditorTabsList"
                             Grid.Row="0"
                             Classes="editor-tabs"
                             ItemsSource="{Binding EditorTabs}"
                             SelectedItem="{Binding SelectedEditorTab}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkspaceEditorTabViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{Binding FileName}"/>
                                <TextBlock Text="●" Foreground="{DynamicResource SemiOrange5}" IsVisible="{Binding IsDirty}"/>
                                <Button ToolTip.Tip="关闭文件"
                                        Padding="3,0"
                                        Command="{Binding $parent[UserControl].DataContext.CloseEditorTabCommand}"
                                        CommandParameter="{Binding}">
                                    <PathIcon Data="{StaticResource AthenaIconClose}" Width="11" Height="11" Foreground="{DynamicResource App.IconMutedForeground}"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ContentControl Grid.Row="1" Content="{Binding SelectedEditorTab}">
                        <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:WorkspaceEditorTabViewModel">
                            <Grid>
                                <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="Menlo, Consolas, monospace"
                                         HorizontalContentAlignment="Stretch"
                                         VerticalContentAlignment="Stretch"
                                         IsVisible="{Binding Mode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Edit}"/>
                                <ScrollViewer IsVisible="{Binding Mode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Preview}">
                                    <lmd:MarkdownRenderer Margin="16" loc:MarkdownHelper.Text="{Binding Text}"/>
                                </ScrollViewer>
                                <Grid IsVisible="{Binding Mode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Diff}"
                                      RowDefinitions="Auto,*">
                                    <Border Padding="8,5" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SemiGreyLowBrush}">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                            <TextBlock Text="HEAD  ↔  当前编辑缓冲区" FontSize="{DynamicResource App.FontSize.Body}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DiffAddedCount, StringFormat=+{0}}"
                                                       Foreground="{DynamicResource SemiGreen6}" FontSize="{DynamicResource App.FontSize.Body}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DiffRemovedCount, StringFormat=−{0}}"
                                                       Foreground="{DynamicResource SemiRed6}" FontSize="{DynamicResource App.FontSize.Body}"/>
                                        </Grid>
                                    </Border>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding DiffLines}" Background="Transparent">
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="MinHeight" Value="22"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="services:WorkspaceDiffLine">
                                                <Grid ColumnDefinitions="38,38,22,*" MinHeight="22">
                                                    <Border Grid.ColumnSpan="4" Background="#1F2DA44E" IsVisible="{Binding IsAdded}"/>
                                                    <Border Grid.ColumnSpan="4" Background="#1FF85149" IsVisible="{Binding IsRemoved}"/>
                                                    <Border Grid.Column="0" Background="#0D808080"/>
                                                    <Border Grid.Column="1" Background="#0D808080"/>
                                                    <TextBlock Grid.Column="0" Text="{Binding OldLineNumberText}" FontFamily="Menlo, Consolas, monospace"
                                                               FontSize="{DynamicResource App.FontSize.Caption}" Opacity="0.45" TextAlignment="Right" Padding="0,3,6,2"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding NewLineNumberText}" FontFamily="Menlo, Consolas, monospace"
                                                               FontSize="{DynamicResource App.FontSize.Caption}" Opacity="0.45" TextAlignment="Right" Padding="0,3,6,2"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Prefix}" FontFamily="Menlo, Consolas, monospace"
                                                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Text}" FontFamily="Menlo, Consolas, monospace"
                                                               FontSize="{DynamicResource App.FontSize.Body}" TextWrapping="NoWrap" Padding="4,3,8,2"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                                <ScrollViewer IsVisible="{Binding Mode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Image}">
                                    <Image Source="{Binding Image}" Stretch="Uniform" Margin="12"/>
                                </ScrollViewer>
                            </Grid>
                        </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>
                <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="{DynamicResource App.FontSize.Body}" Opacity="0.65" Margin="10,5" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="5" Background="{DynamicResource SemiColorBorder}"
                      IsVisible="{Binding IsEditorVisible}" DragCompleted="OnEditorSplitterDragCompleted"/>

        <Border Grid.Column="{Binding IsEditorVisible, Converter={StaticResource EditorPaneGridConverter}, ConverterParameter=BrowserColumn}"
                Grid.ColumnSpan="{Binding IsEditorVisible, Converter={StaticResource EditorPaneGridConverter}, ConverterParameter=BrowserSpan}"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{DynamicResource SemiColorBackground0}">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid Margin="10,8" ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource AthenaIconOpenFile}" Width="15" Height="15" Foreground="{DynamicResource App.IconMutedForeground}"/>
                        <TextBlock Text="{Binding WorkspaceName}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding RefreshFilesCommand}" ToolTip.Tip="刷新">
                        <PathIcon Data="{StaticResource AthenaIconRefresh}" Width="15" Height="15" Foreground="{DynamicResource App.IconAccentForeground}"/>
                    </Button>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="8,0,8,6" IsVisible="{Binding IsRenameVisible}" Background="{DynamicResource SemiColorBackground0}">
                    <TextBox Text="{Binding RenameName}"/>
                    <Button Grid.Column="1" Command="{Binding CommitRenameFileCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="{StaticResource AthenaIconEdit}" Width="14" Height="14" Foreground="{DynamicResource App.IconAccentForeground}"/>
                            <TextBlock Text="重命名"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <TreeView Grid.Row="2"
                          ItemsSource="{Binding Files}"
                          SelectedItem="{Binding SelectedFile}"
                          DoubleTapped="OnFileDoubleTapped"
                          Margin="5">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:WorkspaceFileNodeViewModel">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                                <TextBlock.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuItem Header="打开"
                                                  Command="{Binding $parent[UserControl].DataContext.OpenFileCommand}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconOpenFile}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="复制路径"
                                                  Command="{Binding $parent[UserControl].DataContext.CopyRelativePathCommand}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconCopy}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="复制绝对路径"
                                                  Command="{Binding $parent[UserControl].DataContext.CopyAbsolutePathCommand}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconCopy}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="重命名"
                                                  Command="{Binding $parent[UserControl].DataContext.BeginRenameFileCommand}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconEdit}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="删除"
                                                  Command="{Binding $parent[UserControl].DataContext.DeleteFileCommand}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconDelete}" Foreground="{DynamicResource App.IconDangerForeground}"/></MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </TextBlock.ContextFlyout>
                            </TextBlock>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
