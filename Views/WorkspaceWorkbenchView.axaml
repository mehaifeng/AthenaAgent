<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:loc="using:Athena.UI.Markup"
             xmlns:lmd="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             x:Class="Athena.UI.Views.WorkspaceWorkbenchView"
             x:DataType="vm:WorkspaceWorkbenchViewModel">
    <Grid x:Name="WorkbenchGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="180"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="180"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                IsVisible="{Binding IsEditorVisible}"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{DynamicResource SemiColorBackground0}">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="10,7">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Button Content="编辑" Command="{Binding SetEditorModeCommand}" CommandParameter="Edit"/>
                        <Button Content="预览" Command="{Binding SetEditorModeCommand}" CommandParameter="Preview"
                                IsEnabled="{Binding SelectedEditorTab.CanPreview}"/>
                        <Button Content="Diff" Command="{Binding SetEditorModeCommand}" CommandParameter="Diff"
                                IsEnabled="{Binding SelectedEditorTab.CanDiff}"/>
                        <Button Content="保存" Command="{Binding SaveFileCommand}" CommandParameter="{Binding SelectedEditorTab}"
                                IsEnabled="{Binding SelectedEditorTab.IsDirty}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" ToolTip.Tip="关闭编辑区" Command="{Binding CloseEditorPaneCommand}"/>
                </Grid>
                <TabControl Grid.Row="1"
                            ItemsSource="{Binding EditorTabs}"
                            SelectedItem="{Binding SelectedEditorTab}">
                    <TabControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkspaceEditorTabViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{Binding FileName}"/>
                                <TextBlock Text="●" Foreground="{DynamicResource SemiOrange5}" IsVisible="{Binding IsDirty}"/>
                                <Button Content="×"
                                        Padding="3,0"
                                        Command="{Binding $parent[UserControl].DataContext.CloseEditorTabCommand}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:WorkspaceEditorTabViewModel">
                            <Grid>
                                <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="Menlo, Consolas, monospace"
                                         HorizontalContentAlignment="Stretch"
                                         VerticalContentAlignment="Stretch"
                                         IsVisible="{Binding Mode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Edit}"/>
                                <ScrollViewer IsVisible="{Binding Mode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Preview}">
                                    <lmd:MarkdownRenderer Margin="16" loc:MarkdownHelper.Text="{Binding Text}"/>
                                </ScrollViewer>
                                <TextBox Text="{Binding DiffText}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="Menlo, Consolas, monospace"
                                         IsVisible="{Binding Mode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Diff}"/>
                                <ScrollViewer IsVisible="{Binding Mode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Image}">
                                    <Image Source="{Binding Image}" Stretch="Uniform" Margin="12"/>
                                </ScrollViewer>
                            </Grid>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
                <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="11" Opacity="0.65" Margin="10,5" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="5" Background="Transparent" IsVisible="{Binding IsEditorVisible}" DragCompleted="OnEditorSplitterDragCompleted"/>

        <Border Grid.Column="{Binding IsEditorVisible, Converter={StaticResource EditorPaneGridConverter}, ConverterParameter=BrowserColumn}"
                Grid.ColumnSpan="{Binding IsEditorVisible, Converter={StaticResource EditorPaneGridConverter}, ConverterParameter=BrowserSpan}"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{DynamicResource SemiColorBackground0}">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid Margin="10,8" ColumnDefinitions="*,Auto,Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding WorkspaceName}" FontWeight="SemiBold"/>
                        <TextBlock Text="工作区文件" FontSize="11" Opacity="0.6"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="↻" Command="{Binding RefreshFilesCommand}" ToolTip.Tip="刷新"/>
                    <Button Grid.Column="2" Content="＋编辑区" Command="{Binding OpenFileCommand}" IsVisible="{Binding !IsEditorVisible}"/>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,0,8,6" Spacing="5">
                    <Button Content="复制路径" Command="{Binding CopyRelativePathCommand}" CommandParameter="{Binding SelectedFile}"/>
                    <Button Content="绝对路径" Command="{Binding CopyAbsolutePathCommand}" CommandParameter="{Binding SelectedFile}"/>
                    <Button Content="删除" Command="{Binding DeleteFileCommand}" CommandParameter="{Binding SelectedFile}"/>
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="8,0,8,6" IsVisible="{Binding IsRenameVisible}" Background="{DynamicResource SemiColorBackground0}">
                    <TextBox Text="{Binding RenameName}"/>
                    <Button Grid.Column="1" Content="重命名" Command="{Binding CommitRenameFileCommand}"/>
                </Grid>
                <TreeView Grid.Row="2"
                          ItemsSource="{Binding Files}"
                          SelectedItem="{Binding SelectedFile}"
                          DoubleTapped="OnFileDoubleTapped"
                          Margin="5">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:WorkspaceFileNodeViewModel">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                                <TextBlock.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuItem Header="打开"
                                                  Command="{Binding $parent[UserControl].DataContext.OpenFileCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="复制路径"
                                                  Command="{Binding $parent[UserControl].DataContext.CopyRelativePathCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="复制绝对路径"
                                                  Command="{Binding $parent[UserControl].DataContext.CopyAbsolutePathCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="重命名"
                                                  Command="{Binding $parent[UserControl].DataContext.BeginRenameFileCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="删除"
                                                  Command="{Binding $parent[UserControl].DataContext.DeleteFileCommand}"
                                                  CommandParameter="{Binding}"/>
                                    </MenuFlyout>
                                </TextBlock.ContextFlyout>
                            </TextBlock>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
