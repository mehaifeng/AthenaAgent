<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:services="using:Athena.UI.Services"
             xmlns:loc="using:Athena.UI.Markup"
             xmlns:lmd="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             x:Class="Athena.UI.Views.WorkspaceWorkbenchView"
             x:DataType="vm:WorkspaceWorkbenchViewModel">
    <UserControl.Styles>
        <Style Selector="Button.editor-command">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Caption}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.editor-command:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiGrey0}"/>
        </Style>
        <Style Selector="Button.editor-command:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiGrey1}"/>
        </Style>
        <Style Selector="ListBox.editor-tabs">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.editor-tabs ListBoxItem">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.editor-tab-close">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.review-command">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Caption}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.review-command:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiGrey0}"/>
        </Style>
        <Style Selector="ListBox.git-changes">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.git-changes ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="GridSplitter.layout-splitter">
            <Setter Property="Background" Value="{DynamicResource SemiColorBorder}"/>
        </Style>
        <Style Selector="GridSplitter.layout-splitter:pointerover">
            <Setter Property="Background" Value="{DynamicResource App.IconAccentForeground}"/>
        </Style>
        <Style Selector="GridSplitter.layout-splitter:pressed">
            <Setter Property="Background" Value="{DynamicResource App.IconAccentForeground}"/>
        </Style>
        <Style Selector="TextBox.workspace-rename-editor.rename-error">
            <Setter Property="BorderBrush" Value="{DynamicResource App.IconDangerForeground}"/>
        </Style>
    </UserControl.Styles>
    <Grid x:Name="WorkbenchGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="260"/>
            <ColumnDefinition Width="5" MinWidth="5"/>
            <ColumnDefinition Width="280" MinWidth="248"/>
            <ColumnDefinition Width="5" MinWidth="5"/>
            <ColumnDefinition Width="*" MinWidth="100"/>
        </Grid.ColumnDefinitions>

        <!-- 差异审查：按需展开，始终位于编辑器左侧。 -->
        <Border Grid.Column="0"
                MinWidth="260"
                IsVisible="{Binding IsReviewVisible}"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{DynamicResource SemiColorBackground0}">
            <Grid RowDefinitions="Auto,*,Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="10,8,8,5">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource AthenaIconBranch}" Width="14" Height="14"
                                  Foreground="{DynamicResource App.IconAccentForeground}"/>
                        <TextBlock Text="{loc:Loc Git.Review.Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border CornerRadius="8" Padding="6,1" Background="{DynamicResource SemiGrey1}">
                            <TextBlock Text="{Binding GitChangeCount}" FontSize="{DynamicResource App.FontSize.Caption}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="1"
                                HorizontalAlignment="Right">
                        <Button Classes="review-command"
                                Command="{Binding StageAllCommand}"
                                IsEnabled="{Binding !IsGitBusy}"
                                ToolTip.Tip="{loc:Loc Git.Review.StageAll}">
                            <PathIcon Data="{StaticResource SemiIconPlus}" Width="11" Height="11"/>
                        </Button>
                        <Button Classes="review-command"
                                Command="{Binding RestoreAllCommand}"
                                IsEnabled="{Binding !IsGitBusy}"
                                ToolTip.Tip="{loc:Loc Git.Review.RestoreAll}">
                            <PathIcon Data="{StaticResource AthenaIconCancel}" Width="11" Height="11"/>
                        </Button>
                        <Button Classes="review-command"
                                Command="{Binding RefreshWorkbenchCommand}"
                                IsEnabled="{Binding !IsGitBusy}"
                                ToolTip.Tip="{loc:Loc Git.Review.RefreshTree}">
                            <PathIcon Data="{StaticResource AthenaIconRefresh}" Width="11" Height="11"/>
                        </Button>
                        <Button Classes="review-command"
                                Command="{Binding CloseReviewCommand}"
                                ToolTip.Tip="{loc:Loc Git.Review.Close}">
                            <PathIcon Data="{StaticResource AthenaIconClose}" Width="11" Height="11"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <ListBox Grid.Row="1"
                         Classes="git-changes"
                         ItemsSource="{Binding GitChanges}"
                         SelectedItem="{Binding SelectedGitChange}"
                         Margin="5,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GitChangeFileViewModel">
                            <Border Padding="7,6"
                                    CornerRadius="5"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                                    Background="{DynamicResource SemiGrey0}">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="5">
                                    <Border Grid.RowSpan="2"
                                            Width="24"
                                            Height="24"
                                            CornerRadius="5"
                                            Background="{DynamicResource SemiGrey1}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusGlyph}"
                                                   FontFamily="Menlo, Consolas, monospace"
                                                   FontSize="{DynamicResource App.FontSize.Caption}"
                                                   FontWeight="Bold"
                                                   Width="24"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource App.IconAccentForeground}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding FileName}"
                                               FontSize="{DynamicResource App.FontSize.Body}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2" Grid.RowSpan="2"
                                            Classes="review-command"
                                            Command="{Binding $parent[UserControl].DataContext.StageFileCommand}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanStage}"
                                            ToolTip.Tip="{loc:Loc Git.Review.Stage}">
                                        <PathIcon Data="{StaticResource SemiIconPlus}" Width="11" Height="11"/>
                                    </Button>
                                    <Button Grid.Column="3" Grid.RowSpan="2"
                                            Classes="review-command"
                                            Command="{Binding $parent[UserControl].DataContext.RestoreFileCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{loc:Loc Git.Review.Restore}">
                                        <PathIcon Data="{StaticResource AthenaIconCancel}" Width="11" Height="11"/>
                                    </Button>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   FontSize="{DynamicResource App.FontSize.Caption}"
                                                   Foreground="{DynamicResource Chat.TimestampFg}"/>
                                        <TextBlock Text="{Binding DirectoryName}"
                                                   FontSize="{DynamicResource App.FontSize.Caption}"
                                                   Opacity="0.45"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2"
                           Text="{Binding GitStatusText}"
                           FontSize="{DynamicResource App.FontSize.Caption}"
                           Foreground="{DynamicResource Chat.TimestampFg}"
                           Margin="10,5,10,2"
                           TextWrapping="Wrap"
                           MaxHeight="38"/>

                <Border Grid.Row="3"
                        Margin="6"
                        Padding="6"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SemiGreyLowBrush}"
                        Background="{DynamicResource App.SectionBg}">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                        <TextBox Grid.Row="0"
                                 Grid.ColumnSpan="2"
                                 Text="{Binding CommitMessage}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="58"
                                 MaxHeight="100"
                                 Padding="5,4,30,4"
                                 PlaceholderText="{loc:Loc Git.Review.CommitPlaceholder}"/>
                        <Button Grid.Row="0"
                                Grid.Column="1"
                                Classes="review-command"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,3,3,0"
                                IsEnabled="False"
                                ToolTip.Tip="{loc:Loc Git.Review.GenerateSoon}">
                            <PathIcon Data="{StaticResource SemiIconStar}" Width="13" Height="13"
                                      Foreground="{DynamicResource App.IconAccentForeground}"/>
                        </Button>
                        <SplitButton Grid.Row="1"
                                     Grid.ColumnSpan="2"
                                     HorizontalAlignment="Stretch"
                                     HorizontalContentAlignment="Center"
                                     Margin="0,6,0,0"
                                     Command="{Binding CommitCommand}"
                                     Content="{loc:Loc Git.Review.Commit}">
                            <SplitButton.Flyout>
                                <MenuFlyout Placement="TopEdgeAlignedRight">
                                    <MenuItem Header="{loc:Loc Git.Review.CommitPush}"
                                              Command="{Binding CommitAndPushCommand}"/>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <GridSplitter x:Name="ReviewSplitter"
                      Classes="layout-splitter"
                      Grid.Column="1"
                      Width="5"
                      IsVisible="{Binding IsReviewVisible}"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="False"
                      DragStarted="OnReviewSplitterDragStarted"
                      DragDelta="OnReviewSplitterDragDelta"
                      DragCompleted="OnReviewSplitterDragCompleted"/>

        <Border Grid.Column="2"
                IsVisible="{Binding IsEditorVisible}"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{DynamicResource SemiColorBackground0}">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="6,5">
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
                        <Button Classes="editor-command" Command="{Binding SetEditorModeCommand}" CommandParameter="Edit"
                                IsVisible="{Binding SelectedEditorTab.CanEdit}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <PathIcon Data="{StaticResource AthenaIconEdit}" Width="10" Height="10" Foreground="{DynamicResource App.IconAccentForeground}"/>
                                <TextBlock Text="编辑"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="editor-command" Command="{Binding SetEditorModeCommand}" CommandParameter="Preview"
                                IsVisible="{Binding SelectedEditorTab.CanPreview}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <PathIcon Data="{StaticResource AthenaIconPreview}" Width="10" Height="10" Foreground="{DynamicResource App.IconAccentForeground}"/>
                                <TextBlock Text="预览"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="editor-command" Command="{Binding SetEditorModeCommand}" CommandParameter="Diff"
                                IsVisible="{Binding SelectedEditorTab.CanDiff}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <PathIcon Data="{StaticResource AthenaIconBranch}" Width="10" Height="10" Foreground="{DynamicResource App.IconAccentForeground}"/>
                                <TextBlock Text="Diff"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SaveEditorButton" Classes="editor-command"
                                Command="{Binding SaveFileCommand}" CommandParameter="{Binding SelectedEditorTab}"
                                IsVisible="{Binding SelectedEditorTab.CanModify}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <PathIcon Data="{StaticResource AthenaIconSave}" Width="10" Height="10" Foreground="{DynamicResource App.IconAccentForeground}"/>
                                <TextBlock Text="保存"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelEditorButton" Classes="editor-command"
                                Command="{Binding CancelFileEditsCommand}" CommandParameter="{Binding SelectedEditorTab}"
                                IsVisible="{Binding SelectedEditorTab.CanModify}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <PathIcon Data="{StaticResource AthenaIconCancel}" Width="10" Height="10" Foreground="{DynamicResource App.IconAccentForeground}"/>
                                <TextBlock Text="取消"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="editor-command" ToolTip.Tip="关闭编辑区" Command="{Binding CloseEditorPaneCommand}">
                        <PathIcon Data="{StaticResource AthenaIconClose}" Width="10" Height="10" Foreground="{DynamicResource App.IconAccentForeground}"/>
                    </Button>
                </Grid>
                <Grid Grid.Row="1" RowDefinitions="Auto,*">
                    <ListBox x:Name="EditorTabsList"
                             Grid.Row="0"
                             Height="33"
                             Classes="editor-tabs"
                             ItemsSource="{Binding EditorTabs}"
                             SelectedItem="{Binding SelectedEditorTab}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkspaceEditorTabViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"/>
                                <TextBlock Text="●" Foreground="{DynamicResource SemiOrange5}" IsVisible="{Binding IsDirty}"
                                           VerticalAlignment="Center"/>
                                <Button ToolTip.Tip="关闭文件"
                                        Classes="editor-tab-close"
                                        Command="{Binding $parent[UserControl].DataContext.CloseEditorTabCommand}"
                                        CommandParameter="{Binding}">
                                    <PathIcon Data="{StaticResource AthenaIconClose}" Width="8" Height="8" Foreground="{DynamicResource App.IconMutedForeground}"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ContentControl Grid.Row="1" Content="{Binding SelectedEditorTab}">
                        <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:WorkspaceEditorTabViewModel">
                            <Grid>
                                <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="Menlo, Consolas, monospace"
                                         HorizontalContentAlignment="Stretch"
                                         VerticalContentAlignment="Stretch"
                                         IsVisible="{Binding Mode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Edit}"/>
                                <ScrollViewer IsVisible="{Binding Mode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Preview}">
                                    <lmd:MarkdownRenderer Margin="16" loc:MarkdownHelper.Text="{Binding Text}"/>
                                </ScrollViewer>
                                <Grid IsVisible="{Binding Mode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Diff}"
                                      RowDefinitions="Auto,*">
                                    <Border Padding="8,5" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SemiGreyLowBrush}">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                            <TextBlock Text="HEAD  ↔  当前编辑缓冲区" FontSize="{DynamicResource App.FontSize.Body}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DiffAddedCount, StringFormat=+{0}}"
                                                       Foreground="{DynamicResource SemiGreen6}" FontSize="{DynamicResource App.FontSize.Body}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DiffRemovedCount, StringFormat=−{0}}"
                                                       Foreground="{DynamicResource SemiRed6}" FontSize="{DynamicResource App.FontSize.Body}"/>
                                        </Grid>
                                    </Border>
                                    <ListBox x:Name="DiffLinesList"
                                             Grid.Row="1"
                                             ItemsSource="{Binding DiffLines}"
                                             Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="MinHeight" Value="22"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="services:WorkspaceDiffLine">
                                                <Grid ColumnDefinitions="38,38,22,Auto" MinHeight="22">
                                                    <Border Grid.ColumnSpan="4" Background="#1F2DA44E" IsVisible="{Binding IsAdded}"/>
                                                    <Border Grid.ColumnSpan="4" Background="#1FF85149" IsVisible="{Binding IsRemoved}"/>
                                                    <Border Grid.Column="0" Background="#0D808080"/>
                                                    <Border Grid.Column="1" Background="#0D808080"/>
                                                    <TextBlock Grid.Column="0" Text="{Binding OldLineNumberText}" FontFamily="Menlo, Consolas, monospace"
                                                               FontSize="{DynamicResource App.FontSize.Caption}" Opacity="0.45" TextAlignment="Right" Padding="0,3,6,2"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding NewLineNumberText}" FontFamily="Menlo, Consolas, monospace"
                                                               FontSize="{DynamicResource App.FontSize.Caption}" Opacity="0.45" TextAlignment="Right" Padding="0,3,6,2"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Prefix}" FontFamily="Menlo, Consolas, monospace"
                                                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Text}" FontFamily="Menlo, Consolas, monospace"
                                                               FontSize="{DynamicResource App.FontSize.Body}" TextWrapping="NoWrap" Padding="4,3,8,2"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                                <ScrollViewer IsVisible="{Binding Mode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Image}">
                                    <Image Source="{Binding Image}" Stretch="Uniform" Margin="12"/>
                                </ScrollViewer>
                            </Grid>
                        </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>
                <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="{DynamicResource App.FontSize.Body}" Opacity="0.65" Margin="10,5" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <GridSplitter x:Name="EditorSplitter"
                      Classes="layout-splitter"
                      Grid.Column="3"
                      Width="5"
                      IsVisible="{Binding IsEditorVisible}"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="False"
                      DragStarted="OnEditorSplitterDragStarted"
                      DragDelta="OnEditorSplitterDragDelta"
                      DragCompleted="OnEditorSplitterDragCompleted"/>

        <Border Grid.Column="{Binding IsEditorVisible, Converter={StaticResource EditorPaneGridConverter}, ConverterParameter=BrowserColumn}"
                Grid.ColumnSpan="{Binding IsEditorVisible, Converter={StaticResource EditorPaneGridConverter}, ConverterParameter=BrowserSpan}"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{DynamicResource SemiColorBackground0}">
            <Grid RowDefinitions="Auto,*">
                <Grid Margin="10,8">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource AthenaIconOpenFile}" Width="15" Height="15" Foreground="{DynamicResource App.IconMutedForeground}"/>
                        <TextBlock Text="{Binding WorkspaceName}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
                <TreeView x:Name="WorkspaceFileTree"
                          Grid.Row="1"
                          ItemsSource="{Binding Files}"
                          SelectedItem="{Binding SelectedFile}"
                          DoubleTapped="OnFileDoubleTapped"
                          Margin="5">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="vm:WorkspaceFileNodeViewModel">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:WorkspaceFileNodeViewModel">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="6">
                                <PathIcon Classes="workspace-folder-icon"
                                          Data="{StaticResource SemiIconFolder}"
                                          IsVisible="{Binding IsFolderClosed}"
                                          Width="15"
                                          Height="15"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource App.IconMutedForeground}"/>
                                <PathIcon Classes="workspace-folder-open-icon"
                                          Data="{StaticResource SemiIconFolderOpen}"
                                          IsVisible="{Binding IsFolderOpen}"
                                          Width="15"
                                          Height="15"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource App.IconAccentForeground}"/>
                                <PathIcon Classes="workspace-file-icon"
                                          Data="{StaticResource SemiIconFile}"
                                          IsVisible="{Binding IsFile}"
                                          Width="15"
                                          Height="15"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource App.IconMutedForeground}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding !IsRenaming}"/>
                                <TextBox Grid.Column="1"
                                         Classes="workspace-rename-editor"
                                         Classes.rename-error="{Binding HasRenameError}"
                                         Text="{Binding RenameText, Mode=TwoWay}"
                                         MinHeight="24"
                                         Padding="4,1"
                                         VerticalContentAlignment="Center"
                                         IsVisible="{Binding IsRenaming}"
                                         IsEnabled="{Binding !IsRenamePending}"
                                         PropertyChanged="OnRenameTextBoxPropertyChanged"
                                         KeyDown="OnRenameTextBoxKeyDown"
                                         LostFocus="OnRenameTextBoxLostFocus"/>
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding RenameError}"
                                           IsVisible="{Binding HasRenameError}"
                                           Foreground="{DynamicResource App.IconDangerForeground}"
                                           FontSize="{DynamicResource App.FontSize.Caption}"
                                           TextWrapping="Wrap"
                                           Margin="3,1,0,2"/>
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuItem Header="打开"
                                                  Command="{Binding $parent[UserControl].DataContext.OpenFileCommand}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconOpenFile}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="复制路径"
                                                  Command="{Binding $parent[UserControl].DataContext.CopyRelativePathCommand}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconCopy}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="复制绝对路径"
                                                  Command="{Binding $parent[UserControl].DataContext.CopyAbsolutePathCommand}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconCopy}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="重命名"
                                                  Command="{Binding $parent[UserControl].DataContext.BeginRenameFileCommand}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconEdit}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="删除"
                                                  Command="{Binding $parent[UserControl].DataContext.DeleteFileCommand}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconDelete}" Foreground="{DynamicResource App.IconDangerForeground}"/></MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                            </Grid>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
