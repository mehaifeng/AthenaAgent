<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Athena.UI.Markup"
             mc:Ignorable="d"
             d:DesignWidth="720"
             d:DesignHeight="760"
             x:Class="Athena.UI.Views.AboutView"
             x:DataType="vm:AboutViewModel">

    <Design.DataContext>
        <vm:AboutViewModel/>
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Margin="28" Spacing="18" HorizontalAlignment="Stretch" MaxWidth="960">
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc About.Header}"
                           FontWeight="SemiBold"
                           FontSize="{DynamicResource App.FontSize.PageTitle}"/>
                <TextBlock Text="{loc:Loc About.Subtitle}"
                           TextWrapping="Wrap"
                           Opacity="0.62"/>
            </StackPanel>

            <Border Background="{DynamicResource App.SectionBg}"
                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    ClipToBounds="True">
                <Image Source="{DynamicResource About.LogoImage}"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"/>
            </Border>

            <Border Background="{DynamicResource App.SectionBg}"
                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18"
                    HorizontalAlignment="Stretch">
                <StackPanel Spacing="16">
                    <TextBlock Text="{loc:Loc About.Specs}"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource App.FontSize.Title}"/>

                    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Text="{loc:Loc About.KernelVer}" Opacity="0.6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentVersion}" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="1" Text="{loc:Loc About.Framework}" Opacity="0.6" Margin="0,12,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="Avalonia UI / Irihi.Ursa.Themes.Semi"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>

                        <TextBlock Grid.Row="2" Text="{loc:Loc About.License}" Opacity="0.6" Margin="0,12,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="MIT" Margin="0,12,0,0"/>

                        <TextBlock Grid.Row="3" Text="{loc:Loc About.Author}" Opacity="0.6" Margin="0,12,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="@mehaifeng" Margin="0,12,0,0"/>

                        <TextBlock Grid.Row="4" Text="{loc:Loc About.StartupTime}" Opacity="0.6" Margin="0,12,0,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding StartupDurationText}" Margin="0,12,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource App.AssistantBubbleBg}"
                    CornerRadius="8"
                    Padding="14">
                <TextBlock Text="{loc:Loc About.Quote}"
                           FontStyle="Italic"
                           FontSize="{DynamicResource App.FontSize.Subheading}"
                           HorizontalAlignment="Center"
                           Opacity="0.8"/>
            </Border>

            <WrapPanel HorizontalAlignment="Center">
                <Button Command="{Binding CheckForUpdatesCommand}"
                        IsEnabled="{Binding CanCheckForUpdates}"
                        Theme="{StaticResource AccentButtonTheme}"
                        Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Data="{StaticResource AthenaIconUpdate}"
                                  Width="16"
                                  Height="16"
                                  Classes.SlowSpin="{Binding IsCheckingUpdates}"/>
                        <TextBlock Text="{loc:Loc About.BtnChkUpdates}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenDocumentationCommand}"
                        Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Data="{StaticResource AthenaIconDocument}" Width="16" Height="16"/>
                        <TextBlock Text="{loc:Loc About.BtnViewDocs}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenGitHubCommand}"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Data="{StaticResource AthenaIconGithub}" Width="16" Height="16"/>
                        <TextBlock Text="{loc:Loc About.BtnSourceRepo}"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <Border Background="{DynamicResource App.SectionBg}"
                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    IsVisible="{Binding IsUpdateProgressVisible}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding UpdateProgressStatus}"
                               FontSize="{DynamicResource App.FontSize.Body}"
                               Opacity="0.8"
                               TextWrapping="Wrap"/>
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding UpdateProgressValue}"
                                 IsIndeterminate="{Binding IsUpdateProgressIndeterminate}"
                                 Height="6"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
