<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Athena.UI.ViewModels"
        xmlns:controls="using:Athena.UI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:Athena.UI.Markup"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="640"
        x:Class="Athena.UI.Views.CreateTaskDialog"
        x:DataType="vm:CreateTaskDialogViewModel"
        Title="{loc:Loc TaskDialog.Title}"
        Width="460" Height="680"
        MinWidth="420" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Design.DataContext>
        <vm:CreateTaskDialogViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,12">
            <TextBlock Text="{loc:Loc TaskDialog.Title}"
                       HorizontalAlignment="Center"
                       FontSize="{DynamicResource App.FontSize.Title}"
                       FontWeight="Bold"/>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="0,12" Spacing="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Loc TaskDialog.TriggerTime}"
                               FontWeight="Bold"
                               FontSize="{DynamicResource App.FontSize.Subheading}"/>

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{loc:Loc TaskDialog.Date}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,8"/>
                        <CalendarDatePicker Grid.Row="0" Grid.Column="1"
                                            SelectedDate="{Binding TriggerDate}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{loc:Loc TaskDialog.Time}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TimePicker Grid.Row="1" Grid.Column="1"
                                    SelectedTime="{Binding TriggerTime}"
                                    HorizontalAlignment="Stretch"/>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Loc TaskDialog.TaskIntent}"
                               FontWeight="Bold"
                               FontSize="{DynamicResource App.FontSize.Subheading}"/>

                    <TextBlock Text="{loc:Loc TaskDialog.IntentHint}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               FontSize="{DynamicResource App.FontSize.Body}"/>

                    <TextBox Text="{Binding Intent}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="80"
                             MaxHeight="120"
                             PlaceholderText="{loc:Loc TaskDialog.IntentPlaceholder}"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Loc TaskDialog.Recurrence}"
                               FontWeight="Bold"
                               FontSize="{DynamicResource App.FontSize.Subheading}"/>

                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0"
                                   Text="{loc:Loc TaskDialog.RepeatPreset}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding RecurrencePresetDisplayNames}"
                                  SelectedIndex="{Binding SelectedRecurrencePresetIndex}"
                                  HorizontalAlignment="Stretch"/>
                    </Grid>

                    <Border IsVisible="{Binding IsCustomRecurrenceVisible}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0"
                                           Text="{loc:Loc TaskDialog.CustomMode}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding CustomModeDisplayNames}"
                                          SelectedIndex="{Binding SelectedCustomModeIndex}"
                                          HorizontalAlignment="Stretch"/>
                            </Grid>

                            <StackPanel IsVisible="{Binding IsIntervalEditorVisible}" Spacing="8">
                                <TextBlock Text="{loc:Loc TaskDialog.IntervalEditor}"
                                           FontSize="{DynamicResource App.FontSize.Body}"
                                           FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="Auto,80,*" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0"
                                               Text="{loc:Loc TaskDialog.Every}"
                                               VerticalAlignment="Center"/>
                                    <controls:SafeNumericUpDown Grid.Column="1"
                                                                Minimum="1"
                                                                Value="{Binding CustomInterval}"
                                                                FormatString="N0"/>
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding IntervalUnitDisplayNames}"
                                              SelectedIndex="{Binding SelectedIntervalUnitIndex}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsWeeklyDaysEditorVisible}" Spacing="8">
                                <TextBlock Text="{loc:Loc TaskDialog.WeeklyDaysEditor}"
                                           FontSize="{DynamicResource App.FontSize.Body}"
                                           FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="Auto,80,*" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0"
                                               Text="{loc:Loc TaskDialog.EveryNWeeks}"
                                               VerticalAlignment="Center"/>
                                    <controls:SafeNumericUpDown Grid.Column="1"
                                                                Minimum="1"
                                                                Value="{Binding CustomInterval}"
                                                                FormatString="N0"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{loc:Loc TaskDialog.WeeksSuffix}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding WeekdaySelections}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemWidth="58" ItemHeight="32"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WeekdaySelectionItem">
                                            <ToggleButton Content="{Binding DisplayName}"
                                                          IsChecked="{Binding IsSelected}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock IsVisible="{Binding ShowMinuteSchedulingHint}"
                               Text="{Binding MinuteSchedulingHint}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               FontSize="{DynamicResource App.FontSize.Body}"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Loc TaskDialog.TaskType}"
                               FontWeight="Bold"
                               FontSize="{DynamicResource App.FontSize.Subheading}"/>

                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0"
                                   Text="{loc:Loc TaskDialog.Type}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding TaskTypeDisplayNames}"
                                  SelectedIndex="{Binding SelectedTaskTypeIndex}"
                                  HorizontalAlignment="Stretch"/>
                    </Grid>

                    <TextBlock Text="{Binding TaskTypeDescription}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               FontSize="{DynamicResource App.FontSize.Body}"/>
                </StackPanel>

                <Border IsVisible="{Binding HasValidationError}"
                        Background="#22C62828"
                        BorderBrush="#88C62828"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10">
                    <TextBlock Text="{Binding ValidationError}"
                               TextWrapping="Wrap"
                               Foreground="#C62828"
                               FontSize="{DynamicResource App.FontSize.Body}"/>
                </Border>

                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        Padding="12"
                        CornerRadius="4">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Loc TaskDialog.Preview}"
                                   FontWeight="Bold"
                                   FontSize="{DynamicResource App.FontSize.Body}"/>

                        <TextBlock FontSize="{DynamicResource App.FontSize.Body}" TextWrapping="Wrap">
                            <Run Text="{loc:Loc TaskDialog.PreviewRule}"/>
                            <Run Text="{Binding RecurrenceSummaryPreview}"/>
                        </TextBlock>

                        <TextBlock FontSize="{DynamicResource App.FontSize.Body}" TextWrapping="Wrap">
                            <Run Text="{loc:Loc TaskDialog.FirstActualTrigger}"/>
                            <Run Text="{Binding FirstTriggerPreview}"/>
                        </TextBlock>

                        <TextBlock Text="{Binding Intent}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource App.FontSize.Body}"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   MaxHeight="60"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12">
                <Button Command="{Binding CancelCommand}"
                        MinWidth="80"
                        Content="{loc:Loc TaskDialog.BtnCancel}"/>
                <Button Command="{Binding ConfirmCommand}"
                       Theme="{StaticResource AccentButtonTheme}"
                       MinWidth="80"
                       IsEnabled="{Binding Intent, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Content="{loc:Loc TaskDialog.BtnCreate}">
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
