<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Athena.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:Athena.UI.Markup"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="400"
        x:Class="Athena.UI.Views.CreateTaskDialog"
        x:DataType="vm:CreateTaskDialogViewModel"
        Title="{loc:Loc TaskDialog.Title}"
        Width="450" Height="450"
        MinWidth="400" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Design.DataContext>
        <vm:CreateTaskDialogViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" >
        <!-- Title Bar -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource Brush.BrightGreen}"
                BorderThickness="0,0,0,2"
                Padding="10,8"
                >
            <TextBlock Text="{loc:Loc TaskDialog.Title}"
                      HorizontalAlignment="Center"
                      FontSize="14"
                      FontWeight="Bold"
                      Foreground="{DynamicResource Brush.Yellow}"/>
        </Border>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" Padding="15">
            <StackPanel Spacing="15">
                <!-- Trigger Time -->
                <Border BorderBrush="{DynamicResource Brush.BrightGreen}"
                       BorderThickness="2"
                       Padding="10">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Loc TaskDialog.TriggerTime}"
                                  FontWeight="Bold"
                                  Foreground="{DynamicResource Brush.Yellow}"
                                  FontSize="12"/>

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                      Text="{loc:Loc TaskDialog.Date}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,5"/>
                            <CalendarDatePicker Grid.Row="0" Grid.Column="1"
                                               SelectedDate="{Binding TriggerDate}"
                                               HorizontalAlignment="Stretch"
                                               Margin="0,0,0,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                      Text="{loc:Loc TaskDialog.Time}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,5"/>
                            <TimePicker Grid.Row="1" Grid.Column="1"
                                       SelectedTime="{Binding TriggerTime}"
                                       HorizontalAlignment="Stretch"
                                       Margin="0,0,0,5"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Task Intent -->
                <Border BorderBrush="{DynamicResource Brush.BrightGreen}"
                       BorderThickness="2"
                       Padding="10">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Loc TaskDialog.TaskIntent}"
                                  FontWeight="Bold"
                                  Foreground="{DynamicResource Brush.Yellow}"
                                  FontSize="12"/>

                        <TextBlock Text="{loc:Loc TaskDialog.IntentHint}"
                                  TextWrapping="Wrap"
                                  Foreground="{DynamicResource Brush.Green}"
                                  FontSize="11"/>

                        <TextBox Text="{Binding Intent}"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="80"
                                MaxHeight="120"
                                Watermark="{loc:Loc TaskDialog.IntentPlaceholder}"/>
                    </StackPanel>
                </Border>

                <!-- Recurrence -->
                <Border BorderBrush="{DynamicResource Brush.BrightGreen}"
                       BorderThickness="2"
                       Padding="10">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Loc TaskDialog.Recurrence}"
                                  FontWeight="Bold"
                                  Foreground="{DynamicResource Brush.Yellow}"
                                  FontSize="12"/>

                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0"
                                      Text="{loc:Loc TaskDialog.Repeat}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1"
                                     ItemsSource="{Binding RecurrenceDisplayNames}"
                                     SelectedIndex="{Binding SelectedRecurrenceIndex}"
                                     HorizontalAlignment="Stretch"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Preview -->
                <Border BorderBrush="{DynamicResource Brush.Green}"
                       BorderThickness="1"
                       Padding="10"
                       
                       Margin="0,0,0,70">
                    <StackPanel Spacing="5">
                        <TextBlock Text="{loc:Loc TaskDialog.Preview}"
                                  FontWeight="Bold"
                                  Foreground="{DynamicResource Brush.Green}"
                                  FontSize="11"/>

                        <TextBlock FontSize="11" TextWrapping="Wrap">
                            <Run Text="{loc:Loc TaskDialog.PreviewWill}"/>
                            <Run Text="{Binding Recurrence, Mode=OneWay}"/>
                            <Run Text="{loc:Loc TaskDialog.PreviewTriggerAt}"/>
                            <Run Text="{Binding FullTriggerTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}', Mode=OneWay}"/>
                        </TextBlock>

                        <TextBlock Text="{Binding Intent, Mode=OneWay}"
                                  TextWrapping="Wrap"
                                  FontSize="11"
                                  FontStyle="Italic"
                                  Foreground="{DynamicResource Brush.Green}"
                                  MaxHeight="60"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2"
               BorderBrush="{DynamicResource Brush.BrightGreen}"
               BorderThickness="0,2,0,0"
               Padding="10"
               >
            <StackPanel Orientation="Horizontal"
                       HorizontalAlignment="Right"
                       Spacing="10">
                <Button Content="{loc:Loc TaskDialog.BtnCancel}"
                       Command="{Binding CancelCommand}"
                       MinWidth="80"/>
                <Button Content="{loc:Loc TaskDialog.BtnCreate}"
                       Command="{Binding ConfirmCommand}"
                       Classes="primary"
                       MinWidth="80"
                       IsEnabled="{Binding Intent, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
