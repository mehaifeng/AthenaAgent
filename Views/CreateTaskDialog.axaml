<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Athena.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:Athena.UI.Markup"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="400"
        x:Class="Athena.UI.Views.CreateTaskDialog"
        x:DataType="vm:CreateTaskDialogViewModel"
        Title="{loc:Loc TaskDialog.Title}"
        Width="450" Height="520"
        MinWidth="400" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Design.DataContext>
        <vm:CreateTaskDialogViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <!-- 标题栏 -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,12"
                >
            <TextBlock Text="{loc:Loc TaskDialog.Title}"
                      HorizontalAlignment="Center"
                      FontSize="16"
                      FontWeight="Bold"/>
        </Border>

        <!-- 表单内容 -->
        <ScrollViewer Grid.Row="1" Padding="0,12">
            <StackPanel Spacing="16">
                <!-- 触发时间 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Loc TaskDialog.TriggerTime}"
                              FontWeight="Bold"
                              FontSize="13"/>

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                  Text="{loc:Loc TaskDialog.Date}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,8"/>
                        <CalendarDatePicker Grid.Row="0" Grid.Column="1"
                                           SelectedDate="{Binding TriggerDate}"
                                           HorizontalAlignment="Stretch"
                                           Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                  Text="{loc:Loc TaskDialog.Time}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,8"/>
                        <TimePicker Grid.Row="1" Grid.Column="1"
                                   SelectedTime="{Binding TriggerTime}"
                                   HorizontalAlignment="Stretch"
                                   Margin="0,0,0,8"/>
                    </Grid>
                </StackPanel>

                <!-- 任务意图 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Loc TaskDialog.TaskIntent}"
                              FontWeight="Bold"
                              FontSize="13"/>

                    <TextBlock Text="{loc:Loc TaskDialog.IntentHint}"
                              TextWrapping="Wrap"
                              Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                              FontSize="12"/>

                    <TextBox Text="{Binding Intent}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="80"
                            MaxHeight="120"
                            Watermark="{loc:Loc TaskDialog.IntentPlaceholder}"/>
                </StackPanel>

                <!-- 循环 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Loc TaskDialog.Recurrence}"
                              FontWeight="Bold"
                              FontSize="13"/>

                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0"
                                  Text="{loc:Loc TaskDialog.Repeat}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1"
                                 ItemsSource="{Binding RecurrenceDisplayNames}"
                                 SelectedIndex="{Binding SelectedRecurrenceIndex}"
                                 HorizontalAlignment="Stretch"/>
                    </Grid>
                </StackPanel>

                <!-- 任务类型 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Loc TaskDialog.TaskType}"
                              FontWeight="Bold"
                              FontSize="13"/>

                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0"
                                  Text="{loc:Loc TaskDialog.Type}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1"
                                 ItemsSource="{Binding TaskTypeDisplayNames}"
                                 SelectedIndex="{Binding SelectedTaskTypeIndex}"
                                 HorizontalAlignment="Stretch"/>
                    </Grid>

                    <TextBlock Text="{Binding TaskTypeDescription}"
                              TextWrapping="Wrap"
                              Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                              FontSize="12"/>
                </StackPanel>

                <!-- 预览 -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                       BorderThickness="1"
                       Padding="12"
                       CornerRadius="4">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Loc TaskDialog.Preview}"
                                  FontWeight="Bold"
                                  FontSize="12"/>

                        <TextBlock FontSize="12" TextWrapping="Wrap">
                            <Run Text="{loc:Loc TaskDialog.PreviewWill}"/>
                            <Run Text="{Binding Recurrence, Mode=OneWay}"/>
                            <Run Text="{loc:Loc TaskDialog.PreviewTriggerAt}"/>
                            <Run Text="{Binding FullTriggerTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}', Mode=OneWay}"/>
                        </TextBlock>

                        <TextBlock Text="{Binding Intent, Mode=OneWay}"
                                  TextWrapping="Wrap"
                                  FontSize="12"
                                  FontStyle="Italic"
                                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                  MaxHeight="60"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2"
               BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
               BorderThickness="0,1,0,0"
               Padding="0,12,0,0"
               >
            <StackPanel Orientation="Horizontal"
                       HorizontalAlignment="Right"
                       Spacing="12">
                <Button Command="{Binding CancelCommand}"
                       MinWidth="80"
                       Content="{loc:Loc TaskDialog.BtnCancel}">
                </Button>
                <Button Command="{Binding ConfirmCommand}"
                       Classes="accent"
                       MinWidth="80"
                       IsEnabled="{Binding Intent, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Content="{loc:Loc TaskDialog.BtnCreate}">
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
