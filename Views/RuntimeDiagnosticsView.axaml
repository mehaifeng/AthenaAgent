<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:loc="using:Athena.UI.Markup"
             xmlns:u="https://irihi.tech/ursa"
             x:Class="Athena.UI.Views.RuntimeDiagnosticsView"
             x:DataType="vm:RuntimeDiagnosticsViewModel">
    <ScrollViewer>
        <StackPanel Margin="28" MaxWidth="960" HorizontalAlignment="Stretch" Spacing="18">
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc Settings.Diagnostics.Title}"
                           FontSize="{DynamicResource App.FontSize.PageTitle}"
                           FontWeight="SemiBold"/>
                <TextBlock Foreground="{DynamicResource App.TextMuted}" Text="{loc:Loc Settings.Diagnostics.Description}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Padding="18"
                    Background="{DynamicResource App.SectionBg}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                    CornerRadius="10">
                <StackPanel Spacing="14">
                    <TextBlock Text="{loc:Loc Settings.Diagnostics.ContextData}"
                               FontSize="{DynamicResource App.FontSize.Title}"
                               FontWeight="SemiBold"/>
                    <TextBlock Foreground="{DynamicResource App.TextMuted}" Text="{loc:Loc Settings.Diagnostics.ContextDataHint}"
                               TextWrapping="Wrap"/>
                    <Grid RowDefinitions="Auto" ColumnDefinitions="150,*" RowSpacing="8" ColumnSpacing="10">
                        <TextBlock Text="{loc:Loc Settings.Diagnostics.MetadataCatalog}" FontWeight="SemiBold"/>
                        <SelectableTextBlock Grid.Column="1" Text="{Binding MetadataDiagnosticsStatus}" TextWrapping="Wrap"/>
                    </Grid>
                    <WrapPanel>
                        <u:IconButton x:Name="RefreshContextDiagnosticsButton"
                                      Content="{loc:Loc Settings.Diagnostics.RefreshContextData}"
                                      Command="{Binding RefreshContextDiagnosticsCommand}"
                                      Margin="0,0,8,8"
                                      AutomationProperties.Name="{loc:Loc Settings.Diagnostics.RefreshContextData}"/>
                        <u:IconButton x:Name="ClearMetadataCacheButton"
                                      Content="{loc:Loc Settings.Diagnostics.ClearMetadataCache}"
                                      Command="{Binding ClearMetadataCacheCommand}"
                                      IsLoading="{Binding IsMaintainingContextData}"
                                      Margin="0,0,8,8"
                                      AutomationProperties.Name="{loc:Loc Settings.Diagnostics.ClearMetadataCache}"/>
                    </WrapPanel>
                    <Border Padding="12"
                            Background="{DynamicResource App.AssistantBubbleBg}"
                            CornerRadius="8"
                            IsVisible="{Binding HasContextMaintenanceStatus}">
                        <TextBlock Text="{Binding ContextMaintenanceStatus}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Padding="18"
                    Background="{DynamicResource App.SectionBg}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                    CornerRadius="10">
                <StackPanel Spacing="14">
                    <TextBlock Text="{loc:Loc Settings.Diagnostics.BrowserRuntime}"
                               FontSize="{DynamicResource App.FontSize.Title}"
                               FontWeight="SemiBold"/>
                    <TextBlock Foreground="{DynamicResource App.TextMuted}" Text="{loc:Loc Settings.Diagnostics.BrowserRuntimeHint}"
                               TextWrapping="Wrap"/>
                    <WrapPanel>
                        <u:IconButton x:Name="TestBrowserRuntimeButton"
                                      Content="{loc:Loc Config.BrowserTestRuntime}"
                                      Command="{Binding TestBrowserRuntimeCommand}"
                                      IsLoading="{Binding IsTestingBrowserRuntime}"
                                      Margin="0,0,8,0"/>
                        <u:IconButton x:Name="InstallBrowserRuntimeButton"
                                      Content="{loc:Loc Config.BrowserInstallRuntime}"
                                      Command="{Binding InstallBrowserRuntimeCommand}"
                                      IsLoading="{Binding IsInstallingBrowserRuntime}"/>
                    </WrapPanel>
                    <Border Padding="12"
                            Background="{DynamicResource App.AssistantBubbleBg}"
                            CornerRadius="8"
                            IsVisible="{Binding HasBrowserRuntimeStatus}">
                        <TextBlock Foreground="{DynamicResource App.TextMuted}" Text="{Binding BrowserRuntimeStatus}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Padding="18"
                    Background="{DynamicResource App.SectionBg}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                    CornerRadius="10">
                <StackPanel Spacing="14">
                    <TextBlock Text="{loc:Loc Settings.Diagnostics.BrowserAgent}"
                               FontSize="{DynamicResource App.FontSize.Title}"
                               FontWeight="SemiBold"/>
                    <TextBlock Foreground="{DynamicResource App.TextMuted}" Text="{loc:Loc Config.BrowserUnifiedModelHint}"
                               TextWrapping="Wrap"/>
                    <u:IconButton x:Name="TestBrowserAgentButton"
                                  Content="{loc:Loc Config.BtnRunDiagnostics}"
                                  Command="{Binding TestBrowserAgentCommand}"
                                  IsLoading="{Binding IsTestingBrowserAgent}"
                                  HorizontalAlignment="Left"/>
                    <Border Padding="12"
                            Background="{DynamicResource App.AssistantBubbleBg}"
                            CornerRadius="8"
                            IsVisible="{Binding HasBrowserAgentTestStatus}">
                        <TextBlock Foreground="{DynamicResource App.TextMuted}" Text="{Binding BrowserAgentTestStatus}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
