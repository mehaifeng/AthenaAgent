<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:views="using:Athena.UI.Views"
             xmlns:controls="using:Athena.UI.Controls"
             xmlns:loc="using:Athena.UI.Markup"
             x:Class="Athena.UI.Views.GeneralSettingsView"
             x:DataType="vm:GeneralSettingsViewModel">
    <UserControl.Styles>
        <!-- 配色方案缩略图画廊：透明 ListBoxItem 外壳，选中/悬停态画在缩略图卡片边框上 -->
        <Style Selector="ListBox.color-schemes">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox.color-schemes > ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.color-schemes > ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.color-schemes > ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.color-schemes > ListBoxItem:pointerover Border.thumb-card">
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="ListBox.color-schemes > ListBoxItem:selected Border.thumb-card">
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.pet-choice">
            <Setter Property="Padding" Value="9"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Width" Value="214"/>
            <Setter Property="Height" Value="82"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource App.SectionBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGreyLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.pet-choice:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}"/>
        </Style>
        <Style Selector="Button.pet-choice.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </UserControl.Styles>
    <ScrollViewer>
        <StackPanel Margin="28" MaxWidth="960" HorizontalAlignment="Stretch" Spacing="18">
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc Settings.General.Title}"
                           FontSize="{DynamicResource App.FontSize.PageTitle}"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Loc Settings.General.Description}"
                           TextWrapping="Wrap"
                           Opacity="0.62"/>
            </StackPanel>

            <Border Padding="18"
                    Background="{DynamicResource App.SectionBg}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                    CornerRadius="10">
                <StackPanel Spacing="16">
                    <TextBlock Text="{loc:Loc Settings.General.Appearance}"
                               FontSize="{DynamicResource App.FontSize.Title}"
                               FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="180,260,*">
                        <TextBlock Text="{loc:Loc Settings.General.Theme}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Width="100" SelectedItem="{Binding State.Config.Theme}">
                            <x:String>Dark</x:String>
                            <x:String>Light</x:String>
                        </ComboBox>
                    </Grid>
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Loc Settings.General.ColorScheme}" VerticalAlignment="Center"/>
                        <ListBox Classes="color-schemes"
                                 ItemsSource="{Binding ColorSchemes}"
                                 SelectedItem="{Binding State.Config.ColorScheme}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" HorizontalAlignment="Stretch"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <views:ColorSchemeThumbnailView SchemeName="{Binding}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                    <Grid ColumnDefinitions="180,260,*">
                        <TextBlock Text="{loc:Loc Settings.General.Language}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Width="100"  SelectedItem="{Binding State.Config.Language}">
                            <x:String>zh-CN</x:String>
                            <x:String>en-US</x:String>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="180,260,*">
                        <TextBlock Text="{loc:Loc Settings.General.FontScale}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FontScaleComboBox" Grid.Column="1" Width="100"
                                  SelectedIndex="{Binding FontScaleIndex}">
                            <ComboBoxItem Content="{loc:Loc Settings.General.FontScale.Minimum}"/>
                            <ComboBoxItem Content="{loc:Loc Settings.General.FontScale.Small}"/>
                            <ComboBoxItem Content="{loc:Loc Settings.General.FontScale.Medium}"/>
                            <ComboBoxItem Content="{loc:Loc Settings.General.FontScale.Large}"/>
                            <ComboBoxItem Content="{loc:Loc Settings.General.FontScale.Maximum}"/>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="180,260,*">
                        <TextBlock Text="{loc:Loc Settings.General.PanelOpacity}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Slider Minimum="0" Maximum="0.8"
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="False"
                                    Width="200"
                                    Value="{Binding State.Config.MainLayout.PanelTransparency}"/>
                            <TextBlock VerticalAlignment="Center" MinWidth="40"
                                       Text="{Binding State.Config.MainLayout.PanelTransparency, StringFormat={}{0:P0}}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{loc:Loc Settings.General.PanelOpacity.Description}"
                               TextWrapping="Wrap"
                               Opacity="0.58"/>
                </StackPanel>
            </Border>

            <Border Padding="18"
                    Background="{DynamicResource App.SectionBg}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                    CornerRadius="10">
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:Loc Settings.General.Interaction}"
                               FontSize="{DynamicResource App.FontSize.Title}"
                               FontWeight="SemiBold"/>
                    <CheckBox Content="{loc:Loc Config.SkipRewindConfirm}"
                              IsChecked="{Binding State.Config.SkipRewindConfirm}"/>
                    <TextBlock Text="{loc:Loc Settings.General.RewindHint}"
                               Margin="26,0,0,0"
                               TextWrapping="Wrap"
                               Opacity="0.58"/>
                    <CheckBox x:Name="AutoExpandReasoningCheckBox"
                              Content="{loc:Loc Settings.General.AutoExpandReasoning}"
                              IsChecked="{Binding State.Config.AutoExpandReasoning}"/>
                    <TextBlock Text="{loc:Loc Settings.General.AutoExpandReasoningHint}"
                               Margin="26,0,0,0"
                               TextWrapping="Wrap"
                               Opacity="0.58"/>
                    <CheckBox x:Name="VirtualPetEnabledCheckBox"
                              Content="{loc:Loc Settings.General.VirtualPet}"
                              IsChecked="{Binding State.Config.VirtualPetEnabled}"/>
                    <TextBlock Text="{loc:Loc Settings.General.VirtualPetHint}"
                               Margin="26,0,0,0"
                               TextWrapping="Wrap"
                               Opacity="0.58"/>
                    <StackPanel Margin="26,0,0,0" Spacing="8">
                        <TextBlock Text="{loc:Loc Settings.General.VirtualPetChoice}"/>
                        <TextBox x:Name="VirtualPetSearchBox"
                                 PlaceholderText="{loc:Loc Settings.General.VirtualPetSearchPlaceholder}"
                                 Text="{Binding PetSearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                        <Border Height="286"
                                Padding="3"
                                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding PetResults}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PetDexCatalogItemViewModel">
                                            <Button Classes="pet-choice"
                                                    Classes.selected="{Binding IsSelected}"
                                                    Command="{Binding UseCommand}">
                                                <Grid ColumnDefinitions="64,*">
                                                    <Grid Width="58" Height="63"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center">
                                                        <controls:PetDexSprite PetSlug="{Binding Slug}"
                                                                               AnimationState="Idle"
                                                                               FrameIndex="0"
                                                                               Width="58" Height="63"
                                                                               IsVisible="{Binding IsInstalled}"/>
                                                        <Image Source="{Binding Thumbnail}"
                                                               Width="58" Height="63"
                                                               Stretch="Uniform"
                                                               IsVisible="{Binding HasThumbnail}"/>
                                                        <Border HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom"
                                                                Width="20" Height="20"
                                                                CornerRadius="10"
                                                                Background="{DynamicResource App.SectionBg}"
                                                                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                                                                BorderThickness="1"
                                                                IsVisible="{Binding IsRemoteOnly}">
                                                            <TextBlock Text="↓" FontSize="12"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Spacing="3">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Attribution}"
                                                                   FontSize="11"
                                                                   Opacity="0.58"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{loc:Loc Settings.General.VirtualPetInstalling}"
                                                                   FontSize="11"
                                                                   Opacity="0.72"
                                                                   IsVisible="{Binding IsBusy}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <TextBlock Text="{Binding PetCatalogStatusText}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Opacity="0.58"/>
                    </StackPanel>
                    <Grid Margin="26,0,0,0" ColumnDefinitions="154,260,*"
                          IsEnabled="{Binding State.Config.VirtualPetEnabled}">
                        <TextBlock Text="{loc:Loc Settings.General.VirtualPetScale}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Slider x:Name="VirtualPetScaleSlider"
                                    Minimum="0.25" Maximum="1"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    Width="180"
                                    Value="{Binding State.Config.VirtualPetScale}"/>
                            <TextBlock MinWidth="40"
                                       VerticalAlignment="Center"
                                       Text="{Binding State.Config.VirtualPetScale, StringFormat={}{0:P0}}"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="VirtualPetRoamingEnabledCheckBox"
                              Content="{loc:Loc Settings.General.VirtualPetRoaming}"
                              IsEnabled="{Binding State.Config.VirtualPetEnabled}"
                              IsChecked="{Binding State.Config.VirtualPetRoamingEnabled}"/>
                    <TextBlock Text="{loc:Loc Settings.General.VirtualPetRoamingHint}"
                               Margin="26,0,0,0"
                               TextWrapping="Wrap"
                               Opacity="0.58"/>
                    <Grid Margin="26,0,0,0" ColumnDefinitions="154,260,*"
                          IsEnabled="{Binding State.Config.VirtualPetEnabled}">
                        <TextBlock Text="{loc:Loc Settings.General.VirtualPetRoamArea}"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="VirtualPetRoamAreaComboBox"
                                  Grid.Column="1"
                                  SelectedIndex="{Binding PetRoamAreaIndex}">
                            <ComboBoxItem Content="{loc:Loc Settings.General.VirtualPetRoamArea.LowerHalf}"/>
                            <ComboBoxItem Content="{loc:Loc Settings.General.VirtualPetRoamArea.LogTerminalBottom}"/>
                            <ComboBoxItem Content="{loc:Loc Settings.General.VirtualPetRoamArea.SessionListBottom}"/>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="VirtualPetGravityEnabledCheckBox"
                              Content="{loc:Loc Settings.General.VirtualPetGravity}"
                              IsEnabled="{Binding State.Config.VirtualPetEnabled}"
                              IsChecked="{Binding State.Config.VirtualPetGravityEnabled}"/>
                    <TextBlock Text="{loc:Loc Settings.General.VirtualPetGravityHint}"
                               Margin="26,0,0,0"
                               TextWrapping="Wrap"
                               Opacity="0.58"/>
                    <CheckBox x:Name="VirtualPetReducedMotionCheckBox"
                              Content="{loc:Loc Settings.General.VirtualPetReducedMotion}"
                              IsEnabled="{Binding State.Config.VirtualPetEnabled}"
                              IsChecked="{Binding State.Config.VirtualPetReducedMotion}"/>
                    <CheckBox x:Name="VirtualPetInteractionEnabledCheckBox"
                              Content="{loc:Loc Settings.General.VirtualPetInteraction}"
                              IsEnabled="{Binding State.Config.VirtualPetEnabled}"
                              IsChecked="{Binding State.Config.VirtualPetInteractionEnabled}"/>
                    <TextBlock Text="{loc:Loc Settings.General.VirtualPetInteractionHint}"
                               Margin="26,0,0,0"
                               TextWrapping="Wrap"
                               Opacity="0.58"/>
                    <CheckBox x:Name="VirtualPetChatterEnabledCheckBox"
                              Content="{loc:Loc Settings.General.VirtualPetChatter}"
                              IsEnabled="{Binding State.Config.VirtualPetInteractionEnabled}"
                              IsChecked="{Binding State.Config.VirtualPetChatterEnabled}"/>
                    <TextBlock Text="{loc:Loc Settings.General.VirtualPetChatterHint}"
                               Margin="26,0,0,0"
                               TextWrapping="Wrap"
                               Opacity="0.58"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
