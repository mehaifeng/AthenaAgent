<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:loc="using:Athena.UI.Markup"
             x:Class="Athena.UI.Views.OwlVillageView"
             x:DataType="vm:ChatTabViewModel"
             Width="560">

    <UserControl.Styles>
        <!-- 运行中的猫头鹰轻微"呼吸"；归巢/出错后静止。 -->
        <Style Selector="Panel.owl">
            <Setter Property="RenderTransform">
                <ScaleTransform/>
            </Setter>
        </Style>
        <Style Selector="Panel.owl.running">
            <Style.Animations>
                <Animation Duration="0:0:2.6" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.08"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.08"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- 整批结束的谢幕：淡出并缩小，播完由编排器移除。 -->
        <Style Selector="Panel.owl.vanishing">
            <Style.Animations>
                <Animation Duration="0:0:0.45" IterationCount="1" FillMode="Forward" Easing="CubicEaseIn">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1.0"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="0.25"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.25"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="14">
        <!-- 标题栏 -->
        <TextBlock Grid.Row="0" Text="{loc:Loc SubAgent.Village.Title}" FontSize="{DynamicResource App.FontSize.Title}" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="0,0,0,12"/>

        <!-- 小镇画布：场所背景 + 猫头鹰图层。整体用 LayoutTransform 等比缩小，
             猫头鹰图层与场所格同属该 Grid，会一并缩小，无需改动 VM 里的定位坐标。 -->
        <LayoutTransformControl Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,12">
            <LayoutTransformControl.LayoutTransform>
                <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
            </LayoutTransformControl.LayoutTransform>
        <Grid Width="636" Height="522">
            <Canvas Width="636" Height="522">
                <!-- 2×3 网格。上排：Archeion(文件) | Ourania(电脑) -->
                <Border Canvas.Left="12" Canvas.Top="12" Width="300" Height="158" CornerRadius="8" ClipToBounds="True">
                    <Border.Background>
                        <ImageBrush Source="/Assets/FileArea.webp" Stretch="UniformToFill"/>
                    </Border.Background>
                    <Border Background="#66FFFFFF" CornerRadius="6" Padding="6,2" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock Text="{loc:Loc SubAgent.Zone.Files}" FontSize="{DynamicResource App.FontSize.Body}" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                    </Border>
                </Border>
                <Border Canvas.Left="336" Canvas.Top="12" Width="300" Height="158" CornerRadius="8" ClipToBounds="True">
                    <Border.Background>
                        <ImageBrush Source="/Assets/ComputerArea.webp" Stretch="UniformToFill"/>
                    </Border.Background>
                    <Border Background="#66FFFFFF" CornerRadius="6" Padding="6,2" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock Text="{loc:Loc SubAgent.Zone.Web}" FontSize="{DynamicResource App.FontSize.Body}" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                    </Border>
                </Border>
                <!-- 中排：Hesychia(冥想，家) | Mnemosyne(书房) -->
                <Border Canvas.Left="12" Canvas.Top="182" Width="300" Height="158" CornerRadius="8" ClipToBounds="True">
                    <Border.Background>
                        <ImageBrush Source="/Assets/MeditationArea.webp" Stretch="UniformToFill"/>
                    </Border.Background>
                    <Border Background="#66FFFFFF" CornerRadius="6" Padding="6,2" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock Text="{loc:Loc SubAgent.Zone.Meditation}" FontSize="{DynamicResource App.FontSize.Body}" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                    </Border>
                </Border>
                <Border Canvas.Left="336" Canvas.Top="182" Width="300" Height="158" CornerRadius="8" ClipToBounds="True">
                    <Border.Background>
                        <ImageBrush Source="/Assets/StudyArea.webp" Stretch="UniformToFill"/>
                    </Border.Background>
                    <Border Background="#66FFFFFF" CornerRadius="6" Padding="6,2" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock Text="{loc:Loc SubAgent.Zone.Library}" FontSize="{DynamicResource App.FontSize.Body}" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                    </Border>
                </Border>
                <!-- 下排：Hephaistos(工坊) | Nostos(归巢) -->
                <Border Canvas.Left="12" Canvas.Top="352" Width="300" Height="158" CornerRadius="8" ClipToBounds="True">
                    <Border.Background>
                        <ImageBrush Source="/Assets/WorkshopArea.webp" Stretch="UniformToFill"/>
                    </Border.Background>
                    <Border Background="#66FFFFFF" CornerRadius="6" Padding="6,2" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock Text="{loc:Loc SubAgent.Zone.Workshop}" FontSize="{DynamicResource App.FontSize.Body}" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                    </Border>
                </Border>
                <Border Canvas.Left="336" Canvas.Top="352" Width="300" Height="158" CornerRadius="8" ClipToBounds="True">
                    <Border.Background>
                        <ImageBrush Source="/Assets/NestingArea.webp" Stretch="UniformToFill"/>
                    </Border.Background>
                    <Border Background="#66FFFFFF" CornerRadius="6" Padding="6,2" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock Text="{loc:Loc SubAgent.Zone.Perch}" FontSize="{DynamicResource App.FontSize.Body}" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                    </Border>
                </Border>
            </Canvas>

            <!-- 猫头鹰图层 -->
            <ItemsControl ItemsSource="{Binding Orchestrator.ActiveAgents}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Width="636" Height="522"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SubAgentViewModel">
                        <!-- 外层：定位（Zone / 漂移变化 → 变换变化 → 过渡产生滑翔与游荡）。 -->
                        <Panel Width="80" Height="80"
                               RenderTransform="{Binding OwlTransform, Converter={StaticResource StringToTransformConverter}}">
                            <Panel.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.7" Easing="CubicEaseInOut"/>
                                </Transitions>
                            </Panel.Transitions>
                            <!-- 内层：呼吸缩放（运行中）/ 谢幕淡出。状态以头部短文案表达，
                                 成功后隐藏，保持角色翅膀和足部完整可见。 -->
                            <Panel Width="80" Height="80"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ToolTip.Tip>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CurrentAction}" Opacity="0.8"/>
                                    </StackPanel>
                                </ToolTip.Tip>
                                <Panel Classes="owl" Width="80" Height="80"
                                       Classes.running="{Binding IsRunning}"
                                       Classes.vanishing="{Binding IsVanishing}"
                                       RenderTransformOrigin="50%,50%">
                                    <Image Source="{Binding OwlFrame}" Width="{Binding OwlSpriteSize}" Height="{Binding OwlSpriteSize}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Stretch="Uniform" RenderTransformOrigin="50%,50%">
                                        <Image.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding OwlSpriteScaleX}"/>
                                        </Image.RenderTransform>
                                    </Image>
                                </Panel>
                                <Border IsVisible="{Binding HasStatusLabel}"
                                        HorizontalAlignment="Center" VerticalAlignment="Top"
                                        Margin="0,-3,0,0" Padding="3,1" CornerRadius="5"
                                        BorderThickness="1" BorderBrush="#33000000"
                                        Background="White" Opacity="0.96">
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="{DynamicResource App.FontSize.Micro}" FontWeight="Normal"
                                               Foreground="#1A1A1A" TextWrapping="NoWrap"/>
                                </Border>
                            </Panel>
                        </Panel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        </LayoutTransformControl>

        <TextBlock Grid.Row="2" Text="{loc:Loc SubAgent.ListHeader}" FontSize="{DynamicResource App.FontSize.Body}" Opacity="0.6" Margin="0,0,0,6"/>

        <!-- 详情列表 -->
        <ScrollViewer Grid.Row="3" MaxHeight="260" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Orchestrator.ActiveAgents}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SubAgentViewModel">
                        <Border Padding="10,7" Margin="0,0,0,6" CornerRadius="8" Background="#14808080">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Grid.Column="0" Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,10,0"
                                         Fill="{Binding State, Converter={StaticResource SubAgentStateToBrushConverter}}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{DynamicResource App.FontSize.Subheading}"/>
                                    <TextBlock Text="{Binding CurrentAction}" FontSize="{DynamicResource App.FontSize.Body}" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="{loc:Loc SubAgent.Cancel}" FontSize="{DynamicResource App.FontSize.Body}" Padding="8,3" VerticalAlignment="Center"
                                        Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
