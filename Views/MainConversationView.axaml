<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:models="using:Athena.UI.Models"
             xmlns:controls="using:Athena.UI.Controls"
             xmlns:views="using:Athena.UI.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Athena.UI.Markup"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:lmd="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             mc:Ignorable="d" 
             d:DesignWidth="720" 
             d:DesignHeight="1080"
             x:Class="Athena.UI.Views.MainConversationView"
             x:Name="ConversationRoot"
             x:DataType="vm:MainConversationViewModel"
             DragDrop.AllowDrop="True"
             DragDrop.DragOver="OnFilesDragOver"
             DragDrop.Drop="OnFilesDrop">

    <Design.DataContext>
        <vm:MainConversationViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <!-- 徽标 alpha 蒙版刷：按图片 alpha 裁剪染色层，只染徽标、不形成整块色板 -->
        <ImageBrush x:Key="LogoMaskBrush" Source="avares://Athena.UI/Assets/AthenaLogo.webp" Stretch="Uniform"/>

        <!-- Markdown 超链接右键菜单：DataContext 由 LiveMarkdown 库设为当前 Link，
             按 HRef scheme 分显本地文件组与网络链接组，命令经 $parent 路由到会话 VM。 -->
        <ContextMenu x:Key="MarkdownLinkContextMenu">
            <MenuItem Header="{loc:Loc Chat.Link.OpenFile}"
                      IsVisible="{Binding HRef, Converter={StaticResource LinkSchemeConverter}, ConverterParameter=file, x:DataType=lmd:Link}"
                      Command="{Binding $parent[UserControl].((vm:MainConversationViewModel)DataContext).OpenMarkdownLinkUriCommand, x:DataType=lmd:Link}"
                      CommandParameter="{Binding HRef, x:DataType=lmd:Link}">
                <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconOpenFile}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Loc Chat.Link.OpenWith}"
                      IsVisible="{Binding HRef, Converter={StaticResource LinkSchemeConverter}, ConverterParameter=file, x:DataType=lmd:Link}"
                      Command="{Binding $parent[UserControl].((vm:MainConversationViewModel)DataContext).OpenMarkdownLinkWithCommand, x:DataType=lmd:Link}"
                      CommandParameter="{Binding HRef, x:DataType=lmd:Link}">
                <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconDetails}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Loc Chat.Link.CopyPath}"
                      IsVisible="{Binding HRef, Converter={StaticResource LinkSchemeConverter}, ConverterParameter=file, x:DataType=lmd:Link}"
                      Command="{Binding $parent[UserControl].((vm:MainConversationViewModel)DataContext).CopyMarkdownLinkAddressCommand, x:DataType=lmd:Link}"
                      CommandParameter="{Binding HRef, x:DataType=lmd:Link}">
                <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconCopy}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Loc Chat.Link.RevealInFolder}"
                      IsVisible="{Binding HRef, Converter={StaticResource LinkSchemeConverter}, ConverterParameter=file, x:DataType=lmd:Link}"
                      Command="{Binding $parent[UserControl].((vm:MainConversationViewModel)DataContext).RevealMarkdownLinkCommand, x:DataType=lmd:Link}"
                      CommandParameter="{Binding HRef, x:DataType=lmd:Link}">
                <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconFolderReveal}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
            </MenuItem>
            <Separator IsVisible="{Binding HRef, Converter={StaticResource LinkSchemeConverter}, ConverterParameter=file, x:DataType=lmd:Link}"/>
            <MenuItem Header="{loc:Loc Chat.Link.OpenUrl}"
                      IsVisible="{Binding HRef, Converter={StaticResource LinkSchemeConverter}, ConverterParameter=http, x:DataType=lmd:Link}"
                      Command="{Binding $parent[UserControl].((vm:MainConversationViewModel)DataContext).OpenMarkdownLinkUriCommand, x:DataType=lmd:Link}"
                      CommandParameter="{Binding HRef, x:DataType=lmd:Link}">
                <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconOpenFile}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Loc Chat.Link.CopyUrl}"
                      IsVisible="{Binding HRef, Converter={StaticResource LinkSchemeConverter}, ConverterParameter=http, x:DataType=lmd:Link}"
                      Command="{Binding $parent[UserControl].((vm:MainConversationViewModel)DataContext).CopyMarkdownLinkAddressCommand, x:DataType=lmd:Link}"
                      CommandParameter="{Binding HRef, x:DataType=lmd:Link}">
                <MenuItem.Icon><PathIcon Data="{StaticResource AthenaIconCopy}" Foreground="{DynamicResource App.IconForeground}"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CloseContextInspectorCommand}"/>
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <!-- 加载动画：三点依次缩放。动画仅在思考指示器显示时挂载，避免隐藏气泡持续重绘。 -->
        <Style Selector="Ellipse.loading-dot">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Fill" Value="{DynamicResource Chat.LoadingDotBrush}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <ScaleTransform ScaleX="0" ScaleY="0"/>
            </Setter>
        </Style>
        <Style Selector="Ellipse.loading-dot.dot1.animating">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite" Delay="0:0:0.15" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="40%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="60%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.loading-dot.dot2.animating">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite" Delay="0:0:0.3" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="0"/><Setter Property="ScaleTransform.ScaleY" Value="0"/></KeyFrame>
                    <KeyFrame Cue="40%"><Setter Property="ScaleTransform.ScaleX" Value="1"/><Setter Property="ScaleTransform.ScaleY" Value="1"/></KeyFrame>
                    <KeyFrame Cue="60%"><Setter Property="ScaleTransform.ScaleX" Value="1"/><Setter Property="ScaleTransform.ScaleY" Value="1"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="0"/><Setter Property="ScaleTransform.ScaleY" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.loading-dot.dot3.animating">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite" Delay="0:0:0.45" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="0"/><Setter Property="ScaleTransform.ScaleY" Value="0"/></KeyFrame>
                    <KeyFrame Cue="40%"><Setter Property="ScaleTransform.ScaleX" Value="1"/><Setter Property="ScaleTransform.ScaleY" Value="1"/></KeyFrame>
                    <KeyFrame Cue="60%"><Setter Property="ScaleTransform.ScaleX" Value="1"/><Setter Property="ScaleTransform.ScaleY" Value="1"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="0"/><Setter Property="ScaleTransform.ScaleY" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- 铭文式呼吸文本：衬线体 + 大字距，缓慢明暗如烛光拂过刻字。
             动画拆到 breathing 子类并由 ShowThinkingIndicator 绑定挂/摘：
             Avalonia 对 IsVisible=false 元素的关键帧动画仍会驱动合成器逐帧渲染
             （AvaloniaUI/Avalonia#17139），静态挂类会让聊天页闲置时也全程重绘。 -->
        <Style Selector="TextBlock.thinking-text">
            <Setter Property="FontFamily" Value="Georgia, Times New Roman, Songti SC, SimSun, serif"/>
            <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Body}"/>
            <Setter Property="LetterSpacing" Value="3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}"/>
        </Style>
        <Style Selector="TextBlock.thinking-text.breathing">
            <Style.Animations>
                <Animation Duration="0:0:2.2" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"> <Setter Property="Opacity" Value="0.35"/> </KeyFrame>
                    <KeyFrame Cue="100%"> <Setter Property="Opacity" Value="0.9"/> </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- 推理过程折叠面板：头部为无边框轻量按钮，面板为灰底卡片，正文弱化显示 -->
        <Style Selector="Button.reasoning-toggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}"/>
        </Style>
        <Style Selector="Button.reasoning-toggle:pointerover">
            <Setter Property="Background" Value="{DynamicResource SemiGreyLowBrush}"/>
        </Style>
        <Style Selector="Border.reasoning-panel">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGreyLowBrush}"/>
            <Setter Property="Background" Value="{DynamicResource App.SectionBg}"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="PathIcon.reasoning-chevron">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform">
                <RotateTransform/>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="RotateTransform.Angle" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
            <Style Selector="^.reasoning-expanded">
                <Setter Property="RotateTransform.Angle" Value="90"/>
            </Style>
        </Style>

        <!-- 消息气泡基础样式 -->
        <Style Selector="Border.message-bubble">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGreyLowBrush}"/>
            <Setter Property="MaxWidth" Value="{DynamicResource App.ContentMaxWidth}"/>
        </Style>

        <!-- 用户消息气泡 -->
        <Style Selector="Border.user-bubble">
            <Setter Property="Background" Value="{DynamicResource Chat.UserBubbleBg}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- AI 消息气泡 -->
        <Style Selector="Border.assistant-bubble">
            <Setter Property="Background" Value="{DynamicResource Chat.AssistantBubbleBg}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- 角色标题颜色 -->
        <Style Selector="TextBlock.role-title">
            <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Body}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.user-title">
            <Setter Property="Foreground" Value="{DynamicResource App.EmphasisForeground}"/>
        </Style>
        <Style Selector="TextBlock.assistant-title">
            <Setter Property="Foreground" Value="{DynamicResource SemiGreen6}"/>
        </Style>

        <Style Selector="Border.attachment-card">
            <Setter Property="Width" Value="116"/>
            <Setter Property="MinHeight" Value="92"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGreyLowBrush}"/>
            <Setter Property="Background" Value="{DynamicResource App.SectionBg}"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

        <Style Selector="Border.audio-attachment-card">
            <Setter Property="MinWidth" Value="240"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGreyLowBrush}"/>
            <Setter Property="Background" Value="{DynamicResource App.SectionBg}"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style Selector="Border.inline-generated-image">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource App.SectionBg}"/>
            <Setter Property="MaxWidth" Value="560"/>
        </Style>

        <!-- Sub-Agents 按钮：运行中涟漪光环（琥珀色，与小镇"运行中"猫头鹰同色系）。
             平时透明不占视觉；active 时从按钮轮廓向外扩散并淡出，无限循环。 -->
        <Style Selector="Border.subagents-glow">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BA7517"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform">
                <ScaleTransform/>
            </Setter>
        </Style>
        <Style Selector="Border.subagents-glow.active">
            <Style.Animations>
                <Animation Duration="0:0:2.4" IterationCount="Infinite" Easing="SineEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.4"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="1.10"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.4"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Sub-Agents 右下角代理数角标：运行中琥珀色，闲时灰色。 -->
        <Style Selector="Border.subagents-badge">
            <Setter Property="MinWidth" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="Background" Value="#9E9A90"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,-5,-5"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Border.subagents-badge.running">
            <Setter Property="Background" Value="#BA7517"/>
        </Style>

        <!-- 气泡操作按钮：默认隐藏，光标进入该消息气泡区域时淡入 -->
        <Style Selector="StackPanel.bubble-actions">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.message-row:pointerover StackPanel.bubble-actions">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="Button.attachment-remove-button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="40,*,Auto">

        <!-- 聊天区域头部：左上/右上圆角与外围 shell-panel（CornerRadius=10）一致，避免直角背景顶出外框圆角；
             左下/右下为直角与下方消息区衔接。 -->
        <Border Grid.Row="0"
                Background="{DynamicResource App.SectionBg}"
                CornerRadius="10,10,0,0"
                VerticalAlignment="Center"
                Padding="12,8">
            <Grid ColumnDefinitions="Auto,*">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Chat.Header}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource App.FontSize.Heading}"/>

                    <Button x:Name="ContextInspectorButton"
                            Command="{Binding ToggleContextInspectorCommand}"
                            VerticalAlignment="Center"
                            Padding="7,4"
                            ToolTip.Tip="{loc:Loc ContextInspector.Open}"
                            AutomationProperties.Name="{loc:Loc ContextInspector.Open}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="{StaticResource SemiIconArticle}" Width="15" Height="15"
                                  Foreground="{DynamicResource App.IconAccentForeground}"/>
                            <TextBlock Text="{loc:Loc ContextInspector.Button}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 子代理入口：始终可用，居中弹出"猫头鹰小镇"。
                         整体包在 Panel 里：底层涟漪光环（运行时循环）+ 按钮 + 右下角数量角标；
                         Panel 挂 ScaleTransform，猫头鹰飞抵时由 code-behind 做弹跳脉冲。 -->
                    <Panel x:Name="SubAgentsEntry"
                           VerticalAlignment="Center"
                           RenderTransformOrigin="50%,50%">
                        <Panel.RenderTransform>
                            <ScaleTransform/>
                        </Panel.RenderTransform>
                        <Border Classes="subagents-glow"
                                Classes.active="{Binding HasRunningSubAgents}"/>
                        <Button x:Name="SubAgentsButton"
                                VerticalAlignment="Center"
                                Padding="5"
                                Command="{Binding ToggleSubAgentPopupCommand}"
                                ToolTip.Tip="{loc:Loc Chat.SubAgents.Toggle}"
                                AutomationProperties.Name="{loc:Loc Chat.SubAgents.Toggle}">
                            <PathIcon Data="{StaticResource AthenaIconSubAgentsOwl}" Width="16" Height="16"
                                      Foreground="{DynamicResource App.IconAccentForeground}"/>
                        </Button>
                        <Border Classes="subagents-badge"
                                Classes.running="{Binding HasRunningSubAgents}"
                                IsVisible="{Binding HasSubAgents}">
                            <TextBlock Text="{Binding SubAgentCount}"
                                       FontSize="{DynamicResource App.FontSize.Tiny}" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Panel>
                </StackPanel>

            </Grid>
        </Border>

        <!-- 聊天消息列表 -->
        <ScrollViewer Grid.Row="1" Name="ChatScrollViewer"
                      IsVisible="{Binding !IsRawContextView}">
            <ItemsControl x:Name="MessagesItemsControl"
                          ItemsSource="{Binding Messages}"
                          Margin="12"
                          MaxWidth="{DynamicResource App.ContentMaxWidth}"
                          HorizontalAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage">
                        <Grid Classes="message-row" Margin="0,0,0,40" IsVisible="{Binding IsBubbleVisible}" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="{Binding IsUser, Converter={StaticResource IntToColumnConverter}, ConverterParameter=UserAlign}"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="{Binding IsUser, Converter={StaticResource BoolToAlignmentConverter}}"
                                        Spacing="4">

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                                    <TextBlock Text="{Binding IsUser, Converter={StaticResource RoleToTitleConverter}}"
                                               Classes.role-title="True"
                                               Classes.user-title="{Binding IsUser}"
                                               Classes.assistant-title="{Binding !IsUser}"/>
                                    
                                    <TextBlock Text="{Binding TimestampText}"
                                               Foreground="{DynamicResource Chat.TimestampFg}" 
                                               FontSize="{DynamicResource App.FontSize.Caption}" 
                                               VerticalAlignment="Center"/>
                                    
                                    <TextBlock Text="{loc:Loc Chat.Archived}" 
                                               IsVisible="{Binding IsCompressed}" 
                                               Foreground="{DynamicResource Chat.ArchivedFg}" 
                                               FontSize="{DynamicResource App.FontSize.Caption}" 
                                               VerticalAlignment="Center" 
                                               FontWeight="Bold"/>
                                </StackPanel>

                                <Border Classes="message-bubble"
                                        Classes.user-bubble="{Binding IsUser}"
                                        Classes.assistant-bubble="{Binding !IsUser}">
                                    <StackPanel Spacing="4">
                                        <!-- 推理过程折叠面板：默认收起，点击头部展开/收起。
                                             流式回复中推理文本在每轮结束时到达，跨工具轮累计展示完整思考链。 -->
                                        <StackPanel IsVisible="{Binding HasReasoningContent}" Margin="0,0,0,8" Spacing="4">
                                            <Button Classes="reasoning-toggle" Padding="8,4" HorizontalAlignment="Left"
                                                    Command="{Binding ToggleReasoningCommand}"
                                                    ToolTip.Tip="{loc:Loc Chat.Reasoning.Header}"
                                                    AutomationProperties.Name="{loc:Loc Chat.Reasoning.Header}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <PathIcon Data="{StaticResource SemiIconBulb}" Width="13" Height="13" Opacity="0.7" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{loc:Loc Chat.Reasoning.Header}" FontSize="{DynamicResource App.FontSize.Body}"/>
                                                    <PathIcon Data="{StaticResource SemiIconChevronRight}" Width="11" Height="11" Opacity="0.7" VerticalAlignment="Center"
                                                              Classes="reasoning-chevron"
                                                              Classes.reasoning-expanded="{Binding IsReasoningExpanded}"/>
                                                </StackPanel>
                                            </Button>
                                            <Border Classes="reasoning-panel" IsVisible="{Binding IsReasoningExpanded}">
                                                <TextBlock Text="{Binding ReasoningContent}"
                                                           TextWrapping="Wrap"
                                                           FontSize="{DynamicResource App.FontSize.Body}"
                                                           Foreground="{DynamicResource SemiColorText3}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Content 为 null 时不实例化重型 Markdown 模板。 -->
                                        <ContentControl Content="{Binding LegacyMarkdownContent}">
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate x:DataType="models:ChatMessage">
                                                    <lmd:MarkdownRenderer
                                                        loc:MarkdownHelper.Text="{Binding DisplayText}"
                                                        LinkCommand="{Binding $parent[UserControl].((vm:MainConversationViewModel)DataContext).OpenMarkdownLinkCommand}"
                                                        LinkContextMenu="{StaticResource MarkdownLinkContextMenu}"
                                                        HorizontalAlignment="Stretch" />
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>

                                        <ItemsControl ItemsSource="{Binding SegmentContent}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:ChatMessageSegment">
                                                    <StackPanel Margin="0,0,0,6">
                                                        <ContentControl Content="{Binding MarkdownContent}">
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate x:DataType="models:ChatMessageSegment">
                                                                    <lmd:MarkdownRenderer
                                                                        loc:MarkdownHelper.Text="{Binding Text}"
                                                                        LinkCommand="{Binding $parent[UserControl].((vm:MainConversationViewModel)DataContext).OpenMarkdownLinkCommand}"
                                                                        LinkContextMenu="{StaticResource MarkdownLinkContextMenu}"
                                                                        HorizontalAlignment="Stretch" />
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>

                                                        <ContentControl Content="{Binding GeneratedImageContent}">
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate x:DataType="models:ChatMessageSegment">
                                                                    <Button Command="{Binding $parent[UserControl].((vm:MainConversationViewModel)DataContext).OpenImageAttachmentCommand}"
                                                                            CommandParameter="{Binding Attachment}"
                                                                            Padding="0"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            HorizontalAlignment="Left"
                                                                            AutomationProperties.Name="{Binding Attachment.DisplayName}">
                                                                        <Border Classes="inline-generated-image">
                                                                            <Image Source="{Binding Attachment.PreviewImage}"
                                                                                   Stretch="Uniform"
                                                                                   MaxWidth="560"/>
                                                                        </Border>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>

                                                        <ContentControl Content="{Binding ToolCallContent}">
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate x:DataType="models:ChatMessageSegment">
                                                                    <!-- 工具调用组：自定义折叠容器（收起露 3 个 + 第 4 个 peek + 底部朦胧） -->
                                                                    <controls:ToolCallStackView HorizontalAlignment="Stretch"/>
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding AttachmentPanelItems}" IsVisible="{Binding ShouldShowAttachmentPanel}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:ChatAttachment">
                                                    <Grid Margin="0,4,8,4">
                                                        <ContentControl Content="{Binding ImageContent}">
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate x:DataType="models:ChatAttachment">
                                                                    <Button Command="{Binding $parent[UserControl].((vm:MainConversationViewModel)DataContext).OpenImageAttachmentCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            Padding="0"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            HorizontalAlignment="Left"
                                                                            ToolTip.Tip="{Binding DisplayName}"
                                                                            AutomationProperties.Name="{Binding DisplayName}">
                                                                        <Border Classes="attachment-card">
                                                                            <Grid RowDefinitions="56,Auto,Auto">
                                                                                <Border Grid.Row="0" CornerRadius="5" ClipToBounds="True" Background="{DynamicResource SemiGreyLowBrush}">
                                                                                    <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"/>
                                                                                </Border>
                                                                                <TextBlock Grid.Row="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource App.FontSize.Body}" Margin="0,5,0,0"/>
                                                                                <TextBlock Grid.Row="2" Text="{Binding DisplaySize}" FontSize="{DynamicResource App.FontSize.Caption}" Opacity="0.65"/>
                                                                            </Grid>
                                                                        </Border>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>

                                                        <ContentControl Content="{Binding GenericFileContent}">
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate x:DataType="models:ChatAttachment">
                                                                    <Border Classes="attachment-card">
                                                                        <Grid RowDefinitions="56,Auto,Auto">
                                                                            <Border Grid.Row="0" Background="{DynamicResource SemiGreyLowBrush}" CornerRadius="5">
                                                                                <TextBlock Text="{Binding FileExtension}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource App.FontSize.Subheading}" FontWeight="Bold"/>
                                                                            </Border>
                                                                            <TextBlock Grid.Row="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource App.FontSize.Body}" Margin="0,5,0,0"/>
                                                                            <TextBlock Grid.Row="2" Text="{Binding DisplaySize}" FontSize="{DynamicResource App.FontSize.Caption}" Opacity="0.65"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>

                                                        <ContentControl Content="{Binding AudioContent}">
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate x:DataType="models:ChatAttachment">
                                                                    <Border Classes="audio-attachment-card">
                                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                                            <Panel Grid.Column="0" VerticalAlignment="Center">
                                                                                <Button Width="32" Height="32" Padding="0" IsVisible="{Binding !IsPlaying}" Command="{Binding $parent[UserControl].((vm:MainConversationViewModel)DataContext).ToggleAudioPlaybackCommand}" CommandParameter="{Binding}" ToolTip.Tip="{loc:Loc Chat.Audio.Play}" AutomationProperties.Name="{loc:Loc Chat.Audio.Play}">
                                                                                    <PathIcon Data="{StaticResource SemiIconPlay}" Width="14" Height="14"/>
                                                                                </Button>
                                                                                <Button Width="32" Height="32" Padding="0" IsVisible="{Binding IsPlaying}" Command="{Binding $parent[UserControl].((vm:MainConversationViewModel)DataContext).ToggleAudioPlaybackCommand}" CommandParameter="{Binding}" ToolTip.Tip="{loc:Loc Chat.Audio.Stop}" AutomationProperties.Name="{loc:Loc Chat.Audio.Stop}">
                                                                                    <PathIcon Data="{StaticResource SemiIconStop}" Width="14" Height="14"/>
                                                                                </Button>
                                                                            </Panel>
                                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,8,0"/>
                                                                            <TextBlock Grid.Column="2" Text="{Binding DisplaySize}" FontSize="{DynamicResource App.FontSize.Caption}" Opacity="0.65" VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border IsVisible="{Binding HasAudioError}"
                                                Background="{DynamicResource App.SectionBg}"
                                                BorderBrush="{DynamicResource SemiRed6}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,8">
                                            <TextBlock Text="{Binding AudioErrorMessage}"
                                                       Foreground="{DynamicResource SemiRed6}"
                                                       TextWrapping="Wrap"
                                                       FontSize="{DynamicResource App.FontSize.Body}"/>
                                        </Border>

                                        <!-- 后台语音生成中提示（不阻塞任何交互） -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsGeneratingAudio}">
                                            <PathIcon Data="{StaticResource SemiIconLoading}" Classes.SlowSpin="{Binding IsGeneratingAudio}" Width="13" Height="13" Opacity="0.6"/>
                                            <TextBlock Text="{loc:Loc Chat.Audio.Generating}" FontStyle="Italic" Opacity="0.6" FontSize="{DynamicResource App.FontSize.Body}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- 手动生成语音：语音开启但该消息尚无音频时出现（补生成被挤掉的/历史消息的语音） -->
                                        <Button HorizontalAlignment="Left"
                                                Padding="8,4"
                                                FontSize="{DynamicResource App.FontSize.Body}"
                                                IsVisible="{Binding CanGenerateAudio}"
                                                Command="{Binding $parent[UserControl].((vm:MainConversationViewModel)DataContext).GenerateMessageAudioCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{loc:Loc Chat.Audio.Generate}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="{StaticResource SemiIconVolume2}" Width="13" Height="13" Opacity="0.75"/>
                                                <TextBlock Text="{loc:Loc Chat.Audio.Generate}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasToolExecutionSummary}">
                                            <PathIcon Data="{StaticResource SemiIconLoading}" Classes.SlowSpin="{Binding HasToolExecutionSummary}" Width="14" Height="14" Opacity="0.6"/>
                                            <TextBlock Text="{Binding ToolExecutionSummary}" FontStyle="Italic" Opacity="0.6" FontSize="{DynamicResource App.FontSize.Subheading}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel IsVisible="{Binding IsLoading}" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="3"
                                                        IsVisible="{Binding !HasToolExecutionSummary}"
                                                        VerticalAlignment="Center">
                                                <Ellipse Classes="loading-dot dot1" Classes.animating="{Binding ShowThinkingIndicator}"/>
                                                <Ellipse Classes="loading-dot dot2" Classes.animating="{Binding ShowThinkingIndicator}"/>
                                                <Ellipse Classes="loading-dot dot3" Classes.animating="{Binding ShowThinkingIndicator}"/>
                                            </StackPanel>
                                            <TextBlock Classes="thinking-text"
                                                       Classes.breathing="{Binding ShowThinkingIndicator}"
                                                       Text="{loc:Loc Chat.ReceivingData}"
                                                       IsVisible="{Binding ShowDefaultThinkingText}"/>
                                            <TextBlock Classes="thinking-text"
                                                       Classes.breathing="{Binding ShowThinkingIndicator}"
                                                       Text="{loc:Loc Chat.ComposingFileText}"
                                                       IsVisible="{Binding ShowComposingFileText}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 操作按钮：默认隐藏，悬停气泡区域时显示；user 靠右、assistant 靠左 -->
                                <StackPanel Classes="bubble-actions" Orientation="Horizontal" Spacing="8"
                                            HorizontalAlignment="{Binding IsUser, Converter={StaticResource BoolToAlignmentConverter}}"
                                            IsVisible="{Binding !IsLoading}">
                                    <Button Command="{Binding $parent[ItemsControl].((vm:MainConversationViewModel)DataContext).CopyMessageCommand}"
                                            CommandParameter="{Binding}"
                                            FontSize="{DynamicResource App.FontSize.Body}"
                                            ToolTip.Tip="{loc:Loc Chat.BtnCopy}"
                                            AutomationProperties.Name="{loc:Loc Chat.BtnCopy}">
                                        <PathIcon Data="{StaticResource SemiIconCopy}" Width="14" Height="14"/>
                                    </Button>

                                    <Button Command="{Binding $parent[ItemsControl].((vm:MainConversationViewModel)DataContext).RewindToMessageCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding CanShowRewind}"
                                            FontSize="{DynamicResource App.FontSize.Body}"
                                            ToolTip.Tip="{loc:Loc Chat.BtnRewind}"
                                            AutomationProperties.Name="{loc:Loc Chat.BtnRewind}">
                                        <PathIcon Data="{StaticResource SemiIconUndo}" Width="14" Height="14"/>
                                    </Button>

                                    <Button Command="{Binding $parent[ItemsControl].((vm:MainConversationViewModel)DataContext).ForkFromMessageCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding CanShowRewind}"
                                            FontSize="{DynamicResource App.FontSize.Body}"
                                            ToolTip.Tip="{loc:Loc Chat.BtnFork}"
                                            AutomationProperties.Name="{loc:Loc Chat.BtnFork}">
                                        <PathIcon Data="{StaticResource SemiIconSourceControl}" Width="14" Height="14"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 空会话占位：新对话无消息时居中显示 Athena 徽标锁标。
             图片上叠一层轻微透明度的蒙版 —— OpacityMask 按图片 alpha 裁剪，只染徽标、不形成整块色板；
             蒙版颜色用聊天区容器背景色(SemiColorBackground0，即 shell-panel 的 Background)，
             轻微染色(0.35)只为压柔和纯黑白的突兀感，仍保留原图轮廓。
             图片底部平直，故下方配一条中置菱形装饰线与加粗宽字距 ATHENA 字标补全构图。 -->
        <Border Grid.Row="1"
                ZIndex="40"
                IsHitTestVisible="False"
                IsVisible="{Binding Messages.Count, Converter={StaticResource EmptyCountToBoolConverter}}">
            <StackPanel MaxWidth="{DynamicResource App.ContentMaxWidth}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14">
                <Panel Width="104" Height="104">
                    <Image Source="avares://Athena.UI/Assets/AthenaLogo.webp" Stretch="Uniform"/>
                    <Rectangle Fill="{DynamicResource SemiColorBackground0}" Opacity="0.6"
                               OpacityMask="{StaticResource LogoMaskBrush}"/>
                </Panel>

                <!-- 装饰分隔线：细线 + 中置菱形，颜色与字标一致 -->
                <Grid ColumnDefinitions="*,Auto,*" Width="200" VerticalAlignment="Center">
                    <Rectangle Grid.Column="0" Height="1" VerticalAlignment="Center"
                               Fill="{DynamicResource SemiColorText2}"/>
                    <Border Grid.Column="1"
                            Width="4" Height="4"
                            CornerRadius="1"
                            Margin="8,0"
                            Background="{DynamicResource SemiColorText2}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <RotateTransform Angle="45"/>
                        </Border.RenderTransform>
                    </Border>
                    <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center"
                               Fill="{DynamicResource SemiColorText2}"/>
                </Grid>

                <TextBlock Text="ATHENA"
                           FontSize="22"
                           FontWeight="Bold"
                           LetterSpacing="8"
                           Foreground="{DynamicResource SemiColorText2}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 输入区域：整体为一个大输入框，文本框在上、功能按钮工具栏在底部 -->
        <Border Grid.Row="2"
                MaxWidth="{DynamicResource App.ContentMaxWidth}"
                HorizontalAlignment="Stretch">
            <Border CornerRadius="0,0,5,5"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                    Background="{DynamicResource App.SectionBg}"
                    Padding="8">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                <!-- 仓库分支入口：工作区绑定仓库时出现。名称打开差异审查，菜单暂保留 UI。 -->
                <Border Grid.Row="0"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,5"
                        CornerRadius="5"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SemiGreyLowBrush}"
                        Background="{DynamicResource SemiGrey0}"
                        IsVisible="{Binding #ConversationRoot.Workbench.HasGitRepository}">
                    <Grid ColumnDefinitions="Auto,Auto,Auto">
                        <Border Grid.Column="0" Padding="7,4" BorderThickness="0,0,1,0"
                                BorderBrush="{DynamicResource SemiGreyLowBrush}">
                            <PathIcon Data="{StaticResource AthenaIconBranch}" Width="12" Height="12"
                                      Foreground="{DynamicResource App.IconAccentForeground}"/>
                        </Border>
                        <Button Grid.Column="1"
                                MinWidth="88"
                                MaxWidth="220"
                                Padding="8,3"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Left"
                                Command="{Binding #ConversationRoot.Workbench.ToggleReviewCommand}"
                                ToolTip.Tip="{loc:Loc Git.Branch.OpenReview}">
                            <TextBlock Text="{Binding #ConversationRoot.Workbench.CurrentBranchName}"
                                       FontSize="{DynamicResource App.FontSize.Body}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                        </Button>
                        <Button Grid.Column="2"
                                Padding="6,3"
                                Background="Transparent"
                                BorderThickness="1,0,0,0"
                                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                                ToolTip.Tip="{loc:Loc Git.Branch.Menu}"
                                AutomationProperties.Name="{loc:Loc Git.Branch.Menu}">
                            <PathIcon Data="{StaticResource SemiIconMore}" Width="12" Height="12"
                                      Foreground="{DynamicResource App.IconMutedForeground}"/>
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="{loc:Loc Git.Branch.SwitchSoon}" IsEnabled="False"/>
                                    <MenuItem Header="{loc:Loc Git.Branch.CreateSoon}" IsEnabled="False"/>
                                    <MenuItem Header="{loc:Loc Git.Branch.ManageSoon}" IsEnabled="False"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </Border>

                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding PendingAttachments}"
                              IsVisible="{Binding HasPendingAttachments}"
                              Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ChatAttachment">
                            <Border Classes="attachment-card" Margin="0,0,8,8">
                                <Grid RowDefinitions="56,Auto,Auto">
                                    <Border Grid.Row="0"
                                            CornerRadius="5"
                                            ClipToBounds="True"
                                            Background="{DynamicResource SemiGreyLowBrush}">
                                        <Image Source="{Binding PreviewImage}"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding IsImage}"/>
                                    </Border>
                                    <Border Grid.Row="0"
                                            IsVisible="{Binding !IsImage}"
                                            Background="{DynamicResource SemiGreyLowBrush}"
                                            CornerRadius="5">
                                        <TextBlock Text="{Binding FileExtension}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="{DynamicResource App.FontSize.Subheading}"
                                                   FontWeight="Bold"/>
                                    </Border>
                                    <Button Grid.Row="0"
                                            Classes="attachment-remove-button"
                                            Command="{Binding $parent[ItemsControl].((vm:MainConversationViewModel)DataContext).RemovePendingAttachmentCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{loc:Loc Chat.Attach.Remove}"
                                            AutomationProperties.Name="{loc:Loc Chat.Attach.Remove}">
                                        <PathIcon Data="{StaticResource SemiIconClose}" Width="12" Height="12"/>
                                    </Button>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="{DynamicResource App.FontSize.Body}"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding DisplaySize}"
                                               FontSize="{DynamicResource App.FontSize.Caption}"
                                               Opacity="0.65"/>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="2"
                           Text="{Binding BackgroundArchiveStatusMessage}"
                           Foreground="{DynamicResource Chat.TimestampFg}"
                           FontSize="{DynamicResource App.FontSize.Body}"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasBackgroundArchiveNeutralStatus}"/>

                <TextBlock Grid.Row="2"
                           Text="{Binding BackgroundArchiveStatusMessage}"
                           Foreground="{DynamicResource SemiRed6}"
                           FontSize="{DynamicResource App.FontSize.Body}"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasBackgroundArchiveErrorStatus}"/>

                <TextBlock Grid.Row="3"
                           Text="{Binding AttachmentStatusMessage}"
                           IsVisible="{Binding HasAttachmentStatusMessage}"
                           Foreground="{DynamicResource SemiRed6}"
                           FontSize="{DynamicResource App.FontSize.Body}"
                           Margin="0,0,0,8"/>

                <!-- 文本输入：无边框，融入外层卡片 -->
                <TextBox x:Name="MessageInputTextBox"
                         Grid.Row="4"
                         Text="{Binding InputText}"
                         PlaceholderText="{Binding InputPlaceholder, Converter={StaticResource LocConverter}}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="4,2"
                         MaxHeight="220">
                    <!-- 覆盖 Semi 主题驱动悬停/聚焦高亮的画刷，使输入框完全融入外层卡片 -->
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextBoxDefaultBorderBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextBoxPointeroverBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextBoxPointeroverBorderBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextBoxFocusBorderBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextBoxPressedBackground" Color="Transparent"/>
                        <Thickness x:Key="TextBoxBorderThickness">0</Thickness>
                    </TextBox.Resources>
                    <TextBox.KeyBindings>
                        <KeyBinding Command="{Binding SendMessageCommand}" Gesture="Enter"/>
                    </TextBox.KeyBindings>
                </TextBox>

                <!-- 底部功能工具栏：左侧功能按钮，右侧模型和发送/停止 -->
                <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto,50" ColumnSpacing="10" Margin="0,6,0,0">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">
                        <Button Command="{Binding AttachFileCommand}"
                                BorderThickness="0"
                                Padding="6"
                                IsEnabled="{Binding CanAcceptAttachments}"
                                ToolTip.Tip="{loc:Loc Chat.Attach.Add}"
                                AutomationProperties.Name="{loc:Loc Chat.Attach.Add}">
                            <PathIcon Data="{StaticResource SemiIconPlus}" Width="18" Height="18"/>
                        </Button>
                        <u:IconSplitButton Icon="{StaticResource SemiIconScissors}"
                                           IsEnabled="{Binding !IsSending}"
                                           Command="{Binding CaptureScreenshotCommand}"
                                           CommandParameter="keep"
                                           ToolTip.Tip="{loc:Loc Chat.Screenshot.Add}"
                                           AutomationProperties.Name="{loc:Loc Chat.Screenshot.Add}">
                            <u:IconSplitButton.Flyout>
                                <MenuFlyout Placement="Top">
                                    <MenuItem Header="{loc:Loc Chat.Screenshot.HideWindow}"
                                              Command="{Binding CaptureScreenshotCommand}"
                                              CommandParameter="hide"/>
                                </MenuFlyout>
                            </u:IconSplitButton.Flyout>
                        </u:IconSplitButton>
                    </StackPanel>

                    <Border x:Name="ContextUsageStatus"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{Binding ContextTokensInfo}">
                        <Grid x:Name="ContextUsageDisplay"
                              IsVisible="{Binding TokenService.HasVisibleUsage}">
                            <TextBlock Text="{Binding TokenService.TokenUsageBarText}"
                                       FontFamily="Consolas, 'Courier New', monospace"
                                       FontSize="{DynamicResource App.FontSize.Caption}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Column="2"
                               Text="{Binding CurrentModelName}"
                               MaxWidth="100"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Chat.TimestampFg}"
                               FontSize="{DynamicResource App.FontSize.Body}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding CurrentModelName}"/>

                    <Button Grid.Column="3"
                            HorizontalAlignment="Stretch"
                            Command="{Binding SendMessageCommand}"
                            Theme="{StaticResource AccentButtonTheme}"
                            IsVisible="{Binding !IsSending}"
                            ToolTip.Tip="{loc:Loc Chat.BtnExecute}"
                            AutomationProperties.Name="{loc:Loc Chat.BtnExecute}">
                        <PathIcon Data="{StaticResource SemiIconSend}" Width="16" Height="16"/>
                    </Button>

                    <Button Grid.Column="3"
                            HorizontalAlignment="Stretch"
                            Command="{Binding StopResponseCommand}"
                            Theme="{StaticResource AccentButtonTheme}"
                            IsVisible="{Binding IsSending}"
                            ToolTip.Tip="{loc:Loc Chat.BtnStop}"
                            AutomationProperties.Name="{loc:Loc Chat.BtnStop}">
                        <PathIcon Data="{StaticResource SemiIconStop}"
                                  Width="16"
                                  Height="16"
                                  Foreground="{DynamicResource SemiRed6}"/>
                    </Button>
                </Grid>
            </Grid>
            </Border>
        </Border>

        <!-- 当前会话上下文检查器：绑定当前 Session VM；不会读取或修改全局设置状态。 -->
        <Border x:Name="ContextInspectorDrawer"
                Grid.Row="1"
                ZIndex="80"
                Width="{DynamicResource App.ContentMaxWidth}"
                MaxWidth="{Binding $parent[UserControl].Bounds.Width}"
                HorizontalAlignment="Center"
                Margin="0,5"
                CornerRadius="8"
                IsVisible="{Binding IsContextInspectorOpen}"
                Background="{DynamicResource App.SectionBg}"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                BorderThickness="1"
                BoxShadow="0 4 24 0 #33000000">
            <Grid RowDefinitions="Auto,*">
                <Border Padding="14,10"
                        BorderBrush="{DynamicResource SemiGreyLowBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="8,8,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Loc ContextInspector.Title}"
                                       FontSize="{DynamicResource App.FontSize.Title}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ConversationId}"
                                       FontSize="{DynamicResource App.FontSize.Caption}"
                                       Opacity="0.55"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding ConversationId}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding CloseContextInspectorCommand}"
                                Padding="6"
                                AutomationProperties.Name="{loc:Loc ContextInspector.Close}"
                                ToolTip.Tip="{loc:Loc ContextInspector.Close}">
                            <PathIcon Data="{StaticResource SemiIconClose}" Width="14" Height="14"/>
                        </Button>
                    </Grid>
                </Border>

                <TabControl x:Name="ContextInspectorTabs" Grid.Row="1" SelectedIndex="{Binding SelectedContextInspectorTab}">
                    <TabItem Header="{loc:Loc ContextInspector.Tab.Overview}">
                        <ScrollViewer>
                            <StackPanel Margin="16" Spacing="14">
                                <Border Classes="settings-card" Padding="14" BorderThickness="1"
                                        BorderBrush="{DynamicResource SemiGreyLowBrush}" CornerRadius="8">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="{loc:Loc ContextInspector.Overview.Model}" FontWeight="SemiBold"/>
                                        <SelectableTextBlock Text="{Binding ContextInspectorModelText}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ContextInspectorMatchText}" Opacity="0.62" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="14" BorderThickness="1" BorderBrush="{DynamicResource SemiGreyLowBrush}" CornerRadius="8">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="{loc:Loc ContextInspector.Overview.Policy}" FontWeight="SemiBold"/>
                                        <SelectableTextBlock Text="{Binding ContextInspectorPolicyText}"
                                                             FontFamily="Menlo,Consolas,monospace" TextWrapping="Wrap"/>
                                        <TextBlock Text="{loc:Loc ContextInspector.Overview.PolicyHint}"
                                                   Opacity="0.62" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="14" BorderThickness="1" BorderBrush="{DynamicResource SemiGreyLowBrush}" CornerRadius="8">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="{loc:Loc ContextInspector.Overview.Usage}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ContextInspectorUsageText}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ContextInspectorUsageDetails}" Opacity="0.62" TextWrapping="Wrap"/>
                                        <TextBlock Text="{loc:Loc ContextInspector.Overview.CachedHint}" Opacity="0.55" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="14" BorderThickness="1" BorderBrush="{DynamicResource SemiGreyLowBrush}" CornerRadius="8">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="{loc:Loc ContextInspector.Overview.Ownership}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ContextInspectorWorkspaceText}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ContextInspectorCompressionModelText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="12"
                                        IsVisible="{Binding HasContextInspectorWarnings}"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource SemiOrange5}"
                                        CornerRadius="8">
                                    <TextBlock Text="{Binding ContextInspectorWarningsText}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{loc:Loc ContextInspector.Tab.Summary}">
                        <ScrollViewer>
                            <StackPanel Margin="16" Spacing="14">
                                <Border Padding="14" BorderThickness="1" BorderBrush="{DynamicResource SemiGreyLowBrush}" CornerRadius="8"
                                        IsVisible="{Binding HasActiveContextSummary}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{loc:Loc ContextInspector.Summary.Active}" FontWeight="SemiBold"/>
                                        <SelectableTextBlock Text="{Binding ActiveContextSummary}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding CompressionSummaryDetails}" Opacity="0.6" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="{loc:Loc Common.Copy}"
                                                    Command="{Binding CopyContextTextCommand}"
                                                    CommandParameter="{Binding ActiveContextSummary}"/>
                                            <Button Content="{loc:Loc ContextInspector.Summary.Undo}"
                                                    Command="{Binding UndoCompressionCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{loc:Loc ContextInspector.Summary.Empty}"
                                           IsVisible="{Binding !HasActiveContextSummary}"
                                           Opacity="0.6" TextWrapping="Wrap"/>
                                <Border Padding="14" BorderThickness="1" BorderBrush="{DynamicResource SemiOrange5}" CornerRadius="8"
                                        IsVisible="{Binding HasOrphanedLegacySummary}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{loc:Loc ContextInspector.Summary.Orphaned}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{loc:Loc ContextInspector.Summary.OrphanedHint}" Opacity="0.65" TextWrapping="Wrap"/>
                                        <SelectableTextBlock Text="{Binding OrphanedLegacySummary}" TextWrapping="Wrap"/>
                                        <Button Content="{loc:Loc Common.Copy}" HorizontalAlignment="Left"
                                                Command="{Binding CopyContextTextCommand}"
                                                CommandParameter="{Binding OrphanedLegacySummary}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{loc:Loc ContextInspector.Tab.Preview}">
                        <ScrollViewer>
                            <StackPanel Margin="16" Spacing="12">
                                <TextBlock Text="{loc:Loc ContextInspector.Preview.Explanation}" TextWrapping="Wrap" Opacity="0.68"/>
                                <Button Content="{loc:Loc ContextInspector.Preview.RefreshPlan}"
                                        Command="{Binding RefreshCompressionPlanCommand}"
                                        HorizontalAlignment="Left"/>
                                <Border Padding="12" BorderThickness="1" BorderBrush="{DynamicResource SemiGreyLowBrush}" CornerRadius="8"
                                        IsVisible="{Binding HasCompressionImpactPreview}">
                                    <SelectableTextBlock Text="{Binding CompressionImpactPreview}" TextWrapping="Wrap"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{loc:Loc ContextInspector.Preview.Generate}"
                                            Command="{Binding GenerateCompressionCandidateCommand}"
                                            IsEnabled="{Binding CanGenerateCompressionCandidate}"/>
                                    <Button Content="{loc:Loc Common.Cancel}"
                                            Command="{Binding CancelCompressionPreviewCommand}"
                                            IsVisible="{Binding IsCompressionPreviewBusy}"/>
                                    <Button Content="{loc:Loc ContextInspector.Preview.Apply}"
                                            Theme="{StaticResource AccentButtonTheme}"
                                            Command="{Binding ApplyCompressionCandidateCommand}"
                                            IsEnabled="{Binding CanApplyCompressionCandidate}"/>
                                </StackPanel>
                                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsCompressionPreviewBusy}"/>
                                <TextBlock Text="{Binding CompressionPreviewStatus}"
                                           IsVisible="{Binding HasCompressionPreviewStatus}"
                                           TextWrapping="Wrap" Opacity="0.72"/>
                                <Border Padding="12" BorderThickness="1" BorderBrush="{DynamicResource SemiGreyLowBrush}" CornerRadius="8"
                                        IsVisible="{Binding HasCompressionCandidatePreview}">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="{loc:Loc ContextInspector.Preview.Candidate}" FontWeight="SemiBold"/>
                                        <SelectableTextBlock Text="{Binding CompressionCandidatePreview}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{loc:Loc ContextInspector.Tab.Raw}">
                        <Grid RowDefinitions="Auto,Auto,*" Margin="12">
                            <StackPanel Grid.Row="0" Spacing="6">
                                <TextBlock Text="{loc:Loc ContextInspector.Raw.Warning}" TextWrapping="Wrap" Opacity="0.68"/>
                                <TextBlock Text="{Binding RawContextSnapshotInfo}" FontSize="{DynamicResource App.FontSize.Caption}"
                                           FontFamily="Menlo,Consolas,monospace" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{loc:Loc ContextInspector.Raw.Refresh}" Command="{Binding RefreshRawContextCommand}"/>
                                    <Button Content="{loc:Loc Common.Cancel}" Command="{Binding CancelRawContextBuildCommand}"
                                            IsVisible="{Binding IsRawContextLoading}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,8" Spacing="4">
                                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRawContextLoading}"/>
                                <TextBlock Text="{Binding RawContextStatus}" IsVisible="{Binding HasRawContextStatus}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding RawContextEntries}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.Styles>
                                    <!-- 简洁列表：透明背景、无容器嵌套、悬停/选中不变色。 -->
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                    <Style Selector="ToggleButton.raw-context-toggle">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    </Style>
                                    <Style Selector="ToggleButton.raw-context-toggle:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                    <Style Selector="ToggleButton.raw-context-toggle:checked /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                    <Style Selector="ToggleButton.raw-context-toggle:pressed /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:RawContextEntry">
                                        <StackPanel>
                                            <ToggleButton IsChecked="{Binding IsExpanded}"
                                                          Classes="raw-context-toggle">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="▸"
                                                               IsVisible="{Binding !IsExpanded}"
                                                               FontFamily="Menlo,Consolas,monospace"
                                                               Opacity="0.55"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="▾"
                                                               IsVisible="{Binding IsExpanded}"
                                                               FontFamily="Menlo,Consolas,monospace"
                                                               Opacity="0.55"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Header}"
                                                               Margin="4,0,0,0"
                                                               FontWeight="Bold"
                                                               FontFamily="Menlo,Consolas,monospace"
                                                               Foreground="{Binding Role, Converter={StaticResource RawRoleToBrushConverter}}"/>
                                                </Grid>
                                            </ToggleButton>
                                            <SelectableTextBlock Text="{Binding Text}"
                                                                 IsVisible="{Binding IsExpanded}"
                                                                 Margin="12,4,0,0"
                                                                 FontFamily="Menlo,Consolas,monospace"
                                                                 FontSize="{DynamicResource App.FontSize.Body}"
                                                                 TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <!-- 猫头鹰"飞行层"：dispatch_subagents 时从助手气泡飞向 Sub-Agents 按钮的过场动画。
             覆盖全部行、不拦截交互；owl 图元由 code-behind 动态增删。 -->
        <Canvas x:Name="OwlFlightOverlay"
                Grid.Row="0" Grid.RowSpan="3"
                ZIndex="90"
                IsHitTestVisible="False"
                ClipToBounds="True"/>

        <!-- 子代理"小镇"居中弹窗（覆盖主对话） -->
        <Grid Grid.Row="0" Grid.RowSpan="3" ZIndex="100" IsVisible="{Binding IsSubAgentPopupOpen}">
            <!-- 遮罩：Border（无悬停态，不随光标变色）+ 点击关闭；同时挡住下层 hover -->
            <Border Background="#66000000" PointerPressed="OnSubAgentScrimPressed"/>
            <!-- 居中面板（内部几何已放大，字号不变） -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource App.SectionBg}"
                    CornerRadius="14" BorderBrush="#33808080" BorderThickness="1">
                <views:OwlVillageView/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
