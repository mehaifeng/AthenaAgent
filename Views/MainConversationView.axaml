<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:models="using:Athena.UI.Models"
             xmlns:controls="using:Athena.UI.Controls"
             xmlns:views="using:Athena.UI.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Athena.UI.Markup"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:lmd="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             mc:Ignorable="d" 
             d:DesignWidth="720" 
             d:DesignHeight="1080"
             x:Class="Athena.UI.Views.MainConversationView"
             x:DataType="vm:MainConversationViewModel"
             DragDrop.AllowDrop="True"
             DragDrop.DragOver="OnFilesDragOver"
             DragDrop.Drop="OnFilesDrop">

    <Design.DataContext>
        <vm:MainConversationViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <!-- 加载动画：希腊回纹（Meander）饰带 —— 三个回字涡旋以发丝细线勾勒，
             依次点亮如波浪扫过檐壁铭刻，下承石碑底座式发丝线；纯黑白灰。 -->
        <Style Selector="Path.meander-glyph">
            <Setter Property="Data" Value="M 0,11 V 1 H 10 V 8 H 4 V 4 H 7"/>
            <Setter Property="Stroke" Value="{DynamicResource SemiColorText1}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeJoin" Value="Miter"/>
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Opacity" Value="0.25"/>
        </Style>
        <Style Selector="Path.meander-glyph.m1">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"> <Setter Property="Opacity" Value="0.25"/> </KeyFrame>
                    <KeyFrame Cue="100%"> <Setter Property="Opacity" Value="1.0"/> </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Path.meander-glyph.m2">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut" Delay="0:0:0.3">
                    <KeyFrame Cue="0%"> <Setter Property="Opacity" Value="0.25"/> </KeyFrame>
                    <KeyFrame Cue="100%"> <Setter Property="Opacity" Value="1.0"/> </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Path.meander-glyph.m3">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut" Delay="0:0:0.6">
                    <KeyFrame Cue="0%"> <Setter Property="Opacity" Value="0.25"/> </KeyFrame>
                    <KeyFrame Cue="100%"> <Setter Property="Opacity" Value="1.0"/> </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Rectangle.meander-base">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill" Value="{DynamicResource SemiColorText2}"/>
            <Setter Property="Opacity" Value="0.35"/>
        </Style>

        <!-- 铭文式呼吸文本：衬线体 + 大字距，缓慢明暗如烛光拂过刻字。
             动画拆到 breathing 子类并由 ShowThinkingIndicator 绑定挂/摘：
             Avalonia 对 IsVisible=false 元素的关键帧动画仍会驱动合成器逐帧渲染
             （AvaloniaUI/Avalonia#17139），静态挂类会让聊天页闲置时也全程重绘。 -->
        <Style Selector="TextBlock.thinking-text">
            <Setter Property="FontFamily" Value="Georgia, Times New Roman, Songti SC, SimSun, serif"/>
            <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Body}"/>
            <Setter Property="LetterSpacing" Value="3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}"/>
        </Style>
        <Style Selector="TextBlock.thinking-text.breathing">
            <Style.Animations>
                <Animation Duration="0:0:2.2" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"> <Setter Property="Opacity" Value="0.35"/> </KeyFrame>
                    <KeyFrame Cue="100%"> <Setter Property="Opacity" Value="0.9"/> </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- 消息气泡基础样式 -->
        <Style Selector="Border.message-bubble">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGreyLowBrush}"/>
            <Setter Property="MaxWidth" Value="{DynamicResource App.ContentMaxWidth}"/>
        </Style>

        <!-- 用户消息气泡 -->
        <Style Selector="Border.user-bubble">
            <Setter Property="Background" Value="{DynamicResource Chat.UserBubbleBg}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- AI 消息气泡 -->
        <Style Selector="Border.assistant-bubble">
            <Setter Property="Background" Value="{DynamicResource Chat.AssistantBubbleBg}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- 角色标题颜色 -->
        <Style Selector="TextBlock.role-title">
            <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Body}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.user-title">
            <Setter Property="Foreground" Value="{DynamicResource App.EmphasisForeground}"/>
        </Style>
        <Style Selector="TextBlock.assistant-title">
            <Setter Property="Foreground" Value="{DynamicResource SemiGreen6}"/>
        </Style>

        <Style Selector="Border.attachment-card">
            <Setter Property="Width" Value="116"/>
            <Setter Property="MinHeight" Value="92"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGreyLowBrush}"/>
            <Setter Property="Background" Value="{DynamicResource App.SectionBg}"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

        <Style Selector="Border.audio-attachment-card">
            <Setter Property="MinWidth" Value="240"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGreyLowBrush}"/>
            <Setter Property="Background" Value="{DynamicResource App.SectionBg}"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style Selector="Border.inline-generated-image">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource App.SectionBg}"/>
            <Setter Property="MaxWidth" Value="560"/>
        </Style>

        <!-- Sub-Agents 按钮：运行中涟漪光环（琥珀色，与小镇"运行中"猫头鹰同色系）。
             平时透明不占视觉；active 时从按钮轮廓向外扩散并淡出，无限循环。 -->
        <Style Selector="Border.subagents-glow">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BA7517"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform">
                <ScaleTransform/>
            </Setter>
        </Style>
        <Style Selector="Border.subagents-glow.active">
            <Style.Animations>
                <Animation Duration="0:0:2.4" IterationCount="Infinite" Easing="SineEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.4"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="1.10"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.4"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Sub-Agents 右下角代理数角标：运行中琥珀色，闲时灰色。 -->
        <Style Selector="Border.subagents-badge">
            <Setter Property="MinWidth" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="Background" Value="#9E9A90"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,-5,-5"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Border.subagents-badge.running">
            <Setter Property="Background" Value="#BA7517"/>
        </Style>

        <!-- 气泡操作按钮：默认隐藏，光标进入该消息气泡区域时淡入 -->
        <Style Selector="StackPanel.bubble-actions">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.message-row:pointerover StackPanel.bubble-actions">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="Button.attachment-remove-button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="40,*,Auto">

        <!-- 聊天区域头部 -->
        <Border Grid.Row="0"
                Background="{DynamicResource App.SectionBg}"
                CornerRadius="0,0,5,5"
                VerticalAlignment="Center"
                Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Chat.Header}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource App.FontSize.Heading}"/>

                    <!-- 调试：切换原始上下文(raw)视图，仅在对话流完成时可用 -->
                    <ToggleButton IsChecked="{Binding IsRawContextView}"
                                  IsEnabled="{Binding CanToggleRawContext}"
                                  VerticalAlignment="Center"
                                  Padding="5"
                                  ToolTip.Tip="{loc:Loc Chat.Raw.Toggle}">
                        <PathIcon Data="{StaticResource AthenaIconRawJson}" Width="15" Height="15"
                                  Foreground="{DynamicResource App.IconAccentForeground}"/>
                    </ToggleButton>

                    <!-- 子代理入口：始终可用，居中弹出"猫头鹰小镇"。
                         整体包在 Panel 里：底层涟漪光环（运行时循环）+ 按钮 + 右下角数量角标；
                         Panel 挂 ScaleTransform，猫头鹰飞抵时由 code-behind 做弹跳脉冲。 -->
                    <Panel x:Name="SubAgentsEntry"
                           VerticalAlignment="Center"
                           RenderTransformOrigin="50%,50%">
                        <Panel.RenderTransform>
                            <ScaleTransform/>
                        </Panel.RenderTransform>
                        <Border Classes="subagents-glow"
                                Classes.active="{Binding HasRunningSubAgents}"/>
                        <Button x:Name="SubAgentsButton"
                                VerticalAlignment="Center"
                                Padding="5"
                                Command="{Binding ToggleSubAgentPopupCommand}"
                                ToolTip.Tip="{loc:Loc Chat.SubAgents.Toggle}">
                            <PathIcon Data="{StaticResource AthenaIconSubAgentsOwl}" Width="16" Height="16"
                                      Foreground="{DynamicResource App.IconAccentForeground}"/>
                        </Button>
                        <Border Classes="subagents-badge"
                                Classes.running="{Binding HasRunningSubAgents}"
                                IsVisible="{Binding HasSubAgents}">
                            <TextBlock Text="{Binding SubAgentCount}"
                                       FontSize="{DynamicResource App.FontSize.Tiny}" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Panel>
                </StackPanel>

                <Grid Grid.Column="1"
                      Width="150"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      ToolTip.Tip="{Binding ContextTokensInfo}">
                    <ProgressBar Minimum="0"
                                 Maximum="{Binding TokenService.MaxTokens}"
                                 Value="{Binding TokenService.CurrentTokens}"
                                 Height="18"
                                 CornerRadius="4"/>
                    <TextBlock Text="{Binding ContextTokensInfo}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource App.FontSize.Caption}"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Button Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleThemeCommand}"
                        Tag="{Binding ThemeIcon}"
                        Margin="0,0,8,0"
                        ToolTip.Tip="{loc:Loc Chat.BtnTheme}">
                    <Panel>
                        <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconMoon}" IsVisible="{Binding ThemeIcon, Converter={StaticResource ThemeTagToVisibilityConverter}, ConverterParameter=Moon}"/>
                        <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconSun}" IsVisible="{Binding ThemeIcon, Converter={StaticResource ThemeTagToVisibilityConverter}, ConverterParameter=Sun}"/>
                    </Panel>
                </Button>
                
                <Button Grid.Column="3"
                        VerticalAlignment="Center"
                        Command="{Binding NewConversationCommand}"
                        IsEnabled="{Binding !IsResetting}"
                        Margin="0,0,8,0"
                        ToolTip.Tip="{loc:Loc Chat.BtnReset}">
                    <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconPlusCircle}"/>
                </Button>
            </Grid>
        </Border>

        <!-- 聊天消息列表 -->
        <ScrollViewer Grid.Row="1" Name="ChatScrollViewer" Padding="12"
                      IsVisible="{Binding !IsRawContextView}">
            <ItemsControl x:Name="MessagesItemsControl"
                          ItemsSource="{Binding Messages}"
                          MaxWidth="{DynamicResource App.ContentMaxWidth}"
                          HorizontalAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage">
                        <Grid Classes="message-row" Margin="0,0,0,40" IsVisible="{Binding IsBubbleVisible}" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="{Binding IsUser, Converter={StaticResource IntToColumnConverter}, ConverterParameter=UserAlign}"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="{Binding IsUser, Converter={StaticResource BoolToAlignmentConverter}}"
                                        Spacing="4">

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                                    <TextBlock Text="{Binding IsUser, Converter={StaticResource RoleToTitleConverter}}"
                                               Classes.role-title="True"
                                               Classes.user-title="{Binding IsUser}"
                                               Classes.assistant-title="{Binding !IsUser}"/>
                                    
                                    <TextBlock Text="{Binding TimestampText}"
                                               Foreground="{DynamicResource Chat.TimestampFg}" 
                                               FontSize="{DynamicResource App.FontSize.Caption}" 
                                               VerticalAlignment="Center"/>
                                    
                                    <TextBlock Text="{loc:Loc Chat.Archived}" 
                                               IsVisible="{Binding IsCompressed}" 
                                               Foreground="{DynamicResource Chat.ArchivedFg}" 
                                               FontSize="{DynamicResource App.FontSize.Caption}" 
                                               VerticalAlignment="Center" 
                                               FontWeight="Bold"/>
                                </StackPanel>

                                <Border Classes="message-bubble"
                                        Classes.user-bubble="{Binding IsUser}"
                                        Classes.assistant-bubble="{Binding !IsUser}">
                                    <StackPanel Spacing="4">
                                        <!-- Content 为 null 时不实例化重型 Markdown 模板。 -->
                                        <ContentControl Content="{Binding LegacyMarkdownContent}">
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate x:DataType="models:ChatMessage">
                                                    <lmd:MarkdownRenderer
                                                        loc:MarkdownHelper.Text="{Binding DisplayText}"
                                                        HorizontalAlignment="Stretch" />
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>

                                        <ItemsControl ItemsSource="{Binding SegmentContent}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:ChatMessageSegment">
                                                    <StackPanel Margin="0,0,0,6">
                                                        <ContentControl Content="{Binding MarkdownContent}">
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate x:DataType="models:ChatMessageSegment">
                                                                    <lmd:MarkdownRenderer
                                                                        loc:MarkdownHelper.Text="{Binding Text}"
                                                                        HorizontalAlignment="Stretch" />
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>

                                                        <ContentControl Content="{Binding GeneratedImageContent}">
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate x:DataType="models:ChatMessageSegment">
                                                                    <Button Command="{Binding $parent[UserControl].((vm:MainConversationViewModel)DataContext).OpenImageAttachmentCommand}"
                                                                            CommandParameter="{Binding Attachment}"
                                                                            Padding="0"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            HorizontalAlignment="Left">
                                                                        <Border Classes="inline-generated-image">
                                                                            <Image Source="{Binding Attachment.PreviewImage}"
                                                                                   Stretch="Uniform"
                                                                                   MaxWidth="560"/>
                                                                        </Border>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>

                                                        <ContentControl Content="{Binding ToolCallContent}">
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate x:DataType="models:ChatMessageSegment">
                                                                    <!-- 工具调用组：自定义折叠容器（收起露 3 个 + 第 4 个 peek + 底部朦胧） -->
                                                                    <controls:ToolCallStackView HorizontalAlignment="Stretch"/>
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding AttachmentPanelItems}" IsVisible="{Binding ShouldShowAttachmentPanel}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:ChatAttachment">
                                                    <Grid Margin="0,4,8,4">
                                                        <ContentControl Content="{Binding ImageContent}">
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate x:DataType="models:ChatAttachment">
                                                                    <Button Command="{Binding $parent[UserControl].((vm:MainConversationViewModel)DataContext).OpenImageAttachmentCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            Padding="0"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            HorizontalAlignment="Left"
                                                                            ToolTip.Tip="{Binding DisplayName}">
                                                                        <Border Classes="attachment-card">
                                                                            <Grid RowDefinitions="56,Auto,Auto">
                                                                                <Border Grid.Row="0" CornerRadius="5" ClipToBounds="True" Background="{DynamicResource SemiGreyLowBrush}">
                                                                                    <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"/>
                                                                                </Border>
                                                                                <TextBlock Grid.Row="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource App.FontSize.Body}" Margin="0,5,0,0"/>
                                                                                <TextBlock Grid.Row="2" Text="{Binding DisplaySize}" FontSize="{DynamicResource App.FontSize.Caption}" Opacity="0.65"/>
                                                                            </Grid>
                                                                        </Border>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>

                                                        <ContentControl Content="{Binding GenericFileContent}">
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate x:DataType="models:ChatAttachment">
                                                                    <Border Classes="attachment-card">
                                                                        <Grid RowDefinitions="56,Auto,Auto">
                                                                            <Border Grid.Row="0" Background="{DynamicResource SemiGreyLowBrush}" CornerRadius="5">
                                                                                <TextBlock Text="{Binding FileExtension}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource App.FontSize.Subheading}" FontWeight="Bold"/>
                                                                            </Border>
                                                                            <TextBlock Grid.Row="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource App.FontSize.Body}" Margin="0,5,0,0"/>
                                                                            <TextBlock Grid.Row="2" Text="{Binding DisplaySize}" FontSize="{DynamicResource App.FontSize.Caption}" Opacity="0.65"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>

                                                        <ContentControl Content="{Binding AudioContent}">
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate x:DataType="models:ChatAttachment">
                                                                    <Border Classes="audio-attachment-card">
                                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                                            <Panel Grid.Column="0" VerticalAlignment="Center">
                                                                                <Button Width="32" Height="32" Padding="0" IsVisible="{Binding !IsPlaying}" Command="{Binding $parent[UserControl].((vm:MainConversationViewModel)DataContext).ToggleAudioPlaybackCommand}" CommandParameter="{Binding}" ToolTip.Tip="{loc:Loc Chat.Audio.Play}">
                                                                                    <PathIcon Data="{StaticResource SemiIconPlay}" Width="14" Height="14"/>
                                                                                </Button>
                                                                                <Button Width="32" Height="32" Padding="0" IsVisible="{Binding IsPlaying}" Command="{Binding $parent[UserControl].((vm:MainConversationViewModel)DataContext).ToggleAudioPlaybackCommand}" CommandParameter="{Binding}" ToolTip.Tip="{loc:Loc Chat.Audio.Stop}">
                                                                                    <PathIcon Data="{StaticResource SemiIconStop}" Width="14" Height="14"/>
                                                                                </Button>
                                                                            </Panel>
                                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,8,0"/>
                                                                            <TextBlock Grid.Column="2" Text="{Binding DisplaySize}" FontSize="{DynamicResource App.FontSize.Caption}" Opacity="0.65" VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border IsVisible="{Binding HasAudioError}"
                                                Background="{DynamicResource App.SectionBg}"
                                                BorderBrush="{DynamicResource SemiRed6}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,8">
                                            <TextBlock Text="{Binding AudioErrorMessage}"
                                                       Foreground="{DynamicResource SemiRed6}"
                                                       TextWrapping="Wrap"
                                                       FontSize="{DynamicResource App.FontSize.Body}"/>
                                        </Border>

                                        <!-- 后台语音生成中提示（不阻塞任何交互） -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsGeneratingAudio}">
                                            <PathIcon Data="{StaticResource SemiIconLoading}" Classes.SlowSpin="{Binding IsGeneratingAudio}" Width="13" Height="13" Opacity="0.6"/>
                                            <TextBlock Text="{loc:Loc Chat.Audio.Generating}" FontStyle="Italic" Opacity="0.6" FontSize="{DynamicResource App.FontSize.Body}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- 手动生成语音：语音开启但该消息尚无音频时出现（补生成被挤掉的/历史消息的语音） -->
                                        <Button HorizontalAlignment="Left"
                                                Padding="8,4"
                                                FontSize="{DynamicResource App.FontSize.Body}"
                                                IsVisible="{Binding CanGenerateAudio}"
                                                Command="{Binding $parent[UserControl].((vm:MainConversationViewModel)DataContext).GenerateMessageAudioCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{loc:Loc Chat.Audio.Generate}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="{StaticResource SemiIconVolume2}" Width="13" Height="13" Opacity="0.75"/>
                                                <TextBlock Text="{loc:Loc Chat.Audio.Generate}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasToolExecutionSummary}">
                                            <PathIcon Data="{StaticResource SemiIconLoading}" Classes.SlowSpin="{Binding HasToolExecutionSummary}" Width="14" Height="14" Opacity="0.6"/>
                                            <TextBlock Text="{Binding ToolExecutionSummary}" FontStyle="Italic" Opacity="0.6" FontSize="{DynamicResource App.FontSize.Subheading}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel IsVisible="{Binding IsLoading}" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <StackPanel Orientation="Vertical" Spacing="3" VerticalAlignment="Center"
                                                        IsVisible="{Binding !HasToolExecutionSummary}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Path Classes="meander-glyph" Classes.m1="{Binding ShowThinkingIndicator}"/>
                                                    <Path Classes="meander-glyph" Classes.m2="{Binding ShowThinkingIndicator}"/>
                                                    <Path Classes="meander-glyph" Classes.m3="{Binding ShowThinkingIndicator}"/>
                                                </StackPanel>
                                                <Rectangle Classes="meander-base" Width="41"/>
                                            </StackPanel>
                                            <TextBlock Classes="thinking-text"
                                                       Classes.breathing="{Binding ShowThinkingIndicator}"
                                                       Text="{loc:Loc Chat.ReceivingData}"
                                                       IsVisible="{Binding ShowDefaultThinkingText}"/>
                                            <TextBlock Classes="thinking-text"
                                                       Classes.breathing="{Binding ShowThinkingIndicator}"
                                                       Text="{loc:Loc Chat.ComposingFileText}"
                                                       IsVisible="{Binding ShowComposingFileText}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 操作按钮：默认隐藏，悬停气泡区域时显示；user 靠右、assistant 靠左 -->
                                <StackPanel Classes="bubble-actions" Orientation="Horizontal" Spacing="8"
                                            HorizontalAlignment="{Binding IsUser, Converter={StaticResource BoolToAlignmentConverter}}"
                                            IsVisible="{Binding !IsLoading}">
                                    <Button Command="{Binding $parent[ItemsControl].((vm:MainConversationViewModel)DataContext).CopyMessageCommand}"
                                            CommandParameter="{Binding}"
                                            FontSize="{DynamicResource App.FontSize.Body}"
                                            ToolTip.Tip="{loc:Loc Chat.BtnCopy}">
                                        <PathIcon Data="{StaticResource SemiIconCopy}" Width="14" Height="14"/>
                                    </Button>

                                    <Button Command="{Binding $parent[ItemsControl].((vm:MainConversationViewModel)DataContext).RewindToMessageCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding CanShowRewind}"
                                            FontSize="{DynamicResource App.FontSize.Body}"
                                            ToolTip.Tip="{loc:Loc Chat.BtnRewind}">
                                        <PathIcon Data="{StaticResource SemiIconUndo}" Width="14" Height="14"/>
                                    </Button>

                                    <Button Command="{Binding $parent[ItemsControl].((vm:MainConversationViewModel)DataContext).ForkFromMessageCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding CanShowRewind}"
                                            FontSize="{DynamicResource App.FontSize.Body}"
                                            ToolTip.Tip="{loc:Loc Chat.BtnFork}">
                                        <PathIcon Data="{StaticResource SemiIconSourceControl}" Width="14" Height="14"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 调试：原始上下文(raw)视图，与消息列表叠放在同一行，按开关切换。
             按消息拆分为独立块 + 虚拟化列表：选择只作用于单块、滚动只渲染可见块，避免大文本卡顿。 -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,5,0,5"
                      IsVisible="{Binding IsRawContextView}">
            <Border 
                CornerRadius="12"
                Background="{DynamicResource App.SectionBg}">
                <!-- 不使用虚拟化：条目高度差异极大（折叠/展开），虚拟化的滚动范围估算会导致滚动条跳跃；
                     默认折叠后折叠态渲染开销很低，普通 StackPanel 即可保证线性、稳定的滚动。 -->
                <ItemsControl ItemsSource="{Binding RawContextEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:RawContextEntry">
                            <Expander Margin="0,0,0,8"
                                      HorizontalAlignment="Stretch"
                                      IsExpanded="{Binding IsExpanded}">
                                <Expander.Header>
                                    <TextBlock Text="{Binding Header}"
                                               FontWeight="Bold"
                                               FontSize="{DynamicResource App.FontSize.Body}"
                                               FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                               Foreground="{Binding Role, Converter={StaticResource RawRoleToBrushConverter}}"/>
                                </Expander.Header>
                                <SelectableTextBlock Text="{Binding Text}"
                                                     FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                                     FontSize="{DynamicResource App.FontSize.Body}"
                                                     TextWrapping="Wrap"/>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </ScrollViewer>

        <!-- 输入区域：整体为一个大输入框，文本框在上、功能按钮工具栏在底部 -->
        <Border Grid.Row="2"
                MaxWidth="{DynamicResource App.ContentMaxWidth}"
                HorizontalAlignment="Stretch">
            <Border CornerRadius="5"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                    Background="{DynamicResource App.SectionBg}"
                    Padding="8">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                <!-- 工作区指示器 -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                    <Button x:Name="WorkspaceSelectorButton"
                            Grid.Column="0"
                            Command="{Binding ToggleWorkspaceFlyoutCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            Padding="6,3"
                            ToolTip.Tip="{loc:Loc Chat.Workspace.SwitchTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource SemiIconFolder}" Width="12" Height="12" Opacity="0.6"/>
                            <TextBlock Text="{Binding CurrentWorkspaceDisplayName}"
                                       FontSize="{DynamicResource App.FontSize.Body}"
                                       Opacity="0.8"
                                       VerticalAlignment="Center"/>
                            <PathIcon Data="{StaticResource SemiIconChevronDown}" Width="9" Height="9" Opacity="0.4"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 工作区下拉面板：Popup 不参与输入区布局，点击外部或失焦自动关闭。 -->
                <Popup x:Name="WorkspaceFlyoutPopup"
                       DataContext="{Binding DataContext, ElementName=WorkspaceSelectorButton}"
                       IsOpen="{Binding IsWorkspaceFlyoutOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding #WorkspaceSelectorButton}"
                       Placement="BottomEdgeAlignedLeft"
                       IsLightDismissEnabled="True">
                    <Border
                        Background="{DynamicResource App.SectionBg}"
                        BorderBrush="{DynamicResource SemiGreyLowBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="6"
                        BoxShadow="0 4 12 0 #40000000">
                    <StackPanel Spacing="4" MinWidth="240" MaxWidth="360">
                        <TextBlock Text="{loc:Loc Chat.Workspace.SelectExisting}"
                                   FontSize="{DynamicResource App.FontSize.Body}" Opacity="0.6" Margin="0,0,0,4"/>
                        <Button Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="6,4"
                                Command="{Binding SelectWorkspaceCommand}"
                                CommandParameter="{x:Null}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource SemiIconComment}" Width="12" Height="12" Opacity="0.6"/>
                                <TextBlock Text="{loc:Loc Chat.Workspace.Global}" FontSize="{DynamicResource App.FontSize.Body}"/>
                            </StackPanel>
                        </Button>
                        <ItemsControl ItemsSource="{Binding AvailableWorkspaces}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:WorkspaceProfile">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                                        <Button Grid.Column="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Padding="6,4"
                                                Command="{Binding #WorkspaceFlyoutPopup.DataContext.SelectWorkspaceCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <PathIcon Grid.Column="0" Data="{StaticResource SemiIconFolder}" Width="12" Height="12" Opacity="0.5" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Spacing="1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource App.FontSize.Body}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding DirectoryPath}" FontSize="{DynamicResource App.FontSize.Caption}" Opacity="0.5" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1"
                                                Classes="danger"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="3"
                                                VerticalAlignment="Center"
                                                Command="{Binding #WorkspaceFlyoutPopup.DataContext.RemoveWorkspaceCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{loc:Loc Chat.Workspace.Remove}">
                                            <PathIcon Data="{StaticResource SemiIconClose}" Width="10" Height="10" Opacity="0.4"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Separator Margin="0,4"/>
                        <Button Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="6,4"
                                Command="{Binding AddWorkspaceCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource SemiIconPlus}" Width="12" Height="12" Opacity="0.6"/>
                                <TextBlock Text="{loc:Loc Chat.Workspace.Add}" FontSize="{DynamicResource App.FontSize.Body}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    </Border>
                </Popup>

                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding PendingAttachments}"
                              IsVisible="{Binding HasPendingAttachments}"
                              Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ChatAttachment">
                            <Border Classes="attachment-card" Margin="0,0,8,8">
                                <Grid RowDefinitions="56,Auto,Auto">
                                    <Border Grid.Row="0"
                                            CornerRadius="5"
                                            ClipToBounds="True"
                                            Background="{DynamicResource SemiGreyLowBrush}">
                                        <Image Source="{Binding PreviewImage}"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding IsImage}"/>
                                    </Border>
                                    <Border Grid.Row="0"
                                            IsVisible="{Binding !IsImage}"
                                            Background="{DynamicResource SemiGreyLowBrush}"
                                            CornerRadius="5">
                                        <TextBlock Text="{Binding FileExtension}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="{DynamicResource App.FontSize.Subheading}"
                                                   FontWeight="Bold"/>
                                    </Border>
                                    <Button Grid.Row="0"
                                            Classes="attachment-remove-button"
                                            Command="{Binding $parent[ItemsControl].((vm:MainConversationViewModel)DataContext).RemovePendingAttachmentCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{loc:Loc Chat.Attach.Remove}">
                                        <PathIcon Data="{StaticResource SemiIconClose}" Width="12" Height="12"/>
                                    </Button>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="{DynamicResource App.FontSize.Body}"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding DisplaySize}"
                                               FontSize="{DynamicResource App.FontSize.Caption}"
                                               Opacity="0.65"/>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="2"
                           Text="{Binding BackgroundArchiveStatusMessage}"
                           Foreground="{DynamicResource Chat.TimestampFg}"
                           FontSize="{DynamicResource App.FontSize.Body}"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasBackgroundArchiveNeutralStatus}"/>

                <TextBlock Grid.Row="2"
                           Text="{Binding BackgroundArchiveStatusMessage}"
                           Foreground="{DynamicResource SemiRed6}"
                           FontSize="{DynamicResource App.FontSize.Body}"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasBackgroundArchiveErrorStatus}"/>

                <TextBlock Grid.Row="3"
                           Text="{Binding AttachmentStatusMessage}"
                           IsVisible="{Binding HasAttachmentStatusMessage}"
                           Foreground="{DynamicResource SemiRed6}"
                           FontSize="{DynamicResource App.FontSize.Body}"
                           Margin="0,0,0,8"/>

                <!-- 文本输入：无边框，融入外层卡片 -->
                <TextBox x:Name="MessageInputTextBox"
                         Grid.Row="4"
                         Text="{Binding InputText}"
                         PlaceholderText="{Binding InputPlaceholder, Converter={StaticResource LocConverter}}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="4,2"
                         MaxHeight="150">
                    <!-- 覆盖 Semi 主题驱动悬停/聚焦高亮的画刷，使输入框完全融入外层卡片 -->
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextBoxDefaultBorderBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextBoxPointeroverBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextBoxPointeroverBorderBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextBoxFocusBorderBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextBoxPressedBackground" Color="Transparent"/>
                        <Thickness x:Key="TextBoxBorderThickness">0</Thickness>
                    </TextBox.Resources>
                    <TextBox.KeyBindings>
                        <KeyBinding Command="{Binding SendMessageCommand}" Gesture="Enter"/>
                    </TextBox.KeyBindings>
                </TextBox>

                <!-- 底部功能工具栏：左侧功能按钮，右侧模型和发送/停止 -->
                <Grid Grid.Row="5" ColumnDefinitions="*,100,50" ColumnSpacing="10" Margin="0,6,0,0">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">
                        <Button Command="{Binding AttachFileCommand}"
                                BorderThickness="0"
                                Padding="6"
                                IsEnabled="{Binding CanAcceptAttachments}"
                                ToolTip.Tip="{loc:Loc Chat.Attach.Add}">
                            <PathIcon Data="{StaticResource SemiIconPlus}" Width="18" Height="18"/>
                        </Button>
                        <u:IconSplitButton Icon="{StaticResource SemiIconScissors}"
                                           IsEnabled="{Binding !IsSending}"
                                           Command="{Binding CaptureScreenshotCommand}"
                                           CommandParameter="keep"
                                           ToolTip.Tip="{loc:Loc Chat.Screenshot.Add}">
                            <u:IconSplitButton.Flyout>
                                <MenuFlyout Placement="Top">
                                    <MenuItem Header="{loc:Loc Chat.Screenshot.HideWindow}"
                                              Command="{Binding CaptureScreenshotCommand}"
                                              CommandParameter="hide"/>
                                </MenuFlyout>
                            </u:IconSplitButton.Flyout>
                        </u:IconSplitButton>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding CurrentModelName}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Chat.TimestampFg}"
                               FontSize="{DynamicResource App.FontSize.Body}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding CurrentModelName}"/>

                    <Button Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            Command="{Binding SendMessageCommand}"
                            Theme="{StaticResource AccentButtonTheme}"
                            IsVisible="{Binding !IsSending}"
                            ToolTip.Tip="{loc:Loc Chat.BtnExecute}">
                        <PathIcon Data="{StaticResource SemiIconSend}" Width="16" Height="16"/>
                    </Button>

                    <Button Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            Command="{Binding StopResponseCommand}"
                            Theme="{StaticResource AccentButtonTheme}"
                            IsVisible="{Binding IsSending}"
                            ToolTip.Tip="{loc:Loc Chat.BtnStop}">
                        <PathIcon Data="{StaticResource SemiIconStop}"
                                  Width="16"
                                  Height="16"
                                  Foreground="{DynamicResource SemiRed6}"/>
                    </Button>
                </Grid>
            </Grid>
            </Border>
        </Border>

        <!-- 猫头鹰"飞行层"：dispatch_subagents 时从助手气泡飞向 Sub-Agents 按钮的过场动画。
             覆盖全部行、不拦截交互；owl 图元由 code-behind 动态增删。 -->
        <Canvas x:Name="OwlFlightOverlay"
                Grid.Row="0" Grid.RowSpan="3"
                ZIndex="90"
                IsHitTestVisible="False"
                ClipToBounds="True"/>

        <!-- 子代理"小镇"居中弹窗（覆盖主对话） -->
        <Grid Grid.Row="0" Grid.RowSpan="3" ZIndex="100" IsVisible="{Binding IsSubAgentPopupOpen}">
            <!-- 遮罩：Border（无悬停态，不随光标变色）+ 点击关闭；同时挡住下层 hover -->
            <Border Background="#66000000" PointerPressed="OnSubAgentScrimPressed"/>
            <!-- 居中面板（内部几何已放大，字号不变） -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource App.SectionBg}"
                    CornerRadius="14" BorderBrush="#33808080" BorderThickness="1">
                <views:OwlVillageView/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
