<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Athena.UI.ViewModels"
        xmlns:loc="using:Athena.UI.Markup"
        x:Class="Athena.UI.Views.AppSettingsWindow"
        x:DataType="vm:AppSettingsWindowViewModel"
        Title="{loc:Loc Settings.Window.Title}"
        Width="1080"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="5" ColumnDefinitions="250,5,*">
        <Border Padding="8"
                Background="{DynamicResource App.WorkspaceLeftBackground}"
                BorderThickness="1"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                CornerRadius="8">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Margin="10,8,10,16" Spacing="4">
                    <TextBlock Text="{loc:Loc Settings.Window.Title}"
                               FontSize="{DynamicResource App.FontSize.PageTitle}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Loc Settings.Window.Subtitle}"
                               TextWrapping="Wrap"
                               Opacity="0.62"/>
                </StackPanel>
                <ListBox x:Name="SettingsNavigation"
                         Grid.Row="1"
                         ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppSettingsSection">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="2,4">
                                <PathIcon Grid.Column="0"
                                          Width="16"
                                          Height="16"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource App.IconAccentForeground}"
                                          IsVisible="{Binding IconKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                          Data="{Binding IconKey, Converter={StaticResource ToolIconKeyToGeometryConverter}}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Background="{DynamicResource App.WorkspaceRightBackground}"
                BorderThickness="1"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                CornerRadius="8"
                ClipToBounds="True">
            <ContentControl x:Name="SettingsContentHost"
                            Content="{Binding SelectedSection.Content}"/>
        </Border>
    </Grid>
</Window>
