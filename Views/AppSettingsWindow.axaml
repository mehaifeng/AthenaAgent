<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Athena.UI.ViewModels"
        xmlns:views="using:Athena.UI.Views"
        xmlns:loc="using:Athena.UI.Markup"
        x:Class="Athena.UI.Views.AppSettingsWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="应用设置"
        Width="900" Height="720" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="760">
            <TextBlock Text="应用设置" FontSize="{DynamicResource App.FontSize.PageTitle}" FontWeight="SemiBold"/>
            <TextBlock Text="修改即时保存。" Opacity="0.65"/>
            <Border Padding="16" BorderThickness="1" BorderBrush="{DynamicResource SemiGreyLowBrush}" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="外观与语言" FontSize="{DynamicResource App.FontSize.Title}" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="180,*">
                        <TextBlock Text="主题" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" SelectedItem="{Binding AppSettings.Config.Theme}">
                            <x:String>Dark</x:String><x:String>Light</x:String>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="180,*">
                        <TextBlock Text="语言" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" SelectedItem="{Binding AppSettings.Config.Language}">
                            <x:String>zh-CN</x:String><x:String>en-US</x:String>
                        </ComboBox>
                    </Grid>
                    <CheckBox Content="{loc:Loc Config.SkipRewindConfirm}"
                              IsChecked="{Binding AppSettings.Config.SkipRewindConfirm}"/>
                </StackPanel>
            </Border>
            <Border Padding="16" BorderThickness="1" BorderBrush="{DynamicResource SemiGreyLowBrush}" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="运行与上下文" FontSize="{DynamicResource App.FontSize.Title}" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="260,*"><TextBlock Text="主对话全局并发上限"/><NumericUpDown Grid.Column="1" Minimum="1" Maximum="16" Value="{Binding AppSettings.Config.MainConversationMaxParallel}"/></Grid>
                    <Grid ColumnDefinitions="260,*"><TextBlock Text="最大上下文 Token"/><NumericUpDown Grid.Column="1" Minimum="1000" Maximum="2000000" Value="{Binding AppSettings.Config.MaxContextTokens}"/></Grid>
                    <Grid ColumnDefinitions="260,*"><TextBlock Text="自动压缩阈值"/><NumericUpDown Grid.Column="1" Minimum="1000" Maximum="2000000" Value="{Binding AppSettings.Config.CompressionThreshold}"/></Grid>
                    <Grid ColumnDefinitions="260,*"><TextBlock Text="工作区知识预算"/><NumericUpDown Grid.Column="1" Minimum="0" Maximum="100000" Value="{Binding AppSettings.Config.WorkspaceKnowledgeTokenBudget}"/></Grid>
                    <CheckBox Content="自动压缩上下文" IsChecked="{Binding AppSettings.Config.AutoCompress}"/>
                </StackPanel>
            </Border>
            <Border Padding="16" BorderThickness="1" BorderBrush="{DynamicResource SemiGreyLowBrush}" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="工具审批" FontSize="{DynamicResource App.FontSize.Title}" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="180,*">
                        <TextBlock Text="当前模式" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding AppSettings.Config.ToolApprovalMode}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <WrapPanel>
                        <Button Content="均衡"
                                Command="{Binding AppSettings.SetApprovalModeCommand}"
                                CommandParameter="Balanced"
                                Margin="0,0,6,0"/>
                        <Button Content="严格"
                                Command="{Binding AppSettings.SetApprovalModeCommand}"
                                CommandParameter="Strict"
                                Margin="0,0,6,0"/>
                        <Button Content="自动"
                                Command="{Binding AppSettings.SetApprovalModeCommand}"
                                CommandParameter="Automatic"
                                Margin="0,0,6,0"/>
                        <Button Content="关闭"
                                Command="{Binding AppSettings.SetApprovalModeCommand}"
                                CommandParameter="Off"/>
                    </WrapPanel>
                    <CheckBox Content="子代理继承永久放行清单"
                              IsChecked="{Binding AppSettings.Config.SubAgentsInheritApproval}"/>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Loc Config.ToolApproval.AutoAllowed}" Opacity="0.8"/>
                        <ItemsControl ItemsSource="{Binding AppSettings.Config.AutoAllowedTools}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                        <TextBlock Text="{Binding}"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Consolas, Menlo, monospace"/>
                                        <Button Grid.Column="1"
                                                Content="{loc:Loc Config.ToolApproval.Revoke}"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AppSettings.RevokeAutoAllowedToolCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="8,2"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Loc Config.ToolApproval.TerminalAllowlist}" Opacity="0.8"/>
                        <ItemsControl ItemsSource="{Binding AppSettings.Config.TerminalAllowlist}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                        <TextBlock Text="{Binding}"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Consolas, Menlo, monospace"/>
                                        <Button Grid.Column="1"
                                                Content="{loc:Loc Config.ToolApproval.Revoke}"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AppSettings.RevokeTerminalAllowlistCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="8,2"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Padding="16" BorderThickness="1" BorderBrush="{DynamicResource SemiGreyLowBrush}" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:Loc Config.BrowserDiagnostics}"
                               FontSize="{DynamicResource App.FontSize.Title}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Loc Config.BrowserUnifiedModelHint}" Opacity="0.65"/>
                    <WrapPanel>
                        <Button x:Name="TestBrowserRuntimeButton"
                                Content="{loc:Loc Config.BrowserTestRuntime}"
                                Command="{Binding AppSettings.TestBrowserRuntimeCommand}"
                                Margin="0,0,6,0"/>
                        <Button x:Name="InstallBrowserRuntimeButton"
                                Content="{loc:Loc Config.BrowserInstallRuntime}"
                                Command="{Binding AppSettings.InstallBrowserRuntimeCommand}"
                                Margin="0,0,6,0"/>
                        <Button x:Name="TestBrowserAgentButton"
                                Content="{loc:Loc Config.BtnRunDiagnostics}"
                                Command="{Binding AppSettings.TestBrowserAgentCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding AppSettings.BrowserRuntimeStatus}"
                               IsVisible="{Binding AppSettings.HasBrowserRuntimeStatus}"
                               TextWrapping="Wrap"
                               Opacity="0.7"/>
                    <TextBlock Text="{Binding AppSettings.BrowserAgentTestStatus}"
                               IsVisible="{Binding AppSettings.HasBrowserAgentTestStatus}"
                               TextWrapping="Wrap"
                               Opacity="0.7"/>
                </StackPanel>
            </Border>
            <Border Padding="16" BorderThickness="1" BorderBrush="{DynamicResource SemiGreyLowBrush}" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="子代理" FontSize="{DynamicResource App.FontSize.Title}" FontWeight="SemiBold"/>
                    <CheckBox Content="启用子代理"
                              IsChecked="{Binding AppSettings.Config.EnableSubAgents}"/>
                    <TextBlock Text="模型在“供应商模型 / 子代理”分工中选择。" Opacity="0.65"/>
                    <Grid ColumnDefinitions="260,*">
                        <TextBlock Text="最大并行数" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1"
                                       Minimum="1" Maximum="16"
                                       Value="{Binding AppSettings.Config.SubAgentMaxParallel}"/>
                    </Grid>
                    <Grid ColumnDefinitions="260,*">
                        <TextBlock Text="单代理最大工具轮数" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1"
                                       Minimum="1" Maximum="100"
                                       Value="{Binding AppSettings.Config.SubAgentMaxIterations}"/>
                    </Grid>
                    <Grid ColumnDefinitions="260,*">
                        <TextBlock Text="超时（秒）" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1"
                                       Minimum="30" Maximum="3600"
                                       Value="{Binding AppSettings.Config.SubAgentTimeoutSeconds}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Expander Header="关于、更新与诊断">
                <views:AboutTabView DataContext="{Binding AboutTabViewModel}"/>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Window>
