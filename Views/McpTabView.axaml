<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Athena.UI.Markup"
             xmlns:appconv="using:Athena.UI.Converters"
             mc:Ignorable="d"
             d:DesignWidth="720"
             d:DesignHeight="1200"
             x:Class="Athena.UI.Views.McpTabView"
             x:DataType="vm:McpTabViewModel">

    <Design.DataContext>
        <vm:McpTabViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <appconv:McpStatusToBrushConverter x:Key="McpStatusToBrushConverter"/>
        <appconv:McpTransportIsHttpConverter x:Key="McpTransportIsHttp"/>
    </UserControl.Resources>

    <Grid RowDefinitions="40,*">

        <!-- HEADER -->
        <Border Grid.Row="0"
                CornerRadius="0,0,5,5"
                Background="{DynamicResource App.SectionBg}"
                Padding="12,8">
            <TextBlock Text="{loc:Loc Config.Mcp}"
                       FontWeight="SemiBold"
                       FontSize="14"/>
        </Border>

        <!-- SCROLLABLE CONTENT -->
        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" Padding="0,5,0,5">
            <Grid RowDefinitions="Auto" Width="{Binding #MainScrollViewer.Viewport.Width}" HorizontalAlignment="Stretch">
                <Border
                    Grid.Row="0"
                    Background="{DynamicResource App.SectionBg}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,60"
                    Padding="16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{loc:Loc Config.Mcp}" FontWeight="Bold" FontSize="15"/>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                            <TextBlock Grid.Column="0" Text="{loc:Loc Config.Mcp.Enable}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Config.EnableMcp}" HorizontalAlignment="Left"/>
                        </Grid>
                        <TextBlock Text="{loc:Loc Config.Mcp.DiscoveryHint}" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>

                        <Button Content="{loc:Loc Config.Mcp.AddServer}"
                                Command="{Binding AddMcpServerCommand}"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding Config.EnableMcp}"/>

                        <ItemsControl ItemsSource="{Binding Config.McpServers}" IsEnabled="{Binding Config.EnableMcp}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1" BorderBrush="{DynamicResource SemiColorBorder}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                                <ToggleSwitch Grid.Column="0" IsChecked="{Binding Enabled}" OnContent="{loc:Loc Config.Mcp.Enabled}" OffContent="{loc:Loc Config.Mcp.Disabled}" HorizontalAlignment="Left"/>
                                                <!-- 连接状态灯 + 提示 -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                             Fill="{Binding Status, Converter={StaticResource McpStatusToBrushConverter}}"/>
                                                    <TextBlock Text="{Binding StatusDetail}" VerticalAlignment="Center" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Content="{loc:Loc Config.Mcp.Reconnect}"
                                                        Command="{Binding $parent[ItemsControl].((vm:McpTabViewModel)DataContext).ReconnectMcpCommand}"/>
                                                <Button Grid.Column="3"
                                                        Content="{loc:Loc Config.Mcp.Remove}"
                                                        Command="{Binding $parent[ItemsControl].((vm:McpTabViewModel)DataContext).RemoveMcpServerCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                            <!-- 名称 + 传输类型 -->
                                            <Grid ColumnDefinitions="90,*,Auto" ColumnSpacing="10">
                                                <TextBlock Grid.Column="0" Text="{loc:Loc Config.Mcp.Name}" VerticalAlignment="Center" Opacity="0.8"/>
                                                <TextBox Grid.Column="1" Text="{Binding Name}"/>
                                                <ToggleSwitch Grid.Column="2"
                                                              IsChecked="{Binding Transport, Converter={StaticResource McpTransportIsHttp}}"
                                                              OnContent="{loc:Loc Config.Mcp.TransportHttp}"
                                                              OffContent="{loc:Loc Config.Mcp.TransportStdio}"/>
                                            </Grid>

                                            <!-- Stdio 段 -->
                                            <StackPanel Spacing="6" IsVisible="{Binding Transport, Converter={StaticResource McpTransportIsHttp}, ConverterParameter=Stdio}">
                                                <Grid ColumnDefinitions="90,*" ColumnSpacing="10" RowDefinitions="Auto,Auto">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.Mcp.Command}" VerticalAlignment="Center" Opacity="0.8"/>
                                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Command}" PlaceholderText="npx / uv / python …"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Config.Mcp.WorkingDir}" VerticalAlignment="Center" Opacity="0.8"/>
                                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WorkingDirectory}" PlaceholderText="(optional)"/>
                                                </Grid>

                                                <!-- 启动参数列表 -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{loc:Loc Config.Mcp.Args}" VerticalAlignment="Center" Opacity="0.8"/>
                                                    <Button Grid.Column="1" Content="+"
                                                            Command="{Binding $parent[UserControl].((vm:McpTabViewModel)DataContext).AddMcpArgCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Arguments}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,0,0,2">
                                                                <TextBox Grid.Column="0" Text="{Binding Value}"/>
                                                                <Button Grid.Column="1" Content="✕"
                                                                        Command="{Binding $parent[UserControl].((vm:McpTabViewModel)DataContext).RemoveMcpArgCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- 环境变量列表 -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{loc:Loc Config.Mcp.Env}" VerticalAlignment="Center" Opacity="0.8"/>
                                                    <Button Grid.Column="1" Content="+"
                                                            Command="{Binding $parent[UserControl].((vm:McpTabViewModel)DataContext).AddMcpEnvCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Environment}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6" Margin="0,0,0,2">
                                                                <TextBox Grid.Column="0" Text="{Binding Key}" PlaceholderText="KEY"/>
                                                                <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="value"/>
                                                                <Button Grid.Column="2" Content="✕"
                                                                        Command="{Binding $parent[UserControl].((vm:McpTabViewModel)DataContext).RemoveMcpEnvCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Http 段 -->
                                            <StackPanel Spacing="6" IsVisible="{Binding Transport, Converter={StaticResource McpTransportIsHttp}}">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <TextBlock Grid.Column="0" Text="{loc:Loc Config.Mcp.Url}" VerticalAlignment="Center" Opacity="0.8"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Url}" PlaceholderText="https://example.com/mcp"/>
                                                </Grid>

                                                <!-- 请求头列表 -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{loc:Loc Config.Mcp.Headers}" VerticalAlignment="Center" Opacity="0.8"/>
                                                    <Button Grid.Column="1" Content="+"
                                                            Command="{Binding $parent[UserControl].((vm:McpTabViewModel)DataContext).AddMcpHeaderCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Headers}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6" Margin="0,0,0,2">
                                                                <TextBox Grid.Column="0" Text="{Binding Key}" PlaceholderText="Authorization"/>
                                                                <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="Bearer …"/>
                                                                <Button Grid.Column="2" Content="✕"
                                                                        Command="{Binding $parent[UserControl].((vm:McpTabViewModel)DataContext).RemoveMcpHeaderCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Claude Desktop JSON 导入 -->
                        <TextBlock Text="{loc:Loc Config.Mcp.ImportTitle}" FontWeight="SemiBold" Opacity="0.8"/>
                        <TextBox Text="{Binding McpImportJson}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="80"
                                 IsEnabled="{Binding Config.EnableMcp}"
                                 PlaceholderText="{loc:Loc Config.Mcp.ImportPlaceholder}"/>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Content="{loc:Loc Config.Mcp.Import}"
                                    Command="{Binding ImportMcpJsonCommand}"
                                    IsEnabled="{Binding Config.EnableMcp}"/>
                            <TextBlock Grid.Column="1" Text="{Binding McpImportStatus}" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
