<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Athena.UI.Markup"
             mc:Ignorable="d" 
             d:DesignWidth="720" 
             d:DesignHeight="1080"
             x:Class="Athena.UI.Views.ConfigTabView"
             x:DataType="vm:ConfigTabViewModel">

    <Design.DataContext>
        <vm:ConfigTabViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="40,*,Auto">

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{DynamicResource App.SectionBg}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <TextBlock Text="{loc:Loc Config.Header}"
                       FontWeight="SemiBold"
                       FontSize="14"/>
        </Border>

        <!-- SCROLLABLE CONTENT -->
        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" Padding="16">
            <Grid Grid.RowDefinitions="Auto,Auto,Auto,Auto" Width="{Binding #MainScrollViewer.Viewport.Width}" RowSpacing="10" HorizontalAlignment="Stretch">

                <!-- SECTION 1: APPEARANCE -->
                <Border 
                    Grid.Row="0"
                    Background="{DynamicResource App.SectionBg}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{loc:Loc Config.SectionAppearance}"
                                   FontWeight="Bold"
                                   FontSize="15"/>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.DispTheme}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Config.Theme}" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Config.DispLanguage}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedIndex="{Binding SelectedLanguageIndex}" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: AI MODEL -->
                <Border 
                    Grid.Row="1"
                    Background="{DynamicResource App.SectionBg}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    HorizontalAlignment="Stretch">
                    <Grid RowDefinitions="Auto,Auto" HorizontalAlignment="Stretch">
                        <TextBlock Grid.Row="0"
                                Text="{loc:Loc Config.SectionPrimaryAI}"
                                FontWeight="Bold"
                                FontSize="15"
                                Margin="0,0,0,16"/>

                        <Grid Grid.Row="1"
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="20"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                            HorizontalAlignment="Stretch">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.ApiProvider}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding Config.Provider}" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Config.ApiEndpoint}" VerticalAlignment="Center" Opacity="0.8"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.BaseUrl}" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Config.AuthToken}" VerticalAlignment="Center" Opacity="0.8"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.ApiKey}" PasswordChar="*" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Config.ModelId}" VerticalAlignment="Center" Opacity="0.8"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.Model}" Watermark="e.g. gpt-4" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Config.ParamTemp}" VerticalAlignment="Center" Opacity="0.8"/>
                            <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                <Slider Grid.Column="0"
                                        Value="{Binding Config.Temperature}"
                                        Minimum="0"
                                        Maximum="2"
                                        TickPlacement="Outside"
                                        IsSnapToTickEnabled="True"
                                        TickFrequency="0.1"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                        Text="{Binding Config.Temperature, StringFormat={}{0:F1}}"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Margin="12,0,0,0"/>
                            </Grid>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc Config.ParamMaxTokens}" VerticalAlignment="Center" Opacity="0.8"/>
                            <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding Config.MaxTokens}" Minimum="100" Maximum="128000" Increment="100" Margin="0,0,0,12" HorizontalAlignment="Stretch"/>

                            <Grid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                                <Button Grid.Column="0"
                                        Command="{Binding TestConnectionCommand}"
                                        IsEnabled="{Binding !IsTestingConnection}"
                                        Theme="{StaticResource AccentButtonTheme}"
                                        Padding="16,4">
                                    <Panel>
                                        <TextBlock Text="{loc:Loc Config.BtnRunDiagnostics}" IsVisible="{Binding !IsTestingConnection}"/>
                                        <PathIcon Data="{StaticResource SemiIconLoading}" IsVisible="{Binding IsTestingConnection}" Classes="SlowSpin" Width="16" Height="16"/>
                                    </Panel>
                                </Button>
                                <TextBlock Grid.Column="1"
                                        Text="{Binding ConnectionStatus}"
                                        TextWrapping="Wrap"
                                        Margin="12,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Opacity="0.8"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- SECTION 4: AUXILIARY CORES -->
                <Border 
                    Grid.Row="2"
                    Background="{DynamicResource App.SectionBg}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{loc:Loc Config.BgTask2ndAICore}" FontWeight="Bold" FontSize="15" />
                        
                        <TabControl Background="Transparent" Padding="0,12,0,0">
                            <TabItem Header="{loc:Loc Config.BgTasks}">
                                <StackPanel Spacing="12" Margin="0,12,0,0">
                                    <TextBlock Text="{loc:Loc Config.SectionSecondaryAI}" FontWeight="SemiBold" Opacity="0.8"/>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.ApiProvider}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding Config.SecondaryProvider}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Config.ApiEndpoint}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.SecondaryBaseUrl}" Margin="0,0,0,8" Watermark="{loc:Loc Config.InheritPrimary}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Config.AuthToken}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.SecondaryApiKey}" PasswordChar="*" Margin="0,0,0,8" Watermark="{loc:Loc Config.InheritPrimary}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Config.ModelId}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.SecondaryModel}" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Config.ParamTemp}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                            <Slider Grid.Column="0"
                                                    Value="{Binding Config.SecondaryTemperature}"
                                                    Minimum="0" 
                                                    Maximum="2"
                                                    TickPlacement="Outside"
                                                    IsSnapToTickEnabled="True"
                                                    TickFrequency="0.1"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                    Text="{Binding Config.SecondaryTemperature, StringFormat={}{0:F1}}"
                                                    VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                        </Grid>
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc Config.ParamMaxTokens}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding Config.SecondaryMaxTokens}" Minimum="100" Maximum="8000" Increment="100" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>
                            </TabItem>
                            
                            <TabItem Header="{loc:Loc Config.VectorKb}">
                                <StackPanel Spacing="12" Margin="0,12,0,0">
                                    <TextBlock Text="{loc:Loc Config.SectionEmbedding}" FontWeight="SemiBold" Opacity="0.8"/>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" RowDefinitions="Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.ApiProvider}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding Config.EmbeddingProvider}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Config.ApiEndpoint}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.EmbeddingBaseUrl}" Watermark="{loc:Loc Config.InheritPrimary}" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Config.AuthToken}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.EmbeddingApiKey}" PasswordChar="*" Watermark="{loc:Loc Config.InheritPrimary}" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Config.ModelId}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.EmbeddingModel}" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </Border>

                <!-- SECTION 3: MEMORY MANAGEMENT -->
                <Border 
                    Grid.Row="3"
                    Background="{DynamicResource App.SectionBg}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,60"
                    Padding="16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{loc:Loc Config.SectionMemory}"
                                   FontWeight="Bold"
                                   FontSize="15"/>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20"  RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.CtxUsage}" VerticalAlignment="Center" Opacity="0.8"/>
                            <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                <Grid.Styles>
                                    <Style Selector="TextBlock.warning">
                                        <Setter Property="Foreground" Value="{DynamicResource SemiOrange6}"/>
                                    </Style>
                                    <Style Selector="TextBlock.critical">
                                        <Setter Property="Foreground" Value="{DynamicResource SemiRed6}"/>
                                    </Style>
                                </Grid.Styles>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding TokenService.TokenInfoText}"
                                            VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                            Classes.warning="{Binding TokenService.IsWarningLimit}"
                                            Classes.critical="{Binding TokenService.IsNearLimit}"/>
                                    <TextBlock Text="{loc:Loc Config.WarnHigh}"
                                            VerticalAlignment="Center" FontSize="11"
                                            IsVisible="{Binding TokenService.IsNearLimit}"
                                            Foreground="{DynamicResource SemiRed6}"
                                            FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Config.MemMaxCtx}" VerticalAlignment="Center" Opacity="0.8"/>
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Config.MaxContextTokens}" Minimum="1000" Maximum="200000" Increment="1000" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Config.MemCompThresh}" VerticalAlignment="Center" Opacity="0.8"/>
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Config.CompressionThreshold}" Minimum="500" Maximum="{Binding Config.MaxContextTokens}" Increment="500" HorizontalAlignment="Stretch" IsEnabled="{Binding Config.AutoCompress}" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Config.MemAutoComp}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ToggleSwitch Grid.Row="3" Grid.Column="1" IsChecked="{Binding Config.AutoCompress}"/>
                        </Grid>

                        <Border Background="{DynamicResource App.AssistantBubbleBg}" CornerRadius="4" Padding="12" Margin="0,8,0,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{loc:Loc Config.CompressionPreview}" FontSize="12" FontWeight="SemiBold" Opacity="0.7"/>
                                <TextBox BorderBrush="LightGray" 
                                         Text="{Binding TokenService.CompressionPreview}"
                                         TextWrapping="Wrap"
                                         FontSize="12" 
                                         MaxHeight="150" 
                                         IsReadOnly="True"
                                         Background="Transparent" 
                                         BorderThickness="1"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{Binding CompressContextCommand}">
                                        <Panel>
                                            <TextBlock Text="{loc:Loc Config.BtnExecCompression}" IsVisible="{Binding !IsCompressing}"/>
                                            <PathIcon Data="{StaticResource SemiIconLoading}" IsVisible="{Binding IsCompressing}" Classes="SlowSpin" Width="16" Height="16"/>
                                        </Panel>
                                    </Button>
                                    <Button Command="{Binding UndoCompressionCommand}" 
                                            Content="{loc:Loc Config.BtnUndoCompression}">
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- FOOTER: SAVE/RESET -->
        <Border Grid.Row="2"
                Padding="16,12"
                Background="{DynamicResource App.SectionBg}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SemiGreyLowBrush}">
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="12">
                <Button Command="{Binding SaveConfigCommand}"
                        Classes="accent"
                        IsEnabled="{Binding !IsSaving}"
                        Padding="24,6"
                        ToolTip.Tip="{loc:Loc Btn.CommitChanges}">
                    <Panel>
                        <PathIcon Data="{StaticResource SemiIconSave}" Width="18" Height="18" IsVisible="{Binding !IsSaving}"/>
                        <PathIcon Data="{StaticResource SemiIconLoading}" Width="18" Height="18" IsVisible="{Binding IsSaving}" Classes="SlowSpin"/>
                    </Panel>
                </Button>
                <Button Command="{Binding ResetConfigCommand}"
                        IsEnabled="{Binding !IsResetting}"
                        Padding="24,6"
                        ToolTip.Tip="{loc:Loc Btn.Rollback}">
                    <Panel>
                        <PathIcon Data="{StaticResource SemiIconUndo}" Width="18" Height="18" IsVisible="{Binding !IsResetting}"/>
                        <PathIcon Data="{StaticResource SemiIconLoading}" Width="18" Height="18" IsVisible="{Binding IsResetting}" Classes="SlowSpin"/>
                    </Panel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
