<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Athena.UI.Markup"
             xmlns:lmd="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             mc:Ignorable="d" 
             d:DesignWidth="720" 
             d:DesignHeight="2000"
             x:Class="Athena.UI.Views.ConfigTabView"
             x:DataType="vm:ConfigTabViewModel">

    <Design.DataContext>
        <vm:ConfigTabViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="40,*">

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{DynamicResource App.SectionBg}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <TextBlock Text="{loc:Loc Config.Header}"
                       FontWeight="SemiBold"
                       FontSize="14"/>
        </Border>

        <!-- SCROLLABLE CONTENT -->
        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" Padding="16">
            <Grid Grid.RowDefinitions="Auto,Auto,Auto,Auto" Width="{Binding #MainScrollViewer.Viewport.Width}" RowSpacing="10" HorizontalAlignment="Stretch">

                <!-- SECTION 1: APPEARANCE -->
                <Border 
                    Grid.Row="0"
                    Background="{DynamicResource App.SectionBg}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{loc:Loc Config.SectionAppearance}"
                                   FontWeight="Bold"
                                   FontSize="15"/>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.DispTheme}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Config.Theme}" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Config.DispLanguage}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedIndex="{Binding SelectedLanguageIndex}" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Config.SkipRegenerateConfirm}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding Config.SkipRegenerateConfirm}" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Config.SkipEditMessageConfirm}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ToggleSwitch Grid.Row="3" Grid.Column="1" IsChecked="{Binding Config.SkipEditConfirm}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: AI MODEL -->
                <Border 
                    Grid.Row="1"
                    Background="{DynamicResource App.SectionBg}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    HorizontalAlignment="Stretch">
                    <Grid RowDefinitions="Auto,Auto" HorizontalAlignment="Stretch">
                        <TextBlock Grid.Row="0"
                                Text="{loc:Loc Config.SectionPrimaryAI}"
                                FontWeight="Bold"
                                FontSize="15"
                                Margin="0,0,0,16"/>

                        <Grid Grid.Row="1"
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="20"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                            HorizontalAlignment="Stretch">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.ApiProvider}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding Config.Provider}" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Config.ApiEndpoint}" VerticalAlignment="Center" Opacity="0.8"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.BaseUrl}" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Config.AuthToken}" VerticalAlignment="Center" Opacity="0.8"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.ApiKey}" PasswordChar="*" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Config.ModelId}" VerticalAlignment="Center" Opacity="0.8"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.Model}" PlaceholderText="e.g. gpt-4" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Config.ParamTemp}" VerticalAlignment="Center" Opacity="0.8"/>
                            <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                <Slider Grid.Column="0"
                                        Value="{Binding Config.Temperature}"
                                        Minimum="0"
                                        Maximum="2"
                                        TickPlacement="Outside"
                                        IsSnapToTickEnabled="True"
                                        TickFrequency="0.1"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                        Text="{Binding Config.Temperature, StringFormat={}{0:F1}}"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Margin="12,0,0,0"/>
                            </Grid>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc Config.EnableFunctionCalling}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ToggleSwitch Grid.Row="5" Grid.Column="1" IsChecked="{Binding Config.EnableFunctionCalling}" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Loc Config.ParamMaxTokens}" VerticalAlignment="Center" Opacity="0.8"/>
                            <NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding Config.MaxTokens}" Minimum="100" Maximum="1000000" Increment="1000" Margin="0,0,0,12" HorizontalAlignment="Stretch"/>

                            <Grid Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                                <Button Grid.Column="0"
                                        Command="{Binding TestConnectionCommand}"
                                        IsEnabled="{Binding CanTestConnection}"
                                        Theme="{StaticResource AccentButtonTheme}"
                                        Padding="16,4">
                                    <Panel>
                                        <TextBlock Text="{loc:Loc Config.BtnRunDiagnostics}" IsVisible="{Binding !IsTestingConnection}"/>
                                        <PathIcon Data="{StaticResource SemiIconLoading}" IsVisible="{Binding IsTestingConnection}" Classes="SlowSpin" Width="16" Height="16"/>
                                    </Panel>
                                </Button>
                                <TextBlock Grid.Column="1"
                                        Text="{Binding ConnectionStatus}"
                                        TextWrapping="Wrap"
                                        Margin="12,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Opacity="0.8"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- SECTION 4: AUXILIARY CORES -->
                <Border 
                    Grid.Row="2"
                    Background="{DynamicResource App.SectionBg}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{loc:Loc Config.BgTask2ndAICore}" FontWeight="Bold" FontSize="15" />
                        
                        <TabControl Background="Transparent" Padding="0,12,0,0">
                            <TabItem Header="{loc:Loc Config.BgTasks}">
                                <StackPanel Spacing="12" Margin="0,12,0,0">
                                    <TextBlock Text="{loc:Loc Config.SectionSecondaryAI}" FontWeight="SemiBold" Opacity="0.8"/>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.ApiProvider}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding Config.SecondaryProvider}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Config.ApiEndpoint}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.SecondaryBaseUrl}" Margin="0,0,0,8" PlaceholderText="{loc:Loc Config.InheritPrimary}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Config.AuthToken}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.SecondaryApiKey}" PasswordChar="*" Margin="0,0,0,8" PlaceholderText="{loc:Loc Config.InheritPrimary}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Config.ModelId}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.SecondaryModel}" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Config.ParamTemp}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                            <Slider Grid.Column="0"
                                                    Value="{Binding Config.SecondaryTemperature}"
                                                    Minimum="0" 
                                                    Maximum="2"
                                                    TickPlacement="Outside"
                                                    IsSnapToTickEnabled="True"
                                                    TickFrequency="0.1"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                    Text="{Binding Config.SecondaryTemperature, StringFormat={}{0:F1}}"
                                                    VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                        </Grid>
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc Config.ParamMaxTokens}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding Config.SecondaryMaxTokens}" Minimum="100" Maximum="8000" Increment="100" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Loc Config.TestConnection}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <Grid Grid.Row="6" Grid.Column="1" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                                            <Button Grid.Column="0"
                                                    Command="{Binding TestSecondaryCommand}"
                                                    IsEnabled="{Binding CanTestSecondary}"
                                                    Theme="{StaticResource AccentButtonTheme}"
                                                    Padding="16,4">
                                                <Panel>
                                                    <TextBlock Text="{loc:Loc Config.Test}" IsVisible="{Binding !IsTestingSecondary}"/>
                                                    <PathIcon Data="{StaticResource SemiIconLoading}" IsVisible="{Binding IsTestingSecondary}" Classes="SlowSpin" Width="16" Height="16"/>
                                                </Panel>
                                            </Button>
                                            <TextBlock Grid.Column="1"
                                                    Text="{Binding SecondaryTestStatus}"
                                                    TextWrapping="Wrap"
                                                    Margin="12,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Opacity="0.8"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </TabItem>
                            
                            <TabItem Header="{loc:Loc Config.VectorKb}">
                                <StackPanel Spacing="12" Margin="0,12,0,0">
                                    <TextBlock Text="{loc:Loc Config.SectionEmbedding}" FontWeight="SemiBold" Opacity="0.8"/>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.ApiProvider}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding Config.EmbeddingProvider}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Config.ApiEndpoint}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.EmbeddingBaseUrl}" PlaceholderText="{loc:Loc Config.InheritPrimary}" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Config.AuthToken}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.EmbeddingApiKey}" PasswordChar="*" PlaceholderText="{loc:Loc Config.InheritPrimary}" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Config.ModelId}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.EmbeddingModel}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Config.TestConnection}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                                            <Button Grid.Column="0"
                                                    Command="{Binding TestEmbeddingCommand}"
                                                    IsEnabled="{Binding CanTestEmbedding}"
                                                    Theme="{StaticResource AccentButtonTheme}"
                                                    Padding="16,4">
                                                <Panel>
                                                    <TextBlock Text="{loc:Loc Config.Test}" IsVisible="{Binding !IsTestingEmbedding}"/>
                                                    <PathIcon Data="{StaticResource SemiIconLoading}" IsVisible="{Binding IsTestingEmbedding}" Classes="SlowSpin" Width="16" Height="16"/>
                                                </Panel>
                                            </Button>
                                            <TextBlock Grid.Column="1"
                                                    Text="{Binding EmbeddingTestStatus}"
                                                    TextWrapping="Wrap"
                                                    Margin="12,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Opacity="0.8"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </TabItem>

                            <TabItem Header="{loc:Loc Config.WebSearch}">
                                <StackPanel Spacing="12" Margin="0,12,0,0">
                                    <!-- 启用开关 -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                                        <TextBlock Grid.Column="0" Text="{loc:Loc Config.Enable}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding Config.WebSearchEnabled}" HorizontalAlignment="Left"/>
                                    </Grid>

                                    <!-- 供应商选择 -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                          IsEnabled="{Binding Config.WebSearchEnabled}">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.ApiProvider}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding WebSearchProviders}"
                                                  SelectedItem="{Binding Config.WebSearchProvider}"
                                                  HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                                  SelectionChanged="WebSearchProvider_SelectionChanged"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Config.ApiEndpoint}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.WebSearchBaseUrl}" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Config.AuthToken}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.WebSearchApiKey}" PasswordChar="*" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="App ID" VerticalAlignment="Center" Opacity="0.8" IsVisible="{Binding IsBaiduProvider}"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.WebSearchAppId}" Margin="0,0,0,8" IsVisible="{Binding IsBaiduProvider}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Config.TestConnection}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                                            <Button Grid.Column="0"
                                                    Command="{Binding TestWebSearchCommand}"
                                                    IsEnabled="{Binding CanTestWebSearch}"
                                                    Theme="{StaticResource AccentButtonTheme}"
                                                    Padding="16,4">
                                                <Panel>
                                                    <TextBlock Text="{loc:Loc Config.Test}" IsVisible="{Binding !IsTestingWebSearch}"/>
                                                    <PathIcon Data="{StaticResource SemiIconLoading}" IsVisible="{Binding IsTestingWebSearch}" Classes="SlowSpin" Width="16" Height="16"/>
                                                </Panel>
                                            </Button>
                                            <TextBlock Grid.Column="1"
                                                    Text="{Binding WebSearchTestStatus}"
                                                    TextWrapping="Wrap"
                                                    Margin="12,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Opacity="0.8"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </TabItem>

                            <TabItem Header="{loc:Loc Config.Browser}">
                                <StackPanel Spacing="8" Margin="0,12,0,0">
                                    <TextBlock Text="{loc:Loc Config.BrowserDescription}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Opacity="0.7"/>

                                    <Grid ColumnDefinitions="80,*" ColumnSpacing="20" RowDefinitions="Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.BrowserEnabled}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding Config.BrowserEnabled}" HorizontalAlignment="Left"/>
                                    </Grid>

                                    <StackPanel Spacing="16" IsEnabled="{Binding Config.BrowserEnabled}">
                                        <Grid ColumnDefinitions="80,*" ColumnSpacing="20" RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.BrowserObservationMode}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <ComboBox Grid.Row="0" Grid.Column="1"
                                                      ItemsSource="{Binding BrowserObservationModes}"
                                                      SelectedItem="{Binding Config.BrowserObservationMode}"
                                                      HorizontalAlignment="Stretch"
                                                      Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Config.BrowserHeadless}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding Config.BrowserHeadless}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                        </Grid>

                                        <TextBlock Text="{loc:Loc Config.BrowserDiagnostics}" FontWeight="SemiBold" FontSize="14" Opacity="0.85"/>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                                            <TextBlock Grid.Column="0" Text="{loc:Loc Config.BrowserRuntimeStatus}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <StackPanel Grid.Column="1" Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Command="{Binding TestBrowserRuntimeCommand}"
                                                            IsEnabled="{Binding CanTestBrowserRuntime}"
                                                            Theme="{StaticResource AccentButtonTheme}"
                                                            Padding="16,4">
                                                        <Panel>
                                                            <TextBlock Text="{loc:Loc Config.BrowserTestRuntime}" IsVisible="{Binding !IsTestingBrowserRuntime}"/>
                                                            <PathIcon Data="{StaticResource SemiIconLoading}" IsVisible="{Binding IsTestingBrowserRuntime}" Classes="SlowSpin" Width="16" Height="16"/>
                                                        </Panel>
                                                    </Button>
                                                    <Button Command="{Binding InstallBrowserRuntimeCommand}"
                                                            IsEnabled="{Binding CanInstallBrowserRuntime}"
                                                            Padding="16,4">
                                                        <Panel>
                                                            <TextBlock Text="{loc:Loc Config.BrowserInstallRuntime}" IsVisible="{Binding !IsInstallingBrowserRuntime}"/>
                                                            <PathIcon Data="{StaticResource SemiIconLoading}" IsVisible="{Binding IsInstallingBrowserRuntime}" Classes="SlowSpin" Width="16" Height="16"/>
                                                        </Panel>
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock Text="{Binding BrowserRuntimeStatus}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Opacity="0.8"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{loc:Loc Config.BrowserRuntime}" FontWeight="SemiBold" FontSize="14" Opacity="0.85"/>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" RowDefinitions="Auto,Auto,Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.BrowserViewportWidth}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding Config.BrowserViewportWidth}" Minimum="320" Maximum="3840" Increment="80" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Config.BrowserViewportHeight}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Config.BrowserViewportHeight}" Minimum="240" Maximum="2160" Increment="60" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Config.BrowserOperationTimeout}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Config.BrowserOperationTimeoutSeconds}" Minimum="5" Maximum="300" Increment="5" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Config.BrowserMaxSteps}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Config.BrowserMaxSteps}" Minimum="1" Maximum="50" Increment="1" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                                        </Grid>

                                        <TextBlock Text="{loc:Loc Config.BrowserSessionPolicy}" FontWeight="SemiBold" FontSize="14" Opacity="0.85"/>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" RowDefinitions="Auto,Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.BrowserSessionTtl}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding Config.BrowserSessionTtlMinutes}" Minimum="1" Maximum="120" Increment="1" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Config.BrowserPersistSession}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding Config.BrowserPersistSession}" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Config.BrowserDownloadEnabled}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding Config.BrowserDownloadEnabled}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                        </Grid>

                                        <TextBlock Text="{loc:Loc Config.BrowserElementMap}" FontWeight="SemiBold" FontSize="14" Opacity="0.85"/>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.BrowserSomMaxElements}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding Config.BrowserSomMaxElements}" Minimum="10" Maximum="200" Increment="10" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Config.BrowserSomIncludeText}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding Config.BrowserSomIncludeText}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                        </Grid>

                                        <TextBlock Text="{loc:Loc Config.BrowserVisionModel}" FontWeight="SemiBold" FontSize="14" Opacity="0.85"/>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" IsEnabled="{Binding IsBrowserVisionEnabled}">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.BrowserScreenshotScale}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding Config.BrowserScreenshotScale}" Minimum="0.25" Maximum="2" Increment="0.25" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Config.BrowserImageQuality}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Config.BrowserImageQuality}" Minimum="30" Maximum="100" Increment="5" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Config.ApiProvider}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding Config.BrowserVisionProvider}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Config.ApiEndpoint}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.BrowserVisionBaseUrl}" PlaceholderText="Leave empty to inherit main AI BaseUrl" Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Config.AuthToken}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Config.BrowserVisionApiKey}" PasswordChar="*" PlaceholderText="Leave empty to inherit main AI API Key" Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc Config.ModelId}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Config.BrowserVisionModel}" PlaceholderText="e.g. gpt-4o-mini" Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Loc Config.ParamMaxTokens}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding Config.BrowserVisionMaxTokens}" Minimum="100" Maximum="8000" Increment="100" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="7" Grid.Column="0" Text="{loc:Loc Config.ParamTemp}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <Grid Grid.Row="7" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                                <Slider Grid.Column="0"
                                                        Value="{Binding Config.BrowserVisionTemperature}"
                                                        Minimum="0"
                                                        Maximum="2"
                                                        TickPlacement="Outside"
                                                        IsSnapToTickEnabled="True"
                                                        TickFrequency="0.1"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Config.BrowserVisionTemperature, StringFormat={}{0:F1}}"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Margin="12,0,0,0"/>
                                            </Grid>

                                            <TextBlock Grid.Row="8" Grid.Column="0" Text="{loc:Loc Config.TestConnection}" VerticalAlignment="Center" Opacity="0.8"/>
                                            <Grid Grid.Row="8" Grid.Column="1" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                                                <Button Grid.Column="0"
                                                        Command="{Binding TestBrowserVisionCommand}"
                                                        IsEnabled="{Binding CanTestBrowserVision}"
                                                        Theme="{StaticResource AccentButtonTheme}"
                                                        Padding="16,4">
                                                    <Panel>
                                                        <TextBlock Text="{loc:Loc Config.Test}" IsVisible="{Binding !IsTestingBrowserVision}"/>
                                                        <PathIcon Data="{StaticResource SemiIconLoading}" IsVisible="{Binding IsTestingBrowserVision}" Classes="SlowSpin" Width="16" Height="16"/>
                                                    </Panel>
                                                </Button>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding BrowserVisionTestStatus}"
                                                           TextWrapping="Wrap"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           Opacity="0.8"/>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </Border>

                <!-- SECTION 3: MEMORY MANAGEMENT -->
                <Border 
                    Grid.Row="3"
                    Background="{DynamicResource App.SectionBg}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,60"
                    Padding="16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{loc:Loc Config.SectionMemory}"
                                   FontWeight="Bold"
                                   FontSize="15"/>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20"  RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.CtxUsage}" VerticalAlignment="Center" Opacity="0.8"/>
                            <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                <Grid.Styles>
                                    <Style Selector="TextBlock.warning">
                                        <Setter Property="Foreground" Value="{DynamicResource SemiOrange6}"/>
                                    </Style>
                                    <Style Selector="TextBlock.critical">
                                        <Setter Property="Foreground" Value="{DynamicResource SemiRed6}"/>
                                    </Style>
                                </Grid.Styles>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding TokenService.TokenInfoText}"
                                            VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                            Classes.warning="{Binding TokenService.IsWarningLimit}"
                                            Classes.critical="{Binding TokenService.IsNearLimit}"/>
                                    <TextBlock Text="{loc:Loc Config.WarnHigh}"
                                            VerticalAlignment="Center" FontSize="11"
                                            IsVisible="{Binding TokenService.IsNearLimit}"
                                            Foreground="{DynamicResource SemiRed6}"
                                            FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Config.MemMaxCtx}" VerticalAlignment="Center" Opacity="0.8"/>
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Config.MaxContextTokens}" Minimum="1000" Maximum="99999999999" Increment="1000" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Config.MemCompThresh}" VerticalAlignment="Center" Opacity="0.8"/>
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Config.CompressionThreshold}" Minimum="500" Maximum="{Binding Config.MaxContextTokens}" Increment="500" HorizontalAlignment="Stretch" IsEnabled="{Binding Config.AutoCompress}" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Config.MemAutoComp}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ToggleSwitch Grid.Row="3" Grid.Column="1" IsChecked="{Binding Config.AutoCompress}"/>
                        </Grid>

                        <Border Background="{DynamicResource App.AssistantBubbleBg}" CornerRadius="4" Padding="12" Margin="0,8,0,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{loc:Loc Config.CompressionPreview}" FontSize="12" FontWeight="SemiBold" Opacity="0.7"/>
                                <Border BorderThickness="1" BorderBrush="LightGray" CornerRadius="5">
                                    <ScrollViewer HorizontalAlignment="Stretch" MinHeight="50" MaxHeight="300" VerticalAlignment="Stretch">
                                        <lmd:MarkdownRenderer loc:MarkdownHelper.Text="{Binding TokenService.CompressionPreview}" />
                                    </ScrollViewer>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{Binding CompressContextCommand}">
                                        <Panel>
                                            <TextBlock Text="{loc:Loc Config.BtnExecCompression}" IsVisible="{Binding !IsCompressing}"/>
                                            <PathIcon Data="{StaticResource SemiIconLoading}" IsVisible="{Binding IsCompressing}" Classes="SlowSpin" Width="16" Height="16"/>
                                        </Panel>
                                    </Button>
                                    <Button Command="{Binding UndoCompressionCommand}" 
                                            Content="{loc:Loc Config.BtnUndoCompression}">
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
