<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Athena.UI.Markup"
             mc:Ignorable="d" 
             d:DesignWidth="720" 
             d:DesignHeight="1080"
             x:Class="Athena.UI.Views.ConfigTabView"
             x:DataType="vm:ConfigTabViewModel">

    <Design.DataContext>
        <vm:ConfigTabViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{DynamicResource App.SectionBg}"
                BorderThickness="0,0,0,1"
                Padding="12,8"
                >
            <TextBlock Text="{loc:Loc Config.Header}"
                       FontWeight="SemiBold"
                       FontSize="14"/>
        </Border>

        <!-- SCROLLABLE CONTENT -->
        <ScrollViewer Grid.Row="1" Padding="16">
            <StackPanel Spacing="16">

                <!-- SECTION 1: APPEARANCE -->
                <Border Background="{DynamicResource App.SectionBg}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{loc:Loc Config.SectionAppearance}"
                                   FontWeight="Bold"
                                   FontSize="15"/>

                        <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.DispTheme}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Config.Theme}" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Config.DispFontScale}" VerticalAlignment="Center" Opacity="0.8"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                                <Slider Width="300" Minimum="10" Maximum="24" Value="{Binding Config.FontSize}" SmallChange="1" LargeChange="2" TickPlacement="BottomRight" TickFrequency="1" />
                                <TextBlock Text="{Binding Config.FontSize}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Config.DispLanguage}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedIndex="{Binding SelectedLanguageIndex}" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Config.DispHeartbeat}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ToggleSwitch Grid.Row="3" Grid.Column="1" IsChecked="{Binding Config.ShowHeartbeatButton}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: AI MODEL -->
                <Border Background="{DynamicResource App.SectionBg}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{loc:Loc Config.SectionPrimaryAI}"
                                   FontWeight="Bold"
                                   FontSize="15"/>

                        <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.ApiProvider}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding Config.Provider}" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Config.ApiEndpoint}" VerticalAlignment="Center" Opacity="0.8"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.BaseUrl}" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Config.AuthToken}" VerticalAlignment="Center" Opacity="0.8"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.ApiKey}" PasswordChar="*" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Config.ModelId}" VerticalAlignment="Center" Opacity="0.8"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.Model}" Watermark="e.g. gpt-4" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Config.ParamTemp}" VerticalAlignment="Center" Opacity="0.8"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                                <Slider Width="300" Value="{Binding Config.Temperature}" Minimum="0" Maximum="2" SmallChange="0.1" LargeChange="0.5" TickPlacement="BottomRight" TickFrequency="0.1" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Config.Temperature, StringFormat={}{0:F1}}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc Config.ParamMaxTokens}" VerticalAlignment="Center" Opacity="0.8"/>
                            <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding Config.MaxTokens}" Minimum="100" Maximum="128000" Increment="100" Margin="0,0,0,12" HorizontalAlignment="Stretch"/>

                            <Grid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                                <Button Grid.Column="0"
                                        Command="{Binding TestConnectionCommand}"
                                        IsEnabled="{Binding !IsTestingConnection}"
                                        Theme="{StaticResource AccentButtonTheme}"
                                        Padding="16,4"
                                        ToolTip.Tip="{loc:Loc Config.BtnRunDiagnostics}">
                                    <PathIcon Data="{StaticResource SemiIconActivity}" Width="16" Height="16"/>
                                </Button>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ConnectionStatus}"
                                           TextWrapping="Wrap"
                                           Margin="12,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Opacity="0.8"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 4: AUXILIARY CORES -->
                <Border Background="{DynamicResource App.SectionBg}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="后台任务与辅助核心" FontWeight="Bold" FontSize="15" />
                        
                        <TabControl Background="Transparent" Padding="0,12,0,0">
                            <TabItem Header="{loc:Loc Config.BgTasks}">
                                <StackPanel Spacing="12" Margin="0,12,0,0">
                                    <TextBlock Text="{loc:Loc Config.SectionSecondaryAI}" FontWeight="SemiBold" Opacity="0.8"/>
                                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.ModelId}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.SecondaryModel}" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Config.ParamTemp}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                                            <Slider Width="300" Value="{Binding Config.SecondaryTemperature}" Minimum="0" Maximum="2" SmallChange="0.1" LargeChange="0.5" TickPlacement="BottomRight" TickFrequency="0.1" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Config.SecondaryTemperature, StringFormat={}{0:F1}}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Config.ParamMaxTokens}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Config.SecondaryMaxTokens}" Minimum="100" Maximum="8000" Increment="100" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>
                            </TabItem>
                            
                            <TabItem Header="{loc:Loc Config.VectorKb}">
                                <StackPanel Spacing="12" Margin="0,12,0,0">
                                    <TextBlock Text="{loc:Loc Config.SectionEmbedding}" FontWeight="SemiBold" Opacity="0.8"/>
                                    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.ApiProvider}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding Config.EmbeddingProvider}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Config.ApiEndpoint}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.EmbeddingBaseUrl}" Watermark="{loc:Loc Config.InheritPrimary}" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Config.ModelId}" VerticalAlignment="Center" Opacity="0.8"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.EmbeddingModel}" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </Border>

                <!-- SECTION 3: MEMORY MANAGEMENT -->
                <Border Background="{DynamicResource App.SectionBg}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,60"
                        Padding="16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{loc:Loc Config.SectionMemory}"
                                   FontWeight="Bold"
                                   FontSize="15"/>

                        <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Config.CtxUsage}" VerticalAlignment="Center" Opacity="0.8"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                                <ProgressBar Value="{Binding ContextTokens}" Maximum="{Binding Config.MaxContextTokens}" Width="300" Height="10" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ContextTokensInfo}" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Text="{loc:Loc Config.WarnHigh}" VerticalAlignment="Center" FontSize="11" IsVisible="{Binding IsNearCompressionThreshold}" Foreground="{DynamicResource Brush.Red}" FontWeight="Bold"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Config.MemMaxCtx}" VerticalAlignment="Center" Opacity="0.8"/>
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Config.MaxContextTokens}" Minimum="1000" Maximum="200000" Increment="1000" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Config.MemCompThresh}" VerticalAlignment="Center" Opacity="0.8"/>
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Config.CompressionThreshold}" Minimum="500" Maximum="{Binding Config.MaxContextTokens}" Increment="500" HorizontalAlignment="Stretch" IsEnabled="{Binding Config.AutoCompress}" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Config.MemAutoComp}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ToggleSwitch Grid.Row="3" Grid.Column="1" IsChecked="{Binding Config.AutoCompress}"/>
                        </Grid>

                        <Border Background="{DynamicResource App.AssistantBubbleBg}" CornerRadius="4" Padding="12" Margin="0,8,0,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{loc:Loc Config.CompressionPreview}" FontSize="12" FontWeight="SemiBold" Opacity="0.7"/>
                                <TextBox BorderBrush="LightGray" 
                                         Text="{Binding CompressionPreview}"
                                         TextWrapping="Wrap"
                                         FontSize="12" 
                                         MaxHeight="150" 
                                         IsReadOnly="True"
                                         Background="Transparent" 
                                         BorderThickness="1"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{Binding CompressContextCommand}" 
                                            ToolTip.Tip="{loc:Loc Config.BtnExecCompression}">
                                        <PathIcon Data="{StaticResource SemiIconActivity}" Width="16" Height="16"/>
                                    </Button>
                                    <Button Command="{Binding UndoCompressionCommand}" 
                                            ToolTip.Tip="{loc:Loc Config.BtnUndoCompression}">
                                        <PathIcon Data="{StaticResource SemiIconUndo}" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>