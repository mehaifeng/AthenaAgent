<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Athena.UI.Markup"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:lmd="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             xmlns:appconv="using:Athena.UI.Converters"
             mc:Ignorable="d"
             d:DesignWidth="720"
             d:DesignHeight="1600"
             x:Class="Athena.UI.Views.ConfigTabView"
             x:DataType="vm:ConfigTabViewModel">

    <Design.DataContext>
        <vm:ConfigTabViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <appconv:ToolApprovalModeToDisplayConverter x:Key="ToolApprovalModeToDisplay"/>
        <appconv:EmbeddingCredentialSourceToDisplayConverter x:Key="EmbeddingCredentialSourceToDisplay"/>
    </UserControl.Resources>
    
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="40,*">
        <Border Grid.Row="0"
                CornerRadius="0,0,5,5"
                Background="{DynamicResource App.SectionBg}"
                Padding="12,8">
            <TextBlock Text="{loc:Loc Config.Header}" FontWeight="SemiBold" FontSize="14"/>
        </Border>

        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" Padding="0,5">
            <StackPanel Width="{Binding #MainScrollViewer.Viewport.Width}" Spacing="10">
                <!-- Appearance -->
                <Border Background="{DynamicResource App.SectionBg}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{loc:Loc Config.SectionAppearance}" FontWeight="Bold" FontSize="15"/>
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="12">
                            <TextBlock Text="{loc:Loc Config.DispTheme}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Config.Theme}"/>
                            <TextBlock Grid.Row="1" Text="{loc:Loc Config.DispLanguage}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedIndex="{Binding SelectedLanguageIndex}"/>
                            <TextBlock Grid.Row="2" Text="{loc:Loc Config.SkipRewindConfirm}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding Config.SkipRewindConfirm}" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Unified provider/model configuration -->
                <Border Background="{DynamicResource App.SectionBg}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc Config.UnifiedModels.Header}" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="{loc:Loc Config.UnifiedModels.Hint}" FontSize="12" Opacity="0.65"/>
                        </StackPanel>

                        <TextBlock Text="{loc:Loc Config.UnifiedModels.Providers}" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="8">
                            <TextBlock Text="{loc:Loc Config.ApiProvider}" VerticalAlignment="Center" Opacity="0.75"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding AiProvider.ProviderPreset}"/>
                            <TextBlock Grid.Row="1" Text="{loc:Loc Config.UnifiedModels.ProviderName}" VerticalAlignment="Center" Opacity="0.75"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AiProvider.DisplayName}"/>
                            <TextBlock Grid.Row="2" Text="{loc:Loc Config.ApiEndpoint}" VerticalAlignment="Center" Opacity="0.75"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AiProvider.BaseUrl}"/>
                            <TextBlock Grid.Row="3" Text="{loc:Loc Config.AuthToken}" VerticalAlignment="Center" Opacity="0.75"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AiProvider.ApiKey}" PasswordChar="*"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <u:IconButton Command="{Binding RefreshModelOptionsCommand}"
                                              IsLoading="{Binding IsRefreshingModelOptions}"
                                              Content="{loc:Loc Config.RefreshModelList}"
                                              ToolTip.Tip="{loc:Loc Config.LoadModelsHint}"/>
                                <TextBlock Text="{Binding ModelOptionsStatus}"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Opacity="0.7"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{loc:Loc Config.UnifiedModels.Roles}" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="120,*,90,110" ColumnSpacing="10">
                            <TextBlock Text="{loc:Loc Config.UnifiedModels.Role}" FontSize="11" Opacity="0.6"/>
                            <TextBlock Grid.Column="1" Text="{loc:Loc Config.UnifiedModels.Model}" FontSize="11" Opacity="0.6"/>
                            <TextBlock Grid.Column="2" Text="{loc:Loc Config.UnifiedModels.Temperature}" FontSize="11" Opacity="0.6"/>
                            <TextBlock Grid.Column="3" Text="{loc:Loc Config.UnifiedModels.MaxOutput}" FontSize="11" Opacity="0.6"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding AiModelRoles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModelRoleAssignmentViewModel">
                                    <Grid ColumnDefinitions="120,*,90,110" ColumnSpacing="10" Margin="0,3">
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Opacity="0.75"/>
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding Settings.Model}" IsEditable="True"/>
                                        <NumericUpDown Grid.Column="2" Value="{Binding Settings.Temperature}" VerticalAlignment="Center" Minimum="0" Maximum="2" Increment="0.1"/>
                                        <NumericUpDown Grid.Column="3" Value="{Binding Settings.MaxOutputTokens}" VerticalAlignment="Center" Minimum="1" Maximum="1000000" Increment="256" IsVisible="{Binding SupportsOutputTokens}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <u:IconButton Command="{Binding TestConnectionCommand}" IsLoading="{Binding IsTestingConnection}" Content="{loc:Loc Config.TestConnection}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ConnectionStatus}" VerticalAlignment="Center" FontSize="11" Opacity="0.7"/>
                        </Grid>

                        <Separator/>
                        <TextBlock Text="{loc:Loc Config.SubAgentParameters}" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="8">
                            <TextBlock Text="{loc:Loc Config.SubAgentsEnabled}" VerticalAlignment="Center" Opacity="0.75"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Config.EnableSubAgents}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Text="{loc:Loc Config.SubAgentMaxParallel}" VerticalAlignment="Center" Opacity="0.75"/>
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Config.SubAgentMaxParallel}" Minimum="1" Maximum="12"/>
                            <TextBlock Grid.Row="2" Text="{loc:Loc Config.SubAgentMaxIterations}" VerticalAlignment="Center" Opacity="0.75"/>
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Config.SubAgentMaxIterations}" Minimum="1" Maximum="60"/>
                            <TextBlock Grid.Row="3" Text="{loc:Loc Config.SubAgentTimeout}" VerticalAlignment="Center" Opacity="0.75"/>
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Config.SubAgentTimeoutSeconds}" Minimum="10" Maximum="1200" Increment="10"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Embedding and knowledge base maintenance -->
                <Border Background="{DynamicResource App.SectionBg}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{loc:Loc Config.EmbeddingModel}" FontWeight="Bold" FontSize="15"/>
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="14">
                            <TextBlock Text="{loc:Loc Config.EmbeddingConnection}" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,0,8"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding EmbeddingCredentialSources}" SelectedItem="{Binding Config.EmbeddingCredentialSource}" Margin="0,0,0,8">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EmbeddingCredentialSourceToDisplay}}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Margin="0,0,0,8" Text="{loc:Loc Config.ModelId}" VerticalAlignment="Center" Opacity="0.75"/>
                            <ComboBox Grid.Row="1" Margin="0,0,0,8" Grid.Column="1" ItemsSource="{Binding EmbeddingModelOptions}" SelectedItem="{Binding Config.AiModels.Embedding.Model}" IsEditable="True"/>
                            <TextBlock Grid.Row="2" Margin="0,0,0,8" Text="{loc:Loc Config.ApiProvider}" VerticalAlignment="Center" Opacity="0.75" IsVisible="{Binding IsEmbeddingCustomConnection}"/>
                            <ComboBox Grid.Row="2" Margin="0,0,0,8" Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding Config.EmbeddingProvider}" IsVisible="{Binding IsEmbeddingCustomConnection}"/>
                            <TextBlock Grid.Row="3" Margin="0,0,0,8" Text="{loc:Loc Config.ApiEndpoint}" VerticalAlignment="Center" Opacity="0.75" IsVisible="{Binding IsEmbeddingCustomConnection}"/>
                            <TextBox Grid.Row="3" Margin="0,0,0,8" Grid.Column="1" Text="{Binding Config.EmbeddingBaseUrl}" IsVisible="{Binding IsEmbeddingCustomConnection}"/>
                            <TextBlock Grid.Row="4" Margin="0,0,0,8" Text="{loc:Loc Config.AuthToken}" VerticalAlignment="Center" Opacity="0.75" IsVisible="{Binding IsEmbeddingCustomConnection}"/>
                            <TextBox Grid.Row="4" Margin="0,0,0,8" Grid.Column="1" Text="{Binding Config.EmbeddingApiKey}" PasswordChar="*" IsVisible="{Binding IsEmbeddingCustomConnection}"/>
                            <StackPanel Grid.Row="5" Margin="0,0,0,8" Grid.ColumnSpan="2" Spacing="10" Orientation="Horizontal">
                                <u:IconButton Command="{Binding RebuildVectorIndexCommand}"
                                              IsLoading="{Binding IsRebuildingVectorIndex}"
                                              Content="{loc:Loc Config.RebuildVectorIndex}"/>
                                <TextBlock Text="{Binding VectorIndexStatus}"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Opacity="0.7"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <Separator/>
                        <TextBlock Text="{loc:Loc Config.KnowledgeMaintenance}" FontWeight="Bold" FontSize="15"/>
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="10">
                            <TextBlock Text="{loc:Loc Config.KbMaintenanceEnabled}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Config.KnowledgeMaintenanceEnabled}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Text="{loc:Loc Config.KbMaintenanceInterval}" VerticalAlignment="Center" Opacity="0.8"/>
                            <NumericUpDown Grid.Row="1" Grid.Column="1"
                                           Value="{Binding Config.KnowledgeMaintenanceIntervalDays}"
                                           Minimum="1" Maximum="365" Width="120"
                                           HorizontalAlignment="Left"/>
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10">
                                <u:IconButton Command="{Binding RunKnowledgeMaintenanceCommand}"
                                              IsLoading="{Binding IsRunningMaintenance}"
                                              Content="{loc:Loc Config.KbMaintenanceRunNow}"/>
                                <TextBlock Text="{Binding MaintenanceStatus}"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Opacity="0.7"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Browser automation belongs with its Browser Agent model role. -->
                <Border Background="{DynamicResource App.SectionBg}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{loc:Loc Config.Browser}" FontWeight="Bold" FontSize="15"/>
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="8">
                            <TextBlock Text="{loc:Loc Config.BrowserEnabled}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Config.BrowserEnabled}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Text="{loc:Loc Config.BrowserObservationMode}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding BrowserObservationModes}" SelectedItem="{Binding Config.BrowserObservationMode}"/>
                            <TextBlock Grid.Row="2" Text="{loc:Loc Config.BrowserHeadless}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding Config.BrowserHeadless}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="3" Text="{loc:Loc Config.BrowserViewportWidth}" VerticalAlignment="Center" Opacity="0.8"/>
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Config.BrowserViewportWidth}" Minimum="320" Maximum="3840" Increment="80"/>
                            <TextBlock Grid.Row="4" Text="{loc:Loc Config.BrowserViewportHeight}" VerticalAlignment="Center" Opacity="0.8"/>
                            <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding Config.BrowserViewportHeight}" Minimum="240" Maximum="2160" Increment="60"/>
                            <TextBlock Grid.Row="5" Text="{loc:Loc Config.BrowserOperationTimeout}" VerticalAlignment="Center" Opacity="0.8"/>
                            <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding Config.BrowserOperationTimeoutSeconds}" Minimum="5" Maximum="300" Increment="5"/>
                            <TextBlock Grid.Row="6" Text="{loc:Loc Config.BrowserMaxSteps}" VerticalAlignment="Center" Opacity="0.8"/>
                            <NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding Config.BrowserMaxSteps}" Minimum="1" Maximum="50"/>
                            <TextBlock Grid.Row="7" Text="{loc:Loc Config.BrowserSessionTtl}" VerticalAlignment="Center" Opacity="0.8"/>
                            <NumericUpDown Grid.Row="7" Grid.Column="1" Value="{Binding Config.BrowserSessionTtlMinutes}" Minimum="1" Maximum="120"/>
                            <TextBlock Grid.Row="8" Text="{loc:Loc Config.BrowserPersistSession}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ToggleSwitch Grid.Row="8" Grid.Column="1" IsChecked="{Binding Config.BrowserPersistSession}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="9" Text="{loc:Loc Config.BrowserDownloadEnabled}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ToggleSwitch Grid.Row="9" Grid.Column="1" IsChecked="{Binding Config.BrowserDownloadEnabled}" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="8" IsEnabled="{Binding IsBrowserVisionEnabled}">
                            <TextBlock Text="{loc:Loc Config.BrowserSomMaxElements}" VerticalAlignment="Center" Opacity="0.8"/>
                            <NumericUpDown Grid.Column="1" Value="{Binding Config.BrowserSomMaxElements}" Minimum="10" Maximum="200" Increment="10"/>
                            <TextBlock Grid.Row="1" Text="{loc:Loc Config.BrowserSomIncludeText}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding Config.BrowserSomIncludeText}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="2" Text="{loc:Loc Config.BrowserScreenshotScale}" VerticalAlignment="Center" Opacity="0.8"/>
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Config.BrowserScreenshotScale}" Minimum="0.25" Maximum="2" Increment="0.25"/>
                            <TextBlock Grid.Row="3" Text="{loc:Loc Config.BrowserImageQuality}" VerticalAlignment="Center" Opacity="0.8"/>
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Config.BrowserImageQuality}" Minimum="30" Maximum="100" Increment="5"/>
                        </Grid>
                        <Grid ColumnDefinitions="120,*" ColumnSpacing="20">
                            <TextBlock Text="{loc:Loc Config.BrowserStructuredOutputMode}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding BrowserStructuredOutputModes}" SelectedItem="{Binding Config.BrowserStructuredOutputMode}"/>
                        </Grid>
                        <Grid ColumnDefinitions="120,*" ColumnSpacing="20">
                            <u:IconButton HorizontalAlignment="Left" Command="{Binding TestBrowserRuntimeCommand}" IsLoading="{Binding IsTestingBrowserRuntime}" Content="{loc:Loc Config.BrowserTestRuntime}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <u:IconButton Command="{Binding InstallBrowserRuntimeCommand}" IsLoading="{Binding IsInstallingBrowserRuntime}" Content="{loc:Loc Config.BrowserInstallRuntime}"/>
                                <u:IconButton Command="{Binding TestBrowserAgentCommand}" IsLoading="{Binding IsTestingBrowserAgent}" Content="{loc:Loc Config.BtnRunDiagnostics}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding BrowserRuntimeStatus}" IsVisible="{Binding HasBrowserRuntimeStatus}" FontSize="11" Opacity="0.7"/>
                        <TextBlock Text="{Binding BrowserAgentTestStatus}" IsVisible="{Binding HasBrowserAgentTestStatus}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </Border>

                <!-- Context management -->
                <Border Background="{DynamicResource App.SectionBg}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{loc:Loc Config.SectionMemory}" FontWeight="Bold" FontSize="15"/>
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="12">
                            <TextBlock Text="{loc:Loc Config.CtxUsage}" VerticalAlignment="Center" Opacity="0.8"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding TokenService.TokenInfoText}" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Loc Config.WarnHigh}" IsVisible="{Binding TokenService.IsNearLimit}" Foreground="{DynamicResource SemiRed6}" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="{loc:Loc Config.MemMaxCtx}" VerticalAlignment="Center" Opacity="0.8"/>
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Config.MaxContextTokens}" Minimum="1000" Maximum="99999999999" Increment="1000"/>
                            <TextBlock Grid.Row="2" Text="{loc:Loc Config.WorkspaceKnowledgeBudget}" VerticalAlignment="Center" Opacity="0.8"/>
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Config.WorkspaceKnowledgeTokenBudget}" Minimum="128" Maximum="{Binding Config.MaxContextTokens}" Increment="250"/>
                            <TextBlock Grid.Row="3" Text="{loc:Loc Config.MemCompThresh}" VerticalAlignment="Center" Opacity="0.8"/>
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Config.CompressionThreshold}" Minimum="500" Maximum="{Binding Config.MaxContextTokens}" Increment="500" IsEnabled="{Binding Config.AutoCompress}"/>
                            <TextBlock Grid.Row="4" Text="{loc:Loc Config.MemAutoComp}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ToggleSwitch Grid.Row="4" Grid.Column="1" IsChecked="{Binding Config.AutoCompress}"/>
                        </Grid>
                        <Border Background="{DynamicResource App.AssistantBubbleBg}" CornerRadius="4">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{loc:Loc Config.CompressionPreview}" FontSize="12" FontWeight="SemiBold" Opacity="0.7"/>
                                <Border BorderThickness="1" BorderBrush="LightGray" CornerRadius="5">
                                    <ScrollViewer MinHeight="50" MaxHeight="300">
                                        <lmd:MarkdownRenderer loc:MarkdownHelper.Text="{Binding TokenService.CompressionPreview}"/>
                                    </ScrollViewer>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <u:IconButton Command="{Binding CompressContextCommand}" IsLoading="{Binding IsCompressing}" Content="{loc:Loc Config.BtnExecCompression}"/>
                                    <Button Command="{Binding UndoCompressionCommand}" Content="{loc:Loc Config.BtnUndoCompression}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Tool approval -->
                <Border Background="{DynamicResource App.SectionBg}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,60" Padding="16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{loc:Loc Config.ToolApproval.Header}" FontWeight="Bold" FontSize="15"/>
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="20">
                            <TextBlock Text="{loc:Loc Config.ToolApproval.Mode}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ToolApprovalModes}" SelectedItem="{Binding Config.ToolApprovalMode}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource ToolApprovalModeToDisplay}}"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:Loc Config.ToolApproval.ModeHint}" IsVisible="{Binding !IsAutomaticApproval}" FontSize="12" Opacity="0.6" Margin="0,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:Loc Config.ToolApproval.AutomaticHint}" IsVisible="{Binding IsAutomaticApproval}" FontSize="12" Opacity="0.8" Margin="0,8"/>
                            <TextBlock Grid.Row="2" Text="{loc:Loc Config.ToolApproval.SubAgentsInherit}" VerticalAlignment="Center" Opacity="0.8"/>
                            <ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding Config.SubAgentsInheritApproval}" HorizontalAlignment="Left"/>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Loc Config.ToolApproval.AutoAllowed}" Opacity="0.8"/>
                            <ItemsControl ItemsSource="{Binding Config.AutoAllowedTools}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="120,*" Margin="0,2">
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" FontFamily="Consolas, Menlo, monospace" FontSize="13"/>
                                            <Button Grid.Column="1" Content="{loc:Loc Config.ToolApproval.Revoke}"
                                                    Command="{Binding $parent[ItemsControl].((vm:ConfigTabViewModel)DataContext).RevokeAutoAllowedToolCommand}"
                                                    CommandParameter="{Binding}" FontSize="12" Padding="8,2"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Loc Config.ToolApproval.TerminalAllowlist}" Opacity="0.8"/>
                            <ItemsControl ItemsSource="{Binding Config.TerminalAllowlist}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="120,*" Margin="0,2">
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" FontFamily="Consolas, Menlo, monospace" FontSize="13"/>
                                            <Button Grid.Column="1" Content="{loc:Loc Config.ToolApproval.Revoke}"
                                                    Command="{Binding $parent[ItemsControl].((vm:ConfigTabViewModel)DataContext).RevokeTerminalAllowlistCommand}"
                                                    CommandParameter="{Binding}" FontSize="12" Padding="8,2"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
