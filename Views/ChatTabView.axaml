<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:models="using:Athena.UI.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Athena.UI.Markup"
             xmlns:lmd="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             mc:Ignorable="d" 
             d:DesignWidth="720" 
             d:DesignHeight="1080"
             x:Class="Athena.UI.Views.ChatTabView"
             x:DataType="vm:ChatTabViewModel">

    <Design.DataContext>
        <vm:ChatTabViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <!-- 加载动画 -->
        <Style Selector="StackPanel.loading-pulse > TextBlock">
            <Style.Animations>
                <Animation Duration="0:0:1.0" IterationCount="Infinite" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%"> <Setter Property="Opacity" Value="0.2"/> </KeyFrame>
                    <KeyFrame Cue="100%"> <Setter Property="Opacity" Value="1.0"/> </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- 消息气泡基础样式 -->
        <Style Selector="Border.message-bubble">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGreyLowBrush}"/>
        </Style>

        <!-- 用户消息气泡 -->
        <Style Selector="Border.user-bubble">
            <Setter Property="Background" Value="{DynamicResource Chat.UserBubbleBg}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- AI 消息气泡 -->
        <Style Selector="Border.assistant-bubble">
            <Setter Property="Background" Value="{DynamicResource Chat.AssistantBubbleBg}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- 角色标题颜色 -->
        <Style Selector="TextBlock.role-title">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.user-title">
            <Setter Property="Foreground" Value="{DynamicResource SemiBlue6}"/>
        </Style>
        <Style Selector="TextBlock.assistant-title">
            <Setter Property="Foreground" Value="{DynamicResource SemiGreen6}"/>
        </Style>

        <Style Selector="Border.attachment-card">
            <Setter Property="Width" Value="116"/>
            <Setter Property="MinHeight" Value="92"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGreyLowBrush}"/>
            <Setter Property="Background" Value="{DynamicResource App.SectionBg}"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

        <Style Selector="Button.attachment-remove-button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="40,*,Auto">

        <!-- 聊天区域头部 -->
        <Border Grid.Row="0"
                Background="{DynamicResource App.SectionBg}"
                BorderThickness="0,0,0,1"
                VerticalAlignment="Center"
                Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{loc:Loc Chat.Header}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           FontSize="14"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding ContextTokensInfo}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Chat.TimestampFg}"
                           FontSize="12" />

                <Button Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleThemeCommand}"
                        Tag="{Binding ThemeIcon}"
                        Margin="0,0,8,0"
                        ToolTip.Tip="{loc:Loc Chat.BtnTheme}">
                    <Panel>
                        <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconMoon}" IsVisible="{Binding ThemeIcon, Converter={StaticResource ThemeTagToVisibilityConverter}, ConverterParameter=Moon}"/>
                        <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconSun}" IsVisible="{Binding ThemeIcon, Converter={StaticResource ThemeTagToVisibilityConverter}, ConverterParameter=Sun}"/>
                    </Panel>
                </Button>
                
                <Button Grid.Column="3" 
                        VerticalAlignment="Center"
                        Command="{Binding NewConversationCommand}" 
                        Margin="0,0,8,0" 
                        ToolTip.Tip="{loc:Loc Chat.BtnReset}">
                    <Panel>
                        <PathIcon Data="{StaticResource SemiIconPlusCircle}" Width="16" Height="16" IsVisible="{Binding !IsResetting}"/>
                        <PathIcon Data="{StaticResource SemiIconLoading}" Width="16" Height="16" IsVisible="{Binding IsResetting}" Classes="SlowSpin"/>
                    </Panel>
                </Button>
            </Grid>
        </Border>

        <!-- 聊天消息列表 -->
        <ScrollViewer Grid.Row="1" Name="ChatScrollViewer" Padding="12">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage">
                        <Grid Margin="0,0,0,40" IsVisible="{Binding IsBubbleVisible}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="{Binding IsUser, Converter={StaticResource IntToColumnConverter}, ConverterParameter=UserAlign}"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="{Binding IsUser, Converter={StaticResource BoolToAlignmentConverter}}"
                                        Spacing="4">

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                                    <TextBlock Text="{Binding IsUser, Converter={StaticResource RoleToTitleConverter}}"
                                               Classes.role-title="True"
                                               Classes.user-title="{Binding IsUser}"
                                               Classes.assistant-title="{Binding !IsUser}"/>
                                    
                                    <TextBlock Text="{Binding TimestampText}"
                                               Foreground="{DynamicResource Chat.TimestampFg}" 
                                               FontSize="10" 
                                               VerticalAlignment="Center"/>
                                    
                                    <TextBlock Text="Archived" 
                                               IsVisible="{Binding IsCompressed}" 
                                               Foreground="{DynamicResource Chat.ArchivedFg}" 
                                               FontSize="10" 
                                               VerticalAlignment="Center" 
                                               FontWeight="Bold"/>
                                </StackPanel>

                                <Border Classes="message-bubble"
                                        Classes.user-bubble="{Binding IsUser}"
                                        Classes.assistant-bubble="{Binding !IsUser}">
                                    <StackPanel Spacing="4">
                                        <lmd:MarkdownRenderer
                                                   loc:MarkdownHelper.Text="{Binding DisplayText}"
                                                   IsVisible="{Binding IsContentVisible}"
                                                   HorizontalAlignment="Stretch" />

                                        <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:ChatAttachment">
                                                    <Border Classes="attachment-card" Margin="0,4,8,4">
                                                        <Grid RowDefinitions="56,Auto,Auto">
                                                            <Border Grid.Row="0"
                                                                    CornerRadius="5"
                                                                    ClipToBounds="True"
                                                                    Background="{DynamicResource SemiGreyLowBrush}">
                                                                <Image Source="{Binding PreviewImage}"
                                                                       Stretch="UniformToFill"
                                                                       IsVisible="{Binding IsImage}"/>
                                                            </Border>
                                                            <Border Grid.Row="0"
                                                                    IsVisible="{Binding !IsImage}"
                                                                    Background="{DynamicResource SemiGreyLowBrush}"
                                                                    CornerRadius="5">
                                                                <TextBlock Text="{Binding FileExtension}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="13"
                                                                           FontWeight="Bold"/>
                                                            </Border>
                                                            <TextBlock Grid.Row="1"
                                                                       Text="{Binding DisplayName}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       FontSize="11"
                                                                       Margin="0,5,0,0"/>
                                                            <TextBlock Grid.Row="2"
                                                                       Text="{Binding DisplaySize}"
                                                                       FontSize="10"
                                                                       Opacity="0.65"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBox Text="{Binding EditContent}"
                                                 IsVisible="{Binding IsEditing}"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 Background="Transparent" BorderThickness="0"/>

                                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasToolExecutionSummary}">
                                            <PathIcon Data="{StaticResource SemiIconLoading}" Classes="SlowSpin" Width="14" Height="14" Opacity="0.6"/>
                                            <TextBlock Text="{Binding ToolExecutionSummary}" FontStyle="Italic" Opacity="0.6" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Classes="loading-pulse" IsVisible="{Binding IsLoading}" Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="..." FontSize="14" FontWeight="Bold" IsVisible="{Binding !HasToolExecutionSummary}"/>
                                            <TextBlock Text="{loc:Loc Chat.ReceivingData}" FontSize="14" IsVisible="{Binding !HasToolExecutionSummary}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 操作按钮 -->
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" IsVisible="{Binding !IsLoading}">
                                    <Button Command="{Binding $parent[ItemsControl].((vm:ChatTabViewModel)DataContext).CopyMessageCommand}" 
                                            CommandParameter="{Binding}" 
                                            FontSize="11"
                                            ToolTip.Tip="{loc:Loc Chat.BtnCopy}">
                                        <PathIcon Data="{StaticResource SemiIconCopy}" Width="14" Height="14"/>
                                    </Button>

                                    <Button Command="{Binding $parent[ItemsControl].((vm:ChatTabViewModel)DataContext).StartInlineEditCommand}" 
                                            CommandParameter="{Binding}" 
                                            IsVisible="{Binding CanShowEdit}" 
                                            FontSize="11"
                                            ToolTip.Tip="{loc:Loc Chat.BtnEdit}">
                                        <PathIcon Data="{StaticResource SemiIconEdit}" Width="14" Height="14"/>
                                    </Button>
                                    
                                    <Button Command="{Binding $parent[ItemsControl].((vm:ChatTabViewModel)DataContext).ConfirmInlineEditCommand}" 
                                            CommandParameter="{Binding}" 
                                            IsVisible="{Binding IsEditing}" 
                                            FontSize="11"
                                            ToolTip.Tip="{loc:Loc Chat.BtnConfirm}">
                                        <PathIcon Data="{StaticResource SemiIconTick}" Width="14" Height="14"/>
                                    </Button>
                                    
                                    <Button Command="{Binding $parent[ItemsControl].((vm:ChatTabViewModel)DataContext).CancelInlineEditCommand}" 
                                            CommandParameter="{Binding}" 
                                            IsVisible="{Binding IsEditing}" 
                                            FontSize="11"
                                            ToolTip.Tip="{loc:Loc Chat.BtnAbort}">
                                        <PathIcon Data="{StaticResource SemiIconClose}" Width="14" Height="14"/>
                                    </Button>
                                    
                                    <Button Command="{Binding $parent[ItemsControl].((vm:ChatTabViewModel)DataContext).RegenerateResponseCommand}" 
                                            CommandParameter="{Binding}" 
                                            IsVisible="{Binding CanShowRegenerate}" 
                                            FontSize="11"
                                            ToolTip.Tip="{loc:Loc Chat.BtnRegen}">
                                        <PathIcon Data="{StaticResource SemiIconSync}" Width="14" Height="14"/>
                                    </Button>

                                    <Button Command="{Binding $parent[ItemsControl].((vm:ChatTabViewModel)DataContext).DeleteMessageCommand}" 
                                            CommandParameter="{Binding}" 
                                            IsVisible="{Binding !IsCompressed}" 
                                            FontSize="11"
                                            ToolTip.Tip="{loc:Loc Chat.BtnPurge}">
                                        <PathIcon Data="{StaticResource SemiIconDelete}" Width="14" Height="14"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 输入区域 -->
        <Border Grid.Row="2" 
                BorderBrush="{DynamicResource App.SectionBg}"
                BorderThickness="0,1,0,0" 
                Padding="12" >
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                <ItemsControl Grid.Row="0"
                              Grid.ColumnSpan="3"
                              ItemsSource="{Binding PendingAttachments}"
                              IsVisible="{Binding HasPendingAttachments}"
                              Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ChatAttachment">
                            <Border Classes="attachment-card" Margin="0,0,8,8">
                                <Grid RowDefinitions="56,Auto,Auto">
                                    <Border Grid.Row="0"
                                            CornerRadius="5"
                                            ClipToBounds="True"
                                            Background="{DynamicResource SemiGreyLowBrush}">
                                        <Image Source="{Binding PreviewImage}"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding IsImage}"/>
                                    </Border>
                                    <Border Grid.Row="0"
                                            IsVisible="{Binding !IsImage}"
                                            Background="{DynamicResource SemiGreyLowBrush}"
                                            CornerRadius="5">
                                        <TextBlock Text="{Binding FileExtension}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="Bold"/>
                                    </Border>
                                    <Button Grid.Row="0"
                                            Classes="attachment-remove-button"
                                            Command="{Binding $parent[ItemsControl].((vm:ChatTabViewModel)DataContext).RemovePendingAttachmentCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{loc:Loc Chat.Attach.Remove}">
                                        <PathIcon Data="{StaticResource SemiIconClose}" Width="12" Height="12"/>
                                    </Button>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="11"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding DisplaySize}"
                                               FontSize="10"
                                               Opacity="0.65"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="3"
                           Text="{Binding AttachmentStatusMessage}"
                           IsVisible="{Binding HasAttachmentStatusMessage}"
                           Foreground="{DynamicResource SemiRed6}"
                           FontSize="12"
                           Margin="0,0,0,8"/>

                <Button Grid.Row="2"
                        Grid.Column="0"
                        Command="{Binding AttachFileCommand}" 
                        VerticalAlignment="Center" 
                        Margin="0,0,8,0"
                        IsEnabled="{Binding !IsSending}"
                        ToolTip.Tip="{loc:Loc Chat.Attach.Add}">
                    <PathIcon Data="{StaticResource SemiIconPlus}" Width="14" Height="14"/>
                </Button>

                <TextBox x:Name="MessageInputTextBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         Text="{Binding InputText}"
                         PlaceholderText="{Binding InputPlaceholder, Converter={StaticResource LocConverter}}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Center"
                         MaxHeight="150"
                         IsEnabled="{Binding !IsSending}">
                    <TextBox.KeyBindings>
                        <KeyBinding Command="{Binding SendMessageCommand}" Gesture="Enter"/>
                    </TextBox.KeyBindings>
                </TextBox>

                <Button Grid.Row="2"
                        Grid.Column="2"
                        Command="{Binding SendMessageCommand}"
                        Margin="12,0,0,0"
                        Classes="accent"
                        Padding="20,8"
                        IsVisible="{Binding !IsSending}"
                        ToolTip.Tip="{loc:Loc Chat.BtnExecute}">
                    <PathIcon Data="{StaticResource SemiIconSend}" Width="16" Height="16"/>
                </Button>

                <Button Grid.Row="2"
                        Grid.Column="2"
                        Command="{Binding StopResponseCommand}"
                        Margin="12,0,0,0"
                        Classes="accent"
                        Padding="20,8"
                        IsVisible="{Binding IsSending}"
                        ToolTip.Tip="{loc:Loc Chat.BtnStop}">
                    <PathIcon Data="{StaticResource SemiIconStop}"
                              Width="16"
                              Height="16"
                              Foreground="{DynamicResource SemiRed6}"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
