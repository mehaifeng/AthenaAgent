<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:models="using:Athena.UI.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Athena.UI.Markup"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:lmd="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             mc:Ignorable="d" 
             d:DesignWidth="720" 
             d:DesignHeight="1080"
             x:Class="Athena.UI.Views.ChatTabView"
             x:DataType="vm:ChatTabViewModel">

    <Design.DataContext>
        <vm:ChatTabViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <!-- 加载动画 -->
        <Style Selector="StackPanel.loading-pulse > TextBlock">
            <Style.Animations>
                <Animation Duration="0:0:1.0" IterationCount="Infinite" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%"> <Setter Property="Opacity" Value="0.2"/> </KeyFrame>
                    <KeyFrame Cue="100%"> <Setter Property="Opacity" Value="1.0"/> </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- 消息气泡基础样式 -->
        <Style Selector="Border.message-bubble">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGreyLowBrush}"/>
        </Style>

        <!-- 用户消息气泡 -->
        <Style Selector="Border.user-bubble">
            <Setter Property="Background" Value="{DynamicResource Chat.UserBubbleBg}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- AI 消息气泡 -->
        <Style Selector="Border.assistant-bubble">
            <Setter Property="Background" Value="{DynamicResource Chat.AssistantBubbleBg}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- 角色标题颜色 -->
        <Style Selector="TextBlock.role-title">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.user-title">
            <Setter Property="Foreground" Value="{DynamicResource App.EmphasisForeground}"/>
        </Style>
        <Style Selector="TextBlock.assistant-title">
            <Setter Property="Foreground" Value="{DynamicResource SemiGreen6}"/>
        </Style>

        <Style Selector="Border.attachment-card">
            <Setter Property="Width" Value="116"/>
            <Setter Property="MinHeight" Value="92"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGreyLowBrush}"/>
            <Setter Property="Background" Value="{DynamicResource App.SectionBg}"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

        <Style Selector="Border.audio-attachment-card">
            <Setter Property="MinWidth" Value="240"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGreyLowBrush}"/>
            <Setter Property="Background" Value="{DynamicResource App.SectionBg}"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style Selector="Border.inline-generated-image">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource App.SectionBg}"/>
            <Setter Property="MaxWidth" Value="560"/>
        </Style>

        <Style Selector="Button.attachment-remove-button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="40,*,Auto">

        <!-- 聊天区域头部 -->
        <Border Grid.Row="0"
                Background="{DynamicResource App.SectionBg}"
                CornerRadius="0,0,5,5"
                VerticalAlignment="Center"
                Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Chat.Header}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               FontSize="14"/>

                    <!-- 调试：切换原始上下文(raw)视图，仅在对话流完成时可用 -->
                    <u:IconToggleButton 
                      IsChecked="{Binding IsRawContextView}"
                      IsEnabled="{Binding CanToggleRawContext}"
                      Icon="{StaticResource SemiIconBrackets}"
                      VerticalAlignment="Center"
                      Padding="6,2"
                      FontSize="11"
                      ToolTip.Tip="{loc:Loc Chat.Raw.Toggle}"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding ContextTokensInfo}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Chat.TimestampFg}"
                           FontSize="12" />

                <Button Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleThemeCommand}"
                        Tag="{Binding ThemeIcon}"
                        Margin="0,0,8,0"
                        ToolTip.Tip="{loc:Loc Chat.BtnTheme}">
                    <Panel>
                        <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconMoon}" IsVisible="{Binding ThemeIcon, Converter={StaticResource ThemeTagToVisibilityConverter}, ConverterParameter=Moon}"/>
                        <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconSun}" IsVisible="{Binding ThemeIcon, Converter={StaticResource ThemeTagToVisibilityConverter}, ConverterParameter=Sun}"/>
                    </Panel>
                </Button>
                
                <u:IconButton Grid.Column="3"
                              VerticalAlignment="Center"
                              Command="{Binding NewConversationCommand}"
                              IsLoading="{Binding IsResetting}"
                              Margin="0,0,8,0"
                              Icon="{StaticResource SemiIconPlusCircle}"
                              ToolTip.Tip="{loc:Loc Chat.BtnReset}"/>
            </Grid>
        </Border>

        <!-- 聊天消息列表 -->
        <ScrollViewer Grid.Row="1" Name="ChatScrollViewer" Padding="12"
                      IsVisible="{Binding !IsRawContextView}">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage">
                        <Grid Margin="0,0,0,40" IsVisible="{Binding IsBubbleVisible}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="{Binding IsUser, Converter={StaticResource IntToColumnConverter}, ConverterParameter=UserAlign}"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="{Binding IsUser, Converter={StaticResource BoolToAlignmentConverter}}"
                                        Spacing="4">

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                                    <TextBlock Text="{Binding IsUser, Converter={StaticResource RoleToTitleConverter}}"
                                               Classes.role-title="True"
                                               Classes.user-title="{Binding IsUser}"
                                               Classes.assistant-title="{Binding !IsUser}"/>
                                    
                                    <TextBlock Text="{Binding TimestampText}"
                                               Foreground="{DynamicResource Chat.TimestampFg}" 
                                               FontSize="10" 
                                               VerticalAlignment="Center"/>
                                    
                                    <TextBlock Text="Archived" 
                                               IsVisible="{Binding IsCompressed}" 
                                               Foreground="{DynamicResource Chat.ArchivedFg}" 
                                               FontSize="10" 
                                               VerticalAlignment="Center" 
                                               FontWeight="Bold"/>
                                </StackPanel>

                                <Border Classes="message-bubble"
                                        Classes.user-bubble="{Binding IsUser}"
                                        Classes.assistant-bubble="{Binding !IsUser}">
                                    <StackPanel Spacing="4">
                                        <!-- 用户消息：纯文本，自适应宽度 -->
                                        <SelectableTextBlock Text="{Binding DisplayText}"
                                                   IsVisible="{Binding ShowUserPlainText}"
                                                   TextWrapping="Wrap"
                                                   HorizontalAlignment="Left" />

                                        <!-- 助手消息：Markdown 渲染 -->
                                        <lmd:MarkdownRenderer
                                                   loc:MarkdownHelper.Text="{Binding DisplayText}"
                                                   IsVisible="{Binding ShowAssistantMarkdown}"
                                                   HorizontalAlignment="Stretch" />

                                        <ItemsControl ItemsSource="{Binding Segments}" IsVisible="{Binding UsesSegmentLayout}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:ChatMessageSegment">
                                                    <StackPanel Margin="0,0,0,6">
                                                        <StackPanel.IsVisible>
                                                            <MultiBinding Converter="{StaticResource ToolCardVisibilityConverter}">
                                                                <Binding Path="IsToolCall"/>
                                                                <Binding Path="$parent[UserControl].((vm:ChatTabViewModel)DataContext).ShowToolCallDetails"/>
                                                            </MultiBinding>
                                                        </StackPanel.IsVisible>
                                                        <lmd:MarkdownRenderer
                                                            loc:MarkdownHelper.Text="{Binding Text}"
                                                            IsVisible="{Binding IsMarkdown}"
                                                            HorizontalAlignment="Stretch" />

                                                        <Button IsVisible="{Binding IsGeneratedImage}"
                                                                Command="{Binding $parent[UserControl].((vm:ChatTabViewModel)DataContext).OpenImageAttachmentCommand}"
                                                                CommandParameter="{Binding Attachment}"
                                                                Padding="0"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                HorizontalAlignment="Left">
                                                            <Border Classes="inline-generated-image">
                                                                <Image Source="{Binding Attachment.PreviewImage}"
                                                                       Stretch="Uniform"
                                                                       MaxWidth="560"/>
                                                            </Border>
                                                        </Button>

                                                        <!-- 工具调用卡片：可折叠，显示状态/摘要，展开后看参数与结果 -->
                                                        <Border IsVisible="{Binding IsToolCall}"
                                                                Classes="tool-call-card"
                                                                Background="{DynamicResource App.SectionBg}"
                                                                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="1"
                                                                HorizontalAlignment="Stretch">
                                                            <StackPanel>
                                                                <!-- 标题行：点击展开/折叠 -->
                                                                <Button Command="{Binding $parent[UserControl].((vm:ChatTabViewModel)DataContext).ToggleToolCallExpandedCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="6,3"
                                                                        HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Stretch">
                                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" >
                                                                        <!-- 状态图标 -->
                                                                        <PathIcon Grid.Column="0"
                                                                                  Data="{StaticResource SemiIconLoading}"
                                                                                  Classes="SlowSpin"
                                                                                  IsVisible="{Binding IsToolRunning}"
                                                                                  Width="11" Height="11"
                                                                                  Opacity="0.7"
                                                                                  VerticalAlignment="Center"/>
                                                                        <PathIcon Grid.Column="0"
                                                                                  Data="{StaticResource SemiIconTickCircle}"
                                                                                  IsVisible="{Binding IsToolSuccess}"
                                                                                  Width="11" Height="11"
                                                                                  Foreground="{DynamicResource SemiGreen6}"
                                                                                  VerticalAlignment="Center"/>
                                                                        <PathIcon Grid.Column="0"
                                                                                  Data="{StaticResource SemiIconAlertCircle}"
                                                                                  IsVisible="{Binding IsToolFailed}"
                                                                                  Width="11" Height="11"
                                                                                  Foreground="{DynamicResource SemiRed6}"
                                                                                  VerticalAlignment="Center"/>

                                                                        <PathIcon Grid.Column="1"
                                                                                  Data="{Binding ToolIconKey, Converter={StaticResource ToolIconKeyToGeometryConverter}}"
                                                                                  Margin="6,0,4,0"
                                                                                  Width="11" Height="11"
                                                                                  Opacity="0.8"
                                                                                  VerticalAlignment="Center"/>

                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="{Binding ToolSummary}"
                                                                                   FontSize="11"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   VerticalAlignment="Center"/>

                                                                        <PathIcon Grid.Column="3"
                                                                                  Data="{StaticResource SemiIconChevronDown}"
                                                                                  Width="10" Height="10"
                                                                                  Opacity="0.5"
                                                                                  IsVisible="{Binding IsExpanded}"
                                                                                  VerticalAlignment="Center"/>
                                                                        <PathIcon Grid.Column="3"
                                                                                  Data="{StaticResource SemiIconChevronRight}"
                                                                                  Width="10" Height="10"
                                                                                  Opacity="0.5"
                                                                                  IsVisible="{Binding !IsExpanded}"
                                                                                  VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Button>

                                                                <!-- 详情：参数与结果 -->
                                                                <StackPanel IsVisible="{Binding IsExpanded}"
                                                                            Margin="8,0,8,6"
                                                                            Spacing="4">
                                                                    <TextBlock Text="{loc:Loc Tool.ArgumentsLabel}"
                                                                               IsVisible="{Binding HasToolArguments}"
                                                                               FontSize="10" FontWeight="SemiBold" Opacity="0.6"/>
                                                                    <Border IsVisible="{Binding HasToolArguments}"
                                                                            Background="{DynamicResource App.SelectedBackground}"
                                                                            CornerRadius="4" Padding="6">
                                                                        <SelectableTextBlock Text="{Binding ToolArguments}"
                                                                                             FontFamily="{StaticResource MonospaceFontFamily}"
                                                                                             FontSize="11"
                                                                                             TextWrapping="Wrap"/>
                                                                    </Border>

                                                                    <TextBlock Text="{loc:Loc Tool.ResultLabel}"
                                                                               IsVisible="{Binding HasToolResult}"
                                                                               FontSize="10" FontWeight="SemiBold" Opacity="0.6"/>
                                                                    <Border IsVisible="{Binding HasToolResult}"
                                                                            Background="{DynamicResource App.SelectedBackground}"
                                                                            CornerRadius="4" Padding="6">
                                                                        <SelectableTextBlock Text="{Binding ToolResult}"
                                                                                             FontSize="11"
                                                                                             TextWrapping="Wrap"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding AttachmentPanelItems}" IsVisible="{Binding ShouldShowAttachmentPanel}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:ChatAttachment">
                                                    <Grid Margin="0,4,8,4">
                                                        <Button IsVisible="{Binding IsImage}"
                                                                Command="{Binding $parent[UserControl].((vm:ChatTabViewModel)DataContext).OpenImageAttachmentCommand}"
                                                                CommandParameter="{Binding}"
                                                                Padding="0"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                HorizontalAlignment="Left"
                                                                ToolTip.Tip="{Binding DisplayName}">
                                                            <Border Classes="attachment-card">
                                                                <Grid RowDefinitions="56,Auto,Auto">
                                                                    <Border Grid.Row="0"
                                                                            CornerRadius="5"
                                                                            ClipToBounds="True"
                                                                            Background="{DynamicResource SemiGreyLowBrush}">
                                                                        <Image Source="{Binding PreviewImage}"
                                                                               Stretch="UniformToFill"/>
                                                                    </Border>
                                                                    <TextBlock Grid.Row="1"
                                                                               Text="{Binding DisplayName}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               FontSize="11"
                                                                               Margin="0,5,0,0"/>
                                                                    <TextBlock Grid.Row="2"
                                                                               Text="{Binding DisplaySize}"
                                                                               FontSize="10"
                                                                               Opacity="0.65"/>
                                                                </Grid>
                                                            </Border>
                                                        </Button>

                                                        <Border Classes="attachment-card" IsVisible="{Binding IsGenericFile}">
                                                            <Grid RowDefinitions="56,Auto,Auto,Auto">
                                                                <Border Grid.Row="0"
                                                                        Background="{DynamicResource SemiGreyLowBrush}"
                                                                        CornerRadius="5">
                                                                    <TextBlock Text="{Binding FileExtension}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               FontSize="13"
                                                                               FontWeight="Bold"/>
                                                                </Border>
                                                                <TextBlock Grid.Row="1"
                                                                           Text="{Binding DisplayName}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           FontSize="11"
                                                                           Margin="0,5,0,0"/>
                                                                <TextBlock Grid.Row="2"
                                                                           Text="{Binding DisplaySize}"
                                                                           FontSize="10"
                                                                           Opacity="0.65"/>
                                                                <TextBlock Grid.Row="3"
                                                                           Text="{loc:Loc Chat.Attach.Parsed}"
                                                                           FontSize="10"
                                                                           Margin="0,3,0,0"
                                                                           Foreground="{DynamicResource SemiGreen6}"
                                                                           IsVisible="{Binding IsParsed}"/>
                                                                <TextBlock Grid.Row="3"
                                                                           Text="{loc:Loc Chat.Attach.ParseFailedShort}"
                                                                           FontSize="10"
                                                                           Margin="0,3,0,0"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip.Tip="{Binding ParseError}"
                                                                           Foreground="{DynamicResource SemiRed6}"
                                                                           IsVisible="{Binding IsParseFailed}"/>
                                                            </Grid>
                                                        </Border>

                                                        <Border Classes="audio-attachment-card" IsVisible="{Binding IsAudio}">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <Panel Grid.Column="0" VerticalAlignment="Center">
                                                                    <Button Width="32" Height="32" Padding="0"
                                                                            IsVisible="{Binding !IsPlaying}"
                                                                            Command="{Binding $parent[UserControl].((vm:ChatTabViewModel)DataContext).ToggleAudioPlaybackCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip.Tip="{loc:Loc Chat.Audio.Play}">
                                                                        <PathIcon Data="{StaticResource SemiIconPlay}" Width="14" Height="14"/>
                                                                    </Button>
                                                                    <Button Width="32" Height="32" Padding="0"
                                                                            IsVisible="{Binding IsPlaying}"
                                                                            Command="{Binding $parent[UserControl].((vm:ChatTabViewModel)DataContext).ToggleAudioPlaybackCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip.Tip="{loc:Loc Chat.Audio.Stop}">
                                                                        <PathIcon Data="{StaticResource SemiIconStop}" Width="14" Height="14"/>
                                                                    </Button>
                                                                </Panel>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding DisplayName}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"
                                                                           Margin="8,0,8,0"/>
                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding DisplaySize}"
                                                                           FontSize="10"
                                                                           Opacity="0.65"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border IsVisible="{Binding HasAudioError}"
                                                Background="{DynamicResource App.SectionBg}"
                                                BorderBrush="{DynamicResource SemiRed6}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,8">
                                            <TextBlock Text="{Binding AudioErrorMessage}"
                                                       Foreground="{DynamicResource SemiRed6}"
                                                       TextWrapping="Wrap"
                                                       FontSize="12"/>
                                        </Border>

                                        <TextBox Text="{Binding EditContent}"
                                                 IsVisible="{Binding IsEditing}"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 Background="Transparent" BorderThickness="0"/>

                                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasToolExecutionSummary}">
                                            <PathIcon Data="{StaticResource SemiIconLoading}" Classes="SlowSpin" Width="14" Height="14" Opacity="0.6"/>
                                            <TextBlock Text="{Binding ToolExecutionSummary}" FontStyle="Italic" Opacity="0.6" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Classes="loading-pulse" IsVisible="{Binding IsLoading}" Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="..." FontSize="14" FontWeight="Bold" IsVisible="{Binding !HasToolExecutionSummary}"/>
                                            <TextBlock Text="{loc:Loc Chat.ReceivingData}" FontSize="14" IsVisible="{Binding !HasToolExecutionSummary}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 操作按钮 -->
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" IsVisible="{Binding !IsLoading}">
                                    <Button Command="{Binding $parent[ItemsControl].((vm:ChatTabViewModel)DataContext).CopyMessageCommand}" 
                                            CommandParameter="{Binding}" 
                                            FontSize="11"
                                            ToolTip.Tip="{loc:Loc Chat.BtnCopy}">
                                        <PathIcon Data="{StaticResource SemiIconCopy}" Width="14" Height="14"/>
                                    </Button>

                                    <Button Command="{Binding $parent[ItemsControl].((vm:ChatTabViewModel)DataContext).StartInlineEditCommand}" 
                                            CommandParameter="{Binding}" 
                                            IsVisible="{Binding CanShowEdit}" 
                                            FontSize="11"
                                            ToolTip.Tip="{loc:Loc Chat.BtnEdit}">
                                        <PathIcon Data="{StaticResource SemiIconEdit}" Width="14" Height="14"/>
                                    </Button>
                                    
                                    <Button Command="{Binding $parent[ItemsControl].((vm:ChatTabViewModel)DataContext).ConfirmInlineEditCommand}" 
                                            CommandParameter="{Binding}" 
                                            IsVisible="{Binding IsEditing}" 
                                            FontSize="11"
                                            ToolTip.Tip="{loc:Loc Chat.BtnConfirm}">
                                        <PathIcon Data="{StaticResource SemiIconTick}" Width="14" Height="14"/>
                                    </Button>
                                    
                                    <Button Command="{Binding $parent[ItemsControl].((vm:ChatTabViewModel)DataContext).CancelInlineEditCommand}" 
                                            CommandParameter="{Binding}" 
                                            IsVisible="{Binding IsEditing}" 
                                            FontSize="11"
                                            ToolTip.Tip="{loc:Loc Chat.BtnAbort}">
                                        <PathIcon Data="{StaticResource SemiIconClose}" Width="14" Height="14"/>
                                    </Button>
                                    
                                    <Button Command="{Binding $parent[ItemsControl].((vm:ChatTabViewModel)DataContext).RegenerateResponseCommand}" 
                                            CommandParameter="{Binding}" 
                                            IsVisible="{Binding CanShowRegenerate}" 
                                            FontSize="11"
                                            ToolTip.Tip="{loc:Loc Chat.BtnRegen}">
                                        <PathIcon Data="{StaticResource SemiIconSync}" Width="14" Height="14"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 调试：原始上下文(raw)视图，与消息列表叠放在同一行，按开关切换。
             按消息拆分为独立块 + 虚拟化列表：选择只作用于单块、滚动只渲染可见块，避免大文本卡顿。 -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,5,0,5"
                      IsVisible="{Binding IsRawContextView}">
            <Border 
                CornerRadius="12"
                Background="{DynamicResource App.SectionBg}">
                <!-- 不使用虚拟化：条目高度差异极大（折叠/展开），虚拟化的滚动范围估算会导致滚动条跳跃；
                     默认折叠后折叠态渲染开销很低，普通 StackPanel 即可保证线性、稳定的滚动。 -->
                <ItemsControl ItemsSource="{Binding RawContextEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:RawContextEntry">
                            <Expander Margin="0,0,0,8"
                                      HorizontalAlignment="Stretch"
                                      IsExpanded="{Binding IsExpanded}">
                                <Expander.Header>
                                    <TextBlock Text="{Binding Header}"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                               Foreground="{Binding Role, Converter={StaticResource RawRoleToBrushConverter}}"/>
                                </Expander.Header>
                                <SelectableTextBlock Text="{Binding Text}"
                                                     FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                                     FontSize="12"
                                                     TextWrapping="Wrap"/>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </ScrollViewer>

        <!-- 输入区域：整体为一个大输入框，文本框在上、功能按钮工具栏在底部 -->
        <Border Grid.Row="2">
            <Border CornerRadius="5"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                    Background="{DynamicResource App.SectionBg}"
                    Padding="8">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <ItemsControl Grid.Row="0"
                              ItemsSource="{Binding PendingAttachments}"
                              IsVisible="{Binding HasPendingAttachments}"
                              Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ChatAttachment">
                            <Border Classes="attachment-card" Margin="0,0,8,8">
                                <Grid RowDefinitions="56,Auto,Auto,Auto">
                                    <Border Grid.Row="0"
                                            CornerRadius="5"
                                            ClipToBounds="True"
                                            Background="{DynamicResource SemiGreyLowBrush}">
                                        <Image Source="{Binding PreviewImage}"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding IsImage}"/>
                                    </Border>
                                    <Border Grid.Row="0"
                                            IsVisible="{Binding !IsImage}"
                                            Background="{DynamicResource SemiGreyLowBrush}"
                                            CornerRadius="5">
                                        <TextBlock Text="{Binding FileExtension}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="Bold"/>
                                    </Border>
                                    <Button Grid.Row="0"
                                            Classes="attachment-remove-button"
                                            Command="{Binding $parent[ItemsControl].((vm:ChatTabViewModel)DataContext).RemovePendingAttachmentCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{loc:Loc Chat.Attach.Remove}">
                                        <PathIcon Data="{StaticResource SemiIconClose}" Width="12" Height="12"/>
                                    </Button>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="11"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding DisplaySize}"
                                               FontSize="10"
                                               Opacity="0.65"/>

                                    <!-- 文档解析状态 -->
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4" Margin="0,3,0,0" IsVisible="{Binding IsParsing}">
                                        <PathIcon Data="{StaticResource SemiIconLoading}" Classes="SlowSpin" Width="10" Height="10" Opacity="0.7"/>
                                        <TextBlock Text="{loc:Loc Chat.Attach.Parsing}" FontSize="10" Opacity="0.7"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="3"
                                               Text="{loc:Loc Chat.Attach.Parsed}"
                                               FontSize="10"
                                               Margin="0,3,0,0"
                                               Foreground="{DynamicResource SemiGreen6}"
                                               IsVisible="{Binding IsParsed}"/>
                                    <TextBlock Grid.Row="3"
                                               Text="{loc:Loc Chat.Attach.ParseFailedShort}"
                                               FontSize="10"
                                               Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding ParseError}"
                                               Foreground="{DynamicResource SemiRed6}"
                                               IsVisible="{Binding IsParseFailed}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="1"
                           Text="{Binding BackgroundArchiveStatusMessage}"
                           Foreground="{DynamicResource Chat.TimestampFg}"
                           FontSize="12"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasBackgroundArchiveNeutralStatus}"/>

                <TextBlock Grid.Row="1"
                           Text="{Binding BackgroundArchiveStatusMessage}"
                           Foreground="{DynamicResource SemiRed6}"
                           FontSize="12"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasBackgroundArchiveErrorStatus}"/>

                <TextBlock Grid.Row="2"
                           Text="{Binding AttachmentStatusMessage}"
                           IsVisible="{Binding HasAttachmentStatusMessage}"
                           Foreground="{DynamicResource SemiRed6}"
                           FontSize="12"
                           Margin="0,0,0,8"/>

                <!-- 文本输入：无边框，融入外层卡片 -->
                <TextBox x:Name="MessageInputTextBox"
                         Grid.Row="3"
                         Text="{Binding InputText}"
                         PlaceholderText="{Binding InputPlaceholder, Converter={StaticResource LocConverter}}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="4,2"
                         MaxHeight="150"
                         IsEnabled="{Binding !IsSending}">
                    <!-- 覆盖 Semi 主题驱动悬停/聚焦高亮的画刷，使输入框完全融入外层卡片 -->
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextBoxDefaultBorderBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextBoxPointeroverBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextBoxPointeroverBorderBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextBoxFocusBorderBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextBoxPressedBackground" Color="Transparent"/>
                        <Thickness x:Key="TextBoxBorderThickness">0</Thickness>
                    </TextBox.Resources>
                    <TextBox.KeyBindings>
                        <KeyBinding Command="{Binding SendMessageCommand}" Gesture="Enter"/>
                    </TextBox.KeyBindings>
                </TextBox>

                <!-- 底部功能工具栏：左侧功能按钮，右侧发送/停止 -->
                <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">
                        <Button Command="{Binding AttachFileCommand}"
                                BorderThickness="0"
                                Padding="6"
                                IsEnabled="{Binding !IsSending}"
                                ToolTip.Tip="{loc:Loc Chat.Attach.Add}">
                            <PathIcon Data="{StaticResource SemiIconPlus}" Width="18" Height="18"/>
                        </Button>
                        <u:IconSplitButton Icon="{StaticResource SemiIconScissors}"
                                           IsEnabled="{Binding !IsSending}"
                                           Command="{Binding CaptureScreenshotCommand}"
                                           CommandParameter="keep"
                                           ToolTip.Tip="{loc:Loc Chat.Screenshot.Add}">
                            <u:IconSplitButton.Flyout>
                                <MenuFlyout Placement="Top">
                                    <MenuItem Header="{loc:Loc Chat.Screenshot.HideWindow}"
                                              Command="{Binding CaptureScreenshotCommand}"
                                              CommandParameter="hide"/>
                                </MenuFlyout>
                            </u:IconSplitButton.Flyout>
                        </u:IconSplitButton>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding SendMessageCommand}"
                            Theme="{StaticResource AccentButtonTheme}"
                            Padding="20,6"
                            IsVisible="{Binding !IsSending}"
                            ToolTip.Tip="{loc:Loc Chat.BtnExecute}">
                        <PathIcon Data="{StaticResource SemiIconSend}" Width="16" Height="16"/>
                    </Button>

                    <Button Grid.Column="1"
                            Command="{Binding StopResponseCommand}"
                            Theme="{StaticResource AccentButtonTheme}"
                            Padding="20,6"
                            IsVisible="{Binding IsSending}"
                            ToolTip.Tip="{loc:Loc Chat.BtnStop}">
                        <PathIcon Data="{StaticResource SemiIconStop}"
                                  Width="16"
                                  Height="16"
                                  Foreground="{DynamicResource SemiRed6}"/>
                    </Button>
                </Grid>
            </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
