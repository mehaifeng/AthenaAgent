<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Athena.UI.Markup"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Athena.UI.Views.TasksTabView"
             x:DataType="vm:TasksTabViewModel">

    <Design.DataContext>
        <vm:TasksTabViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <!-- 移除 ListBoxItem 默认的悬停和选中背景 -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- 定义卡片样式 -->
        <Style Selector="Border.task-item-card">
            <Setter Property="Background" Value="{DynamicResource App.SectionBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGreyLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- 悬停时改变卡片背景 -->
        <Style Selector="ListBoxItem:pointerover Border.task-item-card">
            <Setter Property="Background" Value="{DynamicResource SemiGrey1}"/>
        </Style>

        <!-- 选中时改变卡片背景和边框 -->
        <Style Selector="ListBoxItem:selected Border.task-item-card">
            <Setter Property="Background" Value="{DynamicResource App.SelectedBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.SelectedBorderBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="40,Auto,*">

        <!-- HEADER BAR -->
        <Border Grid.Row="0"
                CornerRadius="0,0,5,5"
                Background="{DynamicResource App.SectionBg}"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{loc:Loc Tasks.Header}"
                           FontWeight="SemiBold"
                           FontSize="{DynamicResource App.FontSize.Heading}"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Command="{Binding CreateTaskCommand}"
                        Padding="12,4"
                        Theme="{StaticResource AccentButtonTheme}"
                        Margin="0,0,8,0" 
                        ToolTip.Tip="{loc:Loc Tasks.BtnNewRoutine}">
                    <PathIcon Data="{StaticResource SemiIconPlus}" Width="16" Height="16"/>
                </Button>

                <Button Grid.Column="2"
                        Command="{Binding ClearAllTasksCommand}"
                        Padding="12,4" 
                        ToolTip.Tip="{loc:Loc Tasks.BtnPurgeAll}">
                    <PathIcon Data="{StaticResource SemiIconDelete}" Width="16" Height="16"/>
                </Button>
            </Grid>
        </Border>

        <!-- SUB-HEADER / STATUS -->
        <Border Grid.Row="1" Padding="12,8,12,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{loc:Loc Tasks.ActiveRoutines}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ScheduledTasks.Count}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
                <Separator Width="1" Height="14" Margin="8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{loc:Loc Tasks.SystemIdle}"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource App.FontSize.Body}"
                           Opacity="0.7"/>
            </StackPanel>
        </Border>

        <!-- TASK LIST -->
        <ScrollViewer Grid.Row="2" Margin="0,5,0,5">
            <ListBox ItemsSource="{Binding ScheduledTasks}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="task-item-card">
                            <Grid ColumnDefinitions="*,30">

                                <StackPanel Grid.Column="0" Spacing="5">
                                    <TextBlock Text="{Binding Intent}"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource App.FontSize.Heading}"
                                               FontWeight="Medium"/>

                                    <Separator Height="1" Margin="0,4,30,4"/>

                                    <StackPanel Orientation="Horizontal" Spacing="24">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{loc:Loc Tasks.Trig}"
                                                       FontSize="{DynamicResource App.FontSize.Body}"
                                                       Opacity="0.6"/>
                                            <TextBlock Text="{Binding TriggerTimeDisplay}"
                                                       FontSize="{DynamicResource App.FontSize.Body}"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{loc:Loc Tasks.Rec}"
                                                       FontSize="{DynamicResource App.FontSize.Body}"
                                                       Opacity="0.6"/>
                                            <TextBlock Text="{Binding RecurrenceDisplay}"
                                                       FontSize="{DynamicResource App.FontSize.Body}"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{loc:Loc Tasks.Type}"
                                                       FontSize="{DynamicResource App.FontSize.Body}"
                                                       Opacity="0.6"/>
                                            <TextBlock Text="{Binding TaskTypeDisplay}"
                                                       FontSize="{DynamicResource App.FontSize.Body}"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Delete Button -->
                                <Button Grid.Column="1"
                                        Command="{Binding $parent[ListBox].((vm:TasksTabViewModel)DataContext).DeleteTaskCommand}"
                                        CommandParameter="{Binding}"
                                        Classes="danger"
                                        Theme="{StaticResource BorderlessButtonTheme}"
                                        VerticalAlignment="Center"
                                        Padding="4"
                                        ToolTip.Tip="{loc:Loc History.BtnDel}">
                                    <PathIcon Data="{StaticResource SemiIconDelete}" Width="14" Height="14" Opacity="0.6"/>
                                </Button>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

    </Grid>
</UserControl>
