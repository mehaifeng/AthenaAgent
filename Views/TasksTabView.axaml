<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Athena.UI.Markup"
             xmlns:controls="using:Athena.UI.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="760"
             x:Class="Athena.UI.Views.TasksTabView"
             x:DataType="vm:TasksTabViewModel">

    <Design.DataContext>
        <vm:TasksTabViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.task-item-card">
            <Setter Property="Background" Value="{DynamicResource App.SectionBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGreyLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,13"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.task-item-card">
            <Setter Property="Background" Value="{DynamicResource SemiGrey1}"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.task-item-card">
            <Setter Property="Background" Value="{DynamicResource App.SelectedBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.SelectedBorderBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="14" ColumnDefinitions="3*,12,7*">
        <!-- 新任务表单直接进入主页左栏。 -->
        <Border Grid.Column="0"
                Background="{DynamicResource App.WorkspaceLeftBackground}"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                BorderThickness="1"
                CornerRadius="8"
                DataContext="{Binding TaskDraft}">
            <Grid RowDefinitions="*,Auto">
                <ScrollViewer Padding="14"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="15">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Loc TaskDialog.TaskIntent}"
                                       FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Intent}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="86"
                                     MaxHeight="130"
                                     PlaceholderText="{loc:Loc TaskDialog.IntentPlaceholder}"/>
                            <TextBlock Text="{loc:Loc TaskDialog.IntentHint}"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource App.FontSize.Body}"
                                       Opacity="0.62"/>
                        </StackPanel>

                        <Separator/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Loc TaskDialog.TriggerTime}"
                                       FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="Auto,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="10"
                                  RowSpacing="8">
                                <TextBlock Text="{loc:Loc TaskDialog.Date}"
                                           VerticalAlignment="Center"/>
                                <CalendarDatePicker Grid.Column="1"
                                                    SelectedDate="{Binding TriggerDate}"
                                                    HorizontalAlignment="Stretch"/>
                                <TextBlock Grid.Row="1"
                                           Text="{loc:Loc TaskDialog.Time}"
                                           VerticalAlignment="Center"/>
                                <TimePicker Grid.Row="1"
                                            Grid.Column="1"
                                            SelectedTime="{Binding TriggerTime}"
                                            HorizontalAlignment="Stretch"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Loc TaskDialog.Recurrence}"
                                       FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding RecurrencePresetDisplayNames}"
                                      SelectedIndex="{Binding SelectedRecurrencePresetIndex}"
                                      HorizontalAlignment="Stretch"/>

                            <Border IsVisible="{Binding IsCustomRecurrenceVisible}"
                                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">
                                <StackPanel Spacing="10">
                                    <ComboBox ItemsSource="{Binding CustomModeDisplayNames}"
                                              SelectedIndex="{Binding SelectedCustomModeIndex}"
                                              HorizontalAlignment="Stretch"/>

                                    <Grid IsVisible="{Binding IsIntervalEditorVisible}"
                                          ColumnDefinitions="Auto,72,*"
                                          ColumnSpacing="7">
                                        <TextBlock Text="{loc:Loc TaskDialog.Every}"
                                                   VerticalAlignment="Center"/>
                                        <controls:SafeNumericUpDown Grid.Column="1"
                                                                    Minimum="1"
                                                                    Value="{Binding CustomInterval}"
                                                                    FormatString="N0"/>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding IntervalUnitDisplayNames}"
                                                  SelectedIndex="{Binding SelectedIntervalUnitIndex}"/>
                                    </Grid>

                                    <StackPanel IsVisible="{Binding IsWeeklyDaysEditorVisible}"
                                                Spacing="8">
                                        <Grid ColumnDefinitions="Auto,72,*"
                                              ColumnSpacing="7">
                                            <TextBlock Text="{loc:Loc TaskDialog.EveryNWeeks}"
                                                       VerticalAlignment="Center"/>
                                            <controls:SafeNumericUpDown Grid.Column="1"
                                                                        Minimum="1"
                                                                        Value="{Binding CustomInterval}"
                                                                        FormatString="N0"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{loc:Loc TaskDialog.WeeksSuffix}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding WeekdaySelections}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel ItemWidth="54"
                                                               ItemHeight="31"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:WeekdaySelectionItem">
                                                    <ToggleButton Content="{Binding DisplayName}"
                                                                  IsChecked="{Binding IsSelected}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Stretch"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock IsVisible="{Binding ShowMinuteSchedulingHint}"
                                       Text="{Binding MinuteSchedulingHint}"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource App.FontSize.Body}"
                                       Opacity="0.62"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Loc TaskDialog.TaskType}"
                                       FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding TaskTypeDisplayNames}"
                                      SelectedIndex="{Binding SelectedTaskTypeIndex}"
                                      HorizontalAlignment="Stretch"/>
                            <TextBlock Text="{Binding TaskTypeDescription}"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource App.FontSize.Body}"
                                       Opacity="0.62"/>
                        </StackPanel>

                        <Border BorderBrush="{DynamicResource SemiGreyLowBrush}"
                                BorderThickness="1"
                                Padding="10"
                                CornerRadius="6">
                            <StackPanel Spacing="5">
                                <TextBlock FontSize="{DynamicResource App.FontSize.Body}"
                                           TextWrapping="Wrap">
                                    <Run Text="{loc:Loc TaskDialog.PreviewRule}"/>
                                    <Run Text="{Binding RecurrenceSummaryPreview}"/>
                                </TextBlock>
                                <TextBlock FontSize="{DynamicResource App.FontSize.Body}"
                                           TextWrapping="Wrap">
                                    <Run Text="{loc:Loc TaskDialog.FirstActualTrigger}"/>
                                    <Run Text="{Binding FirstTriggerPreview}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border IsVisible="{Binding HasValidationError}"
                                Background="#18C62828"
                                BorderBrush="#88C62828"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="9">
                            <TextBlock Text="{Binding ValidationError}"
                                       TextWrapping="Wrap"
                                       Foreground="#C62828"
                                       FontSize="{DynamicResource App.FontSize.Body}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource SemiGreyLowBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12">
                    <Button Command="{Binding $parent[UserControl].((vm:TasksTabViewModel)DataContext).CreateTaskCommand}"
                            Theme="{StaticResource AccentButtonTheme}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            IsEnabled="{Binding CanConfirm}"
                            Content="{loc:Loc TaskDialog.BtnCreate}"/>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧是可横向利用空间的任务宽列表。 -->
        <Border Grid.Column="2"
                Background="{DynamicResource App.WorkspaceRightBackground}"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid RowDefinitions="Auto,*">
                <Border Padding="12,9"
                        BorderBrush="{DynamicResource SemiGreyLowBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Tasks.ActiveRoutines}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ScheduledTasks.Count}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                            <Separator Width="1"
                                       Height="14"
                                       Margin="7,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Tasks.SystemIdle}"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource App.FontSize.Body}"
                                       Opacity="0.65"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding ClearAllTasksCommand}"
                                Padding="10,4"
                                ToolTip.Tip="{loc:Loc Tasks.BtnPurgeAll}">
                            <PathIcon Data="{StaticResource SemiIconDelete}"
                                      Width="15"
                                      Height="15"/>
                        </Button>
                    </Grid>
                </Border>

                <ListBox Grid.Row="1"
                         Margin="10"
                         ItemsSource="{Binding ScheduledTasks}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="task-item-card">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="14">
                                    <StackPanel Spacing="9">
                                        <TextBlock Text="{Binding Intent}"
                                                   TextWrapping="Wrap"
                                                   FontSize="{DynamicResource App.FontSize.Heading}"
                                                   FontWeight="Medium"/>
                                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*"
                                              ColumnSpacing="7">
                                            <TextBlock Text="{loc:Loc Tasks.Trig}"
                                                       FontSize="{DynamicResource App.FontSize.Body}"
                                                       Opacity="0.6"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TriggerTimeDisplay}"
                                                       FontSize="{DynamicResource App.FontSize.Body}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{loc:Loc Tasks.Rec}"
                                                       FontSize="{DynamicResource App.FontSize.Body}"
                                                       Opacity="0.6"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding RecurrenceDisplay}"
                                                       FontSize="{DynamicResource App.FontSize.Body}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="4"
                                                       Text="{loc:Loc Tasks.Type}"
                                                       FontSize="{DynamicResource App.FontSize.Body}"
                                                       Opacity="0.6"/>
                                            <TextBlock Grid.Column="5"
                                                       Text="{Binding TaskTypeDisplay}"
                                                       FontSize="{DynamicResource App.FontSize.Body}"
                                                       FontWeight="SemiBold"/>
                                        </Grid>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Command="{Binding $parent[ListBox].((vm:TasksTabViewModel)DataContext).DeleteTaskCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="danger"
                                            Theme="{StaticResource BorderlessButtonTheme}"
                                            VerticalAlignment="Center"
                                            Padding="5"
                                            ToolTip.Tip="{loc:Loc History.BtnDel}">
                                        <PathIcon Data="{StaticResource SemiIconDelete}"
                                                  Width="14"
                                                  Height="14"
                                                  Opacity="0.65"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
