<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Athena.UI.ViewModels"
        xmlns:loc="using:Athena.UI.Markup"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
        x:Class="Athena.UI.Views.ConfirmDialog"
        x:DataType="vm:ConfirmDialogViewModel"
        Title="{Binding Title}"
        Width="400" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="*,Auto,Auto" Margin="20">
        <!-- 消息内容 -->
        <ScrollViewer Grid.Row="0">
            <TextBlock Text="{Binding Message}"
                      TextWrapping="Wrap"
                      FontSize="14"/>
        </ScrollViewer>

        <!-- 不再询问开关 -->
        <CheckBox Grid.Row="1"
                  Content="{loc:Loc Dialog.DontAskAgain}"
                  IsChecked="{Binding DontAskAgain}"
                  Margin="0,16,0,0"/>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2"
                   Orientation="Horizontal"
                   HorizontalAlignment="Right"
                   Spacing="12"
                   Margin="0,16,0,0">
            <Button Command="{Binding CancelCommand}"
                    MinWidth="80"
                    Content="{Binding CancelText}"/>
            <Button Command="{Binding ConfirmCommand}"
                    Theme="{StaticResource AccentButtonTheme}"
                    MinWidth="80"
                    Content="{Binding ConfirmText}"/>
        </StackPanel>
    </Grid>
</Window>
