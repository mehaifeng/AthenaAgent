<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:loc="using:Athena.UI.Markup"
             x:Class="Athena.UI.Views.ConversationContextSettingsView"
             x:DataType="vm:ConversationContextSettingsViewModel">
    <ScrollViewer>
        <StackPanel Margin="28" MaxWidth="960" HorizontalAlignment="Stretch" Spacing="18">
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc Settings.Context.Title}"
                           FontSize="{DynamicResource App.FontSize.PageTitle}"
                           FontWeight="SemiBold"/>
                <TextBlock Foreground="{DynamicResource App.TextMuted}" Text="{loc:Loc Settings.Context.Description}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Padding="18"
                    Background="{DynamicResource App.SectionBg}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                    CornerRadius="10">
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:Loc Settings.Context.CurrentModel}"
                               FontSize="{DynamicResource App.FontSize.Title}"
                               FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock Foreground="{DynamicResource App.TextMuted}" Text="{loc:Loc Settings.Context.MainModel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding MainModelText}" TextWrapping="Wrap"/>
                        <TextBlock Foreground="{DynamicResource App.TextMuted}" Grid.Row="1" Text="{loc:Loc Settings.Context.ContextWindow}"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding ContextWindowText}"/>
                            <TextBlock Foreground="{DynamicResource App.TextMuted}" Text="{Binding ContextWindowSourceText}"/>
                        </StackPanel>
                        <TextBlock Foreground="{DynamicResource App.TextMuted}" Grid.Row="2" Text="{loc:Loc Settings.Context.MatchStatus}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MatchStatusText}"/>
                        <TextBlock Foreground="{DynamicResource App.TextMuted}" Grid.Row="3" Text="{loc:Loc Settings.Context.MetadataCatalog}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CatalogText}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Padding="18"
                    Background="{DynamicResource App.SectionBg}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                    CornerRadius="10">
                <StackPanel Spacing="16">
                    <TextBlock Text="{loc:Loc Settings.Context.GlobalPolicy}"
                               FontSize="{DynamicResource App.FontSize.Title}"
                               FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="300,220">
                        <TextBlock Text="{loc:Loc Settings.Context.Mode}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Width="220"
                                  ItemsSource="{Binding ContextPolicyModes}"
                                  SelectedItem="{Binding State.Config.ContextPolicy.Mode}"/>
                    </Grid>
                    <Grid ColumnDefinitions="300,220" IsVisible="{Binding IsCustomCap}">
                        <TextBlock Text="{loc:Loc Settings.Context.CustomCap}" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1" Width="220"
                                       Minimum="1024"
                                       Maximum="10000000"
                                       Value="{Binding State.Config.ContextPolicy.CustomCapTokens}"/>
                    </Grid>
                    <CheckBox Content="{loc:Loc Settings.Context.AutoCompress}"
                              IsChecked="{Binding State.Config.ContextPolicy.AutoCompress}"/>
                    <Grid ColumnDefinitions="300,220">
                        <TextBlock Text="{loc:Loc Settings.Context.ThresholdMode}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Width="220"
                                  ItemsSource="{Binding CompressionThresholdModes}"
                                  SelectedItem="{Binding State.Config.ContextPolicy.CompressionThresholdMode}"/>
                    </Grid>
                    <Grid ColumnDefinitions="300,220" IsVisible="{Binding IsCustomThreshold}">
                        <TextBlock Text="{loc:Loc Settings.Context.CompressionThreshold}" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1" Width="220"
                                       Minimum="1"
                                       Maximum="10000000"
                                       Value="{Binding State.Config.ContextPolicy.CustomCompressionThresholdTokens}"/>
                    </Grid>
                    <CheckBox Content="{loc:Loc Settings.Context.ToolResultClearing}"
                              IsChecked="{Binding State.Config.ContextPolicy.ToolResultClearingEnabled}"/>
                    <Grid ColumnDefinitions="300,220" RowDefinitions="Auto,Auto" RowSpacing="4">
                        <TextBlock Text="{loc:Loc Settings.Context.KeepRecentToolResults}" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1" Width="220"
                                       Minimum="20000"
                                       Maximum="800000"
                                       Increment="10000"
                                       Value="{Binding State.Config.ContextPolicy.KeepRecentToolResultChars}"/>
                        <TextBlock Foreground="{DynamicResource App.TextMuted}" Grid.Row="1" Grid.ColumnSpan="2"
                                   Text="{loc:Loc Settings.Context.KeepRecentToolResultsHint}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                    <Grid ColumnDefinitions="300,220" RowDefinitions="Auto,Auto" RowSpacing="4">
                        <TextBlock Text="{loc:Loc Settings.Context.MaxSummaryTokens}" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1" Width="220"
                                       Minimum="1024"
                                       Maximum="32768"
                                       Increment="1024"
                                       Value="{Binding State.Config.ContextPolicy.SummaryMaxTokens}"/>
                        <TextBlock Foreground="{DynamicResource App.TextMuted}" Grid.Row="1" Grid.ColumnSpan="2"
                                   Text="{loc:Loc Settings.Context.MaxSummaryTokensHint}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                    <TextBlock Text="{Binding CompressionEffectText}"
                               TextWrapping="Wrap"/>
                    <TextBlock Foreground="{DynamicResource App.TextMuted}" Text="{Binding EffectivePolicyText}"
                               FontFamily="Menlo,Consolas,monospace"
                               TextWrapping="Wrap"/>
                    <TextBlock Foreground="{DynamicResource App.TextMuted}" Text="{loc:Loc Settings.Context.UnknownAssumption}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Padding="18"
                    Background="{DynamicResource App.SectionBg}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                    CornerRadius="10">
                <StackPanel Spacing="16">
                    <TextBlock Text="{loc:Loc Settings.Context.WorkspaceKnowledge}"
                               FontSize="{DynamicResource App.FontSize.Title}"
                               FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="300,220,*">
                        <TextBlock Text="{loc:Loc Settings.Context.WorkspaceKnowledgeBudget}" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1"
                                       Minimum="0"
                                       Maximum="300000"
                                       Increment="1000"
                                       Value="{Binding State.Config.WorkspaceKnowledgeCharBudget}"/>
                    </Grid>
                    <TextBlock Foreground="{DynamicResource App.TextMuted}" Text="{loc:Loc Settings.Context.BudgetHint}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
