<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:loc="using:Athena.UI.Markup"
             x:Class="Athena.UI.Views.ConversationContextSettingsView"
             x:DataType="vm:ConversationContextSettingsViewModel">
    <ScrollViewer Padding="28">
        <StackPanel MaxWidth="960" HorizontalAlignment="Stretch" Spacing="18">
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc Settings.Context.Title}"
                           FontSize="{DynamicResource App.FontSize.PageTitle}"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Loc Settings.Context.Description}"
                           TextWrapping="Wrap"
                           Opacity="0.62"/>
            </StackPanel>

            <Border Padding="18"
                    Background="{DynamicResource App.SectionBg}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                    CornerRadius="10">
                <StackPanel Spacing="16">
                    <TextBlock Text="{loc:Loc Settings.Context.Conversation}"
                               FontSize="{DynamicResource App.FontSize.Title}"
                               FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="300,180,*">
                        <TextBlock Text="{loc:Loc Settings.Context.MaxParallel}" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1"
                                       Minimum="1"
                                       Maximum="16"
                                       Value="{Binding State.Config.MainConversationMaxParallel}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Padding="18"
                    Background="{DynamicResource App.SectionBg}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                    CornerRadius="10">
                <StackPanel Spacing="16">
                    <TextBlock Text="{loc:Loc Settings.Context.Budget}"
                               FontSize="{DynamicResource App.FontSize.Title}"
                               FontWeight="SemiBold"/>
                    <CheckBox Content="{loc:Loc Settings.Context.AutoCompress}"
                              IsChecked="{Binding State.Config.AutoCompress}"/>
                    <Grid ColumnDefinitions="300,180,*">
                        <TextBlock Text="{loc:Loc Settings.Context.MaxTokens}" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1"
                                       Minimum="1000"
                                       Maximum="2000000"
                                       Value="{Binding State.Config.MaxContextTokens}"/>
                    </Grid>
                    <Grid ColumnDefinitions="300,180,*">
                        <TextBlock Text="{loc:Loc Settings.Context.CompressionThreshold}" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1"
                                       Minimum="1000"
                                       Maximum="2000000"
                                       Value="{Binding State.Config.CompressionThreshold}"/>
                    </Grid>
                    <Grid ColumnDefinitions="300,180,*">
                        <TextBlock Text="{loc:Loc Settings.Context.WorkspaceKnowledgeBudget}" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1"
                                       Minimum="0"
                                       Maximum="100000"
                                       Value="{Binding State.Config.WorkspaceKnowledgeTokenBudget}"/>
                    </Grid>
                    <TextBlock Text="{loc:Loc Settings.Context.BudgetHint}"
                               TextWrapping="Wrap"
                               Opacity="0.58"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
