<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:models="using:Athena.UI.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Athena.UI.Markup"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Athena.UI.Views.HistoryTabView"
             x:DataType="vm:HistoryTabViewModel">

    <Design.DataContext>
        <vm:HistoryTabViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <!-- 移除 ListBoxItem 默认的悬停和选中背景 -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- 定义历史记录卡片样式 -->
        <Style Selector="Border.history-item-card">
            <Setter Property="Background" Value="{DynamicResource App.SectionBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGreyLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.history-item-card.pending-archive">
            <Setter Property="Background" Value="{DynamicResource History.PendingCardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource History.PendingCardBorderBrush}"/>
        </Style>

        <Style Selector="TextBlock.pending-archive-status">
            <Setter Property="Foreground" Value="{DynamicResource History.PendingStatusForeground}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.pending-archive-title">
            <Setter Property="Foreground" Value="{DynamicResource History.PendingTitleForeground}"/>
        </Style>

        <Style Selector="TextBlock.pending-archive-meta">
            <Setter Property="Foreground" Value="{DynamicResource History.PendingMetaForeground}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="Separator.pending-archive-separator">
            <Setter Property="Background" Value="{DynamicResource History.PendingSeparatorBrush}"/>
        </Style>

        <!-- 悬停效果 -->
        <Style Selector="ListBoxItem:pointerover Border.history-item-card">
            <Setter Property="Background" Value="{DynamicResource SemiGrey1}"/>
        </Style>

        <Style Selector="ListBoxItem:pointerover Border.history-item-card.pending-archive">
            <Setter Property="Background" Value="{DynamicResource History.PendingCardPointeroverBackground}"/>
        </Style>

        <!-- 选中效果 -->
        <Style Selector="ListBoxItem:selected Border.history-item-card">
            <Setter Property="Background" Value="{DynamicResource App.SelectedBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.SelectedBorderBrush}"/>
        </Style>

        <Style Selector="ListBoxItem:selected Border.history-item-card.pending-archive">
            <Setter Property="Background" Value="{DynamicResource History.PendingCardSelectedBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource History.PendingCardSelectedBorderBrush}"/>
        </Style>

        <!-- 自定义时间范围：起止倒置时的警示态 -->
        <Style Selector="CalendarDatePicker.invalid">
            <Setter Property="BorderBrush" Value="{DynamicResource SemiRed6}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="40,Auto,*,25">

        <!-- HEADER BAR -->
        <Border Grid.Row="0"
                CornerRadius="0,0,5,5"
                Background="{DynamicResource App.SectionBg}"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{loc:Loc History.Header}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Command="{Binding RefreshCommand}"
                        Padding="8,4"
                        ToolTip.Tip="{loc:Loc History.BtnRefreshDb}">
                    <PathIcon Data="{StaticResource SemiIconRefresh}" Width="14" Height="14"/>
                </Button>
            </Grid>
        </Border>

        <!-- SEARCH & FILTER BAR：第一行常驻；选"自定义范围"时展开日期行 -->
        <Border Grid.Row="1"
                Margin="0,5,0,0"
                Background="{DynamicResource App.SectionBg}"
                CornerRadius="8"
                Padding="10">
        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,8,Auto">
                <TextBox Grid.Column="0"
                         Classes="clearButton"
                         Text="{Binding SearchText}"
                         PlaceholderText="{loc:Loc History.SearchPlaceholder}">
                    <TextBox.InnerLeftContent>
                        <PathIcon Data="{StaticResource SemiIconSearch}"
                                  Width="14" Height="14"
                                  Margin="8,0,4,0"
                                  Opacity="0.5"/>
                    </TextBox.InnerLeftContent>
                </TextBox>

                <ComboBox Grid.Column="2"
                          MinWidth="118"
                          SelectedIndex="{Binding FilterIndex}"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="{loc:Loc History.TimeAll}"/>
                    <ComboBoxItem Content="{loc:Loc History.TimeToday}"/>
                    <ComboBoxItem Content="{loc:Loc History.Time7Days}"/>
                    <ComboBoxItem Content="{loc:Loc History.Time30Days}"/>
                    <ComboBoxItem Content="{loc:Loc History.TimeCustom}"/>
                </ComboBox>
            </Grid>

            <Grid ColumnDefinitions="*,Auto,*,8,Auto" IsVisible="{Binding IsCustomRange}">
                <CalendarDatePicker Grid.Column="0"
                                    SelectedDate="{Binding CustomStartDate}"
                                    Classes.invalid="{Binding IsCustomRangeInvalid}"
                                    PlaceholderText="{loc:Loc History.TimeStartDate}"
                                    HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Column="1"
                           Text="—"
                           Margin="8,0"
                           Opacity="0.5"
                           VerticalAlignment="Center"/>
                <CalendarDatePicker Grid.Column="2"
                                    SelectedDate="{Binding CustomEndDate}"
                                    Classes.invalid="{Binding IsCustomRangeInvalid}"
                                    PlaceholderText="{loc:Loc History.TimeEndDate}"
                                    HorizontalAlignment="Stretch"/>
                <Button Grid.Column="4"
                        Command="{Binding ClearCustomRangeCommand}"
                        Padding="6,4"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{loc:Loc History.TimeClear}">
                    <PathIcon Data="{StaticResource SemiIconClose}" Width="12" Height="12"/>
                </Button>
            </Grid>
        </StackPanel>
        </Border>

        <!-- HISTORY LIST -->
        <ScrollViewer Grid.Row="2" Padding="0,5,0,0">
            <Grid>
                <ListBox ItemsSource="{Binding HistoryItems}"
                         SelectedItem="{Binding SelectedItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         x:Name="HistoryListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ConversationHistoryItem">
                            <!-- fork 分支与普通会话平级展示，仅以标题前的分支徽标区分 -->
                            <Border Classes="history-item-card"
                                    Classes.pending-archive="{Binding IsArchivePlaceholder}">
                                <Grid ColumnDefinitions="*,60">

                                    <!-- Data Block -->
                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border IsVisible="{Binding IsForked}"
                                                    Background="{DynamicResource SemiGreyLowBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="{loc:Loc History.ForkedBadge}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <PathIcon Data="{StaticResource SemiIconSourceControl}" Width="11" Height="11" Opacity="0.7"/>
                                                    <TextBlock Text="{loc:Loc History.ForkedBadge}" FontSize="10" Opacity="0.7" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock
                                                Text="{Binding Summary}"
                                                TextWrapping="Wrap"
                                                MaxLines="2"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center"
                                                Classes.pending-archive-title="{Binding IsArchivePlaceholder}"/>
                                        </StackPanel>
                                        <Separator Height="1"
                                                   Margin="0,4,0,4"
                                                   Classes.pending-archive-separator="{Binding IsArchivePlaceholder}"/>
                                        <StackPanel
                                            Orientation="Horizontal" Spacing="24">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6"
                                                        IsVisible="{Binding !IsArchivePlaceholder}">
                                                <TextBlock Text="{loc:Loc History.Msgs}" FontSize="12" Opacity="0.6"/>
                                                <TextBlock Text="{Binding MessageCount}" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6"
                                                        IsVisible="{Binding !IsArchivePlaceholder}">
                                                <TextBlock Text="{loc:Loc History.Time}" FontSize="12" Opacity="0.6"/>
                                                <TextBlock Text="{Binding DisplayTime}" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6"
                                                        IsVisible="{Binding HasArchiveStatus}">
                                                <PathIcon Data="{StaticResource SemiIconLoading}"
                                                          Width="12"
                                                          Height="12"
                                                          Foreground="{DynamicResource History.PendingStatusForeground}"
                                                          Classes.SlowSpin="{Binding HasArchiveStatus}"/>
                                                <TextBlock Text="{Binding ArchiveStatusText}"
                                                           Classes="pending-archive-status"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Command="{Binding $parent[ListBox].((vm:HistoryTabViewModel)DataContext).SelectHistoryCommand}"
                                                CommandParameter="{Binding}"
                                                Theme="{StaticResource AccentButtonTheme}"
                                                Padding="4"
                                                IsEnabled="{Binding AreActionsEnabled}"
                                                ToolTip.Tip="{loc:Loc History.BtnRestore}">
                                            <PathIcon Data="{DynamicResource SemiIconComment}" Height="14" Width="14" Opacity="0.6"/>
                                        </Button>

                                        <Button Command="{Binding $parent[ListBox].((vm:HistoryTabViewModel)DataContext).DeleteHistoryCommand}"
                                                CommandParameter="{Binding}"
                                                Classes="danger"
                                                Padding="4"
                                                IsEnabled="{Binding AreActionsEnabled}"
                                                ToolTip.Tip="{loc:Loc History.BtnDel}">
                                            <PathIcon Data="{DynamicResource SemiIconDelete}" Width="14" Height="14" Opacity="0.6"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- EMPTY STATE：区分"没有历史记录"与"检索/筛选无匹配" -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding !HistoryItems.Count}">
                    <TextBlock Text="{loc:Loc History.NoRecords}"
                               Opacity="0.5"
                               IsVisible="{Binding !HasActiveFilter}"/>
                    <TextBlock Text="{loc:Loc History.NoMatches}"
                               Opacity="0.5"
                               IsVisible="{Binding HasActiveFilter}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- FOOTER INFO -->
        <Border Grid.Row="3"
                Background="{DynamicResource App.SectionBg}"
                BorderBrush="{DynamicResource SemiGreyLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,4" >
            <TextBlock Text="{loc:Loc History.FooterHint}"
                       HorizontalAlignment="Right"
                       Opacity="0.6"
                       FontSize="11"/>
        </Border>

    </Grid>
</UserControl>
