<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:loc="using:Athena.UI.Markup"
             x:Class="Athena.UI.Views.ToolApprovalSettingsView"
             x:Name="ApprovalRoot"
             x:DataType="vm:ToolApprovalSettingsViewModel">
    <UserControl.Styles>
        <Style Selector="Button.mode-card">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource App.SectionBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SemiGreyLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.mode-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource SemiGrey1}"/>
        </Style>
        <Style Selector="Button.mode-card.selected">
            <Setter Property="Background" Value="{DynamicResource App.SelectedBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.SelectedBorderBrush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="28" MaxWidth="960" HorizontalAlignment="Stretch" Spacing="18">
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc Settings.Approval.Title}"
                           FontSize="{DynamicResource App.FontSize.PageTitle}"
                           FontWeight="SemiBold"/>
                <TextBlock Foreground="{DynamicResource App.TextMuted}" Text="{loc:Loc Settings.Approval.Description}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="{loc:Loc Config.ToolApproval.Mode}"
                           FontSize="{DynamicResource App.FontSize.Title}"
                           FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding ModePicker.Modes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ToolApprovalModeOption">
                            <Button Classes="mode-card" Classes.selected="{Binding IsSelected}"
                                    Command="{Binding SelectCommand}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Title}"
                                    AutomationProperties.HelpText="{Binding Description}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Foreground="{DynamicResource App.TextMuted}" Text="{Binding Description}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <PathIcon Grid.Column="1" Data="{StaticResource AthenaIconConfirm}" Width="16" Height="16"
                                              IsVisible="{Binding IsSelected}" VerticalAlignment="Center"
                                              Foreground="{DynamicResource App.IconAccentForeground}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Content="{loc:Loc Config.ToolApproval.SubAgentsInherit}"
                          IsChecked="{Binding State.Config.SubAgentsInheritApproval}"/>
                <CheckBox Content="{loc:Loc Config.Ptc.Enabled}"
                          IsChecked="{Binding State.Config.PtcEnabled}"/>
                <TextBlock Foreground="{DynamicResource App.TextMuted}" Text="{loc:Loc Config.Ptc.Hint}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Padding="18"
                    Background="{DynamicResource App.SectionBg}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                    CornerRadius="10">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{loc:Loc Config.ToolApproval.AutoAllowed}"
                                   FontSize="{DynamicResource App.FontSize.Title}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Foreground="{DynamicResource App.TextMuted}" Text="{loc:Loc Settings.Approval.AutoAllowedHint}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding State.Config.AutoAllowedTools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <TextBlock Text="{Binding}"
                                               VerticalAlignment="Center"
                                               FontFamily="Consolas, Menlo, monospace"/>
                                    <Button Grid.Column="1"
                                            Content="{loc:Loc Config.ToolApproval.Revoke}"
                                            Command="{Binding #ApprovalRoot.((vm:ToolApprovalSettingsViewModel)DataContext).RevokeAutoAllowedToolCommand}"
                                            CommandParameter="{Binding}"
                                            Padding="8,2"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="18"
                    Background="{DynamicResource App.SectionBg}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SemiGreyLowBrush}"
                    CornerRadius="10">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{loc:Loc Config.ToolApproval.TerminalAllowlist}"
                                   FontSize="{DynamicResource App.FontSize.Title}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Foreground="{DynamicResource App.TextMuted}" Text="{loc:Loc Settings.Approval.TerminalHint}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="300,220,*">
                        <TextBlock Text="{loc:Loc Config.ToolApproval.MaxTerminalOutputChars}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <NumericUpDown Grid.Column="1"
                                       Minimum="1000"
                                       Maximum="1000000"
                                       Increment="5000"
                                       Value="{Binding State.Config.MaxTerminalOutputChars}"/>
                    </Grid>
                    <TextBlock Foreground="{DynamicResource App.TextMuted}" Text="{loc:Loc Settings.Approval.MaxOutputHint}"
                               TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding State.Config.TerminalAllowlist}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <TextBlock Text="{Binding}"
                                               VerticalAlignment="Center"
                                               FontFamily="Consolas, Menlo, monospace"/>
                                    <Button Grid.Column="1"
                                            Content="{loc:Loc Config.ToolApproval.Revoke}"
                                            Command="{Binding #ApprovalRoot.((vm:ToolApprovalSettingsViewModel)DataContext).RevokeTerminalAllowlistCommand}"
                                            CommandParameter="{Binding}"
                                            Padding="8,2"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
