<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Athena.UI.ViewModels"
             xmlns:loc="using:Athena.UI.Markup"
             x:Class="Athena.UI.Views.AppSettingsView"
             x:DataType="vm:AppSettingsViewModel">
    <Grid ColumnDefinitions="228,*">
        <Border Padding="10,12"
                Background="{DynamicResource App.WorkspaceLeftBackground}"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource App.SurfaceBorder}">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Margin="8,4,8,12" Foreground="{DynamicResource App.TextMuted}"
                           Text="{loc:Loc Settings.Window.Subtitle}" TextWrapping="Wrap"/>
                <ListBox x:Name="SettingsNavigation"
                         Grid.Row="1"
                         ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppSettingsSection">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="2,4">
                                <PathIcon Grid.Column="0"
                                          Width="16"
                                          Height="16"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource App.IconAccentForeground}"
                                          IsVisible="{Binding IconKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                          Data="{Binding IconKey, Converter={StaticResource ToolIconKeyToGeometryConverter}}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="{DynamicResource App.WorkspaceRightBackground}"
                ClipToBounds="True">
            <ContentControl x:Name="SettingsContentHost"
                            Content="{Binding SelectedSection.Content}"/>
        </Border>
    </Grid>
</UserControl>
