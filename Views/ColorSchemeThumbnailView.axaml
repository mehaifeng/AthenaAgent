<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Athena.UI.Views.ColorSchemeThumbnailView"
             x:DataType="x:String">
    <StackPanel Spacing="6">
        <!-- 三段式迷你窗体：外层窗框 = Background0，左/右栏 = Background1，中栏 = Background2 -->
        <Border Classes="thumb-card"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource SemiColorBorder}"
                Background="{DynamicResource SemiColorBackground0}"
                Padding="5"
                Height="66">
            <Grid ColumnDefinitions="*,2.3*,*" ColumnSpacing="2">
                <!-- 左栏：工作区 -->
                <Border Grid.Column="0"
                        CornerRadius="3"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        Background="{DynamicResource SemiColorBackground1}">
                    <StackPanel Margin="4,5" Spacing="3" VerticalAlignment="Top">
                        <Border Height="3" CornerRadius="1.5" Background="{DynamicResource SemiColorText2}" Opacity="0.75"/>
                        <Border Height="3" CornerRadius="1.5" Background="{DynamicResource SemiColorText2}" Opacity="0.55"/>
                        <Border Height="3" CornerRadius="1.5" Background="{DynamicResource SemiColorText2}" Opacity="0.35"/>
                    </StackPanel>
                </Border>
                <!-- 中栏：对话区 -->
                <Border Grid.Column="1"
                        CornerRadius="3"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        Background="{DynamicResource SemiColorBackground2}">
                    <StackPanel Margin="4,5" Spacing="3" VerticalAlignment="Top">
                        <Border Height="6" Width="34" CornerRadius="3" HorizontalAlignment="Left"
                                Background="{DynamicResource SemiColorPrimary}"/>
                        <Border Height="3" CornerRadius="1.5" Background="{DynamicResource SemiColorText0}" Opacity="0.85"/>
                        <Border Height="3" CornerRadius="1.5" Background="{DynamicResource SemiColorText2}" Opacity="0.6"/>
                        <Border Height="10" CornerRadius="4" Background="{DynamicResource SemiColorPrimaryLight}"/>
                    </StackPanel>
                </Border>
                <!-- 右栏：侧栏 -->
                <Border Grid.Column="2"
                        CornerRadius="3"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        Background="{DynamicResource SemiColorBackground1}">
                    <StackPanel Margin="4,5" Spacing="3" VerticalAlignment="Top">
                        <Border Height="3" CornerRadius="1.5" Background="{DynamicResource SemiColorText2}" Opacity="0.75"/>
                        <Border Height="3" CornerRadius="1.5" Background="{DynamicResource SemiColorText2}" Opacity="0.55"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <!-- 列表项的 DataContext 即方案名字符串 -->
        <TextBlock Text="{Binding}"
                   FontSize="{DynamicResource App.FontSize.Caption}"
                   Foreground="{DynamicResource SemiColorText2}"
                   HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>
