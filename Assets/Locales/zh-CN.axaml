<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=netstandard">

    <!-- Main Window -->
    <system:String x:Key="App.Title">ATHENA.SYS // 终端连接</system:String>
    <system:String x:Key="Tab.ChatLink">[对话连接]</system:String>
    <system:String x:Key="Tab.SysConfig">[系统配置]</system:String>
    <system:String x:Key="Tab.Scheduler">[任务调度]</system:String>
    <system:String x:Key="Tab.Archives">[历史记录]</system:String>
    <system:String x:Key="Tab.Knowledge">[知识库]</system:String>
    <system:String x:Key="Tab.SysLogs">[系统日志]</system:String>
    <system:String x:Key="Tab.Diagnostic">[诊断信息]</system:String>
    <system:String x:Key="Btn.CommitChanges">[保存更改]</system:String>
    <system:String x:Key="Btn.Rollback">[撤销]</system:String>

    <!-- Chat Tab -->
    <system:String x:Key="Chat.Header">ATHENA_OS // 连接已建立</system:String>
    <system:String x:Key="Chat.Buffer">[缓冲区: {0}]</system:String>
    <system:String x:Key="Chat.BtnTheme">[主题]</system:String>
    <system:String x:Key="Chat.BtnReset">[新对话]</system:String>
    <system:String x:Key="Chat.BtnStats">[统计]</system:String>
    <system:String x:Key="Chat.ReceivingData">正在接收数据</system:String>
    <system:String x:Key="Chat.BtnEdit">[编辑]</system:String>
    <system:String x:Key="Chat.BtnConfirm">[确认]</system:String>
    <system:String x:Key="Chat.BtnAbort">[取消]</system:String>
    <system:String x:Key="Chat.BtnRegen">[重新生成]</system:String>
    <system:String x:Key="Chat.BtnCopy">[复制]</system:String>
    <system:String x:Key="Chat.BtnPurge">[删除]</system:String>
    <system:String x:Key="Chat.InputPlaceholder">&gt; 等待输入...</system:String>
    <system:String x:Key="Chat.MaxContextReached">&gt; 已达到最大上下文限制</system:String>
    <system:String x:Key="Chat.BtnExecute">[发送]</system:String>
    <system:String x:Key="Chat.RoleUser">操作员</system:String>
    <system:String x:Key="Chat.RoleAssistant">雅典娜</system:String>

    <!-- Config Tab -->
    <system:String x:Key="Config.Header">ATHENA.SYS // 系统配置</system:String>
    <system:String x:Key="Config.SectionAppearance">&gt; SYS.OPT.01 // 外观参数</system:String>
    <system:String x:Key="Config.SectionPrimaryAI">&gt; SYS.OPT.02 // 主AI核心</system:String>
    <system:String x:Key="Config.SectionSecondaryAI">&gt; SYS.OPT.03 // 副AI核心</system:String>
    <system:String x:Key="Config.SectionEmbedding">&gt; SYS.OPT.04 // 语义嵌入核心</system:String>
    <system:String x:Key="Config.SectionMemory">&gt; SYS.OPT.05 // 记忆管理</system:String>
    <system:String x:Key="Config.BgTasks">[后台任务]</system:String>
    <system:String x:Key="Config.VectorKb">[向量知识库]</system:String>

    <!-- Config Labels -->
    <system:String x:Key="Config.DispTheme">显示主题:</system:String>
    <system:String x:Key="Config.DispFontScale">字体缩放:</system:String>
    <system:String x:Key="Config.DispHeartbeat">显示心跳按钮:</system:String>
    <system:String x:Key="Config.DispLanguage">显示语言:</system:String>
    <system:String x:Key="Config.ApiProvider">API提供商:</system:String>
    <system:String x:Key="Config.ApiEndpoint">API端点:</system:String>
    <system:String x:Key="Config.AuthToken">认证令牌:</system:String>
    <system:String x:Key="Config.ModelId">模型ID:</system:String>
    <system:String x:Key="Config.ParamTemp">温度参数:</system:String>
    <system:String x:Key="Config.ParamMaxTokens">最大令牌数:</system:String>
    <system:String x:Key="Config.CtxUsage">上下文使用:</system:String>
    <system:String x:Key="Config.MemMaxCtx">最大上下文:</system:String>
    <system:String x:Key="Config.MemCompThresh">压缩阈值:</system:String>
    <system:String x:Key="Config.MemAutoComp">自动压缩:</system:String>
    <system:String x:Key="Config.WarnHigh">[ 警告: &gt;80% ]</system:String>
    <system:String x:Key="Config.CompressionPreview">--- 压缩预览 ---</system:String>
    <system:String x:Key="Config.InheritPrimary">[继承主配置]</system:String>

    <!-- Config Buttons -->
    <!-- 配置按钮 -->
    <system:String x:Key="Config.BtnRunDiagnostics">[运行诊断]</system:String>
    <system:String x:Key="Config.BtnExecCompression">[执行压缩]</system:String>
    <system:String x:Key="Config.BtnUndoCompression">[撤回压缩]</system:String>
    <!-- Tasks Tab -->
    <system:String x:Key="Tasks.Header">ATHENA.SYS // 任务调度器</system:String>
    <system:String x:Key="Tasks.BtnNewRoutine">[新建任务]</system:String>
    <system:String x:Key="Tasks.BtnPurgeAll">[清空全部]</system:String>
    <system:String x:Key="Tasks.ActiveRoutines">&gt; 活动任务:</system:String>
    <system:String x:Key="Tasks.SystemIdle">系统空闲/等待中...</system:String>
    <system:String x:Key="Tasks.Trig">触发:</system:String>
    <system:String x:Key="Tasks.Rec">重复:</system:String>

    <!-- History Tab -->
    <system:String x:Key="History.Header">ATHENA.SYS // 对话存档</system:String>
    <system:String x:Key="History.BtnRefreshDb">[刷新数据]</system:String>
    <system:String x:Key="History.RecordsFound">&gt; 找到记录:</system:String>
    <system:String x:Key="History.Ready">就绪.</system:String>
    <system:String x:Key="History.Msgs">消息:</system:String>
    <system:String x:Key="History.Time">时间:</system:String>
    <system:String x:Key="History.BtnRestore">[恢复]</system:String>
    <system:String x:Key="History.BtnDel">[删除]</system:String>
    <system:String x:Key="History.NoRecords">未找到记录.</system:String>
    <system:String x:Key="History.FooterHint">选择 [恢复] 将历史会话数据加载到当前记忆中.</system:String>

    <!-- Memory Tab -->
    <system:String x:Key="Memory.Header">ATHENA.SYS // 知识库导航器</system:String>
    <system:String x:Key="Memory.BtnRefresh">[刷新]</system:String>
    <system:String x:Key="Memory.BtnImport">[导入]</system:String>
    <system:String x:Key="Memory.BtnExport">[导出]</system:String>
    <system:String x:Key="Memory.BtnDelete">[删除]</system:String>
    <system:String x:Key="Memory.DirectoryStructure">&gt; 目录结构</system:String>
    <system:String x:Key="Memory.MkdirPlaceholder">新建目录 (文件夹名)</system:String>
    <system:String x:Key="Memory.TouchPlaceholder">新建文件 (文件名.md)</system:String>
    <system:String x:Key="Memory.BtnExec">[执行]</system:String>
    <system:String x:Key="Memory.Path">[路径]:</system:String>
    <system:String x:Key="Memory.ModeEdit">[模式: 编辑]</system:String>
    <system:String x:Key="Memory.ModeRead">[模式: 只读]</system:String>
    <system:String x:Key="Memory.NoFileSelected">[ 未选择文件或内容为空 ]</system:String>
    <system:String x:Key="Memory.AwaitingInput">等待操作员输入...</system:String>
    <system:String x:Key="Memory.BtnCommitWrite">[保存写入]</system:String>
    <system:String x:Key="Memory.CtxView">查看</system:String>
    <system:String x:Key="Memory.CtxDelete">删除</system:String>

    <!-- Logs Tab -->
    <system:String x:Key="Logs.Header">ATHENA.SYS // 系统事件日志</system:String>
    <system:String x:Key="Logs.QueryParams">&gt; 查询参数</system:String>
    <system:String x:Key="Logs.TStart">开始时间:</system:String>
    <system:String x:Key="Logs.TEnd">结束时间:</system:String>
    <system:String x:Key="Logs.Lvl">级别:</system:String>
    <system:String x:Key="Logs.Keyword">关键词:</system:String>
    <system:String x:Key="Logs.OptionalFilter">[可选筛选]</system:String>
    <system:String x:Key="Logs.BtnQuery">[查询]</system:String>
    <system:String x:Key="Logs.BtnRefresh">[刷新]</system:String>
    <system:String x:Key="Logs.BtnExport">[导出]</system:String>
    <system:String x:Key="Logs.TotalEvents">总事件数:</system:String>
    <system:String x:Key="Logs.Limit">每页:</system:String>

    <!-- Log Levels -->
    <system:String x:Key="Logs.Level.All">全部</system:String>
    <system:String x:Key="Logs.Level.Verbose">详细</system:String>
    <system:String x:Key="Logs.Level.Debug">调试</system:String>
    <system:String x:Key="Logs.Level.Information">信息</system:String>
    <system:String x:Key="Logs.Level.Warning">警告</system:String>
    <system:String x:Key="Logs.Level.Error">错误</system:String>
    <system:String x:Key="Logs.Level.Fatal">致命</system:String>

    <!-- About Tab -->
    <system:String x:Key="About.Header">ATHENA.SYS // 系统诊断与信息</system:String>
    <system:String x:Key="About.Subtitle">&gt; 人工智能伴侣模块</system:String>
    <system:String x:Key="About.Specs">&gt; 系统规格:</system:String>
    <system:String x:Key="About.KernelVer">内核版本:</system:String>
    <system:String x:Key="About.Framework">框架:</system:String>
    <system:String x:Key="About.License">许可证:</system:String>
    <system:String x:Key="About.Author">作者:</system:String>
    <system:String x:Key="About.Quote">"智慧始于好奇。" — 初始化序列 0x01</system:String>
    <system:String x:Key="About.BtnChkUpdates">[检查更新]</system:String>
    <system:String x:Key="About.BtnViewDocs">[查看文档]</system:String>
    <system:String x:Key="About.BtnSourceRepo">[源码仓库]</system:String>

    <!-- Create Task Dialog -->
    <system:String x:Key="TaskDialog.Title">创建计划任务</system:String>
    <system:String x:Key="TaskDialog.TriggerTime">触发时间</system:String>
    <system:String x:Key="TaskDialog.Date">日期:</system:String>
    <system:String x:Key="TaskDialog.Time">时间:</system:String>
    <system:String x:Key="TaskDialog.TaskIntent">任务意图</system:String>
    <system:String x:Key="TaskDialog.IntentHint">任务触发时雅典娜应该说什么或做什么？</system:String>
    <system:String x:Key="TaskDialog.IntentPlaceholder">例如：检查用户的项目进度并在需要时提供帮助</system:String>
    <system:String x:Key="TaskDialog.Recurrence">重复模式</system:String>
    <system:String x:Key="TaskDialog.Repeat">重复:</system:String>
    <system:String x:Key="TaskDialog.Preview">预览</system:String>
    <system:String x:Key="TaskDialog.PreviewWill">雅典娜将</system:String>
    <system:String x:Key="TaskDialog.PreviewTriggerAt">在以下时间触发</system:String>
    <system:String x:Key="TaskDialog.BtnCancel">[取消]</system:String>
    <system:String x:Key="TaskDialog.BtnCreate">[创建]</system:String>

    <!-- Recurrence -->
    <system:String x:Key="Recurrence.None">none</system:String>
    <system:String x:Key="Recurrence.Daily">daily</system:String>
    <system:String x:Key="Recurrence.Weekly">weekly</system:String>
    <system:String x:Key="Recurrence.NoneDisplay">一次性</system:String>
    <system:String x:Key="Recurrence.DailyDisplay">每天</system:String>
    <system:String x:Key="Recurrence.WeeklyDisplay">每周</system:String>

    <!-- Status Messages -->
    <system:String x:Key="Status.Testing">测试中...</system:String>
    <system:String x:Key="Status.EnterApiKey">请先输入 API Key</system:String>
    <system:String x:Key="Status.ServiceNotInit">服务未初始化</system:String>
    <system:String x:Key="Status.ConfigSaved">配置已保存</system:String>
    <system:String x:Key="Status.ConfigReset">配置已重置</system:String>

</ResourceDictionary>
