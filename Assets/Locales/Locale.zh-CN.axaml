    <!-- 子代理 -->
    <system:String x:Key="Config.SubAgents">子代理</system:String>
    <system:String x:Key="Config.SubAgentsDescription">启用后，主模型可以把相互独立的子任务分派给并行运行的子代理，每个子代理拥有独立的隔离上下文，只有最终摘要会回传主对话。</system:String>
    <system:String x:Key="Config.SubAgentsEnabled">启用子代理:</system:String>
