    <!-- 模型诊断码文案：供应商模型页与上下文检查器共用，键名即 ModelWarnings 里的码。 -->
    <system:String x:Key="ModelWarning.UnknownModelAssumption">未找到可靠匹配；按 1M Context / 256K 压缩阈值假设处理。</system:String>
