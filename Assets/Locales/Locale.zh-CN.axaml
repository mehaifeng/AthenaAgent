    <system:String x:Key="Polis.Citizen.NameNth">{0}（{1}）</system:String>
    <system:String x:Key="Polis.Citizen.Greet">你好呀。|日安。|又见面了。|今天天气不错。|你也出来走走？</system:String>
    <system:String x:Key="Polis.Public.PaintedStoa">彩绘柱廊</system:String>
    <system:String x:Key="Polis.Public.Archive">书库</system:String>
    <system:String x:Key="Polis.Public.Vault">金库</system:String>
    <system:String x:Key="Polis.Public.Grove">橄榄林</system:String>
    <system:String x:Key="Polis.Resident.Surveyor.Name">测绘员</system:String>
    <system:String x:Key="Polis.Resident.Surveyor.Intro">我替雅典娜量过这座城：哪个文件夹最大、哪里的东西最旧、哪份文件提到了什么，她都能翻出来告诉你。|找东西别自己翻：说个大概，雅典娜会一个个文件夹去找，连文档里的字也能搜。</system:String>
    <system:String x:Key="Polis.Resident.Surveyor.Try">帮我看看这个工作区里哪些文件夹最大、哪些很久没动了，列一张清单给我。</system:String>
    <system:String x:Key="Polis.Resident.Scribe.Name">抄写员</system:String>
    <system:String x:Key="Polis.Resident.Scribe.Intro">报告、说明、清单，她都能替你起草；你写了一半的那份，她也能接着写、帮你改顺。|她能直接做出 Word 文档和演示文稿，格式、标题、编号都替你排好。</system:String>
    <system:String x:Key="Polis.Resident.Scribe.Try">帮我起草一份文档：把这周做了什么、遇到了什么问题、下周打算做什么写成一页周报。</system:String>
    <system:String x:Key="Polis.Resident.Accountant.Name">账房</system:String>
    <system:String x:Key="Polis.Resident.Accountant.Intro">一堆表格要汇总、对账、算合计？交给她，哪一格对不上她也会指出来。|她能新建表格、改公式、加列删行，还能把几张表合成一张。</system:String>
    <system:String x:Key="Polis.Resident.Accountant.Try">帮我把这个工作区里的表格汇总一下：每张表是什么、有几行、最要紧的几个数是多少。</system:String>
    <system:String x:Key="Polis.Resident.Smith.Name">铁匠</system:String>
    <system:String x:Key="Polis.Resident.Smith.Intro">要跑命令、装工具、批量改名，她在锻炉前就能办——危险的那几步会先停下来问你。|重复的体力活交给锻炉：几百个文件改格式、压缩、整理，一条命令的事。</system:String>
    <system:String x:Key="Polis.Resident.Smith.Try">帮我看看这个工作区的文件夹里一共有多少文件、占了多大空间（只看，不要改动任何东西）。</system:String>
    <system:String x:Key="Polis.Resident.Sailor.Name">水手</system:String>
    <system:String x:Key="Polis.Resident.Sailor.Intro">船出海就是去网上打听：查资料、对比价格、把网页上的文件下载回来。|她还能替你在网页上点完一整套流程——登录这种要你自己来的事，她会停下来。</system:String>
    <system:String x:Key="Polis.Resident.Sailor.Try">帮我在网上查一查最近关于这个工作区主题的新消息，挑三条最重要的讲给我听，附上来源。</system:String>
    <system:String x:Key="Polis.Resident.Librarian.Name">图书管理员</system:String>
    <system:String x:Key="Polis.Resident.Librarian.Intro">你常用的格式、你的偏好、你说过的要紧事，告诉她一次，她就记在图书馆里，下次不用再说。|想知道她记住了什么？问她就行，记错的也可以让她改掉。</system:String>
    <system:String x:Key="Polis.Resident.Librarian.Try">请记住：我写文档喜欢先给结论、再给细节，标题用短句。以后替我写东西都这样。</system:String>
    <system:String x:Key="Polis.Resident.Maiden.Name">黄金侍女</system:String>
    <system:String x:Key="Polis.Resident.Maiden.Intro">活多的时候，雅典娜会叫上我们几个分头去办，各自查一部分，办完一起回来交给她。|一次要看很多文件、查很多地方时，分给我们比她一个人跑快得多。</system:String>
    <system:String x:Key="Polis.Resident.Maiden.Try">请分头去看这个工作区里的几个主要文件夹，各自总结一下里面有什么，最后汇成一份概览。</system:String>
    <system:String x:Key="Polis.Resident.Herald.Name">传令官</system:String>
    <system:String x:Key="Polis.Resident.Herald.Intro">要定时做的事（每天早上、每周一、每月一号），交给雅典娜排成定时任务；结果出来，由我来报。|应用关着的时候错过的那一次，我也会告诉你。</system:String>
    <system:String x:Key="Polis.Resident.Herald.Try">帮我设一个定时任务：每周一早上 9 点回顾这个工作区上一周的变化，写一份简报给我。</system:String>
    <system:String x:Key="Polis.Resident.Painter.Name">画师</system:String>
    <system:String x:Key="Polis.Resident.Painter.Intro">要一张配图、一幅示意、一个封面？说清楚画什么、什么风格，她就画给你。|画好的图会挂进彩绘柱廊，你随时能来看。</system:String>
    <system:String x:Key="Polis.Resident.Painter.Try">帮我画一张简洁的封面图，主题是这个工作区正在做的事，风格干净、留白多。</system:String>
    <system:String x:Key="Polis.Resident.Artisan.Name">工匠</system:String>
    <system:String x:Key="Polis.Resident.Artisan.Intro">雅典娜还能接上别的工具和技能：日历、邮箱、数据库……要接什么，问她就行。|她自己的设置也能看能改——要紧的改动会先问你。</system:String>
    <system:String x:Key="Polis.Resident.Artisan.Try">你现在能用哪些技能和外部工具？列给我看，并告诉我每样适合做什么。</system:String>
    <system:String x:Key="Polis.Resident.Priestess.Name">女祭司</system:String>
    <system:String x:Key="Polis.Resident.Priestess.Intro">神庙里的每日神谕：每天早上，雅典娜替你看一眼这座城的变化，写一卷晨报，传令官送到你手上。|想换个时间、换个内容？告诉雅典娜，她会改那个定时任务（也要你点头）。</system:String>
    <system:String x:Key="Polis.Resident.Priestess.Try">把每日神谕改成工作日早上 8 点半，晨报里再加一条：今天最该先做的一件事。</system:String>
    <system:String x:Key="Polis.Board.ResumeCommission">上次「{0}」停在半路，要接着做吗？</system:String>
    <system:String x:Key="Polis.Board.ResumeCommission.Prompt">上次「{0}」做到一半停下了，请接着做完。</system:String>
    <system:String x:Key="Polis.Board.FindLostItem">{0}找不到了，要不要找找它去了哪儿？</system:String>
    <system:String x:Key="Polis.Board.FindLostItem.Prompt">之前交付的{0}找不到了，请在这个工作区里找找它是不是被挪到了别处、改了名字。</system:String>
    <system:String x:Key="Polis.Board.TidyAgora">广场上散着 {1} 个文件，要不要归到文件夹里？</system:String>
    <system:String x:Key="Polis.Board.TidyAgora.Prompt">工作区根目录下散着 {1} 个文件，请先列出来、按用途给出归类建议，等我确认之后再挪动。</system:String>
    <system:String x:Key="Polis.Board.SortMixedBuilding">「{0}」里混着 {1} 件东西，要不要分分类？</system:String>
    <system:String x:Key="Polis.Board.SortMixedBuilding.Prompt">「{0}」里混着 {1} 个文件，请看看都有些什么，给出分类整理的方案，等我确认之后再动手。</system:String>
    <system:String x:Key="Polis.Board.ReviewStaleBuilding">「{0}」已经 {2} 天没动了，要不要清点一下？</system:String>
    <system:String x:Key="Polis.Board.ReviewStaleBuilding.Prompt">「{0}」已经 {2} 天没动过了，请清点一下里面的 {1} 个文件：哪些还有用、哪些可以归档，列一张清单给我。</system:String>
    <system:String x:Key="Polis.Board.CatalogImages">给「{0}」里的 {1} 张图片做个目录？</system:String>
    <system:String x:Key="Polis.Board.CatalogImages.Prompt">请给「{0}」里的 {1} 张图片做一份目录：按主题分组，每张一句说明，写成一个 Markdown 文件放在「{0}」里。</system:String>
    <system:String x:Key="Polis.Board.SummarizeSheets">汇总「{0}」里的 {1} 张表？</system:String>
    <system:String x:Key="Polis.Board.SummarizeSheets.Prompt">请把「{0}」里的 {1} 张表格汇总一下：每张是什么、关键的数字是多少，写成一页摘要。</system:String>
    <system:String x:Key="Polis.Board.SummarizeDocuments">把「{0}」里的 {1} 份文档各写一句摘要？</system:String>
    <system:String x:Key="Polis.Board.SummarizeDocuments.Prompt">请把「{0}」里的 {1} 份文档各写一句摘要，汇成一份清单。</system:String>
    <system:String x:Key="Polis.Board.DescribeWorkshop">给「{0}」写一份说明？</system:String>
    <system:String x:Key="Polis.Board.DescribeWorkshop.Prompt">请看看「{0}」里有什么，写一份说明：它是做什么的、主要的部分在哪里、怎么上手。</system:String>
    <system:String x:Key="Polis.Board.InspectArchives">看看「{0}」里的 {1} 个压缩包都装了什么？</system:String>
    <system:String x:Key="Polis.Board.InspectArchives.Prompt">请看看「{0}」里的 {1} 个压缩包分别装了什么（不要解压到别处），列一张清单给我。</system:String>
    <system:String x:Key="Polis.Board.RecapBusyBuilding">「{0}」这两天改得最多，要不要总结一下？</system:String>
    <system:String x:Key="Polis.Board.RecapBusyBuilding.Prompt">「{0}」这两天改动最多，请总结一下最近改了什么、还有什么没做完。</system:String>
    <system:String x:Key="Polis.Board.SetOracle">在神庙设一个每日神谕</system:String>
    <system:String x:Key="Polis.Board.SetOracle.Prompt">在神庙设一个每日神谕</system:String>
    <system:String x:Key="Polis.Board.PlanEmptyCity">这座城还空着，要不要先规划几个文件夹？</system:String>
    <system:String x:Key="Polis.Board.PlanEmptyCity.Prompt">这个工作区还是空的。请问问我打算用它做什么，然后建议一套文件夹结构，等我确认之后再建。</system:String>
    <system:String x:Key="Polis.Board.AskAnything">有什么想问的，直接问我</system:String>
    <system:String x:Key="Polis.Board.AskAnything.Prompt">我想请你帮我：</system:String>
    <system:String x:Key="Polis.Board.RememberPreference">让我记住你的偏好</system:String>
    <system:String x:Key="Polis.Board.RememberPreference.Prompt">请记住我的偏好：（写下你希望她以后都照着做的事）</system:String>
    <system:String x:Key="Polis.Oracle.Set">每日神谕已设立 · {0} · 下一卷：{1}</system:String>
    <system:String x:Key="Polis.Oracle.Paused">每日神谕已暂停（在定时任务页里可以重新启用）</system:String>
    <system:String x:Key="Polis.Oracle.Request">请用定时任务工具（create_task）为这个工作区设立「每日神谕」：每天早上 8 点运行（cron：0 8 * * *），任务名写「每日神谕」，workspaceId 填 {1}。任务内容：回顾工作区「{0}」最近一天的变化，写一卷简短的晨报给我——有什么新东西、有什么值得留意、今天可以先做什么。</system:String>
    <system:String x:Key="Polis.Oracle.RequestGlobal">请用定时任务工具（create_task）设立「每日神谕」：每天早上 8 点运行（cron：0 8 * * *），任务名写「每日神谕」，不填 workspaceId。任务内容：每天早上给我一卷简短的晨报——今天值得留意的事、我可以先做什么。</system:String>
    <system:String x:Key="Polis.Oracle.ItemTitle">每日神谕 · {0}</system:String>
    <system:String x:Key="GameMode.Herald.CronSucceeded">定时任务「{0}」跑完了，点这里看结果</system:String>
    <system:String x:Key="GameMode.Herald.CronFailed">定时任务「{0}」失败了：{1}</system:String>
    <system:String x:Key="GameMode.Herald.CronSkipped">定时任务「{0}」到点时应用没开，这一次跳过了</system:String>
    <system:String x:Key="GameMode.Herald.CronInterrupted">定时任务「{0}」跑到一半被打断了</system:String>
    <system:String x:Key="GameMode.Herald.OracleScroll">每日神谕送来了一卷，放在广场上等你</system:String>
    <system:String x:Key="GameMode.Herald.CommissionInterrupted">「{0}」上次停在半路，要接着做就点这里</system:String>
    <system:String x:Key="GameMode.Notice.VenueFull">{0}满了，{1}先收着</system:String>
    <system:String x:Key="GameMode.Item.Image">一幅彩绘</system:String>
    <system:String x:Key="GameMode.Return.Prefill">关于{0}，请修改：</system:String>
    <!-- 游戏页面的词条：界面、建筑叫法、公共建筑名（由 C# 推给页面）。旁白台词库（Polis.Line.*）已随直播拿掉（2026-10-13） -->
    <system:String x:Key="Polis.Ui.Dismiss">知道了</system:String>
    <system:String x:Key="Polis.Ui.NoticeBoard">广场公告板</system:String>
    <system:String x:Key="Polis.Ui.FogTitle">找不到这座城邦的文件夹</system:String>
    <system:String x:Key="Polis.Ui.FogBody">文件夹被移动、改名或删除了。重新定位它，城邦和存档都还在。</system:String>
    <system:String x:Key="Polis.Ui.Relocate">重新定位</system:String>
    <system:String x:Key="Polis.Ui.Read">读</system:String>
    <system:String x:Key="Polis.Ui.Open">打开</system:String>
    <system:String x:Key="Polis.Ui.Accept">收下</system:String>
    <system:String x:Key="Polis.Ui.Return">退回</system:String>
    <system:String x:Key="Polis.Ui.KindScroll">卷轴</system:String>
    <system:String x:Key="Polis.Ui.KindLedger">账册</system:String>
    <system:String x:Key="Polis.Ui.KindPainting">彩绘板</system:String>
    <system:String x:Key="Polis.Ui.KindAnswer">回答</system:String>
    <system:String x:Key="Polis.Ui.StatePending">等你收下</system:String>
    <system:String x:Key="Polis.Ui.StateAccepted">已收下</system:String>
    <system:String x:Key="Polis.Ui.StateReturned">已退回</system:String>
    <system:String x:Key="Polis.Ui.StateLost">找不到它指向的文件了</system:String>
    <system:String x:Key="Polis.Ui.StateModified">交付之后被改过</system:String>
    <system:String x:Key="Polis.Ui.Founding">这是你的城邦，每座建筑都是你的一个文件夹</system:String>
    <system:String x:Key="Polis.Ui.Close">收起</system:String>
    <system:String x:Key="Polis.Ui.ViewLabel">视角</system:String>
    <system:String x:Key="Polis.Ui.ViewFree">自由</system:String>
    <system:String x:Key="Polis.Ui.ViewPlayer">跟着你</system:String>
    <system:String x:Key="Polis.Ui.ViewAthena">跟着雅典娜</system:String>
    <system:String x:Key="Polis.Ui.ViewFreeTip">左键拖动转视角，右键拖动平移，滚轮缩放；你走远了镜头会跟上</system:String>
    <system:String x:Key="Polis.Ui.ControlsHint">WASD / 方向键走动（按住 Shift 跑）· 拖动转视角 · 走近人或物件按 E 互动 · Enter 和雅典娜说话</system:String>
    <system:String x:Key="Polis.Ui.FocusHint">点一下画面，就能用键盘走动</system:String>
    <system:String x:Key="Polis.Ui.AthenaHere">雅典娜在这边</system:String>
    <system:String x:Key="Polis.Ui.InteractKey">E</system:String>
    <system:String x:Key="Polis.Ui.InteractTalk">和雅典娜说话</system:String>
    <system:String x:Key="Polis.Ui.InteractResident">和{name}说话</system:String>
    <system:String x:Key="Polis.Ui.InteractItem">看看「{title}」</system:String>
    <system:String x:Key="Polis.Ui.InteractPlace">摆在这里</system:String>
    <system:String x:Key="Polis.Ui.InteractTree">去「{title}」这份委托</system:String>
    <system:String x:Key="Polis.Ui.InteractBoard">看看委托板</system:String>
    <system:String x:Key="Polis.Ui.InteractOracle">看看每日神谕</system:String>
    <system:String x:Key="Polis.Ui.InteractVenue">进{venue}看看</system:String>
    <system:String x:Key="Polis.Ui.TalkName">雅典娜</system:String>
    <system:String x:Key="Polis.Ui.TalkToAthena">和雅典娜说话</system:String>
    <system:String x:Key="Polis.Ui.TalkPlaceholder">想请雅典娜做什么？</system:String>
    <system:String x:Key="Polis.Ui.TalkSend">托付</system:String>
    <system:String x:Key="Polis.Ui.TalkStop">请她停下</system:String>
    <system:String x:Key="Polis.Ui.TalkHint">Enter 托付 · Shift+Enter 换行 · Esc 收起</system:String>
    <system:String x:Key="Polis.Ui.TalkIdle">她在听</system:String>
    <system:String x:Key="Polis.Ui.TalkBusy">她在办你交代的事——可以先写下一件</system:String>
    <system:String x:Key="Polis.Ui.TalkQueued">排在后面，前一件做完就开始</system:String>
    <system:String x:Key="Polis.Ui.TalkWaiting">她在等你点头：看看审批窗口</system:String>
    <system:String x:Key="Polis.Ui.TalkCompressing">她在整理记忆，稍等一下</system:String>
    <system:String x:Key="Polis.Ui.TalkAttachments">一并交给她：{names}</system:String>
