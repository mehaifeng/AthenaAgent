    <!-- 辩论（M-E，2026-10-13）：讲台的卡片、对话栏借给辩论时的字、顶上的辩论牌，以及 C# 替人说的那几句 -->
    <system:String x:Key="Polis.Ui.InteractBema">上讲台辩论</system:String>
    <system:String x:Key="Polis.Ui.BemaTitle">讲台</system:String>
    <system:String x:Key="Polis.Ui.BemaBody">提一个议题，你站正方，雅典娜站反方，辩三轮；街上的居民当陪审团。</system:String>
    <system:String x:Key="Polis.Ui.BemaRecord">你 {wins} 胜 {losses} 负 {ties} 平</system:String>
