    <system:String x:Key="Pet.Need.Bored">有点无聊 — 陪它玩会儿</system:String>
    <system:String x:Key="Pet.Need.Lonely">想被理一理 — 摸摸头</system:String>
    <!-- 本地台词库：同一场景的多句用 | 分隔，随机挑一句 -->
    <system:String x:Key="Pet.Line.Greeting">你回来啦！|在的在的。|随时可以开始。</system:String>
    <system:String x:Key="Pet.Line.Pat">就是这儿！|嘿嘿。|再来一下嘛。</system:String>
    <system:String x:Key="Pet.Line.Pat.Low">……谢谢，我需要这个。|嗯，好一点了。</system:String>
    <system:String x:Key="Pet.Line.Pat.High">今天真不错！|可以一直摸下去。</system:String>
    <system:String x:Key="Pet.Line.PatCooldown">毛还没顺回来呢。|等我一下下。|好啦好啦。</system:String>
    <system:String x:Key="Pet.Line.Feed">咔嚓，好吃！|这个我最喜欢！|满分。</system:String>
    <system:String x:Key="Pet.Line.FeedCooldown">其实还挺饱的。|留着待会儿吃？</system:String>
    <system:String x:Key="Pet.Line.Play">追我呀！|看我的！|嗖——</system:String>
    <system:String x:Key="Pet.Line.PlayCooldown">让我喘口气。|还有点晕，稍等。</system:String>
    <system:String x:Key="Pet.Line.LevelUp">我升级啦！|看我厉害吧！|解锁新称号。</system:String>
    <system:String x:Key="Pet.Line.NeedHungry">有点饿了……|能给点吃的吗？</system:String>
    <system:String x:Key="Pet.Line.NeedBored">好无聊啊……|我们做点什么吧。</system:String>
    <system:String x:Key="Pet.Line.NeedLonely">你好久没理我了。|我还在这儿呢。</system:String>
    <system:String x:Key="Pet.Line.NeedMet">你懂我！|对，就是这个！|谢谢你！</system:String>
    <system:String x:Key="Pet.Line.FileCaught">叼到啦！|接住了，放哪儿？|已经放进框里了。</system:String>
    <system:String x:Key="Pet.Line.ResponseDone">搞定！|挺顺利的。|不错嘛。</system:String>
    <system:String x:Key="Pet.Line.Sleepy">好困……|就眯一小会儿。</system:String>
    <system:String x:Key="Pet.Line.Idle">嗨。|接下来做什么？|我在的。</system:String>
    <system:String x:Key="Pet.Line.Idle.Low">今天有点长啊。|唔……</system:String>
    <system:String x:Key="Pet.Line.Idle.High">一切都很好！|今天状态不错。</system:String>

