    <!-- Tool Approval Settings -->
    <system:String x:Key="Config.ToolApproval.Header">工具授权</system:String>
    <system:String x:Key="Config.ToolApproval.Mode">授权模式</system:String>
    <system:String x:Key="Config.ToolApproval.Mode.Off">关闭（全部自动放行）</system:String>
    <system:String x:Key="Config.ToolApproval.Mode.Balanced">平衡（写入/删除/终端需确认，推荐）</system:String>
