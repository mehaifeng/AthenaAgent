    <system:String x:Key="ModelWarning.InvalidContextCapIgnored">设置的上下文上限低于 1024 Token，已忽略并回落到模型元数据。</system:String>
    <system:String x:Key="ModelWarning.InvalidCompressionThresholdIgnored">设置的压缩阈值无效，已忽略并回落到默认阈值。</system:String>
    <system:String x:Key="ModelWarning.CompressionThresholdClamped">设置的压缩阈值高于可用输入预算，已按预算截断。</system:String>
    <system:String x:Key="ModelWarning.ContextCapClampedToModel">设置的上下文上限高于模型自身窗口，已按模型窗口截断——该设定不生效，请改回自动或调到模型窗口以内。</system:String>
    <system:String x:Key="ContextInspector.Button">上下文检查器</system:String>
    <system:String x:Key="ContextInspector.Open">打开上下文检查器</system:String>
    <system:String x:Key="ContextInspector.UsageButton">打开上下文检查器；上下文用量</system:String>
    <system:String x:Key="ContextInspector.Title">上下文检查器</system:String>
    <system:String x:Key="ContextInspector.Close">关闭上下文检查器</system:String>
    <system:String x:Key="ContextInspector.Tab.Overview">概览</system:String>
    <system:String x:Key="ContextInspector.Tab.Summary">当前摘要</system:String>
    <system:String x:Key="ContextInspector.Tab.Preview">压缩预览</system:String>
    <system:String x:Key="ContextInspector.Tab.Raw">RAW Context</system:String>
    <system:String x:Key="ContextInspector.Overview.Model">当前请求模型</system:String>
    <system:String x:Key="ContextInspector.Overview.Policy">有效 W / R / O / S / B / T</system:String>
    <system:String x:Key="ContextInspector.Overview.PolicyHint">W 窗口 · R 输出预留 · O 单次输出上限（来自模型元数据；每次请求实际取它与窗口余量中的较小者，下限为 R，元数据未给出时不显示）· S 安全余量 · B 输入预算 · T 压缩阈值</system:String>
    <system:String x:Key="ContextInspector.Overview.Usage">Usage 锚点</system:String>
    <system:String x:Key="ContextInspector.Overview.CachedHint">Cached Input 只影响缓存复用或计费，不会减少 Context Window 占用。</system:String>
    <system:String x:Key="ContextInspector.Overview.Ownership">所有权与继承链</system:String>
    <system:String x:Key="ContextInspector.Summary.Active">下一次请求实际发送的摘要</system:String>
    <system:String x:Key="ContextInspector.Summary.Undo">撤销最近批次</system:String>
    <system:String x:Key="ContextInspector.Summary.Empty">当前会话没有生效中的压缩摘要。</system:String>
    <system:String x:Key="ContextInspector.Summary.Orphaned">旧版孤立摘要（不会发送）</system:String>
    <system:String x:Key="ContextInspector.Summary.OrphanedHint">该文本无法与压缩标记相互验证，只保留用于诊断与复制。</system:String>
    <system:String x:Key="ContextInspector.Preview.Explanation">下面是本地影响说明：零费用，不调用模型。“立即压缩”会调用压缩模型；压完不满意，可以在「摘要」页或对话里的压缩分隔线上撤销。</system:String>
    <system:String x:Key="ContextInspector.Raw.Warning">RAW Context 可能包含 system prompt、Workspace 知识、本地路径、附件元数据和工具结果；复制前请检查。</system:String>
    <system:String x:Key="ContextInspector.Raw.Refresh">构建 / 刷新快照</system:String>
    <system:String x:Key="ContextInspector.Usage.ReportedDetails">Cached Input {0:N0} · 最近 Usage {1}</system:String>
    <system:String x:Key="ContextInspector.Workspace.App">App 默认值（无 Workspace 覆盖）</system:String>
    <system:String x:Key="ContextInspector.Workspace.Chain">{0} · Workspace → App → 模型元数据</system:String>
    <system:String x:Key="ContextInspector.Warning.UnknownModel">模型未匹配：按 1M / 256K 假设处理。</system:String>
    <system:String x:Key="ContextInspector.Summary.Details">{0} · {1:g} · {2} 条消息 · {3:N0} → {4:N0} Token · Prompt v{5} · {6}</system:String>
    <system:String x:Key="ContextInspector.Preview.NothingToCompress">没有可压缩的历史。</system:String>
    <system:String x:Key="ContextInspector.Overview.ClearedToolResults">已清理 {0} 条旧工具结果（请求里约少 {1:N0} 字符）</system:String>
    <system:String x:Key="ContextInspector.CompactNow.Title">立即压缩</system:String>
    <system:String x:Key="ContextInspector.CompactNow.Hint">不看阈值，把全部未压缩的历史（含最近一轮）压成一份摘要；可随时撤销。会调用压缩模型并可能产生费用。</system:String>
    <system:String x:Key="ContextInspector.CompactNow.FocusWatermark">本次侧重（可选），例如：保留所有报错信息和文件路径</system:String>
    <system:String x:Key="ContextInspector.CompactNow.Button">立即压缩</system:String>
    <system:String x:Key="ContextInspector.Preview.Unavailable">事务式压缩当前不可用。</system:String>
    <system:String x:Key="ContextInspector.Preview.ModelUnavailable">压缩模型策略当前不可用。</system:String>
    <system:String x:Key="ContextInspector.Preview.ImpactFormat">将把 {0} 条消息（共 {1:N0} 字符，其中 {2} 条工具结果已清理）压成摘要；摘要上限 {3:N0} tokens。</system:String>
    <system:String x:Key="ContextInspector.Preview.Cancelled">压缩已取消，会话未发生变化。</system:String>
    <!-- {0} 是压缩链路的技术原因（规划器/校验器的判定或供应商报错原文），刻意保留英文以便与日志比对。 -->
    <system:String x:Key="ContextInspector.Preview.PlanUnavailable">无法生成压缩计划：{0}</system:String>
    <system:String x:Key="ContextInspector.Preview.Failed">候选生成失败：{0}</system:String>
    <system:String x:Key="ContextInspector.Preview.Rejected">候选未通过验收：{0}</system:String>
    <system:String x:Key="ContextInspector.Preview.ApplyFailed">应用失败，会话未发生变化：{0}</system:String>
    <system:String x:Key="ContextInspector.Preview.UndoFailed">撤销失败，会话未发生变化：{0}</system:String>
    <system:String x:Key="ContextInspector.Raw.Stale">RAW 快照已过期，请重新构建。</system:String>
    <system:String x:Key="ContextInspector.Raw.Cancelled">RAW Context 构建已取消。</system:String>
    <system:String x:Key="ContextInspector.Raw.Failed">RAW Context 构建失败：{0}</system:String>
    <system:String x:Key="Settings.Approval.Title">工具审批</system:String>
    <system:String x:Key="Settings.Approval.Description">决定工具调用何时需要你的确认，并管理永久放行项。</system:String>
    <system:String x:Key="Settings.Approval.Balanced.Title">均衡 · 推荐</system:String>
    <system:String x:Key="Settings.Approval.Balanced.Description">只读工具自动执行，写入、删除和终端命令需要确认。</system:String>
    <system:String x:Key="Settings.Approval.Strict.Title">严格</system:String>
    <system:String x:Key="Settings.Approval.Strict.Description">每一次工具调用都需要确认。</system:String>
    <system:String x:Key="Settings.Approval.Automatic.Title">自动</system:String>
    <system:String x:Key="Settings.Approval.Automatic.Description">由自动审批模型裁决未被静态规则处理的调用。</system:String>
    <system:String x:Key="Settings.Approval.Off.Title">关闭审批</system:String>
    <system:String x:Key="Settings.Approval.Off.Description">所有工具自动执行，适合完全受信任的环境。</system:String>
    <system:String x:Key="Settings.Approval.AutoAllowedHint">这些工具已被永久放行，可随时撤销。</system:String>
    <system:String x:Key="Settings.Approval.TerminalHint">白名单中的终端命令无需重复确认。</system:String>
    <system:String x:Key="Settings.Approval.JevShadowHint">弹出审批窗时，在后台把这次调用（工具名、命令行、文件路径、去掉查询串的网址）和你最近的两条消息经 OpenRouter 发给 TypeSafe Jev 打分，分数和你的最终选择一起写进日志，用来评估能否让 Jev 预筛弹窗。文件正文和任务指令只发长度，疑似密钥会打码。不影响任何审批结果；需要一个带 API key 的 OpenRouter 连接。</system:String>
    <system:String x:Key="Settings.Agent.Title">执行与并发</system:String>
    <system:String x:Key="Settings.Agent.Description">配置主对话与并行子代理的执行边界：并发上限、工具轮数与超时。</system:String>
    <system:String x:Key="Settings.Agent.Conversation.Title">主对话执行</system:String>
    <system:String x:Key="Settings.Agent.Conversation.MaxParallel">主对话全局并发上限</system:String>
    <system:String x:Key="Settings.Agent.Conversation.MaxToolRounds">单次回复最大工具轮数</system:String>
    <system:String x:Key="Settings.Agent.Conversation.MaxToolRoundsHint">一次回复内允许的模型调用轮数上限。打满后回复会停在半途，需要回复“继续”接续。运行长流程技能时可调高。</system:String>
    <system:String x:Key="Settings.Agent.SubAgent.Title">子代理</system:String>
    <system:String x:Key="Settings.Agent.SubAgent.Enabled">启用子代理</system:String>
    <system:String x:Key="Settings.Agent.SubAgent.ModelHint">使用的模型在“供应商与业务模型 / 子代理”中选择。</system:String>
    <system:String x:Key="Settings.Agent.SubAgent.MaxParallel">最大并行数</system:String>
    <system:String x:Key="Settings.Agent.SubAgent.MaxToolRounds">单代理最大工具轮数</system:String>
    <system:String x:Key="Settings.Agent.ProviderRetry.Title">供应商请求</system:String>
    <system:String x:Key="Settings.Agent.ProviderRetry.Description">回复流被上游中途掐断时自动重发同一个请求。已经开始输出正文的回合不会重试——重发会让模型从头再写一遍。</system:String>
    <system:String x:Key="Settings.Agent.ProviderRetry.Enabled">自动重试被中断的请求</system:String>
    <system:String x:Key="Settings.Agent.ProviderRetry.MaxAttempts">最大重试次数</system:String>
    <system:String x:Key="Settings.Agent.ProviderRetry.InitialDelay">首次重试前等待（秒）</system:String>
    <system:String x:Key="Settings.Agent.ProviderRetry.Backoff">此后每次翻倍，单次最多 30 秒，一轮总共最多等 60 秒。</system:String>
    <system:String x:Key="Settings.Agent.SubAgent.Timeout">超时（秒）</system:String>
    <system:String x:Key="Settings.Diagnostics.Title">运行诊断</system:String>
    <system:String x:Key="Settings.Diagnostics.Description">检查本地模型与上下文状态、管理可重新生成的缓存，并诊断浏览器运行时。</system:String>
    <system:String x:Key="Settings.Diagnostics.ContextData">模型与上下文数据</system:String>
    <system:String x:Key="Settings.Diagnostics.ContextDataHint">结构化本地诊断只包含 Revision、计数和时间，不包含提示词、图片、路径或 API Key。</system:String>
    <system:String x:Key="Settings.Diagnostics.MetadataCatalog">元数据目录</system:String>
    <system:String x:Key="Settings.Diagnostics.RefreshContextData">刷新诊断</system:String>
    <system:String x:Key="Settings.Diagnostics.ClearMetadataCache">清除元数据缓存</system:String>
    <system:String x:Key="Settings.Diagnostics.ClearMetadataCacheConfirm">清除已下载的 OpenRouter 元数据快照并回退到内置种子？</system:String>
    <system:String x:Key="Settings.Diagnostics.MetadataCacheCleared">已清除下载的元数据缓存；内置种子仍可用。</system:String>
    <system:String x:Key="Settings.Diagnostics.ClearFailed">清除失败：{0}</system:String>
    <system:String x:Key="Settings.Diagnostics.MetadataSummary">Revision {0} · {1:N0} 个模型 · 获取于 {2:g} · {3}</system:String>
    <system:String x:Key="Settings.Diagnostics.BrowserRuntime">浏览器运行时</system:String>
    <system:String x:Key="Settings.Diagnostics.BrowserRuntimeHint">自动浏览器需要本地 Chromium 运行时；缺失时可在这里安装。</system:String>
    <system:String x:Key="Settings.Diagnostics.BrowserAgent">自动浏览器模型</system:String>

