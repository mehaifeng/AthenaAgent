<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=netstandard">

    <!-- Main Window -->
    <system:String x:Key="App.Title">雅典娜 AI 助手</system:String>
    <system:String x:Key="Notification.AssistantTitle">雅典娜已回复</system:String>
    <system:String x:Key="Tray.Show">显示主窗口</system:String>
    <system:String x:Key="Tray.Quit">退出</system:String>
    <system:String x:Key="Tab.ChatLink">对话</system:String>
    <system:String x:Key="Tab.SysConfig">设置</system:String>
    <system:String x:Key="Tab.Scheduler">计划</system:String>
    <system:String x:Key="Tab.Archives">历史</system:String>
    <system:String x:Key="Tab.Files">知识库</system:String>
    <system:String x:Key="Tab.SysLogs">日志</system:String>
    <system:String x:Key="Tab.Diagnostic">关于</system:String>
    <system:String x:Key="Btn.CommitChanges">保存更改</system:String>
    <system:String x:Key="Btn.Rollback">放弃</system:String>

    <!-- Chat Tab -->
    <system:String x:Key="Chat.Header">当前对话</system:String>
    <system:String x:Key="Chat.Buffer">Token: {0}</system:String>
    <system:String x:Key="Chat.BtnTheme">主题</system:String>
    <system:String x:Key="Chat.BtnReset">新对话</system:String>
    <system:String x:Key="Chat.BtnStats">统计</system:String>
    <system:String x:Key="Chat.ReceivingData">思考中...</system:String>
    <system:String x:Key="Chat.BtnEdit">编辑</system:String>
    <system:String x:Key="Chat.BtnConfirm">确认</system:String>
    <system:String x:Key="Chat.BtnAbort">取消</system:String>
    <system:String x:Key="Chat.BtnRegen">重新生成</system:String>
    <system:String x:Key="Chat.BtnCopy">复制</system:String>
    <system:String x:Key="Chat.BtnPurge">删除</system:String>
    <system:String x:Key="Chat.InputPlaceholder">输入消息...</system:String>
    <system:String x:Key="Chat.MaxContextReached">已达到上下文限制</system:String>
    <system:String x:Key="Chat.BtnExecute">发送</system:String>
    <system:String x:Key="Chat.RoleUser">你</system:String>
    <system:String x:Key="Chat.RoleAssistant">雅典娜</system:String>

    <!-- Config Tab -->
    <system:String x:Key="Config.Header">系统设置</system:String>
    <system:String x:Key="Config.SectionAppearance">外观设置</system:String>
    <system:String x:Key="Config.SectionPrimaryAI">主 AI 模型</system:String>
    <system:String x:Key="Config.SectionSecondaryAI">次级 AI 模型</system:String>
    <system:String x:Key="Config.SectionEmbedding">向量嵌入模型</system:String>
    <system:String x:Key="Config.SectionMemory">记忆管理</system:String>
    <system:String x:Key="Config.BgTasks">后台任务</system:String>
    <system:String x:Key="Config.VectorKb">向量知识库</system:String>
    <system:String x:Key="Config.BgTask2ndAICore">后台任务与辅助核心</system:String>



    <!-- Config Labels -->
    <system:String x:Key="Config.DispTheme">显示主题:</system:String>
    <system:String x:Key="Config.DispFontScale">字体缩放:</system:String>
    <system:String x:Key="Config.DispHeartbeat">显示心跳按钮:</system:String>
    <system:String x:Key="Config.DispLanguage">语言设置:</system:String>
    <system:String x:Key="Config.ApiProvider">API 提供商:</system:String>
    <system:String x:Key="Config.ApiEndpoint">API 端点:</system:String>
    <system:String x:Key="Config.AuthToken">API 密钥:</system:String>
    <system:String x:Key="Config.ModelId">模型 ID:</system:String>
    <system:String x:Key="Config.ParamTemp">温度参数:</system:String>
    <system:String x:Key="Config.ParamMaxTokens">最大 Token 数:</system:String>
    <system:String x:Key="Config.CtxUsage">当前上下文:</system:String>
    <system:String x:Key="Config.MemMaxCtx">上下文限制:</system:String>
    <system:String x:Key="Config.MemCompThresh">压缩阈值:</system:String>
    <system:String x:Key="Config.MemAutoComp">自动压缩:</system:String>
    <system:String x:Key="Config.WarnHigh">高负载 (>80%)</system:String>
    <system:String x:Key="Config.CompressionPreview">压缩预览</system:String>
    <system:String x:Key="Config.InheritPrimary">继承主配置</system:String>

    <!-- Config Buttons -->
    <system:String x:Key="Config.BtnRunDiagnostics">运行测试</system:String>
    <system:String x:Key="Config.BtnExecCompression">执行压缩</system:String>
    <system:String x:Key="Config.BtnUndoCompression">清空摘要</system:String>

    <!-- Tasks Tab -->
    <system:String x:Key="Tasks.Header">任务计划</system:String>
    <system:String x:Key="Tasks.BtnNewRoutine">新建任务</system:String>
    <system:String x:Key="Tasks.BtnPurgeAll">全部清除</system:String>
    <system:String x:Key="Tasks.ActiveRoutines">当前活动任务:</system:String>
    <system:String x:Key="Tasks.SystemIdle">系统就绪</system:String>
    <system:String x:Key="Tasks.Trig">触发:</system:String>
    <system:String x:Key="Tasks.Rec">重复:</system:String>

    <!-- History Tab -->
    <system:String x:Key="History.Header">对话记录</system:String>
    <system:String x:Key="History.BtnRefreshDb">刷新</system:String>
    <system:String x:Key="History.RecordsFound">找到记录:</system:String>
    <system:String x:Key="History.Ready">就绪</system:String>
    <system:String x:Key="History.Msgs">消息数:</system:String>
    <system:String x:Key="History.Time">时间:</system:String>
    <system:String x:Key="History.BtnRestore">恢复</system:String>
    <system:String x:Key="History.BtnDel">删除</system:String>
    <system:String x:Key="History.NoRecords">未找到记录</system:String>
    <system:String x:Key="History.FooterHint">选择“恢复”将历史对话加载到当前记忆。</system:String>

    <!-- Files Tab -->
    <system:String x:Key="Files.Header">知识库管理</system:String>
    <system:String x:Key="Files.BtnRefresh">刷新</system:String>
    <system:String x:Key="Files.BtnImport">导入</system:String>
    <system:String x:Key="Files.BtnExport">导出</system:String>
    <system:String x:Key="Files.BtnDelete">删除</system:String>
    <system:String x:Key="Files.DirectoryStructure">目录结构</system:String>
    <system:String x:Key="Files.MkdirPlaceholder">新文件夹名称</system:String>
    <system:String x:Key="Files.TouchPlaceholder">新文件名称 (.md)</system:String>
    <system:String x:Key="Files.BtnExec">创建</system:String>
    <system:String x:Key="Files.Path">路径:</system:String>
    <system:String x:Key="Files.ModeEdit">编辑模式</system:String>
    <system:String x:Key="Files.ModeRead">只读模式</system:String>
    <system:String x:Key="Files.NoFileSelected">未选择文件</system:String>
    <system:String x:Key="Files.AwaitingInput">等待输入...</system:String>
    <system:String x:Key="Files.BtnCommitWrite">保存文件</system:String>
    <system:String x:Key="Files.CtxView">查看</system:String>
    <system:String x:Key="Files.CtxDelete">删除</system:String>

    <!-- Logs Tab -->
    <system:String x:Key="Logs.Header">系统日志</system:String>
    <system:String x:Key="Logs.QueryParams">查询参数</system:String>
    <system:String x:Key="Logs.TStart">开始时间:</system:String>
    <system:String x:Key="Logs.TEnd">结束时间:</system:String>
    <system:String x:Key="Logs.Lvl">级别:</system:String>
    <system:String x:Key="Logs.Keyword">关键字:</system:String>
    <system:String x:Key="Logs.OptionalFilter">可选筛选</system:String>
    <system:String x:Key="Logs.BtnQuery">搜索</system:String>
    <system:String x:Key="Logs.BtnRefresh">刷新</system:String>
    <system:String x:Key="Logs.BtnExport">导出</system:String>
    <system:String x:Key="Logs.TotalEvents">总计条数:</system:String>
    <system:String x:Key="Logs.Limit">每页条数:</system:String>

    <!-- Log Levels -->
    <system:String x:Key="Logs.Level.All">全部</system:String>
    <system:String x:Key="Logs.Level.Verbose">详细</system:String>
    <system:String x:Key="Logs.Level.Debug">调试</system:String>
    <system:String x:Key="Logs.Level.Information">信息</system:String>
    <system:String x:Key="Logs.Level.Warning">警告</system:String>
    <system:String x:Key="Logs.Level.Error">错误</system:String>
    <system:String x:Key="Logs.Level.Fatal">致命</system:String>

    <!-- About Tab -->
    <system:String x:Key="About.Header">关于雅典娜</system:String>
    <system:String x:Key="About.Subtitle">智能 Agent 助手</system:String>
    <system:String x:Key="About.Specs">系统规格:</system:String>
    <system:String x:Key="About.KernelVer">版本号:</system:String>
    <system:String x:Key="About.Framework">框架:</system:String>
    <system:String x:Key="About.License">许可证:</system:String>
    <system:String x:Key="About.Author">开发者:</system:String>
    <system:String x:Key="About.Quote">“智慧始于好奇。”</system:String>
    <system:String x:Key="About.BtnChkUpdates">检查更新</system:String>
    <system:String x:Key="About.BtnViewDocs">查看文档</system:String>
    <system:String x:Key="About.BtnSourceRepo">源码仓库</system:String>

    <!-- Create Task Dialog -->
    <system:String x:Key="TaskDialog.Title">创建新任务</system:String>
    <system:String x:Key="TaskDialog.TriggerTime">计划时间</system:String>
    <system:String x:Key="TaskDialog.Date">日期:</system:String>
    <system:String x:Key="TaskDialog.Time">时间:</system:String>
    <system:String x:Key="TaskDialog.TaskIntent">任务描述</system:String>
    <system:String x:Key="TaskDialog.IntentHint">任务触发时雅典娜应做什么？</system:String>
    <system:String x:Key="TaskDialog.IntentPlaceholder">例如：提醒我检查项目进度</system:String>
    <system:String x:Key="TaskDialog.Recurrence">重复频率</system:String>
    <system:String x:Key="TaskDialog.Repeat">重复:</system:String>
    <system:String x:Key="TaskDialog.Preview">预览</system:String>
    <system:String x:Key="TaskDialog.PreviewWill">雅典娜将在</system:String>
    <system:String x:Key="TaskDialog.PreviewTriggerAt">触发任务：</system:String>
    <system:String x:Key="TaskDialog.BtnCancel">取消</system:String>
    <system:String x:Key="TaskDialog.BtnCreate">创建</system:String>

    <!-- Recurrence -->
    <system:String x:Key="Recurrence.None">None</system:String>
    <system:String x:Key="Recurrence.Daily">Daily</system:String>
    <system:String x:Key="Recurrence.Weekly">Weekly</system:String>
    <system:String x:Key="Recurrence.NoneDisplay">一次性</system:String>
    <system:String x:Key="Recurrence.DailyDisplay">每天</system:String>
    <system:String x:Key="Recurrence.WeeklyDisplay">每周</system:String>

    <!-- Status Messages -->
    <system:String x:Key="Status.Testing">正在测试连接...</system:String>
    <system:String x:Key="Status.EnterApiKey">请先输入 API 密钥</system:String>
    <system:String x:Key="Status.ServiceNotInit">服务未初始化</system:String>
    <system:String x:Key="Status.ConfigSaved">设置已保存</system:String>
    <system:String x:Key="Status.ConfigReset">设置已重置</system:String>

    <!-- Dialogs -->
    <system:String x:Key="Dialog.Title.Warning">警告</system:String>
    <system:String x:Key="Dialog.ConfirmResetConfig">确定要将所有设置恢复为默认值吗？此操作不可撤销。</system:String>
    <system:String x:Key="Dialog.ConfirmClearSummary">确定要清空压缩摘要吗？已归档的消息仍将保持归档状态，仅摘要内容会被清除。</system:String>
    <system:String x:Key="Dialog.ConfirmPurgeTasks">确定要删除所有计划任务吗？</system:String>
    <system:String x:Key="Dialog.ConfirmDeleteFile">确定要删除"{0}"吗？此操作不可撤销。</system:String>

    <!-- Web Search -->
    <system:String x:Key="Config.WebSearch">网络搜索</system:String>
    <system:String x:Key="Config.TestConnection">测试连接</system:String>
    <system:String x:Key="Config.Test">测试</system:String>

</ResourceDictionary>