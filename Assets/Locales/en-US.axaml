<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=netstandard">

    <!-- Main Window -->
    <system:String x:Key="App.Title">Athena AI Assistant</system:String>
    <system:String x:Key="Tab.ChatLink">Chat</system:String>
    <system:String x:Key="Tab.SysConfig">Settings</system:String>
    <system:String x:Key="Tab.Scheduler">Scheduler</system:String>
    <system:String x:Key="Tab.Archives">History</system:String>
    <system:String x:Key="Tab.Files">Knowledge Base</system:String>
    <system:String x:Key="Tab.SysLogs">Logs</system:String>
    <system:String x:Key="Tab.Diagnostic">About</system:String>
    <system:String x:Key="Btn.CommitChanges">Save Changes</system:String>
    <system:String x:Key="Btn.Rollback">Discard</system:String>

    <!-- Chat Tab -->
    <system:String x:Key="Chat.Header">Conversation</system:String>
    <system:String x:Key="Chat.Buffer">Tokens: {0}</system:String>
    <system:String x:Key="Chat.BtnTheme">Theme</system:String>
    <system:String x:Key="Chat.BtnReset">New Chat</system:String>
    <system:String x:Key="Chat.BtnStats">Stats</system:String>
    <system:String x:Key="Chat.ReceivingData">Thinking...</system:String>
    <system:String x:Key="Chat.BtnEdit">Edit</system:String>
    <system:String x:Key="Chat.BtnConfirm">Confirm</system:String>
    <system:String x:Key="Chat.BtnAbort">Cancel</system:String>
    <system:String x:Key="Chat.BtnRegen">Regenerate</system:String>
    <system:String x:Key="Chat.BtnCopy">Copy</system:String>
    <system:String x:Key="Chat.BtnPurge">Delete</system:String>
    <system:String x:Key="Chat.InputPlaceholder">Type a message...</system:String>
    <system:String x:Key="Chat.MaxContextReached">Context limit reached</system:String>
    <system:String x:Key="Chat.BtnExecute">Send</system:String>
    <system:String x:Key="Chat.RoleUser">You</system:String>
    <system:String x:Key="Chat.RoleAssistant">Athena</system:String>

    <!-- Config Tab -->
    <system:String x:Key="Config.Header">System Settings</system:String>
    <system:String x:Key="Config.SectionAppearance">Appearance</system:String>
    <system:String x:Key="Config.SectionPrimaryAI">Primary AI Model</system:String>
    <system:String x:Key="Config.SectionSecondaryAI">Secondary AI Model</system:String>
    <system:String x:Key="Config.SectionEmbedding">Embedding Model</system:String>
    <system:String x:Key="Config.SectionMemory">Memory Management</system:String>
    <system:String x:Key="Config.BgTasks">Background Tasks</system:String>
    <system:String x:Key="Config.VectorKb">Vector Knowledge Base</system:String>

    <!-- Config Labels -->
    <system:String x:Key="Config.DispTheme">Theme:</system:String>
    <system:String x:Key="Config.DispFontScale">Font Size:</system:String>
    <system:String x:Key="Config.DispHeartbeat">Show Heartbeat:</system:String>
    <system:String x:Key="Config.DispLanguage">Language:</system:String>
    <system:String x:Key="Config.ApiProvider">API Provider:</system:String>
    <system:String x:Key="Config.ApiEndpoint">API Endpoint:</system:String>
    <system:String x:Key="Config.AuthToken">API Key:</system:String>
    <system:String x:Key="Config.ModelId">Model ID:</system:String>
    <system:String x:Key="Config.ParamTemp">Temperature:</system:String>
    <system:String x:Key="Config.ParamMaxTokens">Max Tokens:</system:String>
    <system:String x:Key="Config.CtxUsage">Context Usage:</system:String>
    <system:String x:Key="Config.MemMaxCtx">Max Context Tokens:</system:String>
    <system:String x:Key="Config.MemCompThresh">Compression Threshold:</system:String>
    <system:String x:Key="Config.MemAutoComp">Auto-Compression:</system:String>
    <system:String x:Key="Config.WarnHigh">High Usage (>80%)</system:String>
    <system:String x:Key="Config.CompressionPreview">Compression Preview</system:String>
    <system:String x:Key="Config.InheritPrimary">Inherit Primary Settings</system:String>

    <!-- Config Buttons -->
    <system:String x:Key="Config.BtnRunDiagnostics">Run Test</system:String>
    <system:String x:Key="Config.BtnExecCompression">Compress Now</system:String>
    <system:String x:Key="Config.BtnUndoCompression">Undo Compression</system:String>

    <!-- Tasks Tab -->
    <system:String x:Key="Tasks.Header">Task Scheduler</system:String>
    <system:String x:Key="Tasks.BtnNewRoutine">New Task</system:String>
    <system:String x:Key="Tasks.BtnPurgeAll">Clear All</system:String>
    <system:String x:Key="Tasks.ActiveRoutines">Active Tasks:</system:String>
    <system:String x:Key="Tasks.SystemIdle">System Idle</system:String>
    <system:String x:Key="Tasks.Trig">Trigger:</system:String>
    <system:String x:Key="Tasks.Rec">Repeat:</system:String>

    <!-- History Tab -->
    <system:String x:Key="History.Header">Conversation History</system:String>
    <system:String x:Key="History.BtnRefreshDb">Refresh</system:String>
    <system:String x:Key="History.RecordsFound">Records Found:</system:String>
    <system:String x:Key="History.Ready">Ready</system:String>
    <system:String x:Key="History.Msgs">Messages:</system:String>
    <system:String x:Key="History.Time">Time:</system:String>
    <system:String x:Key="History.BtnRestore">Restore</system:String>
    <system:String x:Key="History.BtnDel">Delete</system:String>
    <system:String x:Key="History.NoRecords">No records found</system:String>
    <system:String x:Key="History.FooterHint">Select 'Restore' to load a previous session.</system:String>

    <!-- Files Tab -->
    <system:String x:Key="Files.Header">Knowledge Base</system:String>
    <system:String x:Key="Files.BtnRefresh">Refresh</system:String>
    <system:String x:Key="Files.BtnImport">Import</system:String>
    <system:String x:Key="Files.BtnExport">Export</system:String>
    <system:String x:Key="Files.BtnDelete">Delete</system:String>
    <system:String x:Key="Files.DirectoryStructure">Directory Structure</system:String>
    <system:String x:Key="Files.MkdirPlaceholder">New Folder Name</system:String>
    <system:String x:Key="Files.TouchPlaceholder">New File Name (.md)</system:String>
    <system:String x:Key="Files.BtnExec">Create</system:String>
    <system:String x:Key="Files.Path">Path:</system:String>
    <system:String x:Key="Files.ModeEdit">Mode: Edit</system:String>
    <system:String x:Key="Files.ModeRead">Mode: Read</system:String>
    <system:String x:Key="Files.NoFileSelected">No file selected</system:String>
    <system:String x:Key="Files.AwaitingInput">Waiting for input...</system:String>
    <system:String x:Key="Files.BtnCommitWrite">Save File</system:String>
    <system:String x:Key="Files.CtxView">View</system:String>
    <system:String x:Key="Files.CtxDelete">Delete</system:String>

    <!-- Logs Tab -->
    <system:String x:Key="Logs.Header">System Logs</system:String>
    <system:String x:Key="Logs.QueryParams">Search Filters</system:String>
    <system:String x:Key="Logs.TStart">Start Time:</system:String>
    <system:String x:Key="Logs.TEnd">End Time:</system:String>
    <system:String x:Key="Logs.Lvl">Level:</system:String>
    <system:String x:Key="Logs.Keyword">Keyword:</system:String>
    <system:String x:Key="Logs.OptionalFilter">Optional filter</system:String>
    <system:String x:Key="Logs.BtnQuery">Search</system:String>
    <system:String x:Key="Logs.BtnRefresh">Refresh</system:String>
    <system:String x:Key="Logs.BtnExport">Export</system:String>
    <system:String x:Key="Logs.TotalEvents">Total Events:</system:String>
    <system:String x:Key="Logs.Limit">Limit:</system:String>

    <!-- Log Levels -->
    <system:String x:Key="Logs.Level.All">All</system:String>
    <system:String x:Key="Logs.Level.Verbose">Verbose</system:String>
    <system:String x:Key="Logs.Level.Debug">Debug</system:String>
    <system:String x:Key="Logs.Level.Information">Info</system:String>
    <system:String x:Key="Logs.Level.Warning">Warning</system:String>
    <system:String x:Key="Logs.Level.Error">Error</system:String>
    <system:String x:Key="Logs.Level.Fatal">Fatal</system:String>

    <!-- About Tab -->
    <system:String x:Key="About.Header">About Athena</system:String>
    <system:String x:Key="About.Subtitle">Intelligent Agent Assitant</system:String>
    <system:String x:Key="About.Specs">System Specifications:</system:String>
    <system:String x:Key="About.KernelVer">Version:</system:String>
    <system:String x:Key="About.Framework">Framework:</system:String>
    <system:String x:Key="About.License">License:</system:String>
    <system:String x:Key="About.Author">Developer:</system:String>
    <system:String x:Key="About.Quote">"Wisdom begins in wonder."</system:String>
    <system:String x:Key="About.BtnChkUpdates">Check for Updates</system:String>
    <system:String x:Key="About.BtnViewDocs">Documentation</system:String>
    <system:String x:Key="About.BtnSourceRepo">GitHub</system:String>

    <!-- Create Task Dialog -->
    <system:String x:Key="TaskDialog.Title">Create New Task</system:String>
    <system:String x:Key="TaskDialog.TriggerTime">Schedule</system:String>
    <system:String x:Key="TaskDialog.Date">Date:</system:String>
    <system:String x:Key="TaskDialog.Time">Time:</system:String>
    <system:String x:Key="TaskDialog.TaskIntent">Task Description</system:String>
    <system:String x:Key="TaskDialog.IntentHint">What should Athena do when this task triggers?</system:String>
    <system:String x:Key="TaskDialog.IntentPlaceholder">e.g., Remind me to check the project progress</system:String>
    <system:String x:Key="TaskDialog.Recurrence">Recurrence</system:String>
    <system:String x:Key="TaskDialog.Repeat">Repeat:</system:String>
    <system:String x:Key="TaskDialog.Preview">Preview</system:String>
    <system:String x:Key="TaskDialog.PreviewWill">Athena will</system:String>
    <system:String x:Key="TaskDialog.PreviewTriggerAt">at</system:String>
    <system:String x:Key="TaskDialog.BtnCancel">Cancel</system:String>
    <system:String x:Key="TaskDialog.BtnCreate">Create</system:String>

    <!-- Recurrence -->
    <system:String x:Key="Recurrence.None">None</system:String>
    <system:String x:Key="Recurrence.Daily">Daily</system:String>
    <system:String x:Key="Recurrence.Weekly">Weekly</system:String>
    <system:String x:Key="Recurrence.NoneDisplay">Once</system:String>
    <system:String x:Key="Recurrence.DailyDisplay">Daily</system:String>
    <system:String x:Key="Recurrence.WeeklyDisplay">Weekly</system:String>

    <!-- Status Messages -->
    <system:String x:Key="Status.Testing">Testing connection...</system:String>
    <system:String x:Key="Status.EnterApiKey">Please enter API key</system:String>
    <system:String x:Key="Status.ServiceNotInit">Service not initialized</system:String>
    <system:String x:Key="Status.ConfigSaved">Settings saved</system:String>
    <system:String x:Key="Status.ConfigReset">Settings reset</system:String>

</ResourceDictionary>