    <system:String x:Key="Settings.General.Description">Adjust the app appearance, language, and common interaction preferences.</system:String>
    <system:String x:Key="Settings.General.Appearance">Appearance &amp; language</system:String>
    <system:String x:Key="Settings.General.Theme">Theme</system:String>
    <system:String x:Key="Settings.General.ColorScheme">Color scheme</system:String>
    <system:String x:Key="Settings.General.Language">Language</system:String>
    <system:String x:Key="Settings.General.FontScale">Font size</system:String>
    <system:String x:Key="Settings.General.FontScale.Minimum">Tiny</system:String>
    <system:String x:Key="Settings.General.FontScale.Small">Small</system:String>
    <system:String x:Key="Settings.General.FontScale.Medium">Medium</system:String>
    <system:String x:Key="Settings.General.FontScale.Large">Large</system:String>
    <system:String x:Key="Settings.General.FontScale.Maximum">Largest</system:String>
    <system:String x:Key="Settings.General.PanelOpacity">Panel transparency</system:String>
    <system:String x:Key="Settings.General.PanelOpacity.Description">Let the background image gently show through the three main-window panels. 0% hides it completely (original look); 80% is the most transparent. The title bar is unaffected.</system:String>
    <system:String x:Key="Settings.General.PanelGlass">Frosted glass panels</system:String>
    <system:String x:Key="Settings.General.PanelGlass.Description">Switch panels to a frosted-glass material: the background image shows through blurred, with a light rim and a soft shadow. Glass keeps panels at least partly translucent (otherwise the panel itself would hide it); the slider above can still make them more transparent.</system:String>
    <system:String x:Key="Settings.General.Interaction">Interaction</system:String>
    <system:String x:Key="Settings.General.RewindHint">When enabled, rewinding a conversation happens immediately without a confirmation prompt.</system:String>
    <system:String x:Key="Settings.General.AutoExpandReasoning">Automatically expand reasoning</system:String>
    <system:String x:Key="Settings.General.AutoExpandReasoningHint">When enabled, the reasoning area expands whenever the model starts a new reasoning round. It still collapses when that round finishes.</system:String>
    <system:String x:Key="Settings.General.SystemNotifications">Send system notifications while Athena is in the background</system:String>
    <system:String x:Key="Settings.General.SystemNotificationsHint">Covers a tool call waiting for your approval, a finished reply, and a scheduled task that has run. A scheduled task's own "notify when it succeeds" switch still applies on top of this. On macOS the notification is delivered through Script Editor and must be allowed there once.</system:String>
    <system:String x:Key="Settings.Context.Title">Conversation &amp; context</system:String>
    <system:String x:Key="Settings.Context.Description">Manage application-wide context defaults. Conversation state and summaries are not edited here.</system:String>
    <system:String x:Key="Settings.Context.Budget">Context budget</system:String>
    <system:String x:Key="Settings.Context.AutoCompress">Automatically compress context</system:String>
    <system:String x:Key="Settings.Context.MaxTokens">Maximum context tokens</system:String>
    <system:String x:Key="Settings.Context.CompressionThreshold">Automatic compression threshold</system:String>
    <system:String x:Key="Settings.Context.WorkspaceKnowledgeBudget">Workspace knowledge budget (characters)</system:String>
    <system:String x:Key="Settings.Context.BudgetHint">Keep the compression threshold below the maximum context. Set workspace knowledge to 0 to disable injection.</system:String>
    <system:String x:Key="Settings.Context.CurrentModel">Current main model (read-only)</system:String>
    <system:String x:Key="Settings.Context.MainModel">Provider / model</system:String>
    <system:String x:Key="Settings.Context.ContextWindow">Context window</system:String>
    <system:String x:Key="Settings.Context.MatchStatus">OpenRouter match</system:String>
    <system:String x:Key="Settings.Context.MetadataCatalog">Metadata catalog</system:String>
    <system:String x:Key="Settings.Context.GlobalPolicy">Global context defaults</system:String>
    <system:String x:Key="Settings.Context.Mode">Context mode</system:String>
    <system:String x:Key="Settings.Context.CustomCap">Custom global cap</system:String>
    <system:String x:Key="Settings.Context.ThresholdMode">Compression threshold mode</system:String>
    <system:String x:Key="Settings.Context.ToolResultClearing">Clear old tool results before summarizing</system:String>
    <system:String x:Key="Settings.Context.KeepRecentToolResults">Keep recent tool results (characters)</system:String>
    <system:String x:Key="Settings.Context.KeepRecentToolResultsHint">How much of the most recent tool output stays untouched when clearing; older tool results become a one-line placeholder (the archive is unchanged, and the model can call the tool again if it needs them).</system:String>
    <system:String x:Key="Settings.Context.MaxSummaryTokens">Summary length cap</system:String>
    <system:String x:Key="Settings.Context.MaxSummaryTokensHint">The longest summary, in tokens, that a full compression may produce; also limited by what the compression model can emit in one response and by a quarter of the compression threshold.</system:String>
    <system:String x:Key="Settings.Context.Effect.TwoLayer">At {0:N0} tokens, old tool results are cleared first (the most recent {1:N0} characters are kept); if that is not enough, the whole history is compressed into one summary (at most {2:N0} tokens).</system:String>
    <system:String x:Key="Settings.Context.Effect.FullOnly">At {0:N0} tokens, the whole history is compressed into one summary (at most {1:N0} tokens).</system:String>
    <system:String x:Key="Settings.Context.Effect.Disabled">Automatic compression is off.</system:String>
    <system:String x:Key="Settings.Context.UnknownAssumption">Unmatched models use the 1,000,000 context / 262,144 compression-threshold assumption. Enter verified model metadata in Provider Models when available.</system:String>
    <system:String x:Key="Settings.Context.WorkspaceKnowledge">Workspace knowledge</system:String>
    <system:String x:Key="Settings.Context.Unconfigured">Not configured</system:String>
