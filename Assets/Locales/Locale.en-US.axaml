    <system:String x:Key="ContextInspector.Overview.PolicyHint">W window · R output reserve · O per-request output ceiling (from model metadata; each request uses the smaller of it and the remaining window, never below R, and it is hidden when the metadata does not state one) · S safety margin · B input budget · T compression threshold</system:String>
    <system:String x:Key="ContextInspector.Overview.Usage">Usage anchor</system:String>
    <system:String x:Key="ContextInspector.Overview.CachedHint">Cached input affects billing/cache reuse; it does not reduce context-window occupancy.</system:String>
    <system:String x:Key="ContextInspector.Overview.Ownership">Ownership and inheritance</system:String>
    <system:String x:Key="ContextInspector.Summary.Active">Summary sent on the next request</system:String>
    <system:String x:Key="ContextInspector.Summary.Undo">Undo latest batch</system:String>
    <system:String x:Key="ContextInspector.Summary.Empty">This conversation has no active compression summary.</system:String>
    <system:String x:Key="ContextInspector.Summary.Orphaned">Orphaned legacy summary (not sent)</system:String>
    <system:String x:Key="ContextInspector.Summary.OrphanedHint">This text could not be verified against compression flags. It is preserved only for diagnostics and copying.</system:String>
    <system:String x:Key="ContextInspector.Preview.Explanation">Below is a local impact note: zero cost, no model call. Compact now calls the compression model; if you do not like the result, undo it from the Summary tab or the compression divider in the chat.</system:String>
    <system:String x:Key="ContextInspector.Raw.Warning">RAW context may contain the system prompt, Workspace knowledge, local paths, attachment metadata, and tool results. Review before copying.</system:String>
    <system:String x:Key="ContextInspector.Raw.Refresh">Build / refresh snapshot</system:String>
    <system:String x:Key="ContextInspector.Usage.ReportedDetails">Cached input {0:N0} · Last Usage {1}</system:String>
    <system:String x:Key="ContextInspector.Workspace.App">App defaults (no Workspace override)</system:String>
    <system:String x:Key="ContextInspector.Workspace.Chain">{0} · Workspace → App → model metadata</system:String>
    <system:String x:Key="ContextInspector.Warning.UnknownModel">Unmatched model: using the 1M / 256K assumption.</system:String>
    <system:String x:Key="ContextInspector.Summary.Details">{0} · {1:g} · {2} messages · {3:N0} → {4:N0} tokens · Prompt v{5} · {6}</system:String>
    <system:String x:Key="ContextInspector.Preview.NothingToCompress">There is no history to compress.</system:String>
    <system:String x:Key="ContextInspector.Overview.ClearedToolResults">{0} old tool results cleared (≈{1:N0} characters saved)</system:String>
    <system:String x:Key="ContextInspector.CompactNow.Title">Compact now</system:String>
    <system:String x:Key="ContextInspector.CompactNow.Hint">Ignores the threshold and compresses all uncompressed history, the latest turn included, into one summary; undoable. Calls the compression model and may incur provider charges.</system:String>
    <system:String x:Key="ContextInspector.CompactNow.FocusWatermark">Focus for this compression (optional), e.g. keep every error message and file path</system:String>
    <system:String x:Key="ContextInspector.CompactNow.Button">Compact now</system:String>
    <system:String x:Key="ContextInspector.Preview.Unavailable">Transactional compression is unavailable.</system:String>
    <system:String x:Key="ContextInspector.Preview.ModelUnavailable">Compression model policy is unavailable.</system:String>
    <system:String x:Key="ContextInspector.Preview.ImpactFormat">Will compress {0} messages ({1:N0} characters, {2} of them already-cleared tool results) into a summary; summary limit {3:N0} tokens.</system:String>
    <system:String x:Key="ContextInspector.Preview.Cancelled">Compression cancelled; conversation unchanged.</system:String>
    <!-- {0} is the technical reason from the compression pipeline (planner/validator verdict or the provider error), kept verbatim so it matches the logs. -->
    <system:String x:Key="ContextInspector.Preview.PlanUnavailable">No compression plan could be built: {0}</system:String>
    <system:String x:Key="ContextInspector.Preview.Failed">Candidate generation failed: {0}</system:String>
    <system:String x:Key="ContextInspector.Preview.Rejected">The candidate failed validation: {0}</system:String>
    <system:String x:Key="ContextInspector.Preview.ApplyFailed">Apply failed and the conversation is unchanged: {0}</system:String>
    <system:String x:Key="ContextInspector.Preview.UndoFailed">Undo failed and the conversation is unchanged: {0}</system:String>
    <system:String x:Key="ContextInspector.Raw.Stale">RAW snapshot became stale; refresh it.</system:String>
    <system:String x:Key="ContextInspector.Raw.Cancelled">RAW context build cancelled.</system:String>
