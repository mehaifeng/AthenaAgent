    <!-- 本地台词库：同一场景的多句用 | 分隔，随机挑一句 -->
    <system:String x:Key="Pet.Line.Greeting">Back again!|There you are.|Ready when you are.</system:String>
    <system:String x:Key="Pet.Line.Pat">That spot, yes.|Hey hey!|Do that again.</system:String>
    <system:String x:Key="Pet.Line.Pat.Low">…thanks. I needed that.|Mm. Better.</system:String>
    <system:String x:Key="Pet.Line.Pat.High">Best day!|I could do this forever.</system:String>
    <system:String x:Key="Pet.Line.PatCooldown">Still fluffy from the last one.|Give me a second.|Okay, okay.</system:String>
    <system:String x:Key="Pet.Line.Feed">Crunch. Excellent.|My favourite!|Ten out of ten.</system:String>
    <system:String x:Key="Pet.Line.FeedCooldown">Still full, honestly.|Save it for later?</system:String>
    <system:String x:Key="Pet.Line.Play">Race you!|Watch this!|Zoom.</system:String>
    <system:String x:Key="Pet.Line.PlayCooldown">Catching my breath.|One moment, still dizzy.</system:String>
    <system:String x:Key="Pet.Line.LevelUp">I levelled up!|Look at me go!|New rank unlocked.</system:String>
    <system:String x:Key="Pet.Line.NeedHungry">Getting a bit hungry…|Snack? Please?</system:String>
    <system:String x:Key="Pet.Line.NeedBored">I'm bored…|Let's do something.</system:String>
    <system:String x:Key="Pet.Line.NeedLonely">You've been quiet.|Still here, you know.</system:String>
    <system:String x:Key="Pet.Line.NeedMet">You understood me!|That's exactly it.|Thank you!</system:String>
    <system:String x:Key="Pet.Line.FileCaught">Got it!|Caught it. Where to?|Dropped it in the box.</system:String>
    <system:String x:Key="Pet.Line.ResponseDone">All done!|That went well.|Nice one.</system:String>
    <system:String x:Key="Pet.Line.Sleepy">So sleepy…|Just resting my eyes.</system:String>
    <system:String x:Key="Pet.Line.Idle">Hi.|What's next?|I'm around.</system:String>
    <system:String x:Key="Pet.Line.Idle.Low">Kind of a long day.|Meh.</system:String>
    <system:String x:Key="Pet.Line.Idle.High">Everything's great!|Feeling good today.</system:String>

