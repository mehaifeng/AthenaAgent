    <system:String x:Key="Connectors.Provider.Description.Image.Krea">Krea asynchronous image jobs with configurable Krea model.</system:String>
    <system:String x:Key="Connectors.Provider.Description.Image.OpenAI">OpenAI Images API with text generation and reference-image continuity.</system:String>
    <system:String x:Key="Connectors.Provider.Description.Image.OpenAICodex">Codex Responses image tools authenticated with a ChatGPT/Codex access token.</system:String>
    <system:String x:Key="Connectors.Provider.Description.Image.OpenRouter">OpenRouter image-output models through chat completions.</system:String>
    <system:String x:Key="Connectors.Provider.Description.Image.xAI">xAI Images API with Grok image models.</system:String>
    <system:String x:Key="Connectors.Provider.Description.WebSearch.Brave">Brave Search API using a subscription API key.</system:String>
    <system:String x:Key="Connectors.Provider.Description.WebSearch.DuckDuckGo">Keyless search through DuckDuckGo result pages.</system:String>
    <system:String x:Key="Connectors.Provider.Description.WebSearch.Exa">Exa neural search with result summaries.</system:String>
    <system:String x:Key="Connectors.Provider.Description.WebSearch.Firecrawl">Firecrawl Cloud search API.</system:String>
    <system:String x:Key="Connectors.Provider.Description.WebSearch.FirecrawlSelfHosted">A self-hosted Firecrawl instance without cloud credentials.</system:String>
    <system:String x:Key="Connectors.Provider.Description.WebSearch.Parallel">Parallel Search with fast, one-shot, or agentic mode.</system:String>
    <system:String x:Key="Connectors.Provider.Description.WebSearch.SearXNG">A self-hosted SearXNG instance with JSON search enabled.</system:String>
    <system:String x:Key="Connectors.Provider.Description.WebSearch.Tavily">Tavily Search API with an optional custom endpoint.</system:String>
    <system:String x:Key="Connectors.Provider.Description.WebSearch.xAI">xAI Responses web_search using a selected Grok model.</system:String>
    <system:String x:Key="Connectors.Provider.Description.WebSearch.WebSearchAPI">WebSearchAPI AI Search with API-key authentication.</system:String>
    <system:String x:Key="Connectors.Provider.Description.WebSearch.Zhipu">Zhipu Web Search with an optional custom endpoint.</system:String>
    <system:String x:Key="Connectors.Provider.Description.WebSearch.Baidu">Baidu intelligent Web Search using an API key and App ID.</system:String>

    <!-- Headless Browser -->
    <system:String x:Key="Config.Browser">Browser automation</system:String>
    <system:String x:Key="Config.BrowserDescription">When enabled, Athena can view and operate web pages inside an isolated session. Underlying operations do not enter the main chat context.</system:String>
    <system:String x:Key="Config.BrowserEnabled">Enable browser automation:</system:String>
