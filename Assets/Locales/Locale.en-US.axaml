    <!-- Sub-Agents -->
    <system:String x:Key="Config.SubAgents">Parallel sub-agents</system:String>
    <system:String x:Key="Config.SubAgentsDescription">When enabled, the primary chat can dispatch independent tasks to multiple sub-agents running in parallel. Each sub-agent has its own isolated context; only the final result is sent back to the primary chat.</system:String>
