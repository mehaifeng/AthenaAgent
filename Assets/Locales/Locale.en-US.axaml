    <!-- 游戏模式 M2：藏品、委托板、神谕、居民、海图、传令官 -->
    <system:String x:Key="Polis.Ui.Place">Place</system:String>
    <system:String x:Key="Polis.Ui.Move">Move</system:String>
    <system:String x:Key="Polis.Ui.TakeDown">Take down</system:String>
    <system:String x:Key="Polis.Ui.Remove">Remove</system:String>
    <system:String x:Key="Polis.Ui.PlaceHint">Walk up to an empty pedestal and press E to place “{title}” there</system:String>
    <system:String x:Key="Polis.Ui.PlaceDefault">Put it in the {venue}</system:String>
    <system:String x:Key="Polis.Ui.Cancel">Cancel</system:String>
    <system:String x:Key="Polis.Ui.StoredIn">On display in the {venue}</system:String>
    <system:String x:Key="Polis.Ui.StoredNowhere">Kept, not on display yet</system:String>
    <system:String x:Key="Polis.Ui.VenueCount">{count} of {total} pedestals hold a piece</system:String>
    <system:String x:Key="Polis.Ui.VenueStored">Kept pieces</system:String>
    <system:String x:Key="Polis.Ui.VenueEmpty">Nothing here yet. Results you keep are displayed here.</system:String>
    <system:String x:Key="Polis.Ui.PlaceHere">Place here</system:String>
    <system:String x:Key="Polis.Ui.BoardTitle">Commission board</system:String>
    <system:String x:Key="Polis.Ui.BoardHint">Here are a few things you could hand to me:</system:String>
    <system:String x:Key="Polis.Ui.TakeSuggestion">Give to Athena</system:String>
    <system:String x:Key="Polis.Ui.OracleTitle">Daily oracle</system:String>
    <system:String x:Key="Polis.Ui.OracleNone">Set up a daily oracle at the temple: every morning Athena reviews what changed in this city and the herald brings you the brief. Setting it up needs your nod in the approval window.</system:String>
    <system:String x:Key="Polis.Ui.RequestOracle">Ask Athena to set it up</system:String>
    <system:String x:Key="Polis.Ui.LatestScroll">Read the latest</system:String>
    <system:String x:Key="Polis.Ui.ResidentTitle">{name} the {trade}</system:String>
    <system:String x:Key="Polis.Ui.Chart">Sea chart</system:String>
    <system:String x:Key="Polis.Ui.ChartTitle">Chart of the islands</system:String>
    <system:String x:Key="Polis.Ui.ChartHint">Each island is a city. Click one to sail to its latest commission.</system:String>
    <system:String x:Key="Polis.Ui.ChartRunning">A commission is running</system:String>
    <system:String x:Key="Polis.Ui.ChartWaiting">Waiting for your nod</system:String>
    <system:String x:Key="Polis.Ui.ChartHere">You are here</system:String>
    <system:String x:Key="Polis.Ui.ChartMissing">Folder missing</system:String>
    <!-- Citizens are conversations (M-B, 2026-10-13): one citizen per conversation. Name lists, the epithet pattern, their own lines, greetings and small talk ("|" separates variants; small talk is an "A says|B answers" pair) -->
    <system:String x:Key="Polis.Ui.InteractCitizen">Talk to {name}</system:String>
    <system:String x:Key="Polis.Ui.CensusLine">{total} people live in this city; {street} are out by day</system:String>
    <!-- 问话（M-C，2026-10-13）：居民卡片上的问话、对话栏借给居民时的字，以及没拿到回答时他说的那一句 -->
    <system:String x:Key="Polis.Ui.InteractTalkWaiting">Talk to Athena (she has words waiting for you)</system:String>
    <system:String x:Key="Polis.Ui.SpeakName">You</system:String>
    <system:String x:Key="Polis.Ui.SpeakIdle">Say something; whoever is near will hear</system:String>
    <system:String x:Key="Polis.Ui.SpeakAthenaBusy">Athena is at work. To talk to her, walk up to her and press E</system:String>
    <system:String x:Key="Polis.Ui.SpeakPlaceholder">Say something…</system:String>
    <system:String x:Key="Polis.Ui.SpeakSend">Say</system:String>
    <system:String x:Key="Polis.Ui.SpeakHint">Enter to say · whoever is near may answer · to talk to Athena, walk up to her and press E</system:String>
    <system:String x:Key="Polis.Ui.SpeakCommandSoon">("/" commands are on their way)</system:String>
    <system:String x:Key="Polis.Ui.SpeakMentionSoon">("@" mentions are on their way)</system:String>
    <system:String x:Key="Polis.Ui.AthenaHasWords">I have some words written for you. Come and find me.</system:String>
    <system:String x:Key="Polis.Ui.CitizenChat">Chat a little</system:String>
    <system:String x:Key="Polis.Ui.ChatStatus">Chatting with {name}</system:String>
    <system:String x:Key="Polis.Ui.ChatPlaceholder">Say something to {name}…</system:String>
    <system:String x:Key="Polis.Ui.ChatWaiting">{name} is thinking…</system:String>
    <system:String x:Key="Polis.Ui.ChatSend">Say</system:String>
    <system:String x:Key="Polis.Ui.ChatHint">Enter to say · Esc to take leave</system:String>
    <system:String x:Key="Polis.Ui.AskTimeout">They thought about it, but nothing came.</system:String>
    <system:String x:Key="Polis.Ui.AthenaName">Athena</system:String>
    <system:String x:Key="Polis.Ui.CitizenInfoTrade">{trade} · {age} · {temper}</system:String>
    <system:String x:Key="Polis.Ui.CitizenInfoHome">Lives in "{home}"</system:String>
    <system:String x:Key="Polis.Ui.CitizenInfoStall">Keeps the "{home}" stall at the market</system:String>
    <system:String x:Key="Polis.Ui.CitizenInfoCottage">Lives in a cottage on the edge of town ({home})</system:String>
    <system:String x:Key="Polis.Ui.CitizenInfoNightOwl">Often out at night too</system:String>
    <system:String x:Key="Polis.Ui.AgeYoung">young</system:String>
    <system:String x:Key="Polis.Ui.AgeAdult">in their prime</system:String>
    <system:String x:Key="Polis.Ui.AgeOld">older</system:String>
    <system:String x:Key="Polis.Citizen.Ask.NoModel">To ask me, pick a model for the "Virtual pet and citizens" or "Title generation" role in Settings.</system:String>
    <system:String x:Key="Polis.Citizen.Ask.Busy">I am still thinking about the last question.</system:String>
    <system:String x:Key="Polis.Citizen.Ask.Limited">That is enough questions for this hour. Come back in a while.</system:String>
    <system:String x:Key="Polis.Citizen.Ask.Failed">I thought about it, but nothing came.</system:String>
    <!-- 辩论（M-E，2026-10-13）：讲台的卡片、对话栏借给辩论时的字、顶上的辩论牌，以及 C# 替人说的那几句 -->
    <system:String x:Key="Polis.Ui.InteractBema">Debate at the platform</system:String>
    <system:String x:Key="Polis.Ui.BemaTitle">The speaker's platform</system:String>
    <system:String x:Key="Polis.Ui.BemaBody">Propose a motion: you argue for it, Athena against, three rounds; the citizens in the street are the jury.</system:String>
    <system:String x:Key="Polis.Ui.BemaRecord">You: {wins} won, {losses} lost, {ties} tied</system:String>
    <system:String x:Key="Polis.Ui.BemaPropose">Propose a motion</system:String>
    <system:String x:Key="Polis.Ui.DebateName">Debate</system:String>
    <system:String x:Key="Polis.Ui.DebateMotionStatus">You argue for it, Athena against</system:String>
    <system:String x:Key="Polis.Ui.DebateMotionPlaceholder">Propose a motion… (say: weekends should be work-free)</system:String>
    <system:String x:Key="Polis.Ui.DebateArguePlaceholder">Round {round} of {rounds}: make your point…</system:String>
    <system:String x:Key="Polis.Ui.DebateArgueStatus">Motion: {motion}</system:String>
    <system:String x:Key="Polis.Ui.DebateSend">Speak</system:String>
    <system:String x:Key="Polis.Ui.DebateHint">Enter speaks · Esc ends the debate</system:String>
    <system:String x:Key="Polis.Ui.DebateAthenaThinking">Athena is thinking of her rebuttal…</system:String>
    <system:String x:Key="Polis.Ui.DebateJudging">The jury is deliberating…</system:String>
    <system:String x:Key="Polis.Ui.DebateRound">Round {round} of {rounds}</system:String>
    <system:String x:Key="Polis.Ui.DebateYou">You</system:String>
    <system:String x:Key="Polis.Ui.DebateAthena">Athena</system:String>
    <system:String x:Key="Polis.Ui.DebateVotes">The jury: {you} for, {athena} against</system:String>
    <system:String x:Key="Polis.Ui.DebateYouWin">You won</system:String>
    <system:String x:Key="Polis.Ui.DebateAthenaWins">Athena won</system:String>
    <system:String x:Key="Polis.Ui.DebateTie">A tie</system:String>
    <system:String x:Key="Polis.Ui.DebateClose">Done</system:String>
    <system:String x:Key="Polis.Debate.Limited">That is enough debating for this hour. Rest a while and come back.</system:String>
    <system:String x:Key="Polis.Debate.AthenaNoModel">(Athena cannot speak: no model is set for the main conversation in Settings. She gives you this round.)</system:String>
    <system:String x:Key="Polis.Debate.AthenaFailed">(Athena thinks it over and gives you this round.)</system:String>
    <system:String x:Key="Polis.Debate.JudgeNoModel">The jury has no spokesperson: pick a model for "Virtual pet and citizens" or "Title generation" in Settings. A tie.</system:String>
    <system:String x:Key="Polis.Debate.NoVerdict">The jury could not reach a verdict. A tie.</system:String>
    <!-- 户与民居（M-D，2026-10-13）：户名与新立一户时雅典娜说的那一句 -->
    <system:String x:Key="Polis.Household.NamePattern">The {0} household</system:String>
    <system:String x:Key="Polis.Ui.HouseholdFounded">{name} has moved into a cottage on the edge of town.</system:String>
    <!-- 第三轮（需求 3，敲门）：门里的人怎么应（本地的话，按关系分组）、门板上的面板与对话栏 -->
    <system:String x:Key="Polis.Ui.InteractKnock">Knock at {name}</system:String>
    <system:String x:Key="Polis.Ui.KnockSound">Knock, knock</system:String>
    <system:String x:Key="Polis.Ui.DoorNobody">(Nobody answers.)</system:String>
    <system:String x:Key="Polis.Ui.DoorWho">Who is it?|Who's knocking?|Coming, coming.</system:String>
    <system:String x:Key="Polis.Ui.DoorPestered">Stop knocking!|Again? I heard you!</system:String>
    <system:String x:Key="Polis.Ui.DoorTitle">The door of {name}</system:String>
    <system:String x:Key="Polis.Ui.DoorPickHint">Someone is in. Who do you want?</system:String>
    <system:String x:Key="Polis.Ui.DoorPick">Ask for them</system:String>
    <system:String x:Key="Polis.Ui.DoorCall">Ask them out</system:String>
    <system:String x:Key="Polis.Ui.DoorTalk">Talk through the door</system:String>
    <system:String x:Key="Polis.Ui.DoorLeave">Never mind</system:String>
    <system:String x:Key="Polis.Ui.DoorAnswerWarm">Oh, it's you! What is it?|Ah, it's you - one moment.|You came by?</system:String>
    <system:String x:Key="Polis.Ui.DoorAnswerPlain">What is it?|Yes?|I'm here.</system:String>
    <system:String x:Key="Polis.Ui.DoorAnswerCool">...Yes?|Hm? What is it.</system:String>
    <system:String x:Key="Polis.Ui.DoorAnswerHostile">You again. Well?|What do you want?</system:String>
    <system:String x:Key="Polis.Ui.DoorComing">All right, I'm coming out.|One moment, coming.</system:String>
    <system:String x:Key="Polis.Ui.DoorRefuseCool">No, I'm busy.|Another day.</system:String>
    <system:String x:Key="Polis.Ui.DoorRefuseHostile">I'm not coming out. Go away.|I'd rather not.</system:String>
    <system:String x:Key="Polis.Ui.DoorChatStatus">Talking with {name} through the door</system:String>
    <system:String x:Key="Polis.Ui.DoorChatPlaceholder">Say it through the door to {name}...</system:String>
    <system:String x:Key="Polis.Ui.DoorChatWaiting">{name} is thinking behind the door...</system:String>
    <system:String x:Key="Polis.Ui.RelationsWhyTwo">Because {a}, and {b}</system:String>
    <!-- 第三轮（人物关系，2026-10-13）：左上角的「人际」总览 -->
    <system:String x:Key="Polis.Ui.RelationsButton">People</system:String>
    <system:String x:Key="Polis.Ui.RelationsTitle">Who's who in the city</system:String>
    <system:String x:Key="Polis.Ui.RelationsToYou">How they see you</system:String>
    <system:String x:Key="Polis.Ui.RelationsPick">Pick someone to see why they feel that way about you, and who they get on with.</system:String>
    <system:String x:Key="Polis.Ui.RelationsEmpty">Nobody lives in this city yet.</system:String>
    <system:String x:Key="Polis.Ui.RelationsFriends">Gets on with</system:String>
    <system:String x:Key="Polis.Ui.RelationsRivals">Doesn't get on with</system:String>
    <system:String x:Key="Polis.Ui.RelationsNone">(nobody)</system:String>
    <system:String x:Key="Polis.Ui.RelationsWhy">Because {why}</system:String>
    <system:String x:Key="Polis.Ui.RelationsResidents">Townsfolk with a trade</system:String>
    <system:String x:Key="Polis.Ui.RelationsCitizens">Citizens</system:String>
    <system:String x:Key="Polis.Ui.RelationsIndoors">indoors</system:String>
    <system:String x:Key="Polis.Ui.BandClose">Close</system:String>
    <system:String x:Key="Polis.Ui.BandFriendly">Friendly</system:String>
    <system:String x:Key="Polis.Ui.BandNeutral">Neutral</system:String>
    <system:String x:Key="Polis.Ui.BandCool">Cool</system:String>
    <system:String x:Key="Polis.Ui.BandHostile">Hostile</system:String>
    <system:String x:Key="Polis.Ui.RelationsAthena">Thinks of Athena: {band}</system:String>
    <system:String x:Key="Polis.Ui.RegardClose">reveres her</system:String>
    <system:String x:Key="Polis.Ui.RegardFriendly">respects her</system:String>
    <system:String x:Key="Polis.Ui.RegardNeutral">lukewarm</system:String>
    <system:String x:Key="Polis.Ui.RegardCool">grudging</system:String>
    <system:String x:Key="Polis.Ui.RegardHostile">resents her</system:String>
    <system:String x:Key="Polis.Ui.WhyWarm">warm by nature</system:String>
    <system:String x:Key="Polis.Ui.WhyPrickly">hard to please by nature</system:String>
    <system:String x:Key="Polis.Ui.WhyNature">that is how they treat people</system:String>
    <system:String x:Key="Polis.Ui.WhyChats">you often stop to talk</system:String>
    <system:String x:Key="Polis.Ui.WhyAnnoyed">you have bothered them</system:String>
    <system:String x:Key="Polis.Ui.WhyBusy">you keep their street busy</system:String>
    <system:String x:Key="Polis.Ui.WhyNeglected">you have neglected their street</system:String>
    <system:String x:Key="Polis.Ui.WhyIdle">out of work and sour about it</system:String>
    <system:String x:Key="Polis.Ui.WhyPious">pious</system:String>
    <system:String x:Key="Polis.Ui.WhyDoubting">doubts the gods</system:String>
    <system:String x:Key="Polis.Ui.WhyReverent">reverent by nature</system:String>
    <system:String x:Key="Polis.Ui.WhyDefiant">defiant by nature</system:String>
    <system:String x:Key="Polis.Ui.WhyTrade">what their trade thinks</system:String>
    <system:String x:Key="Polis.Ui.WhyAge">their age</system:String>
    <system:String x:Key="Polis.Citizen.NamesMale">Demetrios|Ariston|Kriton|Phaidros|Lysis|Charmides|Euthyphron|Menon|Theaitetos|Xenophon|Hermon|Philon|Alkibiades|Agathon|Aischines|Anaxagoras|Antiphon|Apollodoros|Archelaos|Archytas|Aristeides|Aristarchos|Aristippos|Charondas|Chairephon|Damon|Demosthenes|Diodotos|Diogenes|Dion|Empedokles|Epikouros|Eratosthenes|Eukleides|Eudoxos|Euripides|Glaukon|Gorgias|Hekataios|Herakleitos|Hermogenes|Hippias|Hippokrates|Iktinos|Isokrates|Kallias|Kallikles|Kebes|Kimon|Kleisthenes|Kleon|Kritias|Ktesippos|Laches|Leon|Lykourgos|Lysandros|Lysias|Melanthios|Meletos|Menexenos|Miltiades|Myron|Nikias|Nikomachos|Pausanias|Perikles|Phaidon|Pheidias|Philolaos|Phokion|Pindaros|Polemarchos|Polykleitos|Praxiteles|Prodikos|Protagoras|Pyrrhon|Simmias|Simonides|Solon|Sophokles|Speusippos|Stesichoros|Thales|Themistokles|Theodoros|Theophrastos|Thoukydides|Thrasyboulos|Thrasymachos|Timaios|Timon|Xanthippos|Zenon|Zeuxis|Androkles|Kallimachos|Eumenes|Nikandros|Philippos|Stephanos|Theagenes|Hieron|Polykrates|Leonidas|Kleomenes|Brasidas|Phormion|Konon|Iphikrates|Chabrias|Timotheos|Epameinondas|Pelopidas|Archimedes|Aristoxenos|Euphranor|Apelles|Parrhasios</system:String>
    <system:String x:Key="Polis.Citizen.NamesFemale">Phyllis|Daphne|Kleio|Helena|Eirene|Thais|Diotima|Aspasia|Melissa|Charis|Korinna|Myrto|Agariste|Agnodike|Alkestis|Andromache|Antigone|Anyte|Ariadne|Arete|Arsinoe|Axiothea|Berenike|Chloe|Chrysis|Damo|Deianeira|Elektra|Elpinike|Erinna|Euadne|Eudokia|Eunike|Euphrosyne|Eurydike|Glykera|Harmonia|Hermione|Hipparchia|Hypatia|Iokaste|Ismene|Kallisto|Kassandra|Kleoboulina|Kleopatra|Kydippe|Lais|Lampito|Leda|Lysistrata|Megara|Melinna|Merope|Metrodora|Moero|Myrrhine|Nausikaa|Neaira|Nikarete|Nossis|Olympias|Pantheia|Penelope|Periktione|Phaidra|Philinna|Phryne|Praxilla|Rhodope|Sappho|Telesilla|Theano|Theodote|Timarete|Xanthippe|Zoe|Agathe|Alkmene|Amaryllis|Anthousa|Archippe|Atalante|Chariklo|Demo|Dorkas|Euboule|Eukleia|Galene|Gorgo|Hero|Iole|Kallirhoe|Kleito|Kore|Lysandra|Melite|Mnesarete|Nikaia|Niobe|Oinone|Pamphile|Philainis|Phila|Polyxena|Rhode|Stratonike|Thaleia|Theophania|Thessale|Timandra|Xenia|Aglaia|Antiope|Ianthe|Kalliope|Lysippe|Melpomene|Ourania|Philomela</system:String>
    <system:String x:Key="Polis.Citizen.NameNth">{0} ({1})</system:String>
    <system:String x:Key="Polis.Citizen.Greet">Hello there.|Good day.|We meet again.|Fine weather today.|Out for a walk too?</system:String>
    <!-- 第三轮（人物关系）：喜欢你的人打招呼说热络的；冷淡、厌恶的人不说话 -->
    <system:String x:Key="Polis.Citizen.GreetWarm">Oh, it's you! You look well today.|Ah, there you are!|So good to see you.|Come, sit a while!|I was just thinking of you.</system:String>
    <system:String x:Key="Polis.Citizen.Market.HawkBread">Bread fresh from the oven, still warm!|Barley cakes, wheat loaves, we have them all!|Sesame rings just baked, try one?</system:String>
    <system:String x:Key="Polis.Citizen.Market.HawkPottery">Fine pots, hear them ring!|Oil flasks, water jars, wine cups, all from my own kiln!|Look at this glaze, you won't find its like in town!</system:String>
    <system:String x:Key="Polis.Citizen.Market.HawkCloth">Fine wool cloth, soft and thick!|Look at this pattern, a whole month on the loom!|A new robe for the festival?</system:String>
    <system:String x:Key="Polis.Citizen.Market.HawkSandals">Sturdy sandals, they'll last you to Sparta!|Made to your foot, a perfect fit!|Freshly tanned leather, smell that!</system:String>
    <system:String x:Key="Polis.Citizen.Market.HawkGrain">Fresh flour, fine as snow!|Barley and wheat by the measure!|Straight from the mill, you can smell the grain!</system:String>
    <system:String x:Key="Polis.Citizen.Market.HawkWood">Wooden bowls and spoons, light and tough!|A sturdy stool to last a lifetime!|Carved from olive wood, look at the grain!</system:String>
    <system:String x:Key="Polis.Citizen.Market.HawkGoods">A bit of everything, come and look!|Lamps, baskets, needles and thread!|Goods from far away, only a few left!</system:String>
    <system:String x:Key="Polis.Citizen.Market.HawkOil">First-press olive oil, smell it!|Good wine, just right with water!|Oil and wine, by the jar or by the ladle!</system:String>
    <system:String x:Key="Polis.Citizen.Market.HawkProduce">Fresh figs, sweet as honey!|Grapes, olives, cabbages, picked this morning!|Ripe pomegranates, red as fire!</system:String>
    <system:String x:Key="Polis.Citizen.Market.HawkFish">Fish landed this morning, fresh as can be!|Sardines and tuna, cheap today!|Buy fish early, it's gone by noon!</system:String>
    <system:String x:Key="Polis.Citizen.Market.Pitch">Pick it up, have a look.|This is today's best batch.|You have a good eye, that one sells fastest.</system:String>
    <system:String x:Key="Polis.Citizen.Market.Ask">How much is this?|What do you want for this?|How much for all of these?</system:String>
    <system:String x:Key="Polis.Citizen.Market.Price">Two obols.|Three obols, no haggling.|One drachma and it's yours.|For you, one obol.</system:String>
    <system:String x:Key="Polis.Citizen.Market.Haggle">Can you do a little less?|That's too much, come down a bit.|I'm a regular, give me a better price.</system:String>
    <system:String x:Key="Polis.Citizen.Market.Concede">All right, all right, call it friendship.|Fine, you mean it, it's yours for less.</system:String>
    <system:String x:Key="Polis.Citizen.Market.Refuse">That's already my lowest.|I can't go lower, it wouldn't cover my costs.</system:String>
    <system:String x:Key="Polis.Citizen.Market.Thanks">There you go, take care!|Thank you, come again!|Come back when you need more!</system:String>
    <system:String x:Key="Polis.Citizen.Market.Bought">Thanks!|Just what I wanted.|They'll love this at home.</system:String>
    <system:String x:Key="Polis.Citizen.Market.Pass">I'll look around a bit more.|Maybe next time.|No, it's not quite right.</system:String>
    <system:String x:Key="Polis.Public.PaintedStoa">Painted Stoa</system:String>
    <system:String x:Key="Polis.Public.Archive">Archive</system:String>
    <system:String x:Key="Polis.Public.Vault">Vault</system:String>
    <system:String x:Key="Polis.Public.Grove">Olive grove</system:String>
    <system:String x:Key="Polis.Resident.Surveyor.Name">Surveyor</system:String>
    <system:String x:Key="Polis.Resident.Surveyor.GreekName">Anaximandros</system:String>
    <system:String x:Key="Polis.Resident.Surveyor.Intro">I have measured every building in this city: which is largest, which nobody has entered for ages, what each one holds. Just ask.|When Athena needs to find something, she often asks me first which quarter it is in.</system:String>
    <system:String x:Key="Polis.Resident.Surveyor.Persona">You keep the city's map and inventories: how large and how old every building (each of the owner's folders) is, and what it holds. You are meticulous, like to speak in numbers and directions, and still fret over the one time you measured wrong.</system:String>
    <system:String x:Key="Polis.Resident.Scribe.Name">Scribe</system:String>
    <system:String x:Key="Polis.Resident.Scribe.GreekName">Kadmos</system:String>
    <system:String x:Key="Polis.Resident.Scribe.Intro">I copy and draft in the archive: reports, notes, letters, lists. Athena dictates, I write.|Don't throw away a half-written page; bring it here and I'll smooth it out.</system:String>
    <system:String x:Key="Polis.Resident.Scribe.Persona">You are the archive's scribe, drafting and copying the city's documents, reports and letters for Athena. You are young, diligent and a bit bookish, and cannot help correcting a badly chosen word.</system:String>
    <system:String x:Key="Polis.Resident.Accountant.Name">Accountant</system:String>
    <system:String x:Key="Polis.Resident.Accountant.GreekName">Pasion</system:String>
    <system:String x:Key="Polis.Resident.Accountant.Intro">Every ledger in the vault is mine: what came in, what went out, which cell does not add up. I see it at a glance.|With figures, one coin off is still off.</system:String>
    <system:String x:Key="Polis.Resident.Accountant.Persona">You keep the accounts in the vault; every ledger, table and figure in the city passes through your hands. You are old, careful with money, speak slowly, and cannot stand accounts that do not balance.</system:String>
    <system:String x:Key="Polis.Resident.Smith.Name">Smith</system:String>
    <system:String x:Key="Polis.Resident.Smith.GreekName">Hephaistion</system:String>
    <system:String x:Key="Polis.Resident.Smith.Intro">The forge is where the heavy work gets done: hundreds of things to go through one by one. Leave it to me, one blow at a time.|Before the blows that really count I stop and ask; what's broken can't be unbroken.</system:String>
    <system:String x:Key="Polis.Resident.Smith.Persona">You work the forge; the city's heavy, repetitive work is done there. You are loud, blunt and quick, hate dawdling, but always double-check before a blow that matters.</system:String>
    <system:String x:Key="Polis.Resident.Sailor.Name">Sailor</system:String>
    <system:String x:Key="Polis.Resident.Sailor.GreekName">Nearchos</system:String>
    <system:String x:Key="Polis.Resident.Sailor.Intro">When the boat leaves harbour it goes to gather news from abroad: tidings, other people's prices, papers to bring home. I'll fetch them.|The sea is unpredictable; know what you want to learn before you send me.</system:String>
    <system:String x:Key="Polis.Resident.Sailor.Persona">You are the harbour's sailor; the boat sails out on schedule to gather news and bring back papers from afar. You are cheerful, love telling sea stories, embellish as you go, and light up when talking about storms.</system:String>
    <system:String x:Key="Polis.Resident.Librarian.Name">Librarian</system:String>
    <system:String x:Key="Polis.Resident.Librarian.GreekName">Zenodotos</system:String>
    <system:String x:Key="Polis.Resident.Librarian.Intro">The round library keeps this city's memory: the owner's preferences and the things that matter, written down once so they need not be said again.|Want to know what is kept here? Ask me. What was recorded wrong can be corrected.</system:String>
    <system:String x:Key="Polis.Resident.Librarian.Persona">You keep the round library, which holds the city's memory: its owner's preferences and the important things they said. You are old, gentle, with a superb memory; you like to quote and you speak softly.</system:String>
    <system:String x:Key="Polis.Resident.Herald.Name">Herald</system:String>
    <system:String x:Key="Polis.Resident.Herald.GreekName">Talthybios</system:String>
    <system:String x:Key="Polis.Resident.Herald.Intro">I stand on the platform: when someone proposes a motion I preside over the debate, and when a scheduled errand comes due, I announce its result.|What you missed while away, I announce when you return.</system:String>
    <system:String x:Key="Polis.Resident.Herald.Persona">You are the herald: you stand on the agora's platform, preside over debates and announce the results of scheduled errands on the hour. You have a ringing voice, care about decorum and like solemn openings.</system:String>
    <system:String x:Key="Polis.Resident.Painter.Name">Painter</system:String>
    <system:String x:Key="Polis.Resident.Painter.GreekName">Kalypso</system:String>
    <system:String x:Key="Polis.Resident.Painter.Intro">Every painting in the painted stoa is mine: illustrations, diagrams, covers. Tell me what and in what mood, and I'll paint it.|Colour changes with where the light comes from. Have you noticed?</system:String>
    <system:String x:Key="Polis.Resident.Painter.Persona">You are the painter of the painted stoa; the city's illustrations, diagrams and covers are yours. You are sensitive, always watching light and colour, speak in images and can be a little absorbed in yourself.</system:String>
    <system:String x:Key="Polis.Resident.Artisan.Name">Artisan</system:String>
    <system:String x:Key="Polis.Resident.Artisan.GreekName">Daidalos</system:String>
    <system:String x:Key="Polis.Resident.Artisan.Intro">I carve stone and make tools and devices by the forge; when crafts and tools from outside the city need fitting in, I do it.|I can adjust the house rules (settings) too, and I ask before touching anything important.</system:String>
    <system:String x:Key="Polis.Resident.Artisan.Persona">You are the artisan by the forge: you carve stone, build tools and devices, fit crafts and tools from outside into the city and adjust its rules. You are deft, quiet and always pondering how to make things finer.</system:String>
    <system:String x:Key="Polis.Resident.Priestess.Name">Priestess</system:String>
    <system:String x:Key="Polis.Resident.Priestess.GreekName">Themistokleia</system:String>
    <system:String x:Key="Polis.Resident.Priestess.Intro">Each morning the temple gives an oracle: Athena looks over the city's changes for its owner and writes a morning scroll.|Want another hour or other contents? Tell Athena and the oracle will follow.</system:String>
    <system:String x:Key="Polis.Resident.Priestess.Persona">You are the temple's priestess; you tend the temple and preside over each morning's oracle (the morning scroll Athena writes for the city's owner). You are solemn and calm, a little mysterious, fond of omens and metaphors.</system:String>
    <system:String x:Key="Polis.Board.ResumeCommission">“{0}” stopped halfway last time — continue it?</system:String>
    <system:String x:Key="Polis.Board.ResumeCommission.Prompt">“{0}” stopped halfway last time. Please finish it.</system:String>
    <system:String x:Key="Polis.Board.FindLostItem">{0} can’t be found — look for where it went?</system:String>
    <system:String x:Key="Polis.Board.FindLostItem.Prompt">{0}, delivered earlier, can’t be found. Please look through this workspace in case it was moved or renamed.</system:String>
    <system:String x:Key="Polis.Board.TidyAgora">{1} loose files lie in the agora — sort them into folders?</system:String>
    <system:String x:Key="Polis.Board.TidyAgora.Prompt">There are {1} loose files at the root of this workspace. List them and suggest how to group them by purpose; move nothing until I confirm.</system:String>
    <system:String x:Key="Polis.Board.SortMixedBuilding">“{0}” holds {1} mixed things — sort them?</system:String>
    <system:String x:Key="Polis.Board.SortMixedBuilding.Prompt">“{0}” holds {1} mixed files. Look at what’s there and propose a way to sort them; change nothing until I confirm.</system:String>
    <system:String x:Key="Polis.Board.ReviewStaleBuilding">“{0}” hasn’t been touched in {2} days — take stock of it?</system:String>
    <system:String x:Key="Polis.Board.ReviewStaleBuilding.Prompt">“{0}” hasn’t been touched in {2} days. Take stock of its {1} files — which are still useful and which could be archived — as a list.</system:String>
    <system:String x:Key="Polis.Board.CatalogImages">Catalogue the {1} images in “{0}”?</system:String>
    <system:String x:Key="Polis.Board.CatalogImages.Prompt">Make a catalogue of the {1} images in “{0}”: group them by subject, one line each, as a Markdown file in “{0}”.</system:String>
    <system:String x:Key="Polis.Board.SummarizeSheets">Summarise the {1} spreadsheets in “{0}”?</system:String>
    <system:String x:Key="Polis.Board.SummarizeSheets.Prompt">Summarise the {1} spreadsheets in “{0}”: what each is and its key numbers, on one page.</system:String>
    <system:String x:Key="Polis.Board.SummarizeDocuments">One-line summaries for the {1} documents in “{0}”?</system:String>
    <system:String x:Key="Polis.Board.SummarizeDocuments.Prompt">Write a one-line summary of each of the {1} documents in “{0}”, collected into one list.</system:String>
    <system:String x:Key="Polis.Board.DescribeWorkshop">Write a guide to “{0}”?</system:String>
    <system:String x:Key="Polis.Board.DescribeWorkshop.Prompt">Look at what’s in “{0}” and write a guide: what it’s for, where the main parts are, and how to get started.</system:String>
    <system:String x:Key="Polis.Board.InspectArchives">See what’s inside the {1} archives in “{0}”?</system:String>
    <system:String x:Key="Polis.Board.InspectArchives.Prompt">Look at what each of the {1} archives in “{0}” contains (don’t extract them anywhere) and list it for me.</system:String>
    <system:String x:Key="Polis.Board.RecapBusyBuilding">“{0}” changed the most lately — recap it?</system:String>
    <system:String x:Key="Polis.Board.RecapBusyBuilding.Prompt">“{0}” has changed the most in the last couple of days. Summarise what changed and what is still unfinished.</system:String>
    <system:String x:Key="Polis.Board.SetOracle">Set up a daily oracle at the temple</system:String>
    <system:String x:Key="Polis.Board.SetOracle.Prompt">Set up a daily oracle at the temple</system:String>
    <system:String x:Key="Polis.Board.PlanEmptyCity">This city is still empty — plan a few folders first?</system:String>
    <system:String x:Key="Polis.Board.PlanEmptyCity.Prompt">This workspace is still empty. Ask me what I plan to use it for, then suggest a folder structure; create nothing until I confirm.</system:String>
    <system:String x:Key="Polis.Board.AskAnything">Ask me anything, directly</system:String>
    <system:String x:Key="Polis.Board.AskAnything.Prompt">I’d like your help with: </system:String>
    <system:String x:Key="Polis.Board.RememberPreference">Let me remember your preferences</system:String>
    <system:String x:Key="Polis.Board.RememberPreference.Prompt">Please remember my preference: (write down what you want her to do from now on)</system:String>
    <system:String x:Key="Polis.Oracle.Set">Daily oracle set · {0} · next brief: {1}</system:String>
    <system:String x:Key="Polis.Oracle.Paused">The daily oracle is paused (re-enable it on the scheduled tasks page)</system:String>
    <system:String x:Key="Polis.Oracle.Request">Please use the scheduled task tool (create_task) to set up a “Daily Oracle” for this workspace: run every morning at 08:00 (cron: 0 8 * * *), name it “Daily Oracle”, workspaceId {1}. The task: review what changed in the workspace “{0}” over the last day and write me a short morning brief — what is new, what deserves attention, what I could start with today.</system:String>
    <system:String x:Key="Polis.Oracle.RequestGlobal">Please use the scheduled task tool (create_task) to set up a “Daily Oracle”: run every morning at 08:00 (cron: 0 8 * * *), name it “Daily Oracle”, and leave workspaceId empty. The task: give me a short morning brief each day — what deserves attention today and what I could start with.</system:String>
    <system:String x:Key="Polis.Oracle.ItemTitle">Daily oracle · {0}</system:String>
    <system:String x:Key="GameMode.Herald.CronSucceeded">Scheduled task “{0}” finished — click to see the result</system:String>
    <system:String x:Key="GameMode.Herald.CronFailed">Scheduled task “{0}” failed: {1}</system:String>
    <system:String x:Key="GameMode.Herald.CronSkipped">Scheduled task “{0}” was skipped: the app was closed when it was due</system:String>
    <system:String x:Key="GameMode.Herald.CronInterrupted">Scheduled task “{0}” was interrupted halfway</system:String>
    <system:String x:Key="GameMode.Herald.OracleScroll">The daily oracle sent a scroll; it is waiting for you in the agora</system:String>
    <system:String x:Key="GameMode.Herald.CommissionInterrupted">“{0}” stopped halfway last time — click to continue</system:String>
    <system:String x:Key="GameMode.Notice.VenueFull">The {0} is full; {1} is kept in storage for now</system:String>
