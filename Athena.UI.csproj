<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\Athena.ico</ApplicationIcon>

    <!-- macOS 打包配置 -->
    <CFBundleName>Athena</CFBundleName>
    <CFBundleDisplayName>Athena</CFBundleDisplayName>
    <CFBundleIdentifier>com.athena.ai</CFBundleIdentifier>
    <CFBundleVersion>$(Version)</CFBundleVersion>
    <CFBundleShortVersionString>$(Version)</CFBundleShortVersionString>
    <CFBundleIconFile>Athena.icns</CFBundleIconFile>
    <NSHighResolutionCapable>true</NSHighResolutionCapable>
    <CFBundleExecutable>Athena.UI</CFBundleExecutable>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Converters\" />
    <AvaloniaXaml Remove="**\*.axaml" />
    <AvaloniaXaml Remove="**\*.paml" />
    <AvaloniaXaml Include="**/*.axaml" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" SubType="Designer" />
    <Compile Update="**/*.axaml.cs">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
    <None Remove="**/*.axaml" />
    <AvaloniaResource Include="Assets/**" />
    <Compile Remove="Athena.Archive.Tests/**/*.cs" />
    <Compile Remove="Athena.Updater/**/*.cs" />
    <Compile Remove="**/obj/**/*.cs" />
  </ItemGroup>

  <!-- AthenaSoul.md 作为嵌入式资源 -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\AthenaSoul.md">
      <LogicalName>AthenaSoul.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets/Athena.ico" />
  </ItemGroup>

  <!-- 编译时将 AthenaSoul.md 复制到输出目录的 AthenaData/KnowledgeBase -->
  <Target Name="CopyAthenaSoulToKnowledgeBase" AfterTargets="Build">
    <PropertyGroup>
      <AthenaDataPath>$(TargetDir)AthenaData/KnowledgeBase</AthenaDataPath>
    </PropertyGroup>
    <MakeDir Directories="$(AthenaDataPath)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Assets/AthenaSoul.md" DestinationFiles="$(AthenaDataPath)/AthenaSoul.md" SkipUnchangedFiles="true" />
    <Message Text="AthenaSoul.md copied to $(AthenaDataPath)" Importance="high" />
  </Target>

  <ItemGroup>
    <!-- Avalonia UI -->
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />

    <PackageReference Include="CliWrap" Version="3.10.2" />

    <!-- MVVM -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" Version="2.0.1" />

    <!-- OpenAI SDK -->
    <PackageReference Include="OpenAI" Version="2.11.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />
    <PackageReference Include="SkiaSharp" Version="4.150.0-preview.1.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.150.0-preview.1.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.150.0-preview.1.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.150.0-preview.1.1" />

    <!-- 配置和依赖注入 -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0-preview.5.26302.115" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0-preview.5.26302.115" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.5.26302.115" />
    <PackageReference Include="Semi.Avalonia" Version="12.0.3" />

    <!-- Serilog 日志 -->
    <PackageReference Include="Serilog" Version="4.4.0-dev-02437" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="8.0.0-nblumhardt-02322" />

    <!-- MCP (Model Context Protocol) 客户端 -->
    <PackageReference Include="ModelContextProtocol" Version="0.4.0-preview.2" />

    <!-- SQLite -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0-preview.5.26302.115" />

    <!-- 向量计算 -->
    <PackageReference Include="System.Numerics.Tensors" Version="11.0.0-preview.5.26302.115" />
  </ItemGroup>

  <!-- Markdown 渲染 - 仅桌面端支持 -->
  <ItemGroup>
    <PackageReference Include="LiveMarkdown.Avalonia" Version="2.1.1" />
    <PackageReference Include="LiveMarkdown.Avalonia.Math" Version="2.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
  </ItemGroup>
</Project>
