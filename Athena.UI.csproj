<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\Athena.ico</ApplicationIcon>
    
    <!-- macOS 打包配置 -->
    <CFBundleName>Athena</CFBundleName>
    <CFBundleDisplayName>Athena</CFBundleDisplayName>
    <CFBundleIdentifier>com.athena.ai</CFBundleIdentifier>
    <CFBundleVersion>1.0.0</CFBundleVersion>
    <CFBundleShortVersionString>1.0.0</CFBundleShortVersionString>
    <CFBundleIconFile>Athena.icns</CFBundleIconFile>
    <NSHighResolutionCapable>true</NSHighResolutionCapable>
    <CFBundleExecutable>Athena.UI</CFBundleExecutable>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- AthenaSoul.md 作为嵌入式资源 -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\AthenaSoul.md">
      <LogicalName>AthenaSoul.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Athena.ico" />
  </ItemGroup>

  <!-- 编译时将 AthenaSoul.md 复制到输出目录的 AthenaData/KnowledgeBase -->
  <Target Name="CopyAthenaSoulToKnowledgeBase" AfterTargets="Build">
    <PropertyGroup>
      <AthenaDataPath>$(TargetDir)AthenaData\KnowledgeBase</AthenaDataPath>
    </PropertyGroup>
    <MakeDir Directories="$(AthenaDataPath)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Assets\AthenaSoul.md" DestinationFiles="$(AthenaDataPath)\AthenaSoul.md" SkipUnchangedFiles="true" />
    <Message Text="AthenaSoul.md copied to $(AthenaDataPath)" Importance="high" />
  </Target>

  <ItemGroup>
    <!-- Avalonia UI -->
    <PackageReference Include="Avalonia" Version="12.0.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.1" />

    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.14">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CliWrap" Version="3.10.1" />

    <!-- MVVM -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" Version="2.0.0-rc1" />

    <!-- OpenAI SDK -->
    <PackageReference Include="OpenAI" Version="2.10.0" />

    <!-- 配置和依赖注入 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.3.26207.106" />
    <PackageReference Include="Semi.Avalonia" Version="12.0.0" />

    <!-- Serilog 日志 -->
    <PackageReference Include="Serilog" Version="4.3.2-dev-02419" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="8.0.0-nblumhardt-02322" />

    <!-- SQLite -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0-preview.3.26207.106" />

    <!-- 向量计算 -->
    <PackageReference Include="System.Numerics.Tensors" Version="11.0.0-preview.3.26207.106" />
  </ItemGroup>

  <!-- Markdown 渲染 - 仅桌面端支持 -->
  <ItemGroup>
    <PackageReference Include="LiveMarkdown.Avalonia" Version="2.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.1" />
  </ItemGroup>
</Project>
