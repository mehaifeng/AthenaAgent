<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\Athena.ico</ApplicationIcon>
    
    <!-- macOS 打包配置 -->
    <CFBundleName>Athena</CFBundleName>
    <CFBundleDisplayName>Athena</CFBundleDisplayName>
    <CFBundleIdentifier>com.athena.ai</CFBundleIdentifier>
    <CFBundleVersion>1.0.0</CFBundleVersion>
    <CFBundleShortVersionString>1.0.0</CFBundleShortVersionString>
    <CFBundleIconFile>Athena.icns</CFBundleIconFile>
    <NSHighResolutionCapable>true</NSHighResolutionCapable>
    <CFBundleExecutable>Athena.UI</CFBundleExecutable>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Converters\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- AthenaSoul.md 作为嵌入式资源 -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\AthenaSoul.md">
      <LogicalName>AthenaSoul.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Athena.ico" />
  </ItemGroup>

  <!-- 编译时将 AthenaSoul.md 复制到输出目录的 AthenaData/KnowledgeBase -->
  <Target Name="CopyAthenaSoulToKnowledgeBase" AfterTargets="Build">
    <PropertyGroup>
      <AthenaDataPath>$(TargetDir)AthenaData\KnowledgeBase</AthenaDataPath>
    </PropertyGroup>
    <MakeDir Directories="$(AthenaDataPath)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Assets\AthenaSoul.md" DestinationFiles="$(AthenaDataPath)\AthenaSoul.md" SkipUnchangedFiles="true" />
    <Message Text="AthenaSoul.md copied to $(AthenaDataPath)" Importance="high" />
  </Target>

  <ItemGroup>
    <!-- Avalonia UI -->
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />

    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.11">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CliWrap" Version="3.10.0" />

    <!-- MVVM -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" Version="1.15.0" />

    <!-- OpenAI SDK -->
    <PackageReference Include="OpenAI" Version="2.1.0" />

    <!-- 配置和依赖注入 -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Semi.Avalonia" Version="11.3.7.3" />

    <!-- Serilog 日志 -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />

    <!-- SQLite -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />

    <!-- 向量计算 -->
    <PackageReference Include="System.Numerics.Tensors" Version="9.0.0" />
  </ItemGroup>

  <!-- Markdown 渲染 - 仅桌面端支持 -->
  <ItemGroup>
    <PackageReference Include="LiveMarkdown.Avalonia" Version="1.9.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
  </ItemGroup>
</Project>
