<Project Sdk="Microsoft.NET.Sdk">
  <!-- 游戏模式 M0 的导出入口：把一个真实文件夹扫描成城邦快照、把一段真实会话转成回放事件，写成网页原型读的夹具。
       开发期工具，不随应用发布。逻辑全在 ../Polis 的纯函数里（Athena.Archive.Tests 同样逐文件链接它们）。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Athena.GameMode.PolisExport</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 与 Athena.UI / Athena.Archive.Tests 同一个版本：不引入新包 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0-preview.6.26359.118" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Polis/*.cs" Link="Polis/%(Filename)%(Extension)" />
    <Compile Include="../../../Services/GeneratedDirectories.cs" Link="Source/Services/GeneratedDirectories.cs" />
  </ItemGroup>
</Project>
