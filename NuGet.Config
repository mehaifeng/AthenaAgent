<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Repository-local prototype feed. Generate it with Libraries/Ptc/scripts/build-local-feed.sh. -->
  <packageSources>
    <clear />
    <add key="ptc-local" value="artifacts/ptc/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="ptc-local"><package pattern="AthenaAgent.Ptc.*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
