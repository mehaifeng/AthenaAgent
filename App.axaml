<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Athena.UI.App"
             xmlns:local="using:Athena.UI"
             xmlns:loc="using:Athena.UI.Markup"
             xmlns:conv="using:Athena.UI.Converters"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:u-semi="https://irihi.tech/ursa/themes/semi"
             xmlns:lmd="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/Athena.ico" 
                      ToolTipText="Athena"
                      Clicked="TrayIcon_OnClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="open" Click="MenuShow_OnClick" />
                        <NativeMenuItem Header="quit" Click="MenuQuit_OnClick" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Athena.UI/Styles/Icons.axaml" />
                <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- 主题字典定义 -->
            <ResourceDictionary.ThemeDictionaries>
                <!-- 语义化颜色定义：深色模式 -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="App.SectionBg" Color="#232324" />
                    <SolidColorBrush x:Key="Chat.UserBubbleBg" Color="#1C2438" />
                    <SolidColorBrush x:Key="Chat.AssistantBubbleBg" Color="#2E2E30" />
                    <SolidColorBrush x:Key="Chat.TimestampFg" Color="#7F7F7F" />
                    <SolidColorBrush x:Key="Chat.ArchivedFg" Color="#FFD33D" />
                    <SolidColorBrush x:Key="Markdown.HeadingFg" Color="#FFFFFF" />
                </ResourceDictionary>
                <!-- 语义化颜色 definition：浅色模式 -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="App.SectionBg" Color="#F6F6F6" />
                    <SolidColorBrush x:Key="Chat.UserBubbleBg" Color="#E8F2FF" />
                    <SolidColorBrush x:Key="Chat.AssistantBubbleBg" Color="#F2F3F5" />
                    <SolidColorBrush x:Key="Chat.TimestampFg" Color="#86909C" />
                    <SolidColorBrush x:Key="Chat.ArchivedFg" Color="#D29E00" />
                    <SolidColorBrush x:Key="Markdown.HeadingFg" Color="#1F1F1F" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 转换器 -->
            <conv:BoolToAlignmentConverter x:Key="BoolToAlignmentConverter"/>
            <conv:IntToColumnConverter x:Key="IntToColumnConverter"/>
            <conv:RoleToBrushConverter x:Key="RoleToBrushConverter"/>
            <conv:RoleToBgConverter x:Key="RoleToBgConverter"/>
            <conv:RoleToTitleConverter x:Key="RoleToTitleConverter"/>
            <conv:LocConverter x:Key="LocConverter"/>
            <conv:OpacityConverter x:Key="OpacityConverter"/>
            <conv:ThemeTagToVisibilityConverter x:Key="ThemeTagToVisibilityConverter"/>

            <!-- 字体设置 -->
            <FontFamily x:Key="MainFontFamily">Inter, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, Helvetica Neue, Microsoft YaHei, sans-serif</FontFamily>
            <FontFamily x:Key="MonospaceFontFamily">Cascadia Code, Consolas, Monaco, Menlo, Courier New, Courier, Monospace</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">Inter, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, Helvetica Neue, Microsoft YaHei, sans-serif</FontFamily>

            <!-- 字号设置 -->
            <x:Double x:Key="TitleFontSize">18</x:Double>
            <x:Double x:Key="BodyFontSize">14</x:Double>
            <x:Double x:Key="SmallFontSize">12</x:Double>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <semi:SemiTheme Locale="zh-CN" />
        <semi:UrsaSemiTheme Locale="zh-CN"/>
        <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml"/>

        <!-- 全局样式：使 TabItem 标题稍微大一点 -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- 旋转动画 -->
        <Style Selector="PathIcon.SlowSpin">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Application.Styles>
</Application>