<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Athena.UI.App"
             xmlns:local="using:Athena.UI"
             xmlns:conv="using:Athena.UI.Converters"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Converters -->
        <conv:BoolToAlignmentConverter x:Key="BoolToAlignmentConverter"/>
        <conv:IntToColumnConverter x:Key="IntToColumnConverter"/>
        <conv:RoleToBrushConverter x:Key="RoleToBrushConverter"/>
        <conv:RoleToBgConverter x:Key="RoleToBgConverter"/>
        <conv:RoleToTitleConverter x:Key="RoleToTitleConverter"/>
        <conv:RoleToTextBrushConverter x:Key="RoleToTextBrushConverter"/>
        <conv:LocConverter x:Key="LocConverter"/>

        <!-- 字体定义 -->
        <FontFamily x:Key="MonospaceFontFamily">Consolas, Monaco, Menlo, Courier New, Courier, Monospace</FontFamily>
        <FontFamily x:Key="ContentControlThemeFontFamily">Consolas, Monaco, Menlo, Courier New, Courier, Monospace</FontFamily>

        <!-- 字号定义 -->
        <x:Double x:Key="TitleFontSize">16</x:Double>
        <x:Double x:Key="BodyFontSize">14</x:Double>
        <x:Double x:Key="SmallFontSize">12</x:Double>

        <!-- DOS 主题颜色 - 深色模式（默认） -->
        <SolidColorBrush x:Key="Brush.Black" Color="#000000"/>
        <SolidColorBrush x:Key="Brush.BrightGreen" Color="#00FF00"/>
        <SolidColorBrush x:Key="Brush.Green" Color="#00AA00"/>
        <SolidColorBrush x:Key="Brush.Yellow" Color="#FFFF00"/>
        <SolidColorBrush x:Key="Brush.Red" Color="#FF0000"/>
        <SolidColorBrush x:Key="Brush.DeepGreen" Color="#003300"/>
        <SolidColorBrush x:Key="Brush.MidGreen" Color="#006600"/>
    </Application.Resources>

    <Application.Styles>
        <!-- Simple 主题作为基础 -->
        <SimpleTheme/>

        <!-- DOS 复古风格控件样式 -->
        <StyleInclude Source="avares://Athena.UI/Styles/DosControls.axaml"/>
    </Application.Styles>
</Application>
