<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Application icon contract.
        Keep UI code bound to AthenaIcon* and App.Icon* keys rather than to a
        vendor icon name or a hard-coded colour.  Most geometries intentionally
        alias the existing Semi vector set; the few product-specific concepts
        live alongside them below.
    -->
    <StaticResource x:Key="AthenaIconModelProvider" ResourceKey="SemiIconServer"/>
    <StaticResource x:Key="AthenaIconKnowledgeBase" ResourceKey="SemiIconBook"/>
    <StaticResource x:Key="AthenaIconScheduledMessages" ResourceKey="SemiIconCalendarClock"/>
    <StaticResource x:Key="AthenaIconSkillsConnectors" ResourceKey="SemiIconPuzzle"/>
    <StaticResource x:Key="AthenaIconSearch" ResourceKey="SemiIconSearch"/>
    <StaticResource x:Key="AthenaIconNewConversation" ResourceKey="SemiIconPlusCircle"/>
    <StaticResource x:Key="AthenaIconEdit" ResourceKey="SemiIconEdit"/>
    <StaticResource x:Key="AthenaIconPin" ResourceKey="SemiIconBookmark"/>
    <StaticResource x:Key="AthenaIconBranch" ResourceKey="SemiIconBranch"/>
    <StaticResource x:Key="AthenaIconStop" ResourceKey="SemiIconStop"/>
    <StaticResource x:Key="AthenaIconDelete" ResourceKey="SemiIconDelete"/>
    <StaticResource x:Key="AthenaIconConfirm" ResourceKey="SemiIconTick"/>
    <StaticResource x:Key="AthenaIconActivity" ResourceKey="SemiIconActivity"/>
    <StaticResource x:Key="AthenaIconPause" ResourceKey="SemiIconPause"/>
    <StaticResource x:Key="AthenaIconRefresh" ResourceKey="SemiIconRefresh"/>
    <StaticResource x:Key="AthenaIconDetails" ResourceKey="SemiIconExternalOpen"/>
    <StaticResource x:Key="AthenaIconSettings" ResourceKey="SemiIconSetting"/>
    <StaticResource x:Key="AthenaIconPreview" ResourceKey="SemiIconEyeOpened"/>
    <StaticResource x:Key="AthenaIconSave" ResourceKey="SemiIconSave"/>
    <StaticResource x:Key="AthenaIconCancel" ResourceKey="SemiIconUndo"/>
    <StaticResource x:Key="AthenaIconClose" ResourceKey="SemiIconClose"/>
    <StaticResource x:Key="AthenaIconOpenFile" ResourceKey="SemiIconFile"/>
    <StaticResource x:Key="AthenaIconCopy" ResourceKey="SemiIconCopy"/>

