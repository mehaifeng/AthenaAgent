    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="App.IconForeground" Color="#F2F2F2"/>
            <SolidColorBrush x:Key="App.IconMutedForeground" Color="#A8A8A8"/>
            <SolidColorBrush x:Key="App.IconAccentForeground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="App.IconDangerForeground" Color="#FF8C8C"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="App.IconForeground" Color="#202020"/>
            <SolidColorBrush x:Key="App.IconMutedForeground" Color="#6B6B6B"/>
            <SolidColorBrush x:Key="App.IconAccentForeground" Color="#111111"/>
            <SolidColorBrush x:Key="App.IconDangerForeground" Color="#C92A2A"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
