        M226.653 91.852c-9.435 0-17.507 9.725-20.734 14.219-.953 1.336-.953 3.134 0 4.473 3.227 4.502 11.3 14.236 20.734 14.236 9.438 0 17.507-9.734 20.722-14.236.97-1.339.97-3.137 0-4.473-3.215-4.495-11.284-14.219-20.722-14.219Z
        M147.592 91.845c-9.439 0-17.509 9.731-20.723 14.226-.971 1.336-.971 3.134 0 4.473 3.214 4.502 11.283 14.242 20.723 14.242 9.438 0 17.518-9.74 20.732-14.242.974-1.339.974-3.137 0-4.473-3.214-4.505-11.294-14.226-20.732-14.226Z
