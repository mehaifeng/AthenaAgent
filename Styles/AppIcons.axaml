<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Application icon contract.

        Views and view models bind to AthenaIcon* / App.Icon* keys only — never to a vendor
        icon name.  The geometries come from CoreUI Icons (Styles/CoreIcons.axaml, generated
        by Scripts/generate-coreui-icons.py); swapping vendors again means rewriting the
        aliases below and nothing else.

        Naming rule: the key states what the icon *means* here, not what it depicts.  Two
        concepts that happen to share a glyph today still get one alias each, so they can
        diverge later without touching call sites.
    -->

    <!-- Window chrome -->
    <StaticResource x:Key="AthenaIconClose" ResourceKey="CoreIconX"/>
    <StaticResource x:Key="AthenaIconWindowMinimize" ResourceKey="CoreIconWindowMinimize"/>
    <StaticResource x:Key="AthenaIconWindowMaximize" ResourceKey="CoreIconWindowMaximize"/>
    <StaticResource x:Key="AthenaIconWindowRestore" ResourceKey="CoreIconWindowRestore"/>
    <StaticResource x:Key="AthenaIconThemeDark" ResourceKey="CoreIconMoon"/>
    <StaticResource x:Key="AthenaIconThemeLight" ResourceKey="CoreIconSun"/>
    <StaticResource x:Key="AthenaIconSettings" ResourceKey="CoreIconSettings"/>
    <StaticResource x:Key="AthenaIconOverflowMenu" ResourceKey="CoreIconOptions"/>
    <StaticResource x:Key="AthenaIconLayoutSwap" ResourceKey="CoreIconSidebar"/>

    <!-- Feature launchers and navigation -->
    <StaticResource x:Key="AthenaIconModelProvider" ResourceKey="CoreIconStorage"/>
    <StaticResource x:Key="AthenaIconKnowledgeBase" ResourceKey="CoreIconBook"/>
    <StaticResource x:Key="AthenaIconScheduledMessages" ResourceKey="CoreIconCalendarCheck"/>
    <StaticResource x:Key="AthenaIconSkillsConnectors" ResourceKey="CoreIconPuzzle"/>
    <StaticResource x:Key="AthenaIconSkills" ResourceKey="CoreIconEducation"/>
    <StaticResource x:Key="AthenaIconConnectors" ResourceKey="CoreIconLinkAlt"/>
    <StaticResource x:Key="AthenaIconSpeech" ResourceKey="CoreIconVolumeHigh"/>
    <StaticResource x:Key="AthenaIconImageGeneration" ResourceKey="CoreIconImage"/>
    <StaticResource x:Key="AthenaIconWebSearch" ResourceKey="CoreIconMagnifyingGlass"/>
    <StaticResource x:Key="AthenaIconDocumentParsing" ResourceKey="CoreIconFindInPage"/>
    <StaticResource x:Key="AthenaIconConversationSettings" ResourceKey="CoreIconCommentSquare"/>
    <StaticResource x:Key="AthenaIconToolApproval" ResourceKey="CoreIconShieldAlt"/>
    <StaticResource x:Key="AthenaIconAgentRuntime" ResourceKey="CoreIconGroup"/>
    <StaticResource x:Key="AthenaIconDiagnostics" ResourceKey="CoreIconSpeedometer"/>
    <StaticResource x:Key="AthenaIconAbout" ResourceKey="CoreIconInfo"/>
    <StaticResource x:Key="AthenaIconLogs" ResourceKey="CoreIconListRich"/>
    <StaticResource x:Key="AthenaIconTerminal" ResourceKey="CoreIconTerminal"/>
    <StaticResource x:Key="AthenaIconDetails" ResourceKey="CoreIconExternalLink"/>
    <StaticResource x:Key="AthenaIconSearch" ResourceKey="CoreIconMagnifyingGlass"/>
    <StaticResource x:Key="AthenaIconGithub" ResourceKey="CoreIconGithub"/>
    <StaticResource x:Key="AthenaIconUpdate" ResourceKey="CoreIconSync"/>

    <!-- Workspace tree and conversation sessions -->
    <StaticResource x:Key="AthenaIconWorkspace" ResourceKey="CoreIconFolder"/>
    <StaticResource x:Key="AthenaIconWorkspaceAdd" ResourceKey="CoreIconFolderAdd"/>
    <StaticResource x:Key="AthenaIconWorkspaceUnfiled" ResourceKey="CoreIconInbox"/>
    <StaticResource x:Key="AthenaIconConversation" ResourceKey="CoreIconChatBubble"/>
    <StaticResource x:Key="AthenaIconConversationAdd" ResourceKey="CoreIconConversationAdd"/>
    <StaticResource x:Key="AthenaIconPin" ResourceKey="CoreIconPin"/>
    <StaticResource x:Key="AthenaIconBranch" ResourceKey="CoreIconFork"/>
    <StaticResource x:Key="AthenaIconExport" ResourceKey="CoreIconShareBoxed"/>
    <StaticResource x:Key="AthenaIconRewind" ResourceKey="CoreIconActionUndo"/>
    <StaticResource x:Key="AthenaIconReasoning" ResourceKey="CoreIconLightbulb"/>
    <StaticResource x:Key="AthenaIconSend" ResourceKey="CoreIconSend"/>
    <StaticResource x:Key="AthenaIconScreenshot" ResourceKey="CoreIconCamera"/>
    <StaticResource x:Key="AthenaIconArchive" ResourceKey="CoreIconInbox"/>
    <StaticResource x:Key="AthenaIconContextInspector" ResourceKey="CoreIconDescription"/>
    <StaticResource x:Key="AthenaIconDocument" ResourceKey="CoreIconDescription"/>

    <!-- Status -->
    <StaticResource x:Key="AthenaIconLoading" ResourceKey="CoreIconLoopCircular"/>
    <StaticResource x:Key="AthenaIconSuccess" ResourceKey="CoreIconCheckCircle"/>
    <StaticResource x:Key="AthenaIconFailure" ResourceKey="CoreIconXCircle"/>
    <StaticResource x:Key="AthenaIconWarning" ResourceKey="CoreIconWarning"/>
    <StaticResource x:Key="AthenaIconInfo" ResourceKey="CoreIconInfo"/>
    <StaticResource x:Key="AthenaIconConfirm" ResourceKey="CoreIconCheckAlt"/>

    <!-- Media playback -->
    <StaticResource x:Key="AthenaIconPlay" ResourceKey="CoreIconMediaPlay"/>
    <StaticResource x:Key="AthenaIconStop" ResourceKey="CoreIconMediaStop"/>

    <!-- Commands -->
    <StaticResource x:Key="AthenaIconAdd" ResourceKey="CoreIconPlus"/>
    <StaticResource x:Key="AthenaIconRemove" ResourceKey="CoreIconMinus"/>
    <StaticResource x:Key="AthenaIconEdit" ResourceKey="CoreIconPencil"/>
    <StaticResource x:Key="AthenaIconDelete" ResourceKey="CoreIconTrash"/>
    <StaticResource x:Key="AthenaIconCopy" ResourceKey="CoreIconCopy"/>
    <StaticResource x:Key="AthenaIconSave" ResourceKey="CoreIconSave"/>
    <StaticResource x:Key="AthenaIconRefresh" ResourceKey="CoreIconReload"/>
    <StaticResource x:Key="AthenaIconCancel" ResourceKey="CoreIconActionUndo"/>
    <StaticResource x:Key="AthenaIconPreview" ResourceKey="CoreIconDescription"/>
    <StaticResource x:Key="AthenaIconOpenFile" ResourceKey="CoreIconFile"/>
    <StaticResource x:Key="AthenaIconFolderReveal" ResourceKey="CoreIconFolderOpen"/>
    <StaticResource x:Key="AthenaIconImport" ResourceKey="CoreIconCloudUpload"/>
    <StaticResource x:Key="AthenaIconDownload" ResourceKey="CoreIconCloudDownload"/>
    <StaticResource x:Key="AthenaIconGenerate" ResourceKey="CoreIconBolt"/>
    <StaticResource x:Key="AthenaIconBlocked" ResourceKey="CoreIconBan"/>
    <StaticResource x:Key="AthenaIconChevronDown" ResourceKey="CoreIconChevronBottom"/>
    <StaticResource x:Key="AthenaIconChevronRight" ResourceKey="CoreIconChevronRight"/>
    <StaticResource x:Key="AthenaIconChevronUp" ResourceKey="CoreIconChevronTop"/>

    <!-- Tool-call categories (ToolCallDisplay.IconKey) -->
    <StaticResource x:Key="AthenaIconToolGeneric" ResourceKey="CoreIconSettings"/>
    <StaticResource x:Key="AthenaIconMemoryRecall" ResourceKey="CoreIconHistory"/>
    <StaticResource x:Key="AthenaIconBrowserTask" ResourceKey="CoreIconGlobeAlt"/>
    <StaticResource x:Key="AthenaIconTaskList" ResourceKey="CoreIconList"/>
    <StaticResource x:Key="AthenaIconTaskCreate" ResourceKey="CoreIconAlarm"/>
    <StaticResource x:Key="AthenaIconSubAgents" ResourceKey="CoreIconGroup"/>
    <StaticResource x:Key="AthenaIconDirectory" ResourceKey="CoreIconFolder"/>

    <!-- Workspace file-tree types (WorkspaceFileNodeViewModel.IconKey) -->
    <StaticResource x:Key="AthenaIconFolder" ResourceKey="CoreIconFolder"/>
    <StaticResource x:Key="AthenaIconFolderOpen" ResourceKey="CoreIconFolderOpen"/>
    <StaticResource x:Key="AthenaIconFileGeneric" ResourceKey="CoreIconFile"/>
    <StaticResource x:Key="AthenaIconFileCode" ResourceKey="CoreIconCode"/>
    <StaticResource x:Key="AthenaIconFileText" ResourceKey="CoreIconShortText"/>
    <StaticResource x:Key="AthenaIconFileDocument" ResourceKey="CoreIconDescription"/>
    <StaticResource x:Key="AthenaIconFileSpreadsheet" ResourceKey="CoreIconSpreadsheet"/>
    <StaticResource x:Key="AthenaIconFilePresentation" ResourceKey="CoreIconScreenDesktop"/>
    <StaticResource x:Key="AthenaIconFileImage" ResourceKey="CoreIconImage"/>
    <StaticResource x:Key="AthenaIconFileVideo" ResourceKey="CoreIconMovie"/>
    <StaticResource x:Key="AthenaIconFileAudio" ResourceKey="CoreIconMusicNote"/>
    <StaticResource x:Key="AthenaIconFileArchive" ResourceKey="CoreIconLayers"/>
    <StaticResource x:Key="AthenaIconFileBinary" ResourceKey="CoreIconMemory"/>
    <StaticResource x:Key="AthenaIconFileScript" ResourceKey="CoreIconTerminal"/>
    <StaticResource x:Key="AthenaIconFileConfig" ResourceKey="CoreIconSettings"/>
    <StaticResource x:Key="AthenaIconFileDatabase" ResourceKey="CoreIconStorage"/>
    <StaticResource x:Key="AthenaIconFileFont" ResourceKey="CoreIconFont"/>
    <StaticResource x:Key="AthenaIconFileSecret" ResourceKey="CoreIconLockLocked"/>
    <StaticResource x:Key="AthenaIconFileVcs" ResourceKey="CoreIconFork"/>
    <StaticResource x:Key="AthenaIconFileWeb" ResourceKey="CoreIconGlobeAlt"/>

    <!--
        Product-specific artwork.  The owl is Athena's own mark for the parallel sub-agent
        village and has no CoreUI equivalent, so it stays hand-authored here.
    -->
    <StreamGeometry x:Key="AthenaIconSubAgentsOwl">
        M114.216 431.529l-61.571 13.089c-13.208 2.81-21.645 15.787-18.829 28.995 2.438 11.492 12.591 19.37 23.874 19.37 1.69 0 3.409-.174 5.11-.541l117.686-25.027-50.783-27.92c-5.312-2.324-10.458-5.053-15.487-7.966Z
        M459.167 383.165c-2.805-13.208-15.9-21.659-28.981-18.828l-76.122 16.187 1.578 49.643 84.697-18.008c13.206-2.806 21.644-15.786 18.828-28.994Z
