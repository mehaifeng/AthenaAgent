<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      悬停 / 按下的覆盖层画笔。三支必须同色、只差 Opacity——这是
      AvaloniaUI/Avalonia#15419 的解法本身：BrushTransition 走直通 alpha 插值，
      两端同色才不可能在中途串出别的颜色。Faded 是"透明"的正确写法，
      用同色零透明度，而不是 Transparent（那是 #00FFFFFF，从它过渡到深色
      覆盖层会经过半透明白，深色主题下肉眼就是闪一下）。

      为什么放在独立的合并字典而不是 App.axaml 的 ThemeDictionaries 里：
      App.SetColorScheme 是整本替换 —— `app.Resources.ThemeDictionaries[Dark] = dark;`
      —— 所以只写在 App.axaml 主题字典里的键，一旦用户切到 Solarized / Cyberpunk /
      Tokyo / Monokai 就会整个消失（那 8 个方案文件之所以是 136 行的全量拷贝，正是这个原因）。
      合并字典不在替换范围内，所以这里定义一次就对所有配色、所有窗口生效。

      这些值只依赖明暗变体，不依赖配色方案，也不依赖面板材质——
      所以它们是静态资源，不该由 ApplyShellPanelMaterial 在运行时构造。

      App.PanelVeilBrush 是个例外，它在这里出现的身份是**兜底**：真正生效的那支由
      ApplyShellPanelMaterial 用当前面板底色重建、写在窗口作用域，会盖住这一支。
      之所以还要兜一层，是因为窗口级资源只在 MainWindow 里存在——任何别的宿主
      （设计器、无头用例里自建的 Window）解析不到它时，DynamicResource 不会报错，
      只会让 Background 保持 null，于是幕布变成一块完全透明的空板：挡不住任何东西，
      而且不抛不报。这正是规则 1 说的静默失败，所以它必须有一支永远解析得到的底。

      App.VeilSkeletonBrush 比 HoverOverlay 略重：悬停覆盖层的本分是"几乎看不见"，
      而骨架条的本分是"一眼看出这里将来会有内容"，两者不该共用一个数。
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="App.HoverOverlayFaded" Color="White" Opacity="0" />
            <SolidColorBrush x:Key="App.HoverOverlay" Color="White" Opacity="0.08" />
            <SolidColorBrush x:Key="App.PressOverlay" Color="White" Opacity="0.15" />
            <SolidColorBrush x:Key="App.PanelVeilBrush" Color="#16161A" />
            <SolidColorBrush x:Key="App.VeilSkeletonBrush" Color="White" Opacity="0.07" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="App.HoverOverlayFaded" Color="Black" Opacity="0" />
            <SolidColorBrush x:Key="App.HoverOverlay" Color="Black" Opacity="0.06" />
            <SolidColorBrush x:Key="App.PressOverlay" Color="Black" Opacity="0.11" />
            <SolidColorBrush x:Key="App.PanelVeilBrush" Color="#F5F6F8" />
            <SolidColorBrush x:Key="App.VeilSkeletonBrush" Color="Black" Opacity="0.07" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
