<SolidColorBrush x:Key="History.PendingMetaForeground" Color="#E0B96A" />
<SolidColorBrush x:Key="History.PendingStatusForeground" Color="#FFD27A" />
<SolidColorBrush x:Key="History.PendingSeparatorBrush" Color="#66E0AF68" />
<SolidColorBrush x:Key="Chat.UserBubbleBg" Color="#FF1F2335" />
<SolidColorBrush x:Key="Chat.AssistantBubbleBg" Color="#FF1F2335" />
<SolidColorBrush x:Key="Chat.TimestampFg" Color="#7F7F7F" />
<SolidColorBrush x:Key="Chat.ArchivedFg" Color="#FFD33D" />
<SolidColorBrush x:Key="Chat.LoadingDotBrush" Color="#FFFFFF" />
<SolidColorBrush x:Key="CodeBlock.ToolButtonForeground" Color="#D9D9DB" />
<SolidColorBrush x:Key="CodeBlock.ToolButtonBackground" Color="#00FFFFFF" />
<SolidColorBrush x:Key="CodeBlock.ToolButtonBorderBrush" Color="#00FFFFFF" />
<SolidColorBrush x:Key="CodeBlock.ToolButtonPointeroverBackground" Color="#14FFFFFF" />
<SolidColorBrush x:Key="CodeBlock.ToolButtonPressedBackground" Color="#20FFFFFF" />
<SolidColorBrush x:Key="CodeBlock.ToolButtonCheckedBackground" Color="#18FFFFFF" />
<SolidColorBrush x:Key="CodeBlock.ToolButtonCheckedPointeroverBackground" Color="#24FFFFFF" />
<SolidColorBrush x:Key="CodeBlock.ToolButtonCheckedPressedBackground" Color="#2EFFFFFF" />
<SolidColorBrush x:Key="CodeBlock.ToolButtonCheckedBorderBrush" Color="#33FFFFFF" />
<SolidColorBrush x:Key="Markdown.HeadingFg" Color="#FFFFFF" />
<Color x:Key="BorderColor">#3DFFFFFF</Color>
<Color x:Key="ForegroundColor">#FFFFFF</Color>
<Color x:Key="CardBackgroundColor">#18FFFFFF</Color>
<Color x:Key="SecondaryCardBackgroundColor">#22FFFFFF</Color>
<Color x:Key="CodeInlineColor">#F2C96D</Color>
<Color x:Key="QuoteBorderColor">#D7BA7D</Color>
    <!-- 方案专属 Semi 核心键覆盖 -->
    <SolidColorBrush x:Key="SemiColorBackground0" Color="#FF16161E" />
<SolidColorBrush x:Key="SemiColorBackground1" Color="#FF1A1B26" />
<SolidColorBrush x:Key="SemiColorBackground2" Color="#FF1F2335" />
<SolidColorBrush x:Key="SemiColorBackground3" Color="#FF24283B" />
<SolidColorBrush x:Key="SemiColorBackground4" Color="#FF292E42" />
</ResourceDictionary>
