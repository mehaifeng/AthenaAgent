<SolidColorBrush x:Key="App.SectionBg" Color="#FF1A1B26" />
<!-- 低对比度分隔边框：视图中 79 处引用，内置字典补齐后与配色方案行为一致 -->
<SolidColorBrush x:Key="SemiGreyLowBrush" Color="#FF1F2335" />
<SolidColorBrush x:Key="AvaloniaTerminalColor0" Color="#FF16161E" />
<SolidColorBrush x:Key="AvaloniaTerminalColor7" Color="#FFFFFF" />
<SolidColorBrush x:Key="AvaloniaTerminalColor15" Color="#FFFFFF" />
<SolidColorBrush x:Key="AvaloniaTerminalCaretBrush" Color="#FFFFFF" />
<SolidColorBrush x:Key="AvaloniaTerminalSelectionBrush" Color="#4060A0FF" />
<SolidColorBrush x:Key="App.WorkspaceLeftBackground" Color="#FF16161E" />
<SolidColorBrush x:Key="App.WorkspaceRightBackground" Color="#FF1A1B26" />
<SolidColorBrush x:Key="History.PendingCardBackground" Color="#FF312617" />
<SolidColorBrush x:Key="History.PendingCardPointeroverBackground" Color="#FF3C2F1C" />
<SolidColorBrush x:Key="History.PendingCardSelectedBackground" Color="#FF43341F" />
<SolidColorBrush x:Key="History.PendingCardBorderBrush" Color="#FFE0AF68" />
<SolidColorBrush x:Key="History.PendingCardSelectedBorderBrush" Color="#FFEED3AC" />
