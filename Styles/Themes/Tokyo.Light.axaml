<StaticResource x:Key="RadioButtonUncheckIconPressedBorderBrush" ResourceKey="App.EmphasisActiveForeground" />
<StaticResource x:Key="RadioButtonCheckIconDefaultBackground" ResourceKey="App.EmphasisForeground" />
<StaticResource x:Key="RadioButtonCheckIconPointeroverBackground" ResourceKey="App.EmphasisPointeroverForeground" />
<StaticResource x:Key="RadioButtonCheckIconPressedBackground" ResourceKey="App.EmphasisActiveForeground" />
<StaticResource x:Key="RadioButtonCheckIconDisabledBackground" ResourceKey="App.EmphasisDisabledForeground" />
<StaticResource x:Key="RadioButtonCheckIconDefaultBorderBrush" ResourceKey="App.EmphasisForeground" />
<StaticResource x:Key="RadioButtonCheckIconPointeroverBorderBrush" ResourceKey="App.EmphasisPointeroverForeground" />
<StaticResource x:Key="RadioButtonCheckIconPressedBorderBrush" ResourceKey="App.EmphasisActiveForeground" />
<StaticResource x:Key="RadioButtonCheckIconDisabledBorderBrush" ResourceKey="App.EmphasisDisabledForeground" />
<StaticResource x:Key="RadioButtonCheckGlyphFill" ResourceKey="App.InverseForeground" />
<StaticResource x:Key="RadioButtonButtonCheckedForeground" ResourceKey="App.EmphasisForeground" />
<StaticResource x:Key="RadioButtonCardCheckedBackground" ResourceKey="App.SelectedBackground" />
<StaticResource x:Key="RadioButtonCardCheckDefaultBorderBrush" ResourceKey="App.EmphasisForeground" />
<StaticResource x:Key="RadioButtonCardCheckPointeroverBorderBrush" ResourceKey="App.EmphasisPointeroverForeground" />
<StaticResource x:Key="RadioButtonCardCheckPressedBorderBrush" ResourceKey="App.EmphasisActiveForeground" />
