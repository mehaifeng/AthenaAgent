<StaticResource x:Key="ToggleSwitchContainerCheckedPointeroverBackground" ResourceKey="App.ToggleCheckedPointeroverBackground" />
<StaticResource x:Key="ToggleSwitchContainerCheckedPressedBackground" ResourceKey="App.ToggleCheckedPressedBackground" />
<StaticResource x:Key="ToggleSwitchContainerCheckedDisabledBackground" ResourceKey="App.EmphasisDisabledForeground" />
<StaticResource x:Key="SimpleToggleSwitchContainerCheckedForeground" ResourceKey="App.InverseForeground" />
<SolidColorBrush x:Key="App.SectionBg" Color="#FFD5D6DB" />
<!-- 低对比度分隔边框：视图中 79 处引用，内置字典补齐后与配色方案行为一致 -->
<SolidColorBrush x:Key="SemiGreyLowBrush" Color="#FFE1E2E7" />
<SolidColorBrush x:Key="AvaloniaTerminalColor0" Color="#FFCBCCD1" />
<SolidColorBrush x:Key="AvaloniaTerminalColor7" Color="#000000" />
<SolidColorBrush x:Key="AvaloniaTerminalColor15" Color="#000000" />
<SolidColorBrush x:Key="AvaloniaTerminalCaretBrush" Color="#000000" />
<SolidColorBrush x:Key="AvaloniaTerminalSelectionBrush" Color="#4060A0FF" />
<SolidColorBrush x:Key="App.WorkspaceLeftBackground" Color="#FFCBCCD1" />
<SolidColorBrush x:Key="App.WorkspaceRightBackground" Color="#FFD5D6DB" />
<SolidColorBrush x:Key="History.PendingCardBackground" Color="#FFFCF7F0" />
<SolidColorBrush x:Key="History.PendingCardPointeroverBackground" Color="#FFFAF2E7" />
<SolidColorBrush x:Key="History.PendingCardSelectedBackground" Color="#FFF8EDDE" />
<SolidColorBrush x:Key="History.PendingCardBorderBrush" Color="#FFF6E7D2" />
<SolidColorBrush x:Key="History.PendingCardSelectedBorderBrush" Color="#FFB89055" />
<SolidColorBrush x:Key="History.PendingTitleForeground" Color="#6E4916" />
<SolidColorBrush x:Key="History.PendingMetaForeground" Color="#9B6A22" />
<SolidColorBrush x:Key="History.PendingStatusForeground" Color="#8C5A12" />
<SolidColorBrush x:Key="History.PendingSeparatorBrush" Color="#66F6E7D2" />
<SolidColorBrush x:Key="Chat.UserBubbleBg" Color="#FFD5D6DB" />
<SolidColorBrush x:Key="Chat.AssistantBubbleBg" Color="#FFD5D6DB" />
<SolidColorBrush x:Key="Chat.TimestampFg" Color="#86909C" />
<SolidColorBrush x:Key="Chat.ArchivedFg" Color="#D29E00" />
<SolidColorBrush x:Key="Chat.LoadingDotBrush" Color="#111111" />
<SolidColorBrush x:Key="CodeBlock.ToolButtonForeground" Color="#5C6068" />
<SolidColorBrush x:Key="CodeBlock.ToolButtonBackground" Color="#00000000" />
<SolidColorBrush x:Key="CodeBlock.ToolButtonBorderBrush" Color="#00000000" />
<SolidColorBrush x:Key="CodeBlock.ToolButtonPointeroverBackground" Color="#12000000" />
<SolidColorBrush x:Key="CodeBlock.ToolButtonPressedBackground" Color="#1B000000" />
<SolidColorBrush x:Key="CodeBlock.ToolButtonCheckedBackground" Color="#14000000" />
<SolidColorBrush x:Key="CodeBlock.ToolButtonCheckedPointeroverBackground" Color="#1B000000" />
<SolidColorBrush x:Key="CodeBlock.ToolButtonCheckedPressedBackground" Color="#22000000" />
<SolidColorBrush x:Key="CodeBlock.ToolButtonCheckedBorderBrush" Color="#1A000000" />
<SolidColorBrush x:Key="Markdown.HeadingFg" Color="#1F1F1F" />
<Color x:Key="BorderColor">#24000000</Color>
<Color x:Key="ForegroundColor">#1F1F1F</Color>
<Color x:Key="CardBackgroundColor">#0A000000</Color>
<Color x:Key="SecondaryCardBackgroundColor">#0C000000</Color>
<Color x:Key="CodeInlineColor">#805400</Color>
<Color x:Key="QuoteBorderColor">#A97917</Color>
    <!-- 方案专属 Semi 核心键覆盖 -->
    <SolidColorBrush x:Key="SemiColorBackground0" Color="#FFCBCCD1" />
<SolidColorBrush x:Key="SemiColorBackground1" Color="#FFD5D6DB" />
<SolidColorBrush x:Key="SemiColorBackground2" Color="#FFE1E2E7" />
<SolidColorBrush x:Key="SemiColorBackground3" Color="#FFE9EAEF" />
<SolidColorBrush x:Key="SemiColorBackground4" Color="#FFF1F2F7" />
</ResourceDictionary>
