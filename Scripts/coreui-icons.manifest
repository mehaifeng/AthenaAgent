brand:github

# --- composites (CoreUI has no "add" variants of these shapes) --------------
# folder interior spans y 136..440, comment-square's bubble y 48..336.
FolderAdd = folder + plus@190,256,288
ConversationAdd = comment-square + plus@170,256,192
