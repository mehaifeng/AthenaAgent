<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Athena.UI.Models"
             xmlns:loc="using:Athena.UI.Markup"
             xmlns:controls="using:Athena.UI.Controls"
             x:Class="Athena.UI.Controls.ToolCallRowView"
             x:DataType="models:ToolCallEntry">
    <StackPanel>
        <Button Classes="process-row"
                Theme="{StaticResource ProcessRowTheme}"
                Command="{Binding ToggleExpandedCommand}"
                ToolTip.Tip="{Binding Summary}"
                AutomationProperties.Name="{Binding Summary}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <!-- 状态标识：执行中/成功/失败共用一个图标，按 key 换几何、按类换颜色 -->
                <PathIcon Grid.Column="0"
                          Classes="tool-status"
                          Classes.SlowSpin="{Binding IsRunning}"
                          Classes.success="{Binding IsSuccess}"
                          Classes.failed="{Binding IsFailed}"
                          Data="{Binding StatusIconKey, Converter={StaticResource ToolIconKeyToGeometryConverter}}"/>

                <PathIcon Grid.Column="1"
                          Data="{Binding IconKey, Converter={StaticResource ToolIconKeyToGeometryConverter}}"
                          Margin="6,0,4,0"
                          Width="11" Height="11"
                          Opacity="0.8"
                          VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding Summary}"
                           FontSize="{DynamicResource App.FontSize.Body}"
                           MaxLines="1"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>

                <PathIcon Grid.Column="3"
                          Classes="process-chevron"
                          IsVisible="{Binding HasDetails}"
                          Data="{Binding ChevronIconKey, Converter={StaticResource ToolIconKeyToGeometryConverter}}"/>
            </Grid>
        </Button>

        <!-- 收起时 ExpandedDetails 为 null，整棵详情子树不被实例化 -->
        <ContentControl Content="{Binding ExpandedDetails}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="models:ToolCallEntry">
                    <Border Classes="tool-detail-editor" Name="ToolDetailEditor">
                        <StackPanel Spacing="8">
                            <SelectableTextBlock Name="ToolDetailName"
                                                 Text="{Binding Name}"
                                                 FontFamily="{StaticResource MonospaceFontFamily}"
                                                 FontSize="{DynamicResource App.FontSize.Body}"
                                                 FontWeight="SemiBold"
                                                 Foreground="{DynamicResource SemiColorText2}"
                                                 TextWrapping="Wrap"/>

                            <StackPanel Spacing="3" IsVisible="{Binding HasArguments}">
                                <TextBlock Foreground="{DynamicResource App.TextMuted}" Text="{loc:Loc Tool.ArgumentsLabel}"
                                           FontSize="{DynamicResource App.FontSize.Caption}" FontWeight="SemiBold"/>
                                <SelectableTextBlock Name="ToolDetailArguments"
                                                     Text="{Binding Arguments}"
                                                     FontFamily="{StaticResource MonospaceFontFamily}"
                                                     FontSize="{DynamicResource App.FontSize.Body}"
                                                     Foreground="{DynamicResource SemiColorText2}"
                                                     TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- PTC 子调用仍按实际顺序嵌套显示，不产生额外的供应商调用或归档字段。 -->
                            <ItemsControl ItemsSource="{Binding ProgramCalls}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ToolCallEntry">
                                        <controls:ToolCallRowView/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Spacing="3" IsVisible="{Binding HasResult}">
                                <TextBlock Foreground="{DynamicResource App.TextMuted}" Text="{loc:Loc Tool.ResultLabel}"
                                           FontSize="{DynamicResource App.FontSize.Caption}" FontWeight="SemiBold"/>
                                <SelectableTextBlock Name="ToolDetailResult"
                                                     Text="{Binding Result}"
                                                     FontFamily="{StaticResource MonospaceFontFamily}"
                                                     FontSize="{DynamicResource App.FontSize.Body}"
                                                     Foreground="{DynamicResource SemiColorText2}"
                                                     TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </StackPanel>
</UserControl>
